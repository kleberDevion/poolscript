# Servidor LSP da PoolScript, em PoolScript.
#
# Fala Language Server Protocol por stdin/stdout. Qualquer editor que seja
# cliente LSP (VS Code, Neovim, Helix, Emacs, JetBrains via plugin LSP)
# conversa com ele.
#
#     pool lsp/servidor.ps
#
# O que entrega:
#
#   - completion type-aware, com o modelo de tipos lido do PRÓPRIO binário
#     (`pool --metadata`) — tipo desconhecido não sugere nada;
#   - hover com a assinatura real do método;
#   - diagnóstico: `pool --check` no arquivo, a cada save/abertura.
#
# Ver docs/lsp.md.
import os
import json
import sys
import protocolo
import modelo

TMP = "/tmp/ps_lsp"

# uri -> texto do arquivo aberto
docs = {}
rodando = true


# ── utilidades de texto ─────────────────────────────────────────────────────

action uri_pra_caminho(uri):
    if uri.startswith("file://"):
        return uri[7:]
    return uri


# O texto até o cursor (linha/coluna em base 0, como o LSP manda).
action ate_o_cursor(texto, linha, coluna):
    ls = texto.split("\n")
    if linha >= len(ls):
        return ""
    return ls[linha][0:coluna]


# A parte da expressão imediatamente antes do cursor: em
# `x = conn.cursor().fetch` devolve `conn.cursor().fetch`.
action pedaco_antes(s):
    i = len(s)
    profundidade = 0
    while i > 0:
        c = s[i - 1]
        if c == ")":
            profundidade = profundidade + 1
        elif c == "(":
            if profundidade == 0:
                break
            profundidade = profundidade - 1
        elif profundidade == 0:
            if not (c.isalnum() or c == "_" or c == "." or c == "\""):
                break
        i = i - 1
    return s[i:]


# ── completion ──────────────────────────────────────────────────────────────

# kind do LSP: 2 = Method, 3 = Function, 9 = Module, 14 = Keyword, 6 = Variable
action item(rotulo, kind, detalhe):
    return {"label": rotulo, "kind": kind, "detail": detalhe}


action completa(texto, linha, coluna):
    prefixo = ate_o_cursor(texto, linha, coluna)
    trecho = pedaco_antes(prefixo)
    itens = []

    if trecho.count(".") > 0:
        corte = trecho.rfind(".")
        alvo = trecho[0:corte]
        vars = modelo.tipos_do_documento(texto)

        # `alvo` é um módulo? sugere os membros dele
        if modelo.eh_modulo(alvo):
            for each m in modelo.membros_de_modulo(alvo):
                itens.append(item(m["nome"], 3, modelo.assinatura(m)))
            return itens

        # senão, o TIPO do alvo é quem manda
        t = modelo.tipo_de_expressao(alvo, vars)
        if t == "" or t.startswith("<modulo:"):
            return []                     # tipo desconhecido: nada de chute
        for each m in modelo.membros_de_tipo(t):
            itens.append(item(m["nome"], 2, t + "." + modelo.assinatura(m)))
        # o que todo objeto tem
        for each m in modelo.membros_de_tipo("__universal__"):
            itens.append(item(m["nome"], 2, modelo.assinatura(m)))
        return itens

    # sem receptor: palavras da linguagem, módulos e variáveis do arquivo
    for each k in modelo.KEYWORDS:
        itens.append(item(k, 14, "palavra da linguagem"))
    for each m in META_MODULOS():
        itens.append(item(m, 9, "modulo"))
    vars = modelo.tipos_do_documento(texto)
    for each v in vars.keys():
        itens.append(item(v, 6, vars[v]))
    return itens


action META_MODULOS():
    return modelo.META["modulos"].keys()


# ── hover ───────────────────────────────────────────────────────────────────

action passa_o_mouse(texto, linha, coluna):
    ls = texto.split("\n")
    if linha >= len(ls):
        return Null
    l = ls[linha]
    # estende o nome sob o cursor pros dois lados
    i = coluna
    while i > 0 and (l[i - 1].isalnum() or l[i - 1] == "_"):
        i = i - 1
    j = coluna
    while j < len(l) and (l[j].isalnum() or l[j] == "_"):
        j = j + 1
    nome = l[i:j]
    if nome == "":
        return Null

    # tem receptor antes do nome?
    antes = l[0:i]
    if antes.endswith("."):
        alvo = pedaco_antes(antes[0:len(antes) - 1])
        m = Null
        onde = ""
        if modelo.eh_modulo(alvo):
            m = modelo.acha(modelo.membros_de_modulo(alvo), nome)
            onde = alvo
        else:
            t = modelo.tipo_de_expressao(alvo, modelo.tipos_do_documento(texto))
            if t != "" and not t.startswith("<modulo:"):
                m = modelo.acha(modelo.membros_de_tipo(t), nome)
                onde = t
        if m != Null:
            corpo = "```ps\n" + onde + "." + modelo.assinatura(m) + "\n```"
            r = m.get("retorna")
            if r != Null:
                corpo = corpo + "\n\ndevolve **" + r + "**"
            return {"contents": {"kind": "markdown", "value": corpo}}
        return Null

    if modelo.eh_modulo(nome):
        qtd = len(modelo.membros_de_modulo(nome))
        return {"contents": {"kind": "markdown",
                "value": "modulo **" + nome + "** — " + str(qtd) + " membros"}}
    if nome in modelo.KEYWORDS:
        return {"contents": {"kind": "markdown",
                "value": "`" + nome + "` — palavra da linguagem"}}
    return Null


# ── diagnóstico ─────────────────────────────────────────────────────────────

# Roda `pool --check` no arquivo e traduz o erro pro formato do LSP.
# `--check` só analisa, não executa — pode rodar a cada save sem efeito
# colateral. Ele já responde JSON no stdout, com linha e coluna:
#
#     {"ok":true}
#     {"ok":false,"tipo":"SyntaxError","msg":"...","linha":1,"coluna":10}
#
# e sai com código 0 nos dois casos — o veredito está no `ok`, não no código.
action diagnostica(uri, texto):
    os.mkdir(TMP, exist_ok=true)
    alvo = TMP + "/check.ps"
    using open(alvo, "w") as f:
        f.write(texto)
    os.cmd("pool --check " + alvo + " > " + TMP + "/c.out 2>/dev/null")
    bruto = open(TMP + "/c.out").read().strip()
    if bruto == "":
        os.cmd("./pool --check " + alvo + " > " + TMP + "/c.out 2>/dev/null")
        bruto = open(TMP + "/c.out").read().strip()
    if bruto == "":
        return []

    r = json.parse(bruto)
    if r.get("ok") == true:
        return []

    # o LSP conta linha e coluna a partir de 0; o `--check` conta a partir de 1
    nlinha = r.get("linha")
    if nlinha == Null:
        nlinha = 1
    ncol = r.get("coluna")
    if ncol == Null:
        ncol = 1
    l0 = nlinha - 1
    c0 = ncol - 1
    if l0 < 0:
        l0 = 0
    if c0 < 0:
        c0 = 0
    tipo = r.get("tipo")
    if tipo == Null:
        tipo = "Erro"
    msg = r.get("msg")
    if msg == Null:
        msg = bruto

    return [{"range": {"start": {"line": l0, "character": c0},
                       "end": {"line": l0, "character": c0 + 1}},
             "severity": 1, "source": "poolscript",
             "message": tipo + ": " + msg}]


action publica_diagnostico(uri, texto):
    protocolo.notifica("textDocument/publishDiagnostics",
                       {"uri": uri, "diagnostics": diagnostica(uri, texto)})


# ── laço principal ──────────────────────────────────────────────────────────

action trata(msg):
    global rodando
    metodo = msg.get("method")
    id = msg.get("id")
    params = msg.get("params")
    if params == Null:
        params = {}

    if metodo == "initialize":
        protocolo.responde(id, {
            "capabilities": {
                # 1 = full: o editor manda o documento inteiro a cada mudança
                "textDocumentSync": 1,
                "completionProvider": {"triggerCharacters": ["."]},
                "hoverProvider": true
            },
            "serverInfo": {"name": "poolscript-lsp"}
        })
        return

    if metodo == "initialized":
        return

    if metodo == "shutdown":
        protocolo.responde(id, Null)
        return

    if metodo == "exit":
        rodando = false
        return

    if metodo == "textDocument/didOpen":
        d = params["textDocument"]
        docs[d["uri"]] = d["text"]
        publica_diagnostico(d["uri"], d["text"])
        return

    if metodo == "textDocument/didChange":
        uri = params["textDocument"]["uri"]
        mudancas = params["contentChanges"]
        if len(mudancas) > 0:
            docs[uri] = mudancas[len(mudancas) - 1]["text"]
        return

    if metodo == "textDocument/didSave":
        uri = params["textDocument"]["uri"]
        if uri in docs:
            publica_diagnostico(uri, docs[uri])
        return

    if metodo == "textDocument/didClose":
        uri = params["textDocument"]["uri"]
        if uri in docs:
            docs.pop(uri)
        return

    if metodo == "textDocument/completion":
        uri = params["textDocument"]["uri"]
        pos = params["position"]
        texto = ""
        if uri in docs:
            texto = docs[uri]
        protocolo.responde(id, completa(texto, pos["line"], pos["character"]))
        return

    if metodo == "textDocument/hover":
        uri = params["textDocument"]["uri"]
        pos = params["position"]
        texto = ""
        if uri in docs:
            texto = docs[uri]
        protocolo.responde(id, passa_o_mouse(texto, pos["line"], pos["character"]))
        return

    # método desconhecido: se tem id, o editor ESPERA resposta — calar trava o
    # cliente. Notificação (sem id) pode ser ignorada, como manda o protocolo.
    if id != Null:
        protocolo.erro(id, -32601, "metodo nao suportado: " + str(metodo))


run_selfwith_("main"):
    modelo.inicia()
    protocolo.loga("pronto — " + str(len(modelo.META["modulos"].keys())) + " modulos, "
                   + str(len(modelo.META["tipos"].keys())) + " tipos")
    while rodando:
        msg = protocolo.le_mensagem()
        if msg == Null:
            break
        try:
            trata(msg)
        catch (e):
            # um erro tratando UMA mensagem não pode derrubar o servidor: o
            # editor ficaria sem completion pelo resto da sessão.
            protocolo.loga("erro tratando " + str(msg.get("method")) + ": " + str(e))
            if msg.get("id") != Null:
                protocolo.erro(msg["id"], -32603, str(e))
    protocolo.loga("encerrado")

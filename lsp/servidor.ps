# Servidor LSP da PoolScript, em PoolScript.
#
# Fala Language Server Protocol por stdin/stdout. Qualquer editor que seja
# cliente LSP (VS Code, Neovim, Helix, Emacs, JetBrains via plugin LSP)
# conversa com ele.
#
#     pool lsp/servidor.ps
#
# O que entrega:
#
#     (`pool --metadata`) — tipo desconhecido não sugere nada;
#   - hover com a assinatura real do método;
#   - diagnóstico: `pool --check` no arquivo, a cada save/abertura;
#   - realce (semantic tokens) vindo do LEXER de verdade (`pool --tokens`),
#     pra não existir uma segunda gramática divergindo do motor.
#
# Ver docs/lsp.md.
import os
import json
import sys
import protocolo
import modelo

# Pasta de trabalho do servidor: onde ele grava o FONTE DO USUÁRIO pra passar
# ao `pool --check`/`--tokens`.
#
# Era `/tmp/ps_lsp`, fixo. Dois problemas, e o primeiro é o que importa:
#
# 1. `/tmp` é gravável por todo mundo e o nome era o MESMO pra qualquer usuário.
#    Outro usuário da máquina podia criar `/tmp/ps_lsp` antes, com permissão de
#    leitura pra si, e passar a ler o código-fonte privado de quem edita — ou
#    trocar o caminho por link simbólico e escolher onde a escrita cai.
# 2. Dois usuários editando ao mesmo tempo pisavam no arquivo um do outro.
#
# `XDG_RUNTIME_DIR` (`/run/user/<uid>`) é a resposta padrão do sistema: já nasce
# 0700 do dono, o systemd limpa no logout, e é por usuário. Sem ele (container,
# sessão sem systemd), cai pro `/tmp` com o UID no nome — não é tão bom, mas
# deixa de ser um caminho que dois usuários disputam.
action lsp_pasta_tmp() {
    raiz = os.getenv("XDG_RUNTIME_DIR")
    if raiz != Null and raiz != "" {
        return raiz + "/poolscript-lsp"
    }
    quem = os.getenv("UID")
    if quem == Null or quem == "" {
        quem = os.getenv("USER")
    }
    if quem == Null or quem == "" {
        quem = "anon"
    }
    return "/tmp/ps_lsp-" + str(quem)
}

TMP = lsp_pasta_tmp()

# uri -> texto do arquivo aberto
docs = {}
rodando = true


# ── utilidades de texto ─────────────────────────────────────────────────────

action uri_pra_caminho(uri) {
    if uri.startswith("file://") {
        return uri[7:]
    }
    return uri
}


# O texto até o cursor (linha/coluna em base 0, como o LSP manda).
# Texto da linha ATÉ o cursor. É o que o completion e o hover olham: o que vem
# depois não influencia o que se sugere.
action ate_o_cursor(texto, linha, coluna) {
    ls = texto.split("\n")
    if linha >= len(ls) {
        return ""
    }
    l = ls[linha]
    if coluna > len(l) {
        coluna = len(l)
    }
    return l[0:coluna]
}


action pedaco_antes(s) {
    i = len(s)
    profundidade = 0
    while i > 0 {
        c = s[i - 1]
        if c == ")" {
            profundidade = profundidade + 1
        }
        elif c == "(" {
            if profundidade == 0 {
                break
            }
            profundidade = profundidade - 1
        }
        elif profundidade == 0 {
            if not (c.isalnum() or c == "_" or c == "." or c == "\"") {
                break
            }
        }
        i = i - 1
    }
    return s[i:]
}


# ── completion ──────────────────────────────────────────────────────────────
#
# A sugestão carrega TRÊS coisas, e é isso que a faz valer:
#
#     label          o nome
#     detail         a assinatura real + o tipo que devolve
#     documentation  a frase da doc explicando o que faz
#
# É a estrutura que existia antes de eu degradá-la. O que tinha sobrado era
# `label` + "palavra da linguagem" no detalhe — quem digita `for` não precisa
# que o editor lhe informe que `for` existe. Por isso PALAVRA DA LINGUAGEM NÃO
# ENTRA: o editor já completa palavra do próprio buffer, e sugestão sem
# conteúdo é ruído que empurra a útil pra baixo.
#
# Nada é digitado aqui: nome e parâmetros vêm de `pool --metadata` (as tabelas
# do VM), a prosa vem de `docs/`, que o `scripts/audita_doc.ps` confere contra
# o motor. Tipo desconhecido devolve lista VAZIA — nunca um chute.

# kind do LSP: 2 = Method, 3 = Function, 5 = Field, 9 = Module,
#              6 = Variable, 21 = Constant
action item(rotulo, kind, detalhe, prosa) {
    it = {"label": rotulo, "kind": kind, "detail": detalhe}
    if prosa != "" {
        it["documentation"] = {"kind": "markdown", "value": prosa}
    }
    return it
}


# Um membro de módulo ou de tipo, com assinatura, retorno e prosa.
action item_membro(escopo, m, kind) {
    sig = modelo.assinatura(m)
    detalhe = escopo + "." + sig
    r = m.get("retorna")
    if r != Null {
        detalhe = detalhe + " -> " + r
    }
    prosa = modelo.resumo_de(escopo, m["nome"])
    if prosa != "" {
        prosa = "```ps\n" + detalhe + "\n```\n\n" + prosa
    }
    return item(m["nome"], kind, detalhe, prosa)
}


action completa(texto, linha, coluna) {
    prefixo = ate_o_cursor(texto, linha, coluna)
    trecho = pedaco_antes(prefixo)
    itens = []
    vars = modelo.tipos_do_documento(texto)

    # `self.` dentro de uma Entity: campos e métodos DELA, nada mais
    if trecho == "self." or trecho.endswith(" self.") {
        ent = modelo.entity_da_linha(texto, linha)
        for each m in modelo.membros_de_entity(texto, ent) {
            itens.append(item(m["nome"], 5, m["detalhe"], ""))
        }
        return itens
    }

    # dentro dos parênteses de uma chamada conhecida: os parâmetros dela.
    # Só quando NÃO há um `.` pendente — `f(x.` é completion de membro.
    if trecho.count(".") == 0 {
        ps = modelo.params_da_chamada(prefixo, vars)
        if len(ps) > 0 {
            for each p in ps {
                d = p.get("default")
                detalhe = "parametro"
                if d != Null {
                    detalhe = "parametro (padrao " + str(d) + ")"
                }
                itens.append(item(p["nome"] + "=", 21, detalhe, ""))
            }
            return itens
        }
    }

    if trecho.count(".") > 0 {
        corte = trecho.rfind(".")
        alvo = trecho[0:corte]

        # `alvo` é um módulo? sugere os membros dele
        if modelo.eh_modulo(alvo) {
            for each m in modelo.membros_de_modulo(alvo) {
                itens.append(item_membro(alvo, m, 3))
            }
            return itens
        }

        # senão, o TIPO do alvo é quem manda
        t = modelo.tipo_de_expressao(alvo, vars)
        if t == "" or t.startswith("<modulo:") {
            return []                     # tipo desconhecido: nada de chute
        }
        for each m in modelo.membros_de_tipo(t) {
            itens.append(item_membro(t, m, 2))
        }
        # o que todo objeto tem
        for each m in modelo.membros_de_tipo("__universal__") {
            itens.append(item(m["nome"], 2, modelo.assinatura(m), ""))
        }
        return itens
    }

    # SEM RECEPTOR: só o que tem conteúdo. Módulos (com a contagem de membros)
    # e as variáveis do arquivo (com o tipo inferido). Palavra da linguagem
    # fica FORA — ver o cabeçalho.
    for each mo in META_MODULOS() {
        itens.append(item(mo, 9, "modulo — " + str(len(modelo.membros_de_modulo(mo))) + " membros", ""))
    }
    for each v in vars.keys() {
        itens.append(item(v, 6, vars[v], ""))
    }
    return itens
}


action META_MODULOS() {
    return modelo.META["modulos"].keys()
}


# ── hover ───────────────────────────────────────────────────────────────────

action passa_o_mouse(texto, linha, coluna) {
    ls = texto.split("\n")
    if linha >= len(ls) {
        return Null
    }
    l = ls[linha]
    # A COLUNA vem do editor e pode passar do fim da linha — depois de apagar
    # texto, o cursor chega numa posição que a linha não tem mais. Sem prender
    # aqui, o `l[i - 1]` do laço abaixo lê fora e derruba o hover inteiro.
    #
    # Isso já era bug antes; ficava escondido porque ler fora da faixa devolvia
    # `null` em silêncio. Quando a leitura passou a levantar (I4/I5), o hover
    # parou de responder e o defeito apareceu.
    if coluna > len(l) {
        coluna = len(l)
    }
    if coluna < 0 {
        coluna = 0
    }
    # estende o nome sob o cursor pros dois lados
    i = coluna
    while i > 0 and (l[i - 1].isalnum() or l[i - 1] == "_") {
        i = i - 1
    }
    j = coluna
    while j < len(l) and (l[j].isalnum() or l[j] == "_") {
        j = j + 1
    }
    nome = l[i:j]
    if nome == "" {
        return Null
    }

    # tem receptor antes do nome?
    antes = l[0:i]
    if antes.endswith(".") {
        alvo = pedaco_antes(antes[0:len(antes) - 1])
        m = Null
        onde = ""
        if modelo.eh_modulo(alvo) {
            m = modelo.acha(modelo.membros_de_modulo(alvo), nome)
            onde = alvo
        }
        else {
            t = modelo.tipo_de_expressao(alvo, modelo.tipos_do_documento(texto))
            if t != "" and not t.startswith("<modulo:") {
                m = modelo.acha(modelo.membros_de_tipo(t), nome)
                onde = t
            }
        }
        if m != Null {
            corpo = "```ps\n" + onde + "." + modelo.assinatura(m) + "\n```"
            r = m.get("retorna")
            if r != Null {
                corpo = corpo + "\n\ndevolve **" + r + "**"
            }
            # a MESMA prosa que o completion mostra, da mesma doc
            prosa = modelo.resumo_de(onde, nome)
            if prosa != "" {
                corpo = corpo + "\n\n" + prosa
            }
            return {"contents": {"kind": "markdown", "value": corpo}}
        }
        return Null
    }

    if modelo.eh_modulo(nome) {
        qtd = len(modelo.membros_de_modulo(nome))
        return {"contents": {"kind": "markdown",
                "value": "modulo **" + nome + "** — " + str(qtd) + " membros"}}
    }
    if nome in modelo.KEYWORDS {
        # "`for` — palavra da linguagem" não informa nada a quem já escreveu
        # `for`. Sem prosa pra mostrar, o hover fica CALADO: caixinha vazia
        # cobre o código e não entrega nada.
        return Null
    }
    return Null
}


# ── realce (semantic tokens) ────────────────────────────────────────────────
#
# A fonte é o LEXER DE VERDADE (`pool --tokens`), não uma segunda gramática:
# gramática paralela diverge do motor no primeiro token novo que a linguagem
# ganhar. O legend abaixo é a ordem que o editor recebe no `initialize`.
LEGENDA = ["keyword", "string", "number", "comment", "function", "variable",
           "type", "operator"]

# tipo do lexer -> índice na LEGENDA. O que não está aqui não é pintado
# (parêntese, vírgula, dois-pontos: o editor já dá conta, e pintar tudo só
# polui).
action indice_do_token(t) {
    if t == "KW" {
        return 0
    }
    if t == "STR" or t == "FSTRING" or t == "COLOR" {
        return 1
    }
    if t == "INT" or t == "FLO" {
        return 2
    }
    if t == "COMMENT" {
        return 3
    }
    if t == "BOOL" or t == "NULL" {
        return 0
    }
    if t == "IDENT_UPPER" {
        return 6
    }
    if t == "IDENT" {
        return 5
    }
    if t == "OP" {
        return 7
    }
    return -1
}


# O LSP quer os tokens ACHATADOS em grupos de 5, e em DELTA: linha relativa ao
# token anterior, coluna relativa ao anterior quando na mesma linha.
action realce(texto) {
    os.mkdir(TMP, exist_ok=true)
    alvo = TMP + "/tok.ps"
    using open(alvo, "w") as f {
        f.write(texto)
    }
    os.cmd("'" + sys.executable + "' --tokens < " + alvo + " > " + TMP + "/tok.json 2>/dev/null")
    bruto = open(TMP + "/tok.json").read().strip()
    if bruto == "" {
        return []
    }
    toks = json.parse(bruto)

    dados = []
    ultima_linha = 0
    ultima_col = 0
    for each t in toks {
        idx = indice_do_token(t["t"])
        if idx < 0 {
            continue
        }
        tam = t["n"]
        if tam <= 0 {
            continue
        }
        linha = t["l"] - 1          # o lexer conta de 1, o LSP de 0
        col = t["c"] - 1
        dlinha = linha - ultima_linha
        dcol = col
        if dlinha == 0 {
            dcol = col - ultima_col
        }
        # token que volta pra trás na mesma linha quebraria o delta
        if dlinha < 0 or (dlinha == 0 and dcol < 0) {
            continue
        }
        dados.append(dlinha)
        dados.append(dcol)
        dados.append(tam)
        dados.append(idx)
        dados.append(0)             # sem modificadores
        ultima_linha = linha
        ultima_col = col
    }
    return dados
}


# ── diagnóstico ─────────────────────────────────────────────────────────────

# Roda `pool --check` no arquivo e traduz o erro pro formato do LSP.
# `--check` só analisa, não executa — pode rodar a cada save sem efeito
# colateral. Ele já responde JSON no stdout, com linha e coluna:
#
#     {"ok":true}
#     {"ok":false,"tipo":"SyntaxError","msg":"...","linha":1,"coluna":10}
#
# e sai com código 0 nos dois casos — o veredito está no `ok`, não no código.
action diagnostica(uri, texto) {
    os.mkdir(TMP, exist_ok=true)
    alvo = TMP + "/check.ps"
    using open(alvo, "w") as f {
        f.write(texto)
    }
    os.cmd("'" + sys.executable + "' --check " + alvo + " > " + TMP + "/c.out 2>/dev/null")
    bruto = open(TMP + "/c.out").read().strip()
    if bruto == "" {
        return []
    }

    r = json.parse(bruto)
    if r.get("ok") == true {
        return []
    }

    # o LSP conta linha e coluna a partir de 0; o `--check` conta a partir de 1
    nlinha = r.get("linha")
    if nlinha == Null {
        nlinha = 1
    }
    ncol = r.get("coluna")
    if ncol == Null {
        ncol = 1
    }
    l0 = nlinha - 1
    c0 = ncol - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    tipo = r.get("tipo")
    if tipo == Null {
        tipo = "Erro"
    }
    msg = r.get("msg")
    if msg == Null {
        msg = bruto
    }

    return [{"range": {"start": {"line": l0, "character": c0},
                       "end": {"line": l0, "character": c0 + 1}},
             "severity": 1, "source": "poolscript",
             "message": tipo + ": " + msg}]
}


action publica_diagnostico(uri, texto) {
    protocolo.notifica("textDocument/publishDiagnostics",
                       {"uri": uri, "diagnostics": diagnostica(uri, texto)})
}


# ── laço principal ──────────────────────────────────────────────────────────

action trata(msg) {
    global rodando
    metodo = msg.get("method")
    id = msg.get("id")
    params = msg.get("params")
    if params == Null {
        params = {}
    }

    if metodo == "initialize" {
        protocolo.responde(id, {
            "capabilities": {
                # 1 = full: o editor manda o documento inteiro a cada mudança
                "textDocumentSync": 1,
                "completionProvider": {"triggerCharacters": ["."]},
                "hoverProvider": true,
                "semanticTokensProvider": {
                    "legend": {"tokenTypes": LEGENDA, "tokenModifiers": []},
                    "full": true
                }
            },
            "serverInfo": {"name": "poolscript-lsp"}
        })
        return
    }

    if metodo == "initialized" {
        return
    }

    if metodo == "shutdown" {
        protocolo.responde(id, Null)
        return
    }

    if metodo == "exit" {
        rodando = false
        return
    }

    if metodo == "textDocument/didOpen" {
        d = params["textDocument"]
        docs[d["uri"]] = d["text"]
        publica_diagnostico(d["uri"], d["text"])
        return
    }

    if metodo == "textDocument/didChange" {
        uri = params["textDocument"]["uri"]
        mudancas = params["contentChanges"]
        if len(mudancas) > 0 {
            docs[uri] = mudancas[len(mudancas) - 1]["text"]
        }
        return
    }

    if metodo == "textDocument/didSave" {
        uri = params["textDocument"]["uri"]
        if uri in docs {
            publica_diagnostico(uri, docs[uri])
        }
        return
    }

    if metodo == "textDocument/didClose" {
        uri = params["textDocument"]["uri"]
        if uri in docs {
            docs.pop(uri)
        }
        return
    }

    if metodo == "textDocument/completion" {
        uri = params["textDocument"]["uri"]
        pos = params["position"]
        texto = ""
        if uri in docs {
            texto = docs[uri]
        }
        protocolo.responde(id, completa(texto, pos["line"], pos["character"]))
        return
    }

    if metodo == "textDocument/semanticTokens/full" {
        uri = params["textDocument"]["uri"]
        texto = ""
        if uri in docs {
            texto = docs[uri]
        }
        protocolo.responde(id, {"data": realce(texto)})
        return
    }

    if metodo == "textDocument/hover" {
        uri = params["textDocument"]["uri"]
        pos = params["position"]
        texto = ""
        if uri in docs {
            texto = docs[uri]
        }
        protocolo.responde(id, passa_o_mouse(texto, pos["line"], pos["character"]))
        return
    }
        
    # método desconhecido: se tem id, o editor ESPERA resposta — calar trava o
    # cliente. Notificação (sem id) pode ser ignorada, como manda o protocolo.
    if id != Null {
        protocolo.erro(id, -32601, "metodo nao suportado: " + str(metodo))
    }
}


if __name__ == "main" {
    modelo.inicia()
    protocolo.loga("pronto — " + str(len(modelo.META["modulos"].keys())) + " modulos, "
                   + str(len(modelo.META["tipos"].keys())) + " tipos")
    while rodando {
        msg = protocolo.le_mensagem()
        if msg == Null {
            break
        }
        try {
            trata(msg)
        }
        catch (e) {
            # um erro tratando UMA mensagem não pode derrubar o servidor: o
            # editor ficaria sem completion pelo resto da sessão.
            protocolo.loga("erro tratando " + str(msg.get("method")) + ": " + str(e))
            if msg.get("id") != Null {
                protocolo.erro(msg["id"], -32603, str(e))
            }
        }
    }
    protocolo.loga("encerrado")
}

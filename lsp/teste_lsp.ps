# Dirige o servidor LSP como um editor faria: escreve mensagens enquadradas na
# entrada dele e confere as respostas. Não precisa de editor nenhum.
#
#     ./pool lsp/teste_lsp.ps
import os
import sys
import json

TMP = "/tmp/ps_lsp_teste"
falhas = 0
feitos = 0

FONTE = "import psodbc\nimport regex\n"
FONTE = FONTE + "conn = psodbc.connect(\"dsn\")\n"
FONTE = FONTE + "cur = conn.cursor()\n"
FONTE = FONTE + "p = regex.compile(\"a\")\n"
FONTE = FONTE + "s = \"texto\"\n"
FONTE = FONTE + "n = 42\n"


action enquadra(obj) {
    corpo = json.stringify(obj)
    return "Content-Length: " + str(len(corpo)) + "\r\n\r\n" + corpo
}


action pede(id, metodo, params) {
    return enquadra({"jsonrpc": "2.0", "id": id, "method": metodo, "params": params})
}


action avisa(metodo, params) {
    return enquadra({"jsonrpc": "2.0", "method": metodo, "params": params})
}


# Manda o roteiro inteiro pro servidor e devolve a lista de respostas (cada
# uma um dict já parseado).
action conversa(roteiro) {
    os.mkdir(TMP, exist_ok=true)
    using open(TMP + "/entrada", "w") as f {
        f.write("".join(roteiro))
    }
    os.cmd("./pool lsp/servidor.ps < " + TMP + "/entrada > " + TMP + "/saida 2> " + TMP + "/log")
    bruto = open(TMP + "/saida").read()
    msgs = []
    resto = bruto
    while true {
        c = resto.find("Content-Length: ")
        if c < 0 {
            break
        }
        resto = resto[c + 16:]
        fim = resto.find("\r\n\r\n")
        if fim < 0 {
            break
        }
        tam = int(resto[0:fim].strip())
        corpo = resto[fim + 4:fim + 4 + tam]
        msgs.append(json.parse(corpo))
        resto = resto[fim + 4 + tam:]
    }
    return msgs
}


action ok(nome, condicao, detalhe) {
    global falhas
    global feitos
    feitos = feitos + 1
    if condicao {
        post("  ok   ", nome)
    }
    else {
        falhas = falhas + 1
        post("  FALHOU", nome, "->", detalhe)
    }
}


# Acha a resposta de um id.
action resposta(msgs, id) {
    for each m in msgs {
        if m.get("id") == id {
            return m
        }
    }
    return Null
}


action notificacoes(msgs, metodo) {
    r = []
    for each m in msgs {
        if m.get("method") == metodo {
            r.append(m)
        }
    }
    return r
}


action rotulos(resp) {
    r = []
    res = resp.get("result")
    if res == Null {
        return r
    }
    for each it in res {
        r.append(it["label"])
    }
    return r
}


action abre(uri, texto) {
    return avisa("textDocument/didOpen",
                 {"textDocument": {"uri": uri, "languageId": "poolscript",
                                   "version": 1, "text": texto}})
}


action posicao(uri, linha, col) {
    return {"textDocument": {"uri": uri}, "position": {"line": linha, "character": col}}
}


run_selfwith_("main") {
    URI = "file:///tmp/ps_lsp_teste/a.ps"

    # ── handshake, completion e hover numa conversa só ──────────────────────
    # linha 7 é a que o editor "está digitando"; o texto do documento termina
    # nela, então a coluna é o fim da linha.
    doc = FONTE + "cur.\n"
    roteiro = [
      pede(1, "initialize", {"processId": Null, "rootUri": Null, "capabilities": {}}),
      avisa("initialized", {}),
      abre(URI, doc),
      # 1) cadeia type-aware: conn = psodbc.connect() -> cur = conn.cursor()
      pede(2, "textDocument/completion", posicao(URI, 7, 4)),
      # 2) membro de módulo
      pede(3, "textDocument/completion", posicao(URI, 1, 0)),
      # 3) hover num método de tipo
      pede(4, "textDocument/hover", posicao(URI, 3, 12)),
      # 4) método desconhecido tem que responder erro, não calar
      pede(5, "textDocument/naoExiste", {}),
      pede(6, "shutdown", {}),
      avisa("exit", {})
    ]
    msgs = conversa(roteiro)

    post("respostas do servidor:", len(msgs))

    r1 = resposta(msgs, 1)
    ok("initialize responde capabilities",
       r1 != Null and r1["result"]["capabilities"]["hoverProvider"] == true, str(r1))

    r2 = resposta(msgs, 2)
    labs = []
    if r2 != Null {
        labs = rotulos(r2)
    }
    ok("cadeia conn.cursor() -> DbCursor sugere fetchall",
       "fetchall" in labs, str(len(labs)) + " itens: " + str(labs[0:6]))
    ok("cadeia NAO sugere metodo de outro tipo",
       not "upper" in labs, str(labs[0:8]))

    r3 = resposta(msgs, 3)
    labs3 = []
    if r3 != Null {
        labs3 = rotulos(r3)
    }
    ok("sem receptor sugere palavra da linguagem",
       "action" in labs3 and "Entity" in labs3, str(len(labs3)) + " itens")
    ok("sem receptor sugere as variaveis do arquivo",
       "conn" in labs3 and "cur" in labs3, str(len(labs3)) + " itens")

    r4 = resposta(msgs, 4)
    txt = ""
    if r4 != Null and r4.get("result") != Null {
        txt = r4["result"]["contents"]["value"]
    }
    ok("hover mostra a assinatura real", txt.count("cursor(") > 0, "[" + txt + "]")

    r5 = resposta(msgs, 5)
    ok("metodo desconhecido devolve erro (nao trava o editor)",
       r5 != Null and r5.get("error") != Null, str(r5))

    r6 = resposta(msgs, 6)
    ok("shutdown responde", r6 != Null, str(r6))

    # ── realce: semantic tokens vindos do lexer de verdade ──────────────────
    fonte = "action f(a):   # soma\n    return a + \"oi\"\n"
    msgsR = conversa([
      pede(1, "initialize", {"processId": Null, "rootUri": Null, "capabilities": {}}),
      abre(URI, fonte),
      pede(2, "textDocument/semanticTokens/full", {"textDocument": {"uri": URI}}),
      avisa("exit", {})
    ])
    rR = resposta(msgsR, 1)
    ok("initialize anuncia o realce",
       rR != Null and rR["result"]["capabilities"].get("semanticTokensProvider") != Null, str(rR))
    r2R = resposta(msgsR, 2)
    dados = []
    if r2R != Null and r2R.get("result") != Null {
        dados = r2R["result"]["data"]
    }
    ok("realce vem em grupos de 5", len(dados) > 0 and len(dados) % 5 == 0, str(len(dados)))
    # o 1º token é `action` na linha 0, coluna 0, 6 chars, tipo 0 (keyword)
    ok("primeiro token e a keyword `action`",
       len(dados) >= 5 and dados[0] == 0 and dados[1] == 0 and dados[2] == 6 and dados[3] == 0,
       str(dados[0:5]))
    # o comentário tem que estar lá (tipo 3) — o lexer normal descarta
    tem_comentario = false
    i = 0
    while i + 4 < len(dados) {
        if dados[i + 3] == 3 {
            tem_comentario = true
        }
        i = i + 5
    }
    ok("comentario entra no realce", tem_comentario, str(dados))
    # a string `"oi"` ocupa 4 no fonte, não 2 (o texto decodificado)
    tem_str4 = false
    i = 0
    while i + 4 < len(dados) {
        if dados[i + 3] == 1 and dados[i + 2] == 4 {
            tem_str4 = true
        }
        i = i + 5
    }
    ok("string mede o trecho do FONTE, com as aspas", tem_str4, str(dados))

    # ── diagnóstico: arquivo com erro de sintaxe ────────────────────────────
    ruim = "action f(:\n    return 1\n"
    msgs2 = conversa([
      pede(1, "initialize", {"processId": Null, "rootUri": Null, "capabilities": {}}),
      abre(URI, ruim),
      avisa("exit", {})
    ])
    diags = notificacoes(msgs2, "textDocument/publishDiagnostics")
    achou = false
    for each d in diags {
        if len(d["params"]["diagnostics"]) > 0 {
            achou = true
        }
    }
    ok("erro de sintaxe vira diagnostico", achou, str(len(diags)) + " notificacoes")

    # arquivo bom não pode gerar diagnóstico
    msgs3 = conversa([
      pede(1, "initialize", {"processId": Null, "rootUri": Null, "capabilities": {}}),
      abre(URI, "post(\"oi\")\n"),
      avisa("exit", {})
    ])
    d3 = notificacoes(msgs3, "textDocument/publishDiagnostics")
    limpo = true
    for each d in d3 {
        if len(d["params"]["diagnostics"]) > 0 {
            limpo = false
        }
    }
    ok("arquivo valido nao gera diagnostico", limpo, str(d3))

    post("")
    post(str(feitos - falhas) + "/" + str(feitos), "checagens passaram")
    if falhas > 0 {
        post("log do servidor:")
        post(open(TMP + "/log").read())
        sys.exit(1)
    }
}

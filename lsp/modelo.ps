# O modelo de tipos do servidor LSP.
#
# A FONTE é o próprio binário: `pool --metadata` despeja módulos, tipos e
# métodos lidos das tabelas do VM. Nada aqui é digitado à mão, então o
# completion não tem como inventar método que o motor não tem — e quando o
# tipo é desconhecido, a resposta é lista VAZIA, nunca um chute.
import os
import sys
import json
import regex

META = {}
TMP = "/tmp/ps_lsp"

# Palavras da linguagem, pra completar onde não há receptor.
KEYWORDS = ["if", "else", "elif", "while", "for", "each", "in", "is", "and",
            "or", "not", "action", "reaction", "return", "continue", "break",
            "pass", "model", "enum", "async", "await", "try", "catch", "as",
            "with", "using", "import", "from", "str", "int", "flo", "bool",
            "char", "list", "dict", "json", "tup", "class", "Class", "Entity",
            "self", "base", "private", "public", "match", "case", "yield",
            "raise", "finally", "count", "global", "to", "post", "input",
            "true", "false", "Null", "run_selfwith_"]


# O modelo vem do binário que está rodando ESTE servidor (`sys.executable`),
# nunca do `pool` que estiver no PATH: dá pra ter um instalado em
# /usr/local/bin mais velho que o do repositório, e aí o completion descreve
# um motor que não é o que o usuário está usando. Foi o que aconteceu — o
# `jinker.request` aparecia sem tipo porque o binário do PATH era antigo.
action carrega() {
    os.mkdir(TMP, exist_ok=true)
    alvo = TMP + "/meta.json"
    os.cmd("'" + sys.executable + "' --metadata > " + alvo + " 2>/dev/null")
    return json.parse(open(alvo).read())
}


action inicia() {
    global META
    META = carrega()
}


action eh_modulo(nome) {
    return nome in META["modulos"]
}


action eh_tipo(nome) {
    return nome in META["tipos"]
}


# Os membros de um módulo ou de um tipo, no formato que o completion usa.
action membros_de_modulo(nome) {
    if not eh_modulo(nome) {
        return []
    }
    return META["modulos"][nome]
}


action membros_de_tipo(nome) {
    if not eh_tipo(nome) {
        return []
    }
    return META["tipos"][nome]
}


# Acha um membro pelo nome dentro de uma lista de membros.
action acha(membros, nome) {
    for each m in membros {
        if m["nome"] == nome {
            return m
        }
    }
    return Null
}


# Assinatura legível: `compile(pattern, flags=None)`.
action assinatura(m) {
    ps = m.get("params")
    if ps == Null {
        ps = []
    }
    partes = []
    for each p in ps {
        d = p.get("default")
        if d == Null {
            partes.append(p["nome"])
        }
        else {
            partes.append(p["nome"] + "=" + str(d))
        }
    }
    return m["nome"] + "(" + ", ".join(partes) + ")"
}


# ── prosa: o resumo vem da DOC, não da memória de ninguém ───────────────────
#
# A sugestão de antigamente não era um rótulo: cada membro vinha com
# assinatura, tipo de retorno E uma frase explicando o que faz. Sem isso o
# completion vira o que ele tinha virado — uma lista de nomes com "palavra da
# linguagem" do lado, que atrapalha mais do que ajuda.
#
# A prosa sai de `docs/<escopo>/<nome>/<nome>.md`, que é a MESMA página que o
# `scripts/audita_doc.ps` confere contra o motor: 87 títulos batendo. Nada é
# digitado aqui — se a doc muda, a sugestão muda junto; se a página não
# existe, a sugestão vem SEM prosa em vez de vir com invenção.
#
# Lido sob demanda e memorizado: completar `regex.` toca ~10 arquivos, não 353.
RAIZ_DOC = ""
RESUMOS = {}


action raiz_doc() {
    if RAIZ_DOC != "" {
        return RAIZ_DOC
    }
    # `docs/` fica ao lado do binário instalado, ou na raiz do repositório
    # quando se roda o servidor direto de lá.
    # Não há `os.dirname`; a pasta sai do próprio caminho do binário.
    exe = sys.executable
    corte = exe.rfind("/")
    onde = "."
    if corte > 0 {
        onde = exe[0:corte]
    }
    for each c in [onde + "/../share/poolscript/docs", onde + "/docs", "docs"] {
        if os.isdir(c) {
            RAIZ_DOC = c
            return RAIZ_DOC
        }
    }
    RAIZ_DOC = "-"
    return RAIZ_DOC
}


# Primeiro parágrafo de prosa da página, ou "" se não houver página.
action resumo_de(escopo, nome) {
    chave = escopo + "/" + nome
    if chave in RESUMOS {
        return RESUMOS[chave]
    }
    RESUMOS[chave] = ""
    raiz = raiz_doc()
    if raiz == "-" {
        return ""
    }
    caminho = raiz + "/" + escopo + "/" + nome + "/" + nome + ".md"
    if not os.exists(caminho) {
        return ""
    }
    # pula o título e pega o primeiro bloco corrido, parando no primeiro
    # cabeçalho, tabela ou bloco de código.
    passou = false
    partes = []
    for each l in open(caminho).read().split("\n") {
        t = l.strip()
        if not passou {
            if t.startswith("# ") {
                passou = true
            }
            continue
        }
        if t == "" {
            if len(partes) > 0 {
                break
            }
            continue
        }
        if t.startswith("#") or t.startswith("|") or t.startswith("```") {
            break
        }
        partes.append(t)
    }
    RESUMOS[chave] = (" ").join(partes)
    return RESUMOS[chave]
}


# ── inferência de tipo ──────────────────────────────────────────────────────

# Tipo de um literal, ou "" se não for literal.
action tipo_de_literal(e) {
    t = e.strip()
    if t == "" {
        return ""
    }
    if t.startswith("\"") or t.startswith("'") or t.startswith("f\"") {
        return "str"
    }
    if t.startswith("[") {
        return "list"
    }
    if t.startswith("{") {
        return "dict"
    }
    if t.startswith("(") {
        return "tup"
    }
    if t == "true" or t == "false" {
        return "bool"
    }
    if regex.fullmatch("-?\\d+", t) != Null {
        return "int"
    }
    if regex.fullmatch("-?\\d+\\.\\d+", t) != Null {
        return "flo"
    }
    return ""
}


# Tipo do resultado de uma expressão como `psodbc.connect()` ou `conn.cursor()`.
# `vars` é o mapa nome -> tipo já descoberto no documento.
# Devolve "" quando não dá pra saber — e aí o completion NÃO sugere nada.
action tipo_de_expressao(e, vars) {
    t = e.strip()
    if t == "" {
        return ""
    }

    lit = tipo_de_literal(t)
    if lit != "" {
        return lit
    }

    # tira a chamada final: `f(...)` -> `f`, guardando que houve chamada
    chamou = false
    if t.endswith(")") {
        abre = t.rfind("(")
        if abre >= 0 {
            t = t[0:abre]
            chamou = true
        }
    }

    # cadeia por ponto: `psodbc.connect` / `conn.cursor` / `regex.compile`
    if t.count(".") > 0 {
        corte = t.rfind(".")
        alvo = t[0:corte]
        nome = t[corte + 1:]
        # módulo?
        if eh_modulo(alvo) {
            m = acha(membros_de_modulo(alvo), nome)
            if m == Null {
                return ""
            }
            r = m.get("retorna")
            if r == Null {
                return ""
            }
            return r
        }
        # recursivo: o tipo do alvo manda
        talvo = tipo_de_expressao(alvo, vars)
        if talvo == "" {
            return ""
        }
        m = acha(membros_de_tipo(talvo), nome)
        if m == Null {
            return ""
        }
        r = m.get("retorna")
        if r == Null {
            return ""
        }
        return r
    }

    # nome simples
    if t in vars {
        return vars[t]
    }
    if eh_modulo(t) {
        return "<modulo:" + t + ">"
    }
    return ""
}


# ── Entity: o que `self.` oferece ───────────────────────────────────────────

# A Entity que contém a linha `n` (base 0), ou "" se a linha está fora de
# qualquer Entity. Vai pela INDENTAÇÃO: o corpo da Entity é o que está mais
# indentado que o cabeçalho dela.
action entity_da_linha(texto, n) {
    linhas = texto.split("\n")
    if n >= len(linhas) {
        return ""
    }
    atual = ""
    ind_ent = -1
    i = 0
    while i <= n and i < len(linhas) {
        l = linhas[i]
        semindent = l.lstrip()
        recuo = len(l) - len(semindent)
        if semindent.startswith("Entity ") or semindent.startswith("class ") or semindent.startswith("Class ") {
            abre = semindent.find("(")
            if abre > 0 {
                atual = semindent.split(" ")[1][0:abre - len(semindent.split(" ")[0]) - 1]
                # mais simples e seguro: pega entre o espaço e o "("
                cab = semindent[semindent.find(" ") + 1:]
                atual = cab[0:cab.find("(")].strip()
                ind_ent = recuo
            }
        }
        elif semindent != "" and ind_ent >= 0 and recuo <= ind_ent {
            atual = ""            # a Entity acabou
            ind_ent = -1
        }
        i = i + 1
    }
    return atual
}


# Membros que `self.` deve oferecer dentro da Entity `nome`: os métodos
# declarados nela, os campos `nome: tipo` e o que for atribuído em
# `self.algo = ...`.
action membros_de_entity(texto, nome) {
    if nome == "" {
        return []
    }
    linhas = texto.split("\n")
    dentro = false
    ind_ent = -1
    achados = []
    vistos = {}

    action poe(rotulo, detalhe) {
        if rotulo in vistos {
            return
        }
        vistos[rotulo] = 1
        achados.append({"nome": rotulo, "detalhe": detalhe})
    }

    for each l in linhas {
        semindent = l.lstrip()
        recuo = len(l) - len(semindent)
        if semindent.startswith("Entity ") or semindent.startswith("class ") or semindent.startswith("Class ") {
            cab = semindent[semindent.find(" ") + 1:]
            este = cab[0:cab.find("(")].strip()
            dentro = (este == nome)
            ind_ent = recuo
            continue
        }
        if semindent == "" {
            continue
        }
        if ind_ent >= 0 and recuo <= ind_ent {
            dentro = false
        }
        if not dentro {
            # `self.x = ...` só conta dentro da Entity certa
            continue
        }
        # método: `action m(self, ...)`, com modificadores antes
        c = semindent.find("action ")
        if c < 0 {
            c = semindent.find("reaction ")
        }
        if c >= 0 {
            resto = semindent[semindent.find(" ", c) + 1:]
            fim = resto.find("(")
            if fim > 0 {
                met = resto[0:fim].strip()
                if met != "" and not met.startswith("__") {
                    poe(met, "metodo de " + nome + resto[fim:].rstrip(":").rstrip(" {"))
                }
            }
            continue
        }
        # campo declarado: `nome: tipo` (com `private`/`public` opcional)
        dp = semindent.find(":")
        if dp > 0 and semindent.find("(") < 0 and semindent.find("=") < 0 {
            campo = semindent[0:dp].strip()
            ps = campo.split(" ")
            campo = ps[len(ps) - 1]
            if regex.fullmatch("[A-Za-z_][A-Za-z0-9_]*", campo) != Null {
                poe(campo, "campo: " + semindent[dp + 1:].strip())
            }
            continue
        }
        # atribuição a `self.x`
        if semindent.startswith("self.") {
            ig = semindent.find("=")
            if ig > 0 {
                campo = semindent[5:ig].strip()
                if regex.fullmatch("[A-Za-z_][A-Za-z0-9_]*", campo) != Null {
                    poe(campo, "campo de " + nome)
                }
            }
        }
    }
    return achados
}


# ── argumento nomeado ───────────────────────────────────────────────────────

# Se o cursor está DENTRO da lista de argumentos de uma chamada, devolve os
# parâmetros da função chamada. Senão, lista vazia.
# `prefixo` é o texto da linha até o cursor.
action params_da_chamada(prefixo, vars) {
    # acha o `(` aberto mais próximo, ignorando os já fechados
    i = len(prefixo)
    profundidade = 0
    abre = -1
    while i > 0 {
        c = prefixo[i - 1]
        if c == ")" {
            profundidade = profundidade + 1
        }
        elif c == "(" {
            if profundidade == 0 {
                abre = i - 1
                break
            }
            profundidade = profundidade - 1
        }
        i = i - 1
    }
    if abre < 0 {
        return []
    }

    # o nome chamado é o que vem imediatamente antes do `(`
    j = abre
    while j > 0 {
        c = prefixo[j - 1]
        if not (c.isalnum() or c == "_" or c == ".") {
            break
        }
        j = j - 1
    }
    chamado = prefixo[j:abre]
    if chamado == "" {
        return []
    }

    m = Null
    if chamado.count(".") > 0 {
        corte = chamado.rfind(".")
        alvo = chamado[0:corte]
        nome = chamado[corte + 1:]
        if eh_modulo(alvo) {
            m = acha(membros_de_modulo(alvo), nome)
        }
        else {
            t = tipo_de_expressao(alvo, vars)
            if t != "" and not t.startswith("<modulo:") {
                m = acha(membros_de_tipo(t), nome)
            }
        }
    }
    if m == Null {
        return []
    }
    ps = m.get("params")
    if ps == Null {
        return []
    }
    return ps
}


# Varre o documento e monta nome -> tipo pras variáveis atribuídas.
# Duas passadas: a segunda resolve `cur = conn.cursor()` depois que `conn` já
# é conhecido.
action tipos_do_documento(texto) {
    vars = {}
    linhas = texto.split("\n")
    for each passada in range(2) {
        for each l in linhas {
            corte = l.find("=")
            if corte < 0 {
                continue
            }
            # `==`, `<=`, `>=`, `!=` e `+=` não são atribuição simples
            if corte + 1 < len(l) and l[corte + 1] == "=" {
                continue
            }
            if corte > 0 and l[corte - 1] in "=<>!+-*/" {
                continue
            }
            alvo = l[0:corte].strip()
            # declaração tipada: `int x = ...`
            partes = alvo.split(" ")
            alvo = partes[len(partes) - 1].strip()
            if regex.fullmatch("[A-Za-z_][A-Za-z0-9_]*", alvo) == Null {
                continue
            }
            dir = l[corte + 1:].strip()
            # tira comentário de fim de linha
            for each marca in ["  #", "  //"] {
                c = dir.find(marca)
                if c >= 0 {
                    dir = dir[0:c].strip()
                }
            }
            t = tipo_de_expressao(dir, vars)
            if t != "" and not t.startswith("<modulo:") {
                vars[alvo] = t
            }
        }
    }
    return vars
}

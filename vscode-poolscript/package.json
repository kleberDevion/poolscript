{
  "name": "poolscript",
  "displayName": "PoolScript",
  "description": "Syntax highlighting, snippets and Dracula theme for PoolScript (.ps).",
  "version": "1.0.0",
  "publisher": "KleberSantanadeOliveira",
  "icon": "images/icon.png",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Programming Languages", "Snippets", "Themes"],
  "keywords": ["poolscript", "ps", "dracula"],
  "contributes": {
    "languages": [
      {
        "id": "poolscript",
        "aliases": ["PoolScript", "poolscript", "ps"],
        "extensions": [".ps", ".psl"],
        "configuration": "./language-configuration/language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "poolscript",
        "scopeName": "source.poolscript",
        "path": "./syntaxes/poolscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "poolscript",
        "path": "./snippets/poolscript.json"
      }
    ],
    "themes": [
      {
        "label": "Dracula (PoolScript)",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula-poolscript-color-theme.json"
      }
    ]
  }
}

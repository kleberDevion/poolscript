{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PoolScript",
  "scopeName": "source.poolscript",
  "fileTypes": ["ps", "psl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.poolscript", "match": "//.*$" },
        { "name": "comment.line.hash.poolscript", "match": "#.*$" },
        { "name": "comment.block.poolscript", "begin": "\"\"\"", "end": "\"\"\"" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fstring.poolscript",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.poolscript", "match": "\\\\." },
            { "name": "meta.embedded.expression.poolscript", "match": "\\{[^}]*\\}" }
          ]
        },
        {
          "name": "string.quoted.double.poolscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.poolscript", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.poolscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.poolscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.poolscript",
          "match": "(@)([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.poolscript" },
            "2": { "name": "entity.name.function.decorator.poolscript" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.poolscript",
          "match": "\\b(if|elif|else|while|for|each|in|is|return|try|catch|as|with|of|using|async|await|count|continue|break)\\b"
        },
        {
          "name": "keyword.operator.logical.poolscript",
          "match": "\\b(and|or|not|Not)\\b"
        },
        {
          "name": "keyword.declaration.poolscript",
          "match": "\\b(action|model|Class|class|type)\\b"
        },
        {
          "name": "keyword.control.import.poolscript",
          "match": "\\b(import|from|PUSH|GET)\\b"
        },
        {
          "name": "keyword.control.entrypoint.poolscript",
          "match": "\\brun_selfwith_\\b"
        },
        {
          "name": "support.function.builtin.poolscript",
          "match": "\\b(post|input|listen|route|create|clear|space|addEnd|char|list|len|range|open|type|getAll)\\b"
        },
        {
          "name": "constant.language.http.poolscript",
          "match": "\\b(POST|PUT|DELETE|JSON|json)\\b"
        },
        {
          "name": "support.class.jinker.poolscript",
          "match": "\\b(Jinker|cors|jsonify|request)\\b"
        },
        {
          "name": "support.class.stdlib.poolscript",
          "match": "\\b(db|hash|jwt|date|mail|os|dotenv)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.poolscript",
          "match": "\\b(str|int|flo|bool)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.poolscript", "match": "\\b(True|true|False|false)\\b" },
        { "name": "constant.language.null.poolscript", "match": "\\b(Null|null|None|none)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.poolscript", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.poolscript", "match": "\\b\\d+\\b" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.call.poolscript",
          "match": "\\b([a-zA-Z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.poolscript" }
          }
        },
        {
          "name": "support.class.poolscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.poolscript", "match": "(\\+=|-=|\\*=|/=|%=|=)" },
        { "name": "keyword.operator.comparison.poolscript", "match": "(===|!==|==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.arithmetic.poolscript", "match": "(\\+\\+|--|\\+|-|\\*|/|%)" },
        { "name": "keyword.operator.logical.symbol.poolscript", "match": "(&&|\\|\\||!)" }
      ]
    }
  }
}

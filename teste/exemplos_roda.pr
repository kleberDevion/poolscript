# Roda os exemplos de `examples/` — porque ninguém os rodava.
#
# POR QUE ESTE ARQUIVO EXISTE: `examples/` tem 16 programas, e nenhum alvo do
# Makefile, nenhum job de CI e nenhum script os executava. Eles são a primeira
# coisa que alguém lê pra aprender a linguagem, e ficavam apodrecendo em
# silêncio: o `make check` inteiro ficava verde com exemplo que nem roda.
#
# Achado por varredura em 29/08, quando a mudança do índice (I4/I5) quebrou
# DOIS de uma vez — e um deles, `lista_index.pr`, existia exatamente pra
# demonstrar o comportamento que a mudança removeu. O cabeçalho dele ainda
# dizia "não trava" enquanto ele travava.
#
# O que este script exige de cada exemplo: rodar até o fim com rc=0. Não confere
# saída — exemplo é feito pra ensinar, não pra ter saída congelada, e prender a
# saída deles seria a fotografia que a suíte já tem demais. O que se cobra é o
# mínimo que não pode faltar: o exemplo da doc funciona.
#
#     ./pool teste/exemplos_roda.pr
import os
import sys
import date

PASTA = "examples"
TEMPO = 20

# Exemplos que BLOQUEIAM de propósito (sobem servidor e esperam conexão, ou
# leem o teclado num laço). Rodar significaria esperar o timeout, e o timeout
# viraria "falha" — então eles são só CONFERIDOS na sintaxe, e isso é dito em
# voz alta no resumo. `cobrinha.pr` fica aqui: é um jogo que só sai com 'q'.
SERVIDOR = ["socket_demo.pr", "cobrinha.pr"]

# Exemplos que precisam de coisa que a máquina pode não ter (rede, credencial).
# Eles rodam; se falharem por ausência do serviço, contam como PULOU, nunca
# como sucesso calado.
PODE_FALTAR = ["mail_demo.pr", "request.pr", "push_get.pr", "swagger.pr"]


# ── processos: sem shell, nos três sistemas ─────────────────────────────────
#
# Cada exemplo roda pelo `os.run([...], capture="live")`: o `Process` que volta
# dá o código de saída (`wait()`), os dois canais da saída e o `kill()` do
# prazo, sem shell no meio e sem arquivo temporário. Era uma linha do `os.cmd`
# (`timeout 20 '<pool>' <ex> > /tmp/... 2>&1 < /dev/null; echo $? > /tmp/...`),
# e isso só existia inteiro no Linux: no macOS o `timeout` do GNU se chama
# `gtimeout` (vem do coreutils do Homebrew), e sem ele TODO exemplo saía 127
# ("command not found"); no Windows o `os.cmd` é o cmd.exe, onde aspas simples
# não são aspas e `;`, `$?` e `/dev/null` não existem, e o "/tmp/..." do motor
# nativo é "<disco>:\tmp\...", na raiz do disco, não o /tmp do MSYS2.

WINDOWS = sys.platform() == "windows"


# Um pedaço do stdout (ou do stderr) do processo; "" quando o canal fechou.
funct le_canal(proc, do_erro) {
    if do_erro {
        return proc.read_err()
    }
    return proc.read()
}


# Lê um canal até o fim, numa TAREFA. Os dois canais andam JUNTOS: cano que
# ninguém lê enche, e o filho trava na escrita. Lendo o stdout até o fim antes
# do stderr, um exemplo que enchesse o stderr ficava esperando o teste, e o
# teste esperando o exemplo.
async funct drena(proc, do_erro) {
    texto = ""
    parte = le_canal(proc, do_erro)
    while parte != "" {
        texto = texto + parte
        parte = le_canal(proc, do_erro)
    }
    return texto
}


# O `timeout` de antes, agora dentro do teste: passou de `prazo` segundos, vai
# o SIGTERM; se em 6 s o exemplo não saiu, o SIGKILL (o `timeout` sem `-k`
# esperava pra sempre por quem ignorasse o TERM). No Windows não há sinal: lá
# o `kill()` encerra o processo na hora. Termina sozinha quando
# `estado["acabou"]` vira verdadeiro, e liga `estado["estourou"]` quando o
# prazo venceu.
async funct vigia(proc, prazo, estado) {
    fim = date.monotonic() + prazo
    while not estado["acabou"] and date.monotonic() < fim {
        sleep(0.1)
    }
    if estado["acabou"] {
        return
    }
    estado["estourou"] = true
    proc.kill()
    fim = date.monotonic() + 6
    while not estado["acabou"] and date.monotonic() < fim {
        sleep(0.1)
    }
    if not estado["acabou"] {
        proc.kill(9)
    }
}


# Roda `args` e devolve [código, saída]. A entrada fecha na hora: é o
# `< /dev/null` de antes (exemplo que lesse o teclado veria fim de arquivo, não
# um terminal esperando). A `vigia` e as duas `drena` andam enquanto o `wait()`
# espera: a espera do principal é o ponto em que as tarefas rodam. O `using`
# fecha os canos no fim do bloco; sem ele, cada exemplo deixava os dois abertos
# até o coletor passar.
#
# A saída é o stdout seguido do stderr. Era um arquivo só (`2>&1`); agora são
# dois canos, e a ordem ENTRE uma linha de um e uma do outro não é mais a da
# escrita. A classificação lá embaixo procura o nome do erro no texto inteiro,
# e isso não depende da ordem.
#
# O código é o que o `$?` depois do `timeout` contava: 124 quando o prazo
# venceu (mesmo que o exemplo, ao morrer, saísse com outro código), e 128 +
# sinal quando ele morreu de sinal (o `wait()` dá `-sinal`). O aviso do sinal
# era o shell que escrevia ("Killed", "Segmentation fault"); sem shell, ele
# vai no fim da saída. O Windows não tem sinal: lá o código é o que o sistema
# deu.
funct executa(args) {
    rc = 0
    textos = []
    estado = {"acabou": false, "estourou": false}
    using os.run(args, capture="live") as proc {
        proc.close()
        canais = [drena(proc, false), drena(proc, true)]
        guarda = vigia(proc, TEMPO, estado)
        rc = proc.wait()
        estado["acabou"] = true
        await guarda
        textos = await canais
    }
    saida = textos[0]
    if saida != "" and not saida.endswith("\n") {
        saida = saida + "\n"
    }
    saida = saida + textos[1]
    if estado["estourou"] {
        rc = 124
        saida = saida + "\npassou de " + str(TEMPO) + " s: encerrado pelo exemplos_roda"
    }
    elif rc < 0 and not WINDOWS {
        saida = saida + "\nmorreu do sinal " + str(-rc)
        rc = 128 - rc
    }
    return [rc, saida]
}


funct roda(caminho) {
    return executa([sys.executable, caminho])
}


funct confere_sintaxe(caminho) {
    return executa([sys.executable, "--check", caminho])
}


if __name__ == "main" {
    if not os.isdir(PASTA) {
        post("nao achei", PASTA + "/")
        sys.exit(1)
    }

    okey = []
    falhou = []
    pulou = []
    so_sintaxe = []
    # `examples/swagger.pr` gera a doc em `path/docs` a partir da pasta onde
    # roda (a raiz do repo). O que a rodada criou, a rodada apaga: a sobra
    # entrava no próximo commit.
    tinha_path = os.isdir("path")

    nomes = []
    for each e in os.ls(PASTA) {
        if e["name"].endswith(".pr") {
            addEnd(nomes, e["name"])
        }
    }
    nomes.sort()

    for each n in nomes {
        caminho = PASTA + "/" + n

        if SERVIDOR.contains(n) {
            r = confere_sintaxe(caminho)
            if r[0] != 0 {
                post("  SINTAXE  " + n)
                post("      " + r[1].strip())
                addEnd(falhou, n)
            }
            else {
                addEnd(so_sintaxe, n)
            }
            continue
        }

        r = roda(caminho)
        if r[0] == 0 {
            addEnd(okey, n)
            continue
        }
        # Serviço ausente é PULOU, e só pra quem depende dele. Erro de
        # linguagem (Syntax/Type/Index/Name) é FALHA em qualquer exemplo.
        # A lista tem que ser dos tipos que o motor levanta HOJE. Ela citava
        # "RuntimeError: variável não definida", que virou NameError — e a
        # cláusula morta transformava erro de linguagem em "faltou serviço"
        # nos 4 exemplos de PODE_FALTAR: rc 0, verde, com o exemplo quebrado.
        # NameError, AttributeError, KeyError e ZeroDivisionError não estavam
        # aqui em forma nenhuma.
        so_servico = PODE_FALTAR.contains(n)
        parece_lingua = ("SyntaxError" in r[1] or "TypeError" in r[1]
                         or "IndexError" in r[1] or "ValueError" in r[1]
                         or "NameError" in r[1] or "AttributeError" in r[1]
                         or "KeyError" in r[1] or "ZeroDivisionError" in r[1]
                         or "OverflowError" in r[1])
        if so_servico and not parece_lingua {
            addEnd(pulou, n)
            continue
        }
        post("  FALHOU   " + n + "  (rc " + str(r[0]) + ")")
        for each l in r[1].strip().split("\n") {
            post("      " + l)
        }
        addEnd(falhou, n)
    }

    if not tinha_path and os.isdir("path") {
        os.rmdir("path", force=true)
    }
    post("")
    post("exemplos:", str(len(nomes)), " rodaram:", str(len(okey)),
         " so sintaxe:", str(len(so_sintaxe)), " pularam:", str(len(pulou)))
    if len(so_sintaxe) > 0 {
        post("   (servidor, nao executados:", (", ").join(so_sintaxe) + ")")
    }
    if len(pulou) > 0 {
        post("   (PULARAM por falta de servico:", (", ").join(pulou) + ")")
    }
    if len(falhou) > 0 {
        post("")
        post("FALHARAM:", str(len(falhou)))
        for each f in falhou {
            post("   " + f)
        }
        sys.exit(1)
    }
    post("todos os exemplos rodam.")
    sys.exit(0)
}

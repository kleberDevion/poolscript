# Confere o `pool --metadata` contra o MOTOR — chamando de verdade.
#
# O metadata é o que o editor consome no autocomplete. Se ele diz que
# `append` não tem parâmetro e o motor exige um, o autocomplete mente. Este
# script não confia em doc nem em tabela: pra cada método de tipo ele CHAMA
# sem argumento num `pool` de verdade e compara o que o motor responde com o
# que o metadata prometeu.
#
#   ./pool teste/confere_metadata.ps
#
# Foi escrito depois de eu publicar `b.hex(b)` no metadata confundindo a LIB
# `bytes` (bytes.hex(b), recebe argumento) com o TIPO `bytes` (b.hex(), não
# recebe). Nome igual, coisa diferente — e nenhuma tabela pegava isso.

import os
import json
import sys

# Cada bloco de checagem soma aqui; no fim, qualquer falha = rc 1. Sem isso o
# script imprimia "FALHA" e saía 0 — portão que não reprova não é portão.
falhas = 0

# Acha o binário do REPOSITÓRIO onde quer que o script rode (raiz, teste/).
# O `pool` do PATH pode ser um build antigo — conferir metadata contra ele
# mediria a versão errada.
POOL = "./pool"
if not os.exists(POOL) {
    POOL = "../pool"
}
if not os.exists(POOL) {
    POOL = "pool"
}

# valor de amostra por tipo: só os que dá pra construir numa expressão
amostras = {
    "str": "\"abc\"",
    "list": "[1, 2]",
    "dict": "{\"a\": 1}",
    "tup": "(1, 2)",
    "bytes": "\"oi\".encode()"
}

bruto = os.run([POOL, "--metadata"], true)
meta = bruto.get_json()
if meta == Null {
    post(f"FALHA — o binario nao devolveu o metadata em JSON. Resposta:\n {bruto}")
    raise MetadataIlegivel("pool --metadata ilegivel — binario antigo no PATH?")
}
tipos = meta["tipos"]

divergencias = []
conferidos = 0

for each tipo in tipos.keys() {
    if not amostras.contains(tipo) {
        continue
    }
    alvo = amostras[tipo]
    for each m in tipos[tipo] {
        metodo = m["nome"]
        obrigatorios = 0
        for each p in m["params"] {
            if p["default"] == Null {
                obrigatorios = obrigatorios + 1
            }
        }
        conferidos = conferidos + 1

        # chama SEM argumento; o motor diz quantos esperava
        #
        # O predicado NAO pode casar palavra solta. Ele casava "espera" e
        # "argumento", e as mensagens de erro viraram as do CPython — as duas
        # palavras sumiram de uma vez, os 89 metodos deixaram de casar, e o
        # portao passou a cuspir 42 divergencias falsas. O ramo de baixo
        # (`not exigiu and obrigatorios > 0`) e o espelho disso: com o
        # predicado sempre falso ele acusa todo mundo.
        #
        # Agora o que se procura e o que a mensagem de aridade SEMPRE tem, nas
        # duas grafias: um tipo de erro, e a palavra argumento em pt ou en.
        fonte = "post(" + alvo + "." + metodo + "())"
        saida = os.run([POOL, "-e", fonte], true)
        exigiu = (saida.contains("Error")
                  and (saida.contains("argument") or saida.contains("argumento")))

        if exigiu and obrigatorios == 0 {
            divergencias.append(tipo + "." + metodo
                + " -> metadata diz SEM parametro, motor exige: "
                + saida.split("\n")[0])
        }
        if not exigiu and obrigatorios > 0 {
            divergencias.append(tipo + "." + metodo
                + " -> metadata exige " + str(obrigatorios)
                + " parametro(s), motor aceita sem nenhum")
        }
    }
}

post("metodos conferidos:", conferidos)
if len(divergencias) == 0 {
    post("OK — metadata bate com o motor")
}
else {
    post("FALHA —", len(divergencias), "divergencia(s):")
    for each d in divergencias {
        post("  ", d)
    }
    falhas = falhas + 1
}

# ── metadata que declara TIPO DE RETORNO inexistente ────────────────────────
# `retorna: "Button"` sem `Button` em `tipos` faz o editor resolver a cadeia
# pro nada: `app.button().` não oferecia membro nenhum.
# escalares e formas genéricas não são "tipos" com métodos — não se cobra
# que estejam na tabela.
escalares = ["str", "int", "flo", "bool", "list", "dict", "tup", "bytes",
             "Null", "action", "type", "future", "module", "Entity",
             "list[str]", "list[dict]", "list[int]"]
tipos_conhecidos = tipos.keys() + escalares
retornos_orfaos = []
for each t in tipos.keys() {
    for each m in tipos[t] {
        r = m["retorna"]
        if r != Null and not tipos_conhecidos.contains(r) {
            retornos_orfaos.append(t + "." + m["nome"] + " -> " + r)
        }
    }
}
for each mod in meta["modulos"].keys() {
    for each m in meta["modulos"][mod] {
        r = m["retorna"]
        if r != Null and not tipos_conhecidos.contains(r) {
            retornos_orfaos.append(mod + "." + m["nome"] + " -> " + r)
        }
    }
}

if len(retornos_orfaos) == 0 {
    post("OK — todo tipo de retorno declarado existe em `tipos`")
}
else {
    post("FALHA —", len(retornos_orfaos), "retorno(s) apontando pra tipo inexistente:")
    for each r in retornos_orfaos {
        post("  ", r)
    }
    falhas = falhas + 1
}

# ── campo declarado que o motor NÃO serve ───────────────────────────────────
# Cada entrada da tabela CAMPOS é uma promessa ao editor. Aqui o campo é
# ACESSADO de verdade nos tipos que dá pra construir sem I/O — fantasma
# (declarado e inexistente) derruba a checagem. Sete já viveram lá.
import mail
import regex
import jinker
import qrcode
import manpu

# PNG de verdade pra construir o PoolFile — o motor só o cria a partir de
# arquivo com extensão binária.
PNG = "/tmp/ps_cm_amostra.png"
qrcode.make("x").save(PNG)

# a EXPRESSÃO que constrói cada amostra — o campo é acessado num `pool`
# separado, então precisa do fonte, não do objeto.
amostras_fonte = {}
amostras_fonte["MailMessage"] = "mail.MailMessage()"
amostras_fonte["MailServer"] = "mail.MailServer()"
amostras_fonte["MailReader"] = "mail.MailReader()"
amostras_fonte["Pattern"] = "regex.compile(\"a\")"
amostras_fonte["Jinker"] = "jinker.Jinker(name=\"conf\")"
amostras_fonte["JinkerResponse"] = "jinker.JinkerResponse()"
amostras_fonte["QRImage"] = "qrcode.make(\"x\")"
amostras_fonte["ManpuFile"] = "manpu.open(target=\"/tmp/ps_cm.txt\")"
amostras_fonte["PoolQRCode"] = "qrcode.QRCode()"
# PoolFile só nasce de arquivo com extensão binária (`ext_binaria` no motor),
# e o próprio qrcode da linguagem gera um PNG de verdade — sem isso as 3
# propriedades dele nunca foram conferidas.
amostras_fonte["PoolFile"] = ("os.loadFile(\"" + PNG + "\", \"rb\")")

amostras_campo = {}
amostras_campo["MailMessage"] = mail.MailMessage()
amostras_campo["MailServer"] = mail.MailServer()
amostras_campo["MailReader"] = mail.MailReader()
amostras_campo["Pattern"] = regex.compile("a")
amostras_campo["Jinker"] = jinker.Jinker(name="conf")
amostras_campo["JinkerResponse"] = jinker.JinkerResponse()
amostras_campo["QRImage"] = qrcode.make("x")
amostras_campo["ManpuFile"] = manpu.open(target="/tmp/ps_cm.txt")
amostras_campo["PoolQRCode"] = qrcode.QRCode()
amostras_campo["PoolFile"] = os.loadFile(PNG, "rb")

# Tipo que NÃO dá pra construir aqui, e o porquê. Ele existe pra que o
# `continue` de baixo deixe de ser silencioso: sem esta lista, tipo novo com
# propriedade some da checagem sem ninguém saber. Foi o que aconteceu — oito
# tipos e vinte e uma propriedades nunca foram conferidos, e o script imprimia
# "OK — todo campo declarado existe no motor".
SEM_AMOSTRA = {}
SEM_AMOSTRA["Response"] = "só nasce de uma chamada HTTP concluída"
SEM_AMOSTRA["PoolCursor"] = "precisa de conexão de banco viva"
SEM_AMOSTRA["DbCursor"] = "precisa de conexão de banco viva"
SEM_AMOSTRA["RequestProxy"] = "só existe dentro de um handler do jinker atendendo"
SEM_AMOSTRA["PoolFileUpload"] = "só existe dentro de um handler recebendo multipart"
SEM_AMOSTRA["ChannelManager"] = "só existe com o servidor do jinker de pé"
# `guzer.UI(...)` marca a janela pra ABRIR SOZINHA no fim do script (auto-show,
# `guz_mostra` lê `vm->guz_app`). Construir uma aqui faz este processo parar no
# exit esperando alguém fechar a janela — o portão trava, não falha.
SEM_AMOSTRA["UI"] = "construir uma UI faz o script abrir janela no fim (auto-show) e travar"

nao_conferidos = []
fantasmas = []
campos_conferidos = 0
for each tipo in tipos.keys() {
    if not amostras_campo.has(tipo) {
        # tem propriedade e ninguém declarou o motivo de não conferir? falha.
        props = 0
        for each mm in tipos[tipo] {
            if mm.has("kind") and mm["kind"] == "property" {
                props = props + 1
            }
        }
        if props > 0 and not SEM_AMOSTRA.has(tipo) {
            addEnd(nao_conferidos, tipo + " (" + str(props)
                   + " propriedade(s)) -> sem amostra e sem motivo declarado"
                   + " em SEM_AMOSTRA")
        }
        continue
    }
    alvo = amostras_campo[tipo]
    for each m in tipos[tipo] {
        # método comum não traz a chave "kind"; só propriedade traz
        if not m.has("kind") {
            continue
        }
        if m["kind"] != "property" {
            continue
        }
        campos_conferidos = campos_conferidos + 1
        fonte = "import mail\nimport regex\nimport jinker\nimport qrcode\n"
        fonte = fonte + "_v = " + amostras_fonte[tipo] + "\npost(_v." + m["nome"] + ")"
        saida = os.run([POOL, "-e", fonte], true)
        # O motor diz "'T' object has no attribute 'x'" (AttributeError) — a
        # frase antiga era "membro inexistente". Enquanto casou a antiga, esta
        # checagem ficou VERDE PARA SEMPRE: campo fantasma declarado no
        # metadata nunca mais foi pego, e o script imprimia "OK — todo campo
        # declarado existe no motor" com fantasma dentro.
        if saida.contains("has no attribute") {
            fantasmas.append(tipo + "." + m["nome"] + " -> declarado, mas o motor nao tem")
        }
    }
}

post("campos conferidos:", campos_conferidos)
for each t in SEM_AMOSTRA.keys() {
    post("   (nao conferido:", t, "—", SEM_AMOSTRA[t] + ")")
}
if len(fantasmas) == 0 {
    post("OK — todo campo declarado existe no motor")
}
else {
    post("FALHA —", len(fantasmas), "campo(s) fantasma:")
    for each f in fantasmas {
        post("  ", f)
    }
    falhas = falhas + 1
}

# Pular não pode ser sucesso: tipo novo com propriedade, sem amostra e sem
# motivo declarado, reprova. Ou alguém escreve a amostra, ou escreve por que
# não dá — as duas resolvem, ficar calado não.
if len(nao_conferidos) > 0 {
    post("FALHA —", len(nao_conferidos), "tipo(s) com propriedade fora da checagem:")
    for each t in nao_conferidos {
        post("  ", t)
    }
    falhas = falhas + 1
}

if falhas > 0 {
    sys.exit(1)
}

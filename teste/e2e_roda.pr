# Roda os testes de ponta a ponta, respeitando o PAPEL de cada script.
#
# POR QUE ISTO EXISTE: o alvo antigo era um `for s in teste/e2e/*.pr`, e o
# shell ordena alfabeticamente — `jinker_cli.pr` rodava ANTES de
# `jinker_srv.pr`. O cliente subia sem servidor e morria com "Connection
# refused"; depois o servidor ficava servindo até o `timeout` matá-lo, e o
# alvo inteiro reprovava. A orquestração certa existia só no LEIAME, em prosa,
# fora de qualquer coisa que roda.
#
# Papel não se adivinha por nome de arquivo, então está declarado aqui:
#
#   PARES      servidor + cliente. Sobe o servidor como processo filho, ESPERA
#              a porta aceitar conexão (não `sleep` no escuro), roda o cliente,
#              e mata o servidor aconteça o que acontecer.
#   SOZINHOS   fluxo único, roda direto.
#   SEM_PAR    servidor que não tem cliente: bloquearia até o timeout. É
#              RELATADO, não rodado — e relatado em voz alta, porque pular
#              calado é o mesmo que não ter o teste.
#
# Script que não acha o serviço externo imprime PULOU e sai 0; isso é
# resultado, não falha, e aparece no resumo.
#
#     ./pool teste/e2e_roda.pr               # tudo
#     ./pool teste/e2e_roda.pr jinker        # só o que casa com o filtro
#
# Nada aqui passa por shell nem por arquivo em /tmp, pra valer igual no Linux,
# no macOS e no Windows: os processos são `Process` (ver `sobe`), e a espera
# da porta é o socket do próprio motor (ver `espera_porta`).
import os
import sys
import date
import sockets

PASTA = "teste/e2e"
TEMPO = 120        # segundos por script

# [servidor, [clientes...], porta que o servidor abre]
# Vários clientes contra o MESMO servidor: subir e derrubar o jinker uma vez
# por cliente seria desperdício, e o estado que um deixa (upload gravado, canal
# aberto) é justamente o que o próximo pode precisar.
PARES = [
    ["jinker_srv.pr", ["jinker_cli.pr", "jinker_bruto.pr"], 28840]
]

# Servidor sem cliente: rodar seria travar até o timeout.
SEM_PAR = {
    "ws.pr": "servidor de WebSocket sem cliente — bloqueia pra sempre; o par coberto e jinker_srv+jinker_cli"
}


# Espera a porta ACEITAR conexão. Devolve 1 se abriu, 0 se estourou o prazo.
# Melhor que `sleep 2`: numa máquina carregada 2s não bastam, e numa rápida
# são 2s jogados fora por execução.
#
# A tentativa é o socket do PRÓPRIO motor. Antes era `timeout 1 bash -c
# '</dev/tcp/...'` pelo `os.cmd`, que só existe inteiro no Linux: no macOS o
# `timeout` do GNU se chama `gtimeout` (vem do coreutils do Homebrew), e no
# Windows o `os.cmd` roda no cmd.exe, que não tem `/dev/tcp`, aspas simples
# nem `$?`. Sem o `timeout`, a tentativa falhava SEMPRE, e o par reprovava
# dizendo que a porta não abriu.
#
# O `connect_ex` não levanta: devolve 0 (conectou) ou o código do erro, e é
# esse número que se confere. A versão com `os.cmd` já tinha errado nisso: ela
# testava o que o `os.cmd` devolve — a SAÍDA, nunca o código de saída — e com
# `Null == 0` valendo True a função voltava 1 na PRIMEIRA volta, sempre. A
# "espera de 20 s" era decorativa; quando `Null == 0` virou False (I1/I2/I3),
# ela passou a nunca dar certo.
#
# O prazo é de RELÓGIO, não de contagem de voltas: cada tentativa pode levar
# até 1 s (o `settimeout`), e contar voltas deixava o prazo real depender de
# quanto o sistema demora pra recusar a conexão.
funct espera_porta(porta, prazo) {
    fim = date.monotonic() + prazo
    while date.monotonic() < fim {
        sk = sockets.socket()
        sk.settimeout(1)
        rc = sk.connect_ex(("127.0.0.1", porta))
        sk.close()
        if rc == 0 {
            return 1
        }
        sleep(0.1)
    }
    return 0
}


# ── processos: sem shell, nos três sistemas ─────────────────────────────────
#
# Servidor e scripts rodam pelo `os.run([...], capture="live")`: o `Process`
# que volta É o processo do pool — o pid exato, `kill()`, e `wait()` com o
# código de saída —, sem shell no meio e sem arquivo temporário. A versão
# anterior montava tudo em sh (`sh -c 'exec ...' &`, `$!` e `$?` gravados em
# /tmp, `kill`, `timeout`), e isso só existe inteiro no Linux: no macOS falta
# o `timeout`; no Windows o `os.cmd` é o cmd.exe (sem `exec`, `&`, `$!`, `$?`
# nem `/dev/null`), não há `kill`, e o "/tmp" do motor nativo é a raiz do
# disco, não o /tmp do MSYS2.


# Um pedaço do stdout (ou do stderr) do processo; "" quando o canal fechou.
funct le_canal(proc, do_erro) {
    if do_erro {
        return proc.read_err()
    }
    return proc.read()
}


# Lê um canal até o fim, numa TAREFA.
#
# Os dois canais do filho têm que andar JUNTOS: cano que ninguém lê enche, e o
# filho trava na escrita. Ler o stdout até o fim e só depois o stderr pendura
# quando o stderr enche primeiro — o filho espera o driver, o driver espera o
# filho. Como tarefa, cada leitura cede: as duas (e a `vigia`) andam enquanto
# o principal espera.
async funct drena(proc, do_erro) {
    texto = ""
    parte = le_canal(proc, do_erro)
    while parte != "" {
        texto = texto + parte
        parte = le_canal(proc, do_erro)
    }
    return texto
}


# Mata `proc` se ele passar de `prazo` segundos — o `timeout` de antes, agora
# dentro do driver. Primeiro o SIGTERM (ver `derruba`: é o que deixa o jinker
# sair limpo); se em 6 s ele não saiu, SIGKILL. Termina sozinha quando
# `estado["acabou"]` vira verdadeiro, e liga `estado["estourou"]` quando o
# prazo venceu.
async funct vigia(proc, prazo, estado) {
    fim = date.monotonic() + prazo
    while not estado["acabou"] and date.monotonic() < fim {
        sleep(0.1)
    }
    if estado["acabou"] {
        return
    }
    estado["estourou"] = true
    proc.kill()
    fim = date.monotonic() + 6
    while not estado["acabou"] and date.monotonic() < fim {
        sleep(0.1)
    }
    if not estado["acabou"] {
        proc.kill(9)
    }
}


# Espera `proc` terminar e devolve [código, estourou]. A `vigia` corre durante
# o `wait()`: a espera do principal é o ponto em que as tarefas andam.
funct espera_sair(proc, prazo) {
    estado = {"acabou": false, "estourou": false}
    guarda = vigia(proc, prazo, estado)
    rc = proc.wait()
    estado["acabou"] = true
    await guarda
    return [rc, estado["estourou"]]
}


# Sobe o servidor e devolve [processo, canais]: `canais` são as duas `drena`
# lendo o que ele escreve enquanto serve — o log, que o `derruba` devolve.
#
# O que se guarda é o processo do POOL, e isso já custou caro duas vezes: com
# `sh -c` sem `exec`, o pid guardado era o de um shell que saía logo em
# seguida; com `setsid` (que forka e o pai sai), era o de quem já tinha
# morrido — o sinal não chegava em ninguém e o servidor ficava órfão. O
# `setsid` estava ali pra proteger de `pkill -f`, que matava o próprio script;
# matando pelo processo exato o problema não existe.
#
# A entrada fecha na hora: é o `< /dev/null` de antes. O servidor não lê
# nada, e se lesse veria fim de arquivo em vez de esperar um teclado.
funct sobe(srv) {
    proc = os.run([sys.executable, PASTA + "/" + srv], capture="live")
    proc.close()
    return [proc, [drena(proc, false), drena(proc, true)]]
}


# Derruba o servidor pelo PROCESSO, SEM shell e SEM padrão, e devolve o que ele
# escreveu enquanto rodou.
#
# POR QUE NÃO `pkill -f <nome>`: o padrão casa a LINHA DE COMANDO, e a linha de
# comando de quem está rodando o `pkill` também contém o nome — o script se
# matava junto (aconteceu duas vezes aqui). E casar por padrão pega qualquer
# processo alheio que tenha o nome no argv.
#
# POR QUE SIGTERM primeiro, e por que ESPERAR: o jinker tem desligamento
# gracioso (SIGTERM -> `g_jk_parar` -> o laço sai e o processo RETORNA). Matar
# com SIGKILL pula a saída limpa, e processo morto por sinal **não grava o
# `.gcda`** — foi por isso que 24 casos novos de HTTP cru não mexeram um ponto
# na cobertura de `ps_jinker.c`. O KILL fica só como último recurso: é a
# `vigia` com prazo 0 — SIGTERM agora, SIGKILL se em 6 s ele não saiu.
#
# No Windows não existe sinal: lá o `kill()` do `Process` encerra o processo na
# hora, sem a saída graciosa (e sem `.gcda`). O servidor morre do mesmo jeito,
# que é o que o teste precisa.
funct derruba(servidor) {
    espera_sair(servidor[0], 0)
    textos = await servidor[1]
    return textos[0] + "\n" + textos[1]
}


# Roda um script e devolve [rc, saida_junta, estourou].
#
# Havia aqui uma lista `COM_JANELA` e um `GUZER_HEADLESS=1` no ambiente: o
# guzer abria janela no fim do script e travava esperando o usuário fechar. O
# guzer saiu da linguagem; nenhum script do e2e abre janela.
#
# `saida_junta` é o stdout seguido do stderr. Eram um arquivo só
# (`> arq 2>&1`); agora são dois canos, e a ordem ENTRE uma linha de um e uma
# do outro não é mais a da escrita. O resumo não depende dela: o PULOU sai no
# stdout, e o texto inteiro é conferido.
#
# `estourou` é o que o código 124 do `timeout` dizia: passou de TEMPO e foi
# encerrado. Conta como FALHA mesmo com código 0 — um script que trata o
# SIGTERM e sai limpo (o jinker faz isso) passaria como se tivesse terminado.
funct roda(caminho) {
    proc = os.run([sys.executable, caminho], capture="live")
    proc.close()
    canais = [drena(proc, false), drena(proc, true)]
    fim = espera_sair(proc, TEMPO)
    textos = await canais
    saida = textos[0] + "\n" + textos[1]
    if fim[1] {
        saida = saida + "\npassou de " + str(TEMPO) + " s: encerrado pelo e2e_roda"
    }
    return [fim[0], saida, fim[1]]
}


funct mostra(saida) {
    for each l in saida.split("\n") {
        if l.strip() != "" {
            post("     ", l)
        }
    }
}


if __name__ == "main" {
    filtro = ""
    if len(sys.argv) > 1 {
        filtro = sys.argv[1]
    }

    # Nomes que já têm papel declarado não entram na lista de "sozinhos".
    com_papel = {}
    for each p in PARES {
        com_papel[p[0]] = 1
        for each cl in p[1] {
            com_papel[cl] = 1
        }
    }
    for each k in SEM_PAR.keys() {
        com_papel[k] = 1
    }

    falhou = []
    pulou = []
    okey = []
    naorodou = []

    # ── 1) os pares ─────────────────────────────────────────────────────────
    for each p in PARES {
        srv = p[0]
        clientes = p[1]
        porta = p[2]
        casa = filtro == "" or filtro in srv
        for each cl in clientes {
            if filtro in cl {
                casa = true
            }
        }
        if not casa {
            continue
        }
        post("── " + srv + " + " + (", ").join(clientes))

        servidor = sobe(srv)

        # O servidor morre no `finally`, sempre — com a porta que não abriu,
        # com cliente falhando, e mesmo se o driver estourar no meio. Deixar
        # servidor vivo faz a próxima execução falhar por porta ocupada, que é
        # a mesma família de não-hermético do E1. E morre com SIGTERM,
        # esperando ele sair sozinho: ver o comentário de `derruba`.
        abriu = 0
        resultados = []
        log_srv = ""
        try {
            abriu = espera_porta(porta, 20)
            if abriu == 1 {
                for each cl in clientes {
                    resultados.append([cl, roda(PASTA + "/" + cl)])
                }
            }
        }
        finally {
            # o log só está inteiro depois que ele morre
            log_srv = derruba(servidor)
        }

        if abriu == 0 {
            post("      servidor nao abriu a porta", str(porta), "em 20s")
            mostra(log_srv)
            falhou.append(srv)
            continue
        }

        for each par in resultados {
            cl = par[0]
            r = par[1]
            post("   · " + cl)
            mostra(r[1])
            if r[0] != 0 or r[2] {
                falhou.append(cl + " (rc " + str(r[0]) + ")")
            }
            elif "PULOU" in r[1] {
                pulou.append(cl)
            }
            else {
                okey.append(srv + "+" + cl)
            }
        }
    }

    # ── 2) os que rodam sozinhos ────────────────────────────────────────────
    nomes = []
    for each e in os.ls(PASTA) {
        n = e["name"]
        if n.endswith(".pr") and not n in com_papel {
            nomes.append(n)
        }
    }
    nomes.sort()

    for each n in nomes {
        if filtro != "" and not filtro in n {
            continue
        }
        post("── " + n)
        r = roda(PASTA + "/" + n)
        mostra(r[1])
        if r[0] != 0 or r[2] {
            falhou.append(n + " (rc " + str(r[0]) + ")")
        }
        elif "PULOU" in r[1] {
            pulou.append(n)
        }
        else {
            okey.append(n)
        }
    }

    # ── 3) os que não dá pra rodar sem alguém do outro lado ─────────────────
    for each n in SEM_PAR.keys() {
        if filtro != "" and not filtro in n {
            continue
        }
        naorodou.append(n + " — " + SEM_PAR[n])
    }

    post("")
    post("passaram:", len(okey))
    for each x in okey {
        post("   ", x)
    }
    if len(pulou) > 0 {
        post("PULARAM (servico externo fora do ar):", len(pulou))
        for each x in pulou {
            post("   ", x)
        }
    }
    if len(naorodou) > 0 {
        post("NAO RODADOS (sem par):", len(naorodou))
        for each x in naorodou {
            post("   ", x)
        }
    }
    if len(falhou) > 0 {
        post("FALHARAM:", len(falhou))
        for each x in falhou {
            post("   ", x)
        }
        sys.exit(1)
    }
    post("")
    post("e2e: ok")
}

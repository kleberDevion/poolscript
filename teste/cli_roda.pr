confere("--check aprova o import opcional (try que pega ImportError)", "{\"ok\":true}" in r["saida"])
r = roda([POOL, "--check"], entrada="try {\n    import naoexiste9\n} catch (ValueError e) {\n    post(\"sem\")\n}\n")
confere("--check acusa o import ausente quando o catch nao pega ImportError", "No module named" in r["saida"])
# rodando, o cursor do import ausente cai no NOME do módulo, como no --check

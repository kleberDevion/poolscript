r = roda([POOL, "-c", "ordem.pr"])
confere("opcao desconhecida sem parecida manda pro --help, rc 64",
        r["rc"] == 64 and "opcao desconhecida '-c' (as opcoes estao em jinga --help)" in r["saida"])

# Plano 6, lote 9: o quadro do erro, o --check e os comandos de editor.
# O quadro conta a linha pelo `\n` (a linha de 5000 bytes vinha em dois

confere("--tokens --utf16 converte a coluna dos erros", "\"erros\":[{\"msg\":" in r["saida"] and "\"coluna\":22" in r["saida"])
r = roda([POOL, "--ast", "--utf16"], entrada="str s = \"\U0001F600\U0001F600\"; int a\u00e7 = 1\n")

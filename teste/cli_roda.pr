# A LINHA DE COMANDO e o gerenciador de pacotes — `pool` e `psl`.
#
# POR QUE ESTE ARQUIVO EXISTE: `vm/main.c` estava em 19,7% de ramo e
# `vm/ps_pkg.c` em 0,0% — 26 de 26 funções nunca executadas. Não é código
# morto: é a porta de entrada do usuário (`jinga arquivo.pr`, `jpkg install`) e o
# único lugar do projeto que BAIXA E INSTALA CÓDIGO DE TERCEIRO. A suíte em C
# só sabia rodar `pool <arquivo>`; argumento, variável de ambiente e código de
# saída ficavam fora, e com eles a CLI inteira.
#
# O registry é servido pelo PRÓPRIO jinker em loopback — a linguagem servindo o
# pacote que ela mesma instala. Nada de rede externa, nada de mock.
#
#     ./pool teste/cli_roda.pr
#
# Reprova com rc != 0 e a lista do que falhou.
import os
import sys
import json

PASTA = "/tmp/ps_cli_teste"
HOME  = PASTA + "/home"
PORTA = 28951

falhas = []
ok = 0

funct confere(nome, cond)
{
    global ok
    if cond
    {
        ok = ok + 1
    }
    else
    {
        addEnd(falhas, nome)
    }
}

# Roda um comando e devolve {"saida": <stdout+stderr>, "rc": <int>}. O `os.cmd`
# não devolve código de saída (só a saída), então ele vai pro arquivo — sem
# isso metade dos casos da CLI seria "não deu erro", que não é asserção.
funct roda(cmd)
{
    os.cmd("cd " + PASTA + " && { " + cmd + " ; } > " + PASTA + "/.out 2>&1; echo $? > " + PASTA + "/.rc")
    return {"saida": os.readFile(PASTA + "/.out"), "rc": int(os.readFile(PASTA + "/.rc").strip())}
}

funct com_home(cmd)
{
    return roda("JINGA_HOME=" + HOME + " " + cmd)
}

if os.exists(PASTA)
{
    os.rmdir(PASTA, force=true)
}
os.mkdir(PASTA, exist_ok=true)
os.mkdir(HOME, exist_ok=true)
POOL = sys.executable

# ── superfície da CLI (vm/main.c) ───────────────────────────────────────────
r = roda("'" + POOL + "' --version")
confere("--version imprime a versão", "Jinga" in r["saida"] and r["rc"] == 0)
# A DATA da build distingue dois binários da mesma versão (o instalado e o
# recém-compilado respondiam igual). O prefixo não muda: quem lê a saída — o
# servidor LSP tira a versão dela — continua valendo.
confere("--version traz a data da build entre parênteses",
        "[PSVM] (" in r["saida"] and ")" in r["saida"].split("(")[1]
        and "-" in r["saida"].split("(")[1].split(")")[0])
r = roda("'" + POOL + "' -V")
confere("-V é o mesmo que --version", "Jinga" in r["saida"] and r["rc"] == 0)

# ── os nomes de antes do rename continuam valendo ───────────────────────────
#
# A linguagem se chamava PoolScript: quem instalou antes tem `~/.poolscript`,
# `POOLSCRIPT_HOME` no ambiente e `import poolscript.libs.x` nos programas.
# Nada disso pode quebrar de um dia pro outro. O contrato é: a variável antiga
# ainda é lida (a nova ganha quando as duas existem), a forma antiga do import
# ainda importa, e a pasta antiga vira `~/.jinga` na primeira chamada do `jpkg`
# — com aviso, porque mover pasta calado é o tipo de coisa que some.
os.mkdir(PASTA + "/home_antigo/libs", exist_ok=true)
os.writeFile(PASTA + "/home_antigo/libs/velha.pr", "V = \"da pasta antiga\"\n")
os.writeFile(PASTA + "/usa_velha.pr",
             "import velha\nimport poolscript.libs.velha as p\nimport jinga.libs.velha as j\npost(velha.V, p.V, j.V)\n")
r = roda("POOLSCRIPT_HOME=" + PASTA + "/home_antigo '" + POOL + "' usa_velha.pr")
confere("POOLSCRIPT_HOME ainda e lida, e import poolscript.libs.x e jinga.libs.x acham a mesma lib",
        r["rc"] == 0 and r["saida"].strip() == "da pasta antiga da pasta antiga da pasta antiga")
os.mkdir(PASTA + "/home_novo/libs", exist_ok=true)
os.writeFile(PASTA + "/home_novo/libs/velha.pr", "V = \"da pasta nova\"\n")
r = roda("JINGA_HOME=" + PASTA + "/home_novo POOLSCRIPT_HOME=" + PASTA + "/home_antigo '" + POOL + "' usa_velha.pr")
confere("com as duas variaveis, JINGA_HOME ganha",
        r["rc"] == 0 and r["saida"].strip() == "da pasta nova da pasta nova da pasta nova")
os.mkdir(PASTA + "/casa/.poolscript/libs", exist_ok=true)
os.writeFile(PASTA + "/casa/.poolscript/libs/velha.pr", "V = \"migrada\"\n")
r = roda("HOME=" + PASTA + "/casa '" + POOL + "' list")
confere("jpkg move ~/.poolscript pra ~/.jinga na primeira chamada e avisa",
        r["rc"] == 0 and "virou" in r["saida"] and os.exists(PASTA + "/casa/.jinga/libs/velha.pr")
        and not os.exists(PASTA + "/casa/.poolscript"))
r = roda("HOME=" + PASTA + "/casa '" + POOL + "' usa_velha.pr")
confere("depois de movida, a lib e achada em ~/.jinga",
        r["rc"] == 0 and r["saida"].strip() == "migrada migrada migrada")

r = roda("'" + POOL + "' --help")
confere("--help lista os modos", "jinga arquivo.pr" in r["saida"] and r["rc"] == 0)
r = roda("'" + POOL + "' -h")
confere("-h é o mesmo que --help", "jinga arquivo.pr" in r["saida"])

r = roda("'" + POOL + "' //doc")
confere("//doc aponta a especificação", "http" in r["saida"])

r = roda("'" + POOL + "' -e 'post(2 + 3)'")
confere("-e roda código inline", r["saida"].strip() == "5" and r["rc"] == 0)

r = roda("'" + POOL + "' -e 'post(1/0)'")
confere("-e propaga erro com rc != 0", r["rc"] != 0 and "zero" in r["saida"])

os.writeFile(PASTA + "/bom.pr", "post(\"rodou\")\n")
r = roda("'" + POOL + "' bom.pr")
confere("roda arquivo", r["saida"].strip() == "rodou" and r["rc"] == 0)

os.writeFile(PASTA + "/torto.pr", "x = (1 +\n")
r = roda("'" + POOL + "' torto.pr")
confere("arquivo com sintaxe torta sai != 0", r["rc"] != 0 and "SyntaxError" in r["saida"])

r = roda("'" + POOL + "' nao_existe.pr")
confere("arquivo inexistente sai != 0", r["rc"] != 0)

r = roda("'" + POOL + "' --check bom.pr")
confere("--check aprova fonte válido", "\"ok\":true" in r["saida"])
r = roda("'" + POOL + "' --check torto.pr")
confere("--check reprova fonte torto com linha e coluna",
        "\"ok\":false" in r["saida"] and "\"linha\":" in r["saida"] and "\"coluna\":" in r["saida"])
r = roda("echo 'post(1)' | '" + POOL + "' --check")
confere("--check lê da entrada padrão", "\"ok\":true" in r["saida"])

# Método sem `self`: UM erro, na linha do `funct` (5) — não um NameError no
# `self` do corpo (6) nem um TypeError na chamada (10). O editor sublinha a
# declaração, que é onde está o defeito.
os.writeFile(PASTA + "/sem_self.pr",
             "class C {\n    funct __init__(self) {\n        self.x = 1\n    }\n"
             + "    funct m() {\n        return self.x\n    }\n}\nc = C()\nc.m()\n")
r = roda("'" + POOL + "' --check sem_self.pr")
confere("--check: método sem self dá um erro só, na linha da declaração",
        "\"ok\":false" in r["saida"] and "sem self" in r["saida"]
        and "\"linha\":5" in r["saida"] and "\"linha\":6" not in r["saida"]
        and "\"linha\":10" not in r["saida"]
        and len(r["saida"].split("\"tipo\":")) == 3)

r = roda("echo 'x = 1' | '" + POOL + "' --tokens")
confere("--tokens devolve JSON de tokens", "\"t\":\"IDENT\"" in r["saida"] and "\"l\":1" in r["saida"])

# ── `--contexto`: o que o editor chama a cada tecla ─────────────────────────
#
# É a maior região descoberta do `main.c` (59 ramos) e o caminho mais quente do
# LSP: a cada tecla o editor pergunta "o que o cursor toca aqui". Um só caso
# ("responde algo") deixava os cinco contextos e todos os erros sem teste.
#
# O contrato tem cinco respostas — `topo`, `membro`, `nenhum`, `decorador`,
# `import` — mais o NOME PARCIAL, que só conta quando encosta no cursor.
r = roda("echo 'post(1)' | '" + POOL + "' --contexto 1:1")
confere("--contexto no topo diz `topo`", "\"contexto\":\"topo\"" in r["saida"])

# depois de um ponto, o contexto é MEMBRO e o receptor vem junto — é o que faz
# o editor listar os métodos de `str` e não a linguagem inteira
r = roda("printf 'x = \"ab\"\\nx.' | '" + POOL + "' --contexto 2:3")
confere("--contexto depois do ponto diz `membro`", "\"contexto\":\"membro\"" in r["saida"])
confere("--contexto membro diz de QUEM é o membro", "x" in r["saida"])

# nome PARCIAL: `ge|` conta, `ge |` não. Sem essa distinção o editor completa
# em cima de espaço em branco.
r = roda("printf 'po' | '" + POOL + "' --contexto 1:3")
confere("--contexto pega o nome parcial encostado no cursor", "\"parcial\":\"po\"" in r["saida"])
r = roda("printf 'po ' | '" + POOL + "' --contexto 1:4")
confere("--contexto NÃO pega parcial separado por espaço",
        not "\"parcial\":\"po\"" in r["saida"])

# decorador e import são contextos próprios: o editor oferece listas diferentes
r = roda("printf '@' | '" + POOL + "' --contexto 1:2")
confere("--contexto depois de `@` diz `decorador`", "\"decorador\"" in r["saida"])
r = roda("printf 'import ' | '" + POOL + "' --contexto 1:8")
confere("--contexto depois de `import` diz `import`", "\"import\"" in r["saida"])

# ARGUMENTO TORTO: tem que ser erro com mensagem, não lixo nem crash. É entrada
# não confiável — quem chama é o editor, com o cursor onde o usuário deixou.
r = roda("echo 'post(1)' | '" + POOL + "' --contexto")
confere("--contexto sem posição é erro", "\"erro\"" in r["saida"] and r["rc"] != 0)
r = roda("echo 'post(1)' | '" + POOL + "' --contexto abc")
confere("--contexto com posição não numérica é erro", "\"erro\"" in r["saida"])
r = roda("echo 'post(1)' | '" + POOL + "' --contexto 0:0")
confere("--contexto com linha/coluna zero é erro", "\"erro\"" in r["saida"])
r = roda("echo 'post(1)' | '" + POOL + "' --contexto -1:5")
confere("--contexto com linha negativa é erro", "\"erro\"" in r["saida"])
# posição MUITO além do fim do arquivo: não pode ler fora
r = roda("echo 'post(1)' | '" + POOL + "' --contexto 9999:9999")
confere("--contexto além do fim não quebra", r["rc"] == 0 or "\"contexto\"" in r["saida"])
# entrada vazia
r = roda("printf '' | '" + POOL + "' --contexto 1:1")
confere("--contexto de arquivo vazio não quebra", "\"contexto\"" in r["saida"])

# ── comandos de editor: arquivo no argumento, buffer com caminho, import ────
#
# O editor precisa das duas formas: o ARQUIVO salvo (e aí ele passa o caminho)
# e o BUFFER não salvo (stdin). Antes, `--tokens`/`--ast`/`--contexto`
# ignoravam o argumento calados e liam o stdin — com o terminal herdado, o
# comando TRAVAVA esperando entrada que ninguém ia mandar.
os.mkdir(PASTA + "/proj", exist_ok=true)
os.writeFile(PASTA + "/proj/util.pr", "funct soma(a, b)\n{\n    return a + b\n}\n")
os.writeFile(PASTA + "/proj/main.pr", "import util\npost(util.soma(1, 2))\n")

r = roda("'" + POOL + "' --tokens proj/main.pr < /dev/null")
confere("--tokens lê o arquivo do argumento", "\"v\":\"util\"" in r["saida"])
r = roda("'" + POOL + "' --ast proj/main.pr < /dev/null")
confere("--ast lê o arquivo do argumento", "\"k\":\"ImportStmt\"" in r["saida"])
r = roda("'" + POOL + "' --contexto 2:11 proj/main.pr < /dev/null")
confere("--contexto lê o arquivo do argumento", "\"receptor\":\"util\"" in r["saida"])

# `--path`: o buffer vem do stdin, mas vale como se fosse aquele arquivo — é
# assim que o módulo VIZINHO é achado. Sem isso, o editor não conferia nada
# entre arquivos, e calado.
r = roda("printf 'import util\\nutil.naoexiste()\\n' | '" + POOL + "' --check --path proj/main.pr")
confere("--check --path enxerga o módulo vizinho",
        "\"ok\":false" in r["saida"] and "naoexiste" in r["saida"])
r = roda("printf 'import util\\npost(util.soma(1, 2))\\n' | '" + POOL + "' --check --path proj/main.pr")
confere("--check --path aprova o que está certo", "\"ok\":true" in r["saida"])

# Módulo que não existe: o `--check` dizia `{"ok":true}` e o erro só aparecia
# rodando. Um typo no import passava limpo pelo editor.
r = roda("printf 'import nao_existe_zz\\n' | '" + POOL + "' --check")
confere("--check acusa módulo que não existe",
        "ImportError" in r["saida"] and "No module named" in r["saida"]
        and "nao_existe_zz" in r["saida"])
r = roda("printf 'from nao_existe_zz import coisa\\npost(coisa)\\n' | '" + POOL + "' --check")
confere("--check acusa módulo que não existe no from", "No module named" in r["saida"])
r = roda("printf 'from nao_existe_zz import *\\n' | '" + POOL + "' --check")
confere("--check acusa módulo que não existe no from *", "No module named" in r["saida"])
r = roda("printf 'from nao_existe_zz import a, b, c\\n' | '" + POOL + "' --check")
confere("--check acusa o módulo ausente uma vez só",
        len(r["saida"].split("No module named")) == 3)
r = roda("printf 'import os\\nimport util\\n' | '" + POOL + "' --check --path proj/main.pr")
confere("--check não acusa módulo que existe (nativo e vizinho)", "\"ok\":true" in r["saida"])

# A coluna aponta o NOME, não a palavra-chave: o editor sublinhava `import`.
r = roda("printf 'import naoexiste_zz\\n' | '" + POOL + "' --check")
confere("o erro do import aponta a coluna do nome do módulo", "\"coluna\":8" in r["saida"])
r = roda("printf '    from pacote.sub import x\\n' | '" + POOL + "' --check")
confere("com indentação e caminho pontilhado, a coluna é a do primeiro segmento",
        "\"coluna\":10" in r["saida"])
r = roda("printf 'from json import naoexiste_zz\\n' | '" + POOL + "' --check")
confere("nome que o módulo não tem aponta a coluna do NOME importado",
        "\"coluna\":18" in r["saida"])
r = roda("'" + POOL + "' --check proj/main.pr")
confere("--check por caminho continua aprovando o import vizinho", "\"ok\":true" in r["saida"])

# Arquivo que não dá `fseek` (pipe, /dev/stdin): saía 66 calado.
r = roda("printf 'post(7)\\n' | '" + POOL + "' /dev/stdin")
confere("jinga roda fonte vindo de pipe", r["saida"].strip() == "7" and r["rc"] == 0)

# ── `--contexto`: o que faltava pro editor não completar no lugar errado ────
#
# A coluna do lexer conta CARACTERE; o corte do receptor contava BYTE, então
# um acento antes na linha devolvia `" o"` em vez de `os`.
r = roda("printf 'f(\"é\", os.' | '" + POOL + "' --contexto 1:11")
confere("--contexto não se perde com acento antes do receptor",
        "\"receptor\":\"os\"" in r["saida"])
# dentro de string e de comentário o editor não pode abrir completion
r = roda("printf 'x = \"os.pa\"' | '" + POOL + "' --contexto 1:11")
confere("--contexto dentro de string diz `texto`", "\"contexto\":\"texto\"" in r["saida"])
r = roda("printf 'x = 1 # veja os.' | '" + POOL + "' --contexto 1:17")
confere("--contexto dentro de comentário diz `comentario`",
        "\"contexto\":\"comentario\"" in r["saida"])
# mas o que está dentro de `{}` de f-string é CÓDIGO, e completa como código
r = roda("printf 'x = 1\\npost(f\"oi {x} {os.pa}\")\\n' | '" + POOL + "' --contexto 2:21")
confere("--contexto dentro de {} da f-string enxerga o membro",
        "\"contexto\":\"membro\"" in r["saida"] and "\"receptor\":\"os\"" in r["saida"])
# em que funct/classe o cursor está — `topo` não quer dizer escopo global
r = roda("printf 'funct soma(a)\\n{\\n    a\\n}\\n' | '" + POOL + "' --contexto 3:6")
confere("--contexto diz em que funct o cursor está", "\"escopo\":\"soma\"" in r["saida"])
# (o escopo sai da ÁRVORE; com a linha quebrada no meio, a árvore ainda para
# no primeiro erro — é o que o lote da recuperação de erro resolve)
r = roda("printf 'class C\\n{\\n    funct m(self)\\n    {\\n        self.x\\n    }\\n}\\n' | '"
         + POOL + "' --contexto 5:14")
confere("--contexto diz a classe e o método",
        "\"escopo\":\"C.m\"" in r["saida"] and "\"receptor\":\"self\"" in r["saida"])
# no meio da palavra, o pedaço ANTES do cursor é o que se está digitando
r = roda("printf 'post(abcdef)' | '" + POOL + "' --contexto 1:9")
confere("--contexto no meio da palavra devolve o pedaço antes do cursor",
        "\"parcial\":\"abc\"" in r["saida"])

# ── `async funct`: erro de tarefa não some, e aponta a linha certa ──────────
#
# A exceção de uma tarefa ficava guardada no future; sem `await`, sumia — o
# programa saía 0 e calado. E quando alguém aguardava, a linha acusada era a do
# `await`, não a do `raise`.
os.writeFile(PASTA + "/tarefa_erro.pr",
             "async funct falha()\n{\n    sleep(0.01)\n    raise ValueError(\"quebrei\")\n}\n"
             + "async funct boa()\n{\n    sleep(0.2)\n    return 1\n}\n"
             + "f = falha()\ng = boa()\npost(await g)\n")
r = roda("'" + POOL + "' tarefa_erro.pr")
confere("erro de tarefa que ninguém aguardou aparece no fim",
        "quebrei" in r["saida"] and "ninguem aguardou" in r["saida"])

os.writeFile(PASTA + "/tarefa_await.pr",
             "async funct falha()\n{\n    sleep(0.01)\n    raise ValueError(\"quebrei\")\n}\n"
             + "f = falha()\nv = await f\n")
r = roda("'" + POOL + "' tarefa_await.pr")
confere("o traceback da tarefa termina na linha do raise",
        "linha 4" in r["saida"] and r["rc"] != 0)

os.writeFile(PASTA + "/tarefa_comeca.pr",
             "async funct t()\n{\n    post(\"corpo\")\n    sleep(0.01)\n    post(\"resto\")\n}\n"
             + "f = t()\npost(\"chamou\")\nawait f\n")
r = roda("'" + POOL + "' tarefa_comeca.pr")
confere("a tarefa começa na chamada, antes da linha seguinte",
        r["saida"].strip() == "corpo\nchamou\nresto")

# ── onde cada coisa TERMINA, e a f-string por dentro ────────────────────────
#
# Sem coluna final, o editor sublinha 1 caractere e a seleção estrutural
# (Ctrl+W) não tem onde parar. E a f-string saía como UM token: as expressões
# de dentro não existiam pro realce nem pro "ir pra definição".
r = roda("printf 'nome = \"ana\"\\n' | '" + POOL + "' --tokens")
confere("--tokens diz onde o token termina",
        "\"c2\":" in r["saida"] and "\"l2\":" in r["saida"])
r = roda("printf 'funct f(a)\\n{\\n    return a\\n}\\n' | '" + POOL + "' --ast")
confere("--ast diz a coluna final do nó", "\"c2\":" in r["saida"])

# `--bytecode`: o que o compilador gera, uma instrução por linha, com o
# significado do argumento — é como se afirma o que um laço VIRA.
funct opcodes_de(saida, proto)
{
    nomes = []
    dentro = false
    for each l in saida.split("\n")
    {
        if l.startswith("== proto ")
        {
            dentro = l.startswith("== proto " + str(proto) + " ")
            continue
        }
        if dentro and l.strip() != ""
        {
            addEnd(nomes, l.split()[1])
        }
    }
    return nomes
}
os.writeFile(PASTA + "/laco.pr", "int n = 0\nwhile n < 1000000000 {\n    n++\n}\npost(n)\n")
r = roda("'" + POOL + "' --bytecode laco.pr")
confere("--bytecode lista o proto do modulo", r["rc"] == 0 and "== proto 0 <module>" in r["saida"])
confere("--bytecode diz o nome do global e o alvo do salto",
        "LOAD_GLOBAL      " in r["saida"] and "; n" in r["saida"] and "; -> " in r["saida"])
confere("--bytecode mostra a constante", "; 1000000000" in r["saida"])
# O laço tipado vira 5 instruções por volta: a comparação FUNDIDA com o
# desvio (JF_LT) e o `n++` numa instrução só (INC_GLOBAL_INT), sem DUP,
# POP_TOP nem COERCE_DECL — eram 12.
confere("laco tipado: comparacao+desvio e n++ fundidos",
        opcodes_de(r["saida"], 0) == ["LOAD_CONST", "STORE_GLOBAL", "LOAD_GLOBAL", "LOAD_CONST",
                                      "JF_LT", "INC_GLOBAL_INT", "JUMP", "LOAD_GLOBAL",
                                      "LOAD_GLOBAL", "CALL", "POP_TOP", "HALT"])
os.writeFile(PASTA + "/laco2.pr",
             "funct f() {\n    int i = 10\n    while i > 0 {\n        i--\n    }\n    int j = 0\n    j += 1\n    return i + j\n}\nx = 0\nwhile x {\n    x = 0\n}\nif x == 1 and x > 2 {\n    post(1)\n}\nif x != 2 {\n    post(2)\n}\n")
r = roda("'" + POOL + "' --bytecode laco2.pr")
confere("i-- e j += 1 em int local viram DEC/INC_LOCAL_INT",
        "DEC_LOCAL_INT" in opcodes_de(r["saida"], 1) and "INC_LOCAL_INT" in opcodes_de(r["saida"], 1)
        and not "COERCE_DECL" in opcodes_de(r["saida"], 1))
confere("condicao que nao e comparacao fica JUMP_IF_FALSE", "JUMP_IF_FALSE" in opcodes_de(r["saida"], 0))
# no `and` só o lado ESQUERDO funde (o direito passa por TO_BOOL)
confere("== no if e no lado esquerdo do and vira JF_EQ; != no if vira JF_NE",
        "JF_EQ" in opcodes_de(r["saida"], 0) and "JF_NE" in opcodes_de(r["saida"], 0)
        and "TO_BOOL" in opcodes_de(r["saida"], 0))
os.writeFile(PASTA + "/rng.pr", "s = 0\nfor each i in range(3) {\n    s = s + i\n}\npost(s)\n")
r = roda("'" + POOL + "' --bytecode rng.pr")
confere("range decodificado uma vez: RANGE_PREPARA antes do ITER_RANGE",
        "RANGE_PREPARA" in opcodes_de(r["saida"], 0) and "ITER_RANGE" in opcodes_de(r["saida"], 0))

# ── código de máquina (x86-64): o mesmo resultado com e sem ele ──────────────
os.writeFile(PASTA + "/jit.pr",
             "int n = 0\nwhile n < 300000 {\n    n++\n}\ns = 0\nfor each i in range(10) {\n    s = s + i\n}\n"
             + "funct fib(int k) {\n    if k < 2 { return k }\n    return fib(k - 1) + fib(k - 2)\n}\n"
             + "t = \"\"\ni = 0\nwhile i < 3 {\n    t = t + str(i)\n    i = i + 1\n}\n"
             + "big = 9223372036854775807\nbig = big + 1\n"
             + "post(n, s, fib(15), t, big, 1 < 2, \"a\" < \"b\", not (2 > 1))\n")
com = roda("JINGA_JIT_LOG=1 '" + POOL + "' jit.pr")
sem = roda("'" + POOL + "' --sem-jit jit.pr")
# `fib` compila: a chamada entre functs nativas e direta (jit_chama), sem
# passar pelo interpretador, e o `return` volta pro chamador nativo.
confere("com codigo de maquina o programa roda e o log diz o que compilou",
        com["rc"] == 0 and "[jit] <module>" in com["saida"] and "[jit] fib" in com["saida"])
confere("com e sem codigo de maquina a saida e a mesma",
        sem["rc"] == 0 and "300000 45 610 012 9223372036854775808 True True False" in sem["saida"]
        and "300000 45 610 012 9223372036854775808 True True False" in com["saida"])
falha = roda("JINGA_JIT_FALHA=1 JINGA_JIT_LOG=1 '" + POOL + "' jit.pr")
confere("mmap recusado: o programa segue interpretado, sem abortar",
        falha["rc"] == 0 and "300000 45 610" in falha["saida"] and not "[jit]" in falha["saida"])
os.writeFile(PASTA + "/jit_erro.pr", "int n = 9223372036854775807\nwhile n < 9223372036854775807 + 0 {\n    n++\n}\nn++\n")
r = roda("'" + POOL + "' jit_erro.pr")
confere("estouro dentro do nativo: o erro e o do interpretador, na linha certa",
        r["rc"] != 0 and "declare como 'long n'" in r["saida"] and "linha 5" in r["saida"])
r = roda("printf 'x = = 1\\n' | '" + POOL + "' --bytecode")
confere("--bytecode com erro de sintaxe sai como ao rodar", r["rc"] != 0 and "SyntaxError" in r["saida"])

r = roda("printf 'x = 1\\npost(f\"oi {x} {x + 2}\")\\n' | '" + POOL + "' --tokens")
confere("--tokens publica os tokens de dentro da f-string",
        "\"v\":\"x\"" in r["saida"] and "\"v\":\"+\"" in r["saida"])
confere("os tokens da f-string têm a posição real no fonte",
        "\"l\":2" in r["saida"] and "\"c\":12" in r["saida"])
# quem só pinta string ignora os de dentro por essa marca
confere("os tokens de dentro vêm marcados", "\"em\":\"fstring\"" in r["saida"])

# e na ÁRVORE: as interpolações são nós FILHOS do literal, com posição real.
# Enquanto elas não existiam na árvore, quem anda nela não via o que está
# entre as chaves — a captura de closure perdia a variável usada só ali.
r = roda("printf 'post(f\"oi {n.upper()}\")\\n' | '" + POOL + "' --ast")
confere("--ast traz a expressão de dentro da f-string",
        "\"texto\":\"upper\"" in r["saida"])
confere("o nó de dentro da f-string tem a coluna real",
        "\"k\":\"Name\",\"l\":1,\"c\":12,\"texto\":\"n\"" in r["saida"])

# o INTERVALO de cada `{...}` vem no token da f-string: é com ele que o editor
# sabe que ali é código, inclusive no espaço entre os tokens de dentro
r = roda("printf 'x = 1\\npost(f\"oi {x} e { x + 2 }\")\\n' | '" + POOL + "' --tokens")
confere("--tokens diz onde cada interpolação começa e acaba",
        "\"interp\":[{\"l\":2,\"c\":12,\"l2\":2,\"c2\":13},{\"l\":2,\"c\":18,\"l2\":2,\"c2\":25}]" in r["saida"])
# enquanto se digita, a chave fica aberta — é justo aí que o completion abre
r = roda("printf 'post(f\"sao {tot' | '" + POOL + "' --tokens")
confere("interpolação ainda aberta também tem intervalo",
        "\"interp\":[{\"l\":1,\"c\":13,\"l2\":1,\"c2\":16}]" in r["saida"])

# A contagem de coluna do protocolo do editor é UTF-16; a do motor é
# caractere. Com `--utf16` o motor entrega a do editor, e quem não pede não vê
# diferença.
# (o `printf` do sh não entende `\x`; os bytes do 𠮷 vão em octal)
r = roda("printf 'a = \"\\360\\240\\256\\267\" + b\\n' | '" + POOL + "' --tokens")
confere("sem --utf16 a coluna conta CARACTERE",
        "\"c\":11,\"n\":1,\"l2\":1,\"c2\":12,\"v\":\"b\"" in r["saida"])
r = roda("printf 'a = \"\\360\\240\\256\\267\" + b\\n' | '" + POOL + "' --tokens --utf16")
confere("com --utf16 o caractere fora do plano básico vale 2",
        "\"c\":12,\"n\":1,\"l2\":1,\"c2\":13,\"v\":\"b\"" in r["saida"])
# o TAMANHO do token vai na mesma conta que as colunas: a string tem aspa,
# o caractere de 2 unidades e aspa — 4 em UTF-16, e `c2 - c` também dá 4
confere("com --utf16 o n da string conta o caractere como 2",
        "\"t\":\"STR\",\"l\":1,\"c\":5,\"n\":4,\"l2\":1,\"c2\":9" in r["saida"])
# a posição do cursor CHEGA na mesma conta: com `--utf16` o motor recebe a
# coluna do editor e acha o mesmo lugar
r = roda("printf 'x = \"\\360\\240\\256\\267\"\\nx.up' | '" + POOL + "' --contexto 2:5")
confere("--contexto sem --utf16 lê coluna em caractere", "\"parcial\":\"up\"" in r["saida"])

# ── código pela metade: o editor precisa do que sobrou ──────────────────────
#
# Enquanto se digita, o arquivo passa a maior parte do tempo inválido. Antes,
# um caractere estranho fazia o `--tokens` devolver `[]` (a tela inteira
# perdia a cor) e um erro de sintaxe fazia o `--ast` parar ali (o painel de
# estrutura esvaziava da linha do erro pra baixo).
r = roda("printf 'x = 1\\nstr ação = 2\\ny = 3\\n' | '" + POOL + "' --tokens")
confere("--tokens devolve os tokens das linhas boas apesar do caractere estranho",
        "\"v\":\"x\"" in r["saida"] and "\"v\":\"y\"" in r["saida"])
confere("--tokens diz o erro do lexer junto com os tokens",
        "\"erros\":[" in r["saida"] and "sem acento" in r["saida"])
confere("--tokens marca o trecho ruim como token ERRO",
        "\"t\":\"ERRO\"" in r["saida"])
r = roda("printf 'x = \"aberta\\ny = 2\\n' | '" + POOL + "' --tokens")
confere("--tokens com string sem fechar não perde a linha seguinte",
        "\"v\":\"y\"" in r["saida"])

r = roda("printf 'import os\\nx = 1\\nif x > 0 \\npost(1)\\nfunct f() { return 7 }\\n' | '"
         + POOL + "' --ast")
confere("--ast devolve o que vem DEPOIS do erro de sintaxe",
        "\"texto\":\"f\"" in r["saida"])
confere("--ast lista os erros de sintaxe", "\"erros\":[" in r["saida"])

r = roda("printf 'if x > 0 \\npost(1)\\nwhile y \\npost(2)\\n' | '" + POOL + "' --check")
confere("--check lista TODOS os erros de sintaxe, não só o primeiro",
        len(r["saida"].split("\"linha\":")) >= 3)

# com erro de sintaxe, a conferência de tipo não roda: statement descartado
# faria nome existente aparecer como inexistente (cascata)
r = roda("printf 'n = 1\\nif n > 0 \\npost(n)\\n' | '" + POOL + "' --check")
confere("--check com sintaxe torta não inventa erro de nome",
        not "NameError" in r["saida"])

# o programa RODANDO continua parando no primeiro erro
os.writeFile(PASTA + "/torto2.pr", "x = 1\nif x > 0 \npost(1)\n")
r = roda("'" + POOL + "' torto2.pr")
confere("rodar continua parando no primeiro erro de sintaxe",
        r["rc"] != 0 and "SyntaxError" in r["saida"])

# nome com acento: a mensagem diz a regra, não só "caractere inesperado"
r = roda("printf 'ação = 1\\n' | '" + POOL + "' --check")
confere("nome com acento explica a regra do identificador",
        "sem acento" in r["saida"])

# ── parêntese esquecido aberto: o erro vai no `(`, e o resto do arquivo fica ─
#
# Rodada 3 da Jinga. Dentro de `(` a quebra de linha não conta, então com
# `funct f(` esquecido aberto a declaração de baixo virava parâmetro: o erro
# saía NELA ("'int' e palavra reservada ... nome de parametro", na linha
# errada) e ela sumia da árvore. Com `funct f( {` sumia tudo depois do `(`.
# E um statement quebrado DENTRO de uma funct derrubava a funct inteira: o
# resto do corpo vazava pro topo (a árvore mostrava `y` como global) e o `}`
# virava um erro fantasma.
funct topo(saida)
{
    d = json.parse(saida)
    nomes = []
    for each n in d["arvore"]["lista"]
    {
        t = ""
        if "texto" in n
        {
            t = str(n["texto"])
        }
        addEnd(nomes, n["k"] + ":" + t)
    }
    return nomes
}
funct corpo_de(saida, nome)
{
    d = json.parse(saida)
    for each n in d["arvore"]["lista"]
    {
        if "texto" in n and n["texto"] == nome and "b" in n
        {
            nomes = []
            for each s in n["b"]["lista"]
            {
                t = ""
                if "texto" in s
                {
                    t = str(s["texto"])
                }
                addEnd(nomes, s["k"] + ":" + t)
            }
            return nomes
        }
    }
    return Null
}
funct erros_do_check(saida)
{
    d = json.parse(saida)
    if "erros" in d
    {
        return [[e["linha"], e["coluna"], e["msg"]] for each e in d["erros"]]
    }
    return []
}

os.writeFile(PASTA + "/aberto.pr",
             "import os\npost(1)\nfunct f(\nint funct depois(int a) {\n    return a\n}\nz = 3\n")
r = roda("'" + POOL + "' --check aberto.pr")
confere("parentese esquecido: o erro sai no `(`, um só",
        erros_do_check(r["saida"]) == [[3, 8, "parentese '(' aberto nao foi fechado"]])
r = roda("'" + POOL + "' --ast aberto.pr")
confere("parentese esquecido: a declaracao de baixo continua na arvore",
        "ActionDecl:depois" in topo(r["saida"]) and "Assignment:z" in topo(r["saida"]))
r = roda("'" + POOL + "' --tokens aberto.pr")
confere("--tokens marca onde o motor fechou o grupo (SINC)", "\"t\":\"SINC\"" in r["saida"])
r = roda("'" + POOL + "' aberto.pr")
confere("rodando, o erro tambem sai no `(` da linha 3",
        r["rc"] != 0 and "parentese '(' aberto nao foi fechado" in r["saida"]
        and "linha 3" in r["saida"])

os.writeFile(PASTA + "/quebrado.pr", "import os\nfunct f( {\npost(1)\n")
r = roda("'" + POOL + "' --check quebrado.pr")
confere("`funct f( {`: um erro, no `(` — o `{` logo depois nao vira outro",
        erros_do_check(r["saida"]) == [[2, 8, "parentese '(' aberto nao foi fechado"]])

os.writeFile(PASTA + "/multi.pr",
             "import os\nfunct f( {\npost(1)\nx = = 2\nint funct depois(int a) {\n    return a\n}\n")
r = roda("'" + POOL + "' --ast multi.pr")
confere("`funct f( {` nao engole a declaracao que vem depois",
        "ActionDecl:depois" in topo(r["saida"]))
# A linha de baixo que VOLTA a indentacao da linha do `(` fecha o grupo ali:
# `post(1)` e `x = = 2` nao sao argumentos de `f(`, sao as linhas seguintes.
# Antes o grupo so fechava na declaracao (linha 5), tudo entre o `(` e ela
# era "sintoma" e saia da lista — o erro REAL da linha 4 sumia, e `post(1)`
# sumia da arvore.
confere("o que esta depois do `(` aberto volta pra arvore",
        "ExpressionStmt:" in topo(r["saida"]))
r = roda("'" + POOL + "' --check multi.pr")
confere("o erro real da linha de baixo nao some como sintoma do `(`",
        erros_do_check(r["saida"]) == [[2, 8, "parentese '(' aberto nao foi fechado"],
                                       [4, 5, "expressao invalida"]])
# Rodando, o MESMO erro do editor: o `(` esquecido em 2:8, nao o "esperado
# nome de parametro" no `{` da coluna 10. A sonda de grupos do modo de
# recuperacao escolhe a frase quando o parser para dentro de um grupo sem
# par. Vale tambem pro modulo importado.
r = roda("'" + POOL + "' quebrado.pr")
confere("rodando `funct f( {`: a frase e a coluna sao as do `--check` (o `(`)",
        r["rc"] != 0 and "parentese '(' aberto nao foi fechado" in r["saida"]
        and "linha 2" in r["saida"] and "|        ^^^" in r["saida"])
os.writeFile(PASTA + "/mq.pr", "funct f( {\npost(1)\n")
os.writeFile(PASTA + "/main_q.pr", "import mq\n")
r = roda("'" + POOL + "' main_q.pr")
confere("modulo importado com `funct f( {`: rodando acusa o `(` dele",
        r["rc"] != 0 and "mq: parentese '(' aberto nao foi fechado" in r["saida"]
        and "em mq.pr, linha 1" in r["saida"])
r = roda("'" + POOL + "' --check main_q.pr")
confere("--check do importador acusa o `(` do modulo, na coluna do `(`",
        "mq: parentese '(' aberto nao foi fechado" in r["saida"] and "\"coluna_arquivo\":8" in r["saida"])

# Cada erro do --check diz onde o trecho acusado TERMINA (`l2`/`c2`, a
# posicao logo depois do ultimo caractere), como os tokens e os nos: o token
# no erro de sintaxe, o abridor no grupo sem par, o no inteiro no erro de tipo.
funct fins_do_check(saida)
{
    d = json.parse(saida)
    return [[e["linha"], e["coluna"], e["l2"], e["c2"]] for each e in d["erros"]]
}
os.writeFile(PASTA + "/fim.pr", "x = = 2\nfunct f(\n")
r = roda("'" + POOL + "' --check fim.pr")
confere("--check: l2/c2 do erro de sintaxe e o fim do token; do grupo sem par, o abridor",
        fins_do_check(r["saida"]) == [[1, 5, 1, 6], [2, 8, 2, 9]])
os.writeFile(PASTA + "/fim_tipo.pr", "int x = \"abc\"\n")
r = roda("'" + POOL + "' --check fim_tipo.pr")
confere("--check: l2/c2 do erro de tipo cobre a expressao inteira",
        fins_do_check(r["saida"]) == [[1, 9, 1, 14]])
r = roda("printf 'x = \"\\360\\240\\256\\267\" = 2\\n' | '" + POOL + "' --check")
confere("--check sem --utf16: c2 em caractere", fins_do_check(r["saida"]) == [[1, 9, 1, 10]])
r = roda("printf 'x = \"\\360\\240\\256\\267\" = 2\\n' | '" + POOL + "' --check --utf16")
confere("--check --utf16: c2 convertido como a coluna", fins_do_check(r["saida"]) == [[1, 10, 1, 11]])

os.writeFile(PASTA + "/corpo.pr",
             "funct a() {\n    x = = 1\n    y = 2\n}\nfunct b() {\n    return 3\n}\n")
r = roda("'" + POOL + "' --ast corpo.pr")
confere("statement quebrado dentro da funct: a funct fica, nada vaza pro topo",
        topo(r["saida"]) == ["ActionDecl:a", "ActionDecl:b"])
confere("statement quebrado dentro da funct: o resto do corpo continua dentro dela",
        corpo_de(r["saida"], "a") == ["Assignment:y"])
r = roda("'" + POOL + "' --check corpo.pr")
confere("statement quebrado dentro da funct: sem erro fantasma no `}`",
        erros_do_check(r["saida"]) == [[2, 9, "expressao invalida"]])

os.writeFile(PASTA + "/fecha.pr",
             "funct a() {\n    x = f(\n}\nfunct b() {\n    return 3\n}\n")
r = roda("'" + POOL + "' --ast fecha.pr")
confere("`(` aberto fechado pelo `}` da funct: as duas funct ficam",
        topo(r["saida"]) == ["ActionDecl:a", "ActionDecl:b"])
r = roda("'" + POOL + "' --check fecha.pr")
confere("`(` aberto fechado pelo `}` da funct: o erro sai no `(`",
        erros_do_check(r["saida"]) == [[2, 10, "parentese '(' aberto nao foi fechado"]])

# os corpos com laço próprio (classe, model, enum) também seguram o membro
# quebrado: a declaração fica na árvore com o que sobrou
funct membros(saida, k)
{
    d = json.parse(saida)
    for each n in d["arvore"]["lista"]
    {
        if n["k"] == k
        {
            nomes = []
            for each s in n["lista"]
            {
                addEnd(nomes, str(s["texto"]))
            }
            return nomes
        }
    }
    return Null
}
os.writeFile(PASTA + "/classe.pr",
             "class C {\n    public int = = 1\n    funct n(self) { return 1 }\n}\nz = 1\n")
r = roda("'" + POOL + "' --ast classe.pr")
confere("membro quebrado nao derruba a classe", membros(r["saida"], "EntityDecl") == ["n"])
os.writeFile(PASTA + "/modelo.pr", "model M() {\n    nome: str(\n    idade: int\n}\nz = 1\n")
r = roda("'" + POOL + "' --ast modelo.pr")
confere("campo com `(` aberto nao derruba o model", "ModelDecl:M" in topo(r["saida"]))
os.writeFile(PASTA + "/enumr.pr", "enum Cor {\n    A = = 1\n    B = 2\n}\nz = 1\n")
r = roda("'" + POOL + "' --ast enumr.pr")
confere("membro quebrado nao derruba o enum", membros(r["saida"], "EnumDecl") == ["B"])

# o erro do lexer (grupo sem par) não esconde mais o erro de sintaxe de outra
# linha: o `--check` lista os dois, na ordem do arquivo
os.writeFile(PASTA + "/dois.pr",
             "funct f(\nint funct depois(int a) {\n    return a\n}\nx = = 3\n")
r = roda("'" + POOL + "' --check dois.pr")
confere("--check lista o grupo sem par E o erro de outra linha, em ordem",
        erros_do_check(r["saida"]) == [[1, 8, "parentese '(' aberto nao foi fechado"],
                                       [5, 5, "expressao invalida"]])

# ── o `pool` só carrega a biblioteca que o programa usa ─────────────────────
#
# Ligado aos clientes de banco (Postgres, MySQL, ODBC, Mongo), o `pool`
# carregava na partida de TODO programa essas bibliotecas e o que elas
# arrastam — 36 no `ldd`, 90% do trabalho de um `pool --version` (callgrind),
# e o binário nem abria numa máquina sem o cliente do Mongo. Agora cada driver
# abre a sua na primeira conexão. Isto já se perdeu uma vez: fica travado.
r = roda("ldd '" + POOL + "'")
confere("o pool nao depende de cliente de banco na partida",
        r["rc"] == 0 and not "libpq" in r["saida"] and not "libmariadb" in r["saida"]
        and not "libmongoc" in r["saida"] and not "libodbc" in r["saida"]
        and not "libgssapi" in r["saida"] and not "libldap" in r["saida"])

# ── conferir N funct custa proporcional a N, não a N² ───────────────────────
#
# Rodada 4 da Jinga. As listas de nomes do compilador eram varridas do começo
# a cada declaração: 10 mil funct de uma linha levavam 0,8 s pra conferir e 40
# mil, 32 s — ao rodar também. Sem número absoluto (a máquina muda): a razão
# entre 20 mil e 5 mil funct. Linear dá perto de 4; o quadrático de antes dava
# 16. Melhor de três, pra ruído de agenda não reprovar.
import date
funct gera_decl(n)
{
    partes = []
    i = 0
    while i < n
    {
        addEnd(partes, "int funct f" + str(i) + "(int a) { return a + " + str(i) + " }")
        i = i + 1
    }
    addEnd(partes, "post(f0(1))")
    return "\n".join(partes) + "\n"
}
funct melhor_de_tres(cmd)
{
    melhor = 1000000.0
    k = 0
    while k < 3
    {
        t0 = date.monotonic()
        roda(cmd)
        t = date.monotonic() - t0
        if t < melhor
        {
            melhor = t
        }
        k = k + 1
    }
    return melhor
}
os.writeFile(PASTA + "/decl5k.pr", gera_decl(5000))
os.writeFile(PASTA + "/decl20k.pr", gera_decl(20000))
t5  = melhor_de_tres("'" + POOL + "' --check decl5k.pr")
t20 = melhor_de_tres("'" + POOL + "' --check decl20k.pr")
confere("--check de 20 mil funct custa perto de 4x o de 5 mil (era 16x)", t20 < t5 * 8)

# ── a memória não guarda o arquivo inteiro ──────────────────────────────────
#
# Rodar um arquivo custava ~3 KB de memória POR LINHA: o vetor com todos os
# tokens e a árvore inteira ficavam na memória até o fim da compilação, e um
# arquivo de 1 milhão de linhas pedia 4 GB (a máquina entrava na swap). Agora o
# motor lê uma declaração de topo por vez, guarda só os cabeçalhos e o código
# gerado, e a VM assume o programa compilado em vez de copiá-lo. O pico medido
# por `/usr/bin/time -f %M` (KB) entre 20 mil e 5 mil funct dá o custo das 15
# mil a mais; era 3,1 KB por linha e passou a ~1,5 KB. Teto folgado pra ruído,
# apertado o bastante pra pegar a volta do arquivo inteiro.
funct pico_kb(cmd)
{
    r = roda("/usr/bin/time -f '%M' " + cmd + " > /dev/null")
    linhas = r["saida"].strip().split("\n")
    return int(linhas[linhas.len() - 1].strip())
}
if os.exists("/usr/bin/time")
{
    m5  = pico_kb("'" + POOL + "' decl5k.pr")
    m20 = pico_kb("'" + POOL + "' decl20k.pr")
    por_linha = (m20 - m5) * 1024 / 15000
    confere("rodar 20 mil funct custa menos de 2,2 KB de memoria por linha (era 3,1 KB): "
            + str(por_linha) + " B", por_linha < 2200)
}

# O LIMITE da regra: palavra-chave como argumento nomeado, compreensão e lambda
# com declaração dentro são continuação VÁLIDA de uma linha com `(` aberto — e
# continuam passando. A sincronia por declaração só roda em arquivo que já tem
# grupo sem par.
os.writeFile(PASTA + "/validos.pr",
             "funct g(*a, **k) { return k }\npost(g(1,\nclass=2, from=3, import=4))\n"
             + "post([x * 2\nfor each x in [1, 2]])\nh = funct(cb) { return cb(1) }\n"
             + "post(h(funct(v) {\n    funct interna(w) { return w + 1 }\n    return interna(v)\n}))\n")
r = roda("'" + POOL + "' --check validos.pr")
confere("continuacao valida dentro de `(` continua passando no --check",
        r["saida"].strip() == "{\"ok\":true}")

# ── `build`: roda todos os .pr da pasta, em ordem ───────────────────────────
#
# `cmd_build` varre o diretório, filtra pela extensão da linguagem (`.pr`),
# ORDENA e roda um por um. Nada disso tinha teste: 26 ramos, incluindo a pasta
# sem nada pra rodar e o arquivo que falha no meio.
os.mkdir(PASTA + "/obra", exist_ok=true)
os.writeFile(PASTA + "/obra/b_segundo.pr", "post(\"SEGUNDO\")\n")
os.writeFile(PASTA + "/obra/a_primeiro.pr", "post(\"PRIMEIRO\")\n")
os.writeFile(PASTA + "/obra/nao_e_fonte.txt", "isto nao roda\n")
r = roda("cd obra && '" + POOL + "' build")
confere("build roda os .pr da pasta", "PRIMEIRO" in r["saida"] and "SEGUNDO" in r["saida"])
# a ORDEM é parte do contrato: `build` de resultado imprevisível é inútil
# quando um arquivo depende do que o anterior deixou pronto
confere("build roda em ordem alfabética",
        r["saida"].find("PRIMEIRO") < r["saida"].find("SEGUNDO"))
confere("build ignora quem não é fonte", not "isto nao roda" in r["saida"])
confere("build sai 0 quando tudo passa", r["rc"] == 0)

# arquivo que FALHA no meio: o `build` não pode engolir e sair 0
os.writeFile(PASTA + "/obra/c_quebra.pr", "post(nao_existe_essa_variavel)\n")
r = roda("cd obra && '" + POOL + "' build")
confere("build reprova quando um arquivo falha", r["rc"] != 0)
os.cmd("rm -f " + PASTA + "/obra/c_quebra.pr")

# pasta sem nenhum fonte: caso de borda do coletor
os.mkdir(PASTA + "/vazia", exist_ok=true)
r = roda("cd vazia && '" + POOL + "' build")
confere("build em pasta vazia não quebra", r["rc"] == 0 or r["saida"].strip().len() > 0)

# ── entradas tortas da CLI ──────────────────────────────────────────────────
r = roda("'" + POOL + "' arquivo_que_nao_existe.pr")
confere("arquivo inexistente é erro com mensagem",
        r["rc"] != 0 and "nao consegui abrir" in r["saida"])
r = roda("'" + POOL + "' -e 'post(1 + 1)'")
confere("-e roda código inline", "2" in r["saida"] and r["rc"] == 0)
r = roda("'" + POOL + "' -e 'post(nao_existe)'")
confere("-e com erro sai != 0", r["rc"] != 0)
r = roda("'" + POOL + "' -e")
confere("-e sem código é erro", r["rc"] != 0)
r = roda("'" + POOL + "'")
confere("sem argumento nenhum mostra a ajuda", "Uso:" in r["saida"])
r = roda("'" + POOL + "' --version")
confere("--version diz a versão", "Jinga" in r["saida"] and r["rc"] == 0)
r = roda("'" + POOL + "' --help")
confere("--help lista os comandos", "Uso:" in r["saida"] and r["rc"] == 0)

r = roda("'" + POOL + "' --metadata")
confere("--metadata expõe os módulos", "\"modulos\"" in r["saida"] and r["rc"] == 0)

r = roda("'" + POOL + "' --opcao-que-nao-existe")
# `rc != 0 OU qualquer saída` aprovava um pool que imprimisse lixo e saísse 0.
# O contrato de verdade: recusa (rc != 0) E diz O QUE recusou.
confere("opção desconhecida é recusada citando a opção",
        r["rc"] != 0 and "opcao-que-nao-existe" in r["saida"])

# `build` roda todos os .pr da pasta — inclusive os que já criamos
os.mkdir(PASTA + "/b", exist_ok=true)
os.writeFile(PASTA + "/b/um.pr", "post(\"um\")\n")
r = roda("cd b && '" + POOL + "' build")
confere("build roda os .pr da pasta", "um" in r["saida"])

# ── gerenciador de pacotes: instalar do disco (vm/ps_pkg.c) ─────────────────
os.writeFile(PASTA + "/hello.pr", "#!cmd\nfunct main() {\n    post(\"oi do pacote\")\n}\nmain()\n")

r = com_home("'" + POOL + "' install hello.pr")
confere("jpkg install cria o comando", "instalado" in r["saida"] and r["rc"] == 0)
confere("jpkg install grava o .pr e o atalho",
        os.isfile(HOME + "/commands/hello.pr") and os.isfile(HOME + "/bin/hello"))
confere("jpkg install registra em installed.json", os.isfile(HOME + "/installed.json"))

r = com_home("'" + POOL + "' list")
confere("jpkg list mostra o comando instalado", "hello" in r["saida"])

r = com_home("sh " + HOME + "/bin/hello")
confere("o atalho instalado executa o pacote", "oi do pacote" in r["saida"])

r = com_home("'" + POOL + "' uninstall hello")
confere("jpkg uninstall remove", r["rc"] == 0 and os.exists(HOME + "/commands/hello.pr") == false)

os.writeFile(PASTA + "/minhalib.pr", "#!lib\nfunct dobro(x) {\n    return x * 2\n}\n")
r = com_home("'" + POOL + "' install minhalib.pr -asLib")
confere("jpkg install -asLib instala como biblioteca", r["rc"] == 0)
confere("a lib vai pra pasta de libs", os.isfile(HOME + "/libs/minhalib.pr"))

os.writeFile(PASTA + "/usa.pr", "import minhalib\npost(minhalib.dobro(21))\n")
r = com_home("'" + POOL + "' usa.pr")
confere("a lib instalada é importável", r["saida"].strip() == "42")

# As exceções são valores também DENTRO de módulo importado: a ligação dos
# nomes tem dois laços (script principal e módulo); sem o segundo,
# `ValueError` num módulo era NameError.
os.writeFile(PASTA + "/zzexc.pr", "funct quem() {\n    return ValueError\n}\n")
os.writeFile(PASTA + "/usa_exc.pr", "import zzexc\npost(zzexc.quem() is Exception, zzexc.quem())\n")
r = roda("'" + POOL + "' usa_exc.pr")
confere("exceção é valor dentro de módulo importado", r["saida"].strip() == "True ValueError")

r = com_home("'" + POOL + "' uninstall minhalib -asLib")
confere("jpkg uninstall -asLib remove a lib", os.exists(HOME + "/libs/minhalib.pr") == false)

# nome instalado como comando E como lib: sem flag, o uninstall dizia "Erro:"
# e removia o comando mesmo assim. Comando destrutivo sob "Erro:" para.
os.writeFile(PASTA + "/dup.pr", "#!cmd\nfunct main() {\n    post(\"dup\")\n}\nmain()\n")
com_home("'" + POOL + "' install dup.pr")
com_home("'" + POOL + "' install dup.pr -asLib")
r = com_home("'" + POOL + "' uninstall dup")
confere("uninstall ambiguo recusa (rc 1) e diz como desambiguar",
        r["rc"] == 1 and "-asLib" in r["saida"])
confere("uninstall ambiguo nao remove nada",
        os.isfile(HOME + "/commands/dup.pr") and os.isfile(HOME + "/libs/dup.pr"))
com_home("'" + POOL + "' uninstall dup -asLib")
r = com_home("'" + POOL + "' uninstall dup")
confere("desambiguado, o comando sai", r["rc"] == 0 and os.exists(HOME + "/commands/dup.pr") == false)

r = com_home("'" + POOL + "' uninstall nao_instalado")
confere("uninstall do que não existe não finge sucesso",
        r["rc"] != 0 and "nao esta instalado" in r["saida"])

# ── registry: configuração e recusa de HTTP inseguro ────────────────────────
r = com_home("'" + POOL + "' registry show")
confere("registry show sem configuração avisa", r["saida"].strip().len() > 0)

r = com_home("'" + POOL + "' registry set-url https://exemplo.test/index.json")
confere("registry set-url grava", r["rc"] == 0)
r = com_home("'" + POOL + "' registry show")
confere("registry show devolve o que foi gravado", "exemplo.test" in r["saida"])

r = com_home("'" + POOL + "' registry set-url http://exemplo-inseguro.test/i.json")
saiu = com_home("'" + POOL + "' install qualquer")
confere("registry em http inseguro é recusado",
        "https" in saiu["saida"] or saiu["rc"] != 0)

# ── registry DE VERDADE, servido pelo próprio jinker em loopback ────────────
os.writeFile(PASTA + "/estatico/pacote.pr", "")
os.mkdir(PASTA + "/estatico", exist_ok=true)
os.writeFile(PASTA + "/estatico/pacote.pr",
             "#!cmd\nfunct main() {\n    post(\"vim do registry\")\n}\nmain()\n")

import hash
fonte = os.readFile(PASTA + "/estatico/pacote.pr")
sha = hash.sha256(fonte)
raiz_url = "http://127.0.0.1:" + str(PORTA)
indice = "{\"pacote\": {\"url\": \"" + raiz_url + "/pacote.pr\", \"sha256\": \"" + sha + "\"},\n"
indice = indice + " \"torto\": {\"url\": \"" + raiz_url + "/pacote.pr\", \"sha256\": \"" + ("0" * 64) + "\"},\n"
indice = indice + " \"simples\": \"" + raiz_url + "/pacote.pr\"}\n"
os.writeFile(PASTA + "/estatico/index.json", indice)

srv_src = "import jinker\n"
srv_src = srv_src + "app = jinker.Jinker(name=\"registry\", static_folder=\"" + PASTA + "/estatico\", static_url=\"/\")\n"
srv_src = srv_src + "if __name__ == \"main\" {\n"
srv_src = srv_src + "    app(debug=false, host=\"127.0.0.1\", port=" + str(PORTA) + ")\n"
srv_src = srv_src + "}\n"
os.writeFile(PASTA + "/registry_srv.pr", srv_src)

os.cmd("'" + POOL + "' " + PASTA + "/registry_srv.pr > " + PASTA + "/srv.log 2>&1 & echo $! > " + PASTA + "/srv.pid")

# espera a porta ABRIR, em vez de dormir no escuro
import sockets
subiu = false
tentativa = 0
while (tentativa < 50 and subiu == false)
{
    s = sockets.socket()
    s.settimeout(0.2)
    if s.connect_ex(("127.0.0.1", PORTA)) == 0
    {
        subiu = true
    }
    s.close()
    tentativa = tentativa + 1
    sleep(0.1)
}
confere("o registry local subiu", subiu)

if subiu
{
    com_home("'" + POOL + "' registry set-url " + raiz_url + "/index.json")

    r = com_home("'" + POOL + "' install pacote")
    confere("jpkg install <nome> baixa do registry e confere o sha256",
            r["rc"] == 0 and os.isfile(HOME + "/commands/pacote.pr"))

    r = com_home("sh " + HOME + "/bin/pacote")
    confere("o pacote baixado executa", "vim do registry" in r["saida"])

    r = com_home("'" + POOL + "' install torto")
    confere("sha256 que não confere ABORTA a instalação",
            r["rc"] != 0 and os.exists(HOME + "/commands/torto.pr") == false)

    r = com_home("'" + POOL + "' install simples")
    confere("entrada sem sha256 instala (integridade é OPCIONAL — ver auditoria)",
            r["rc"] == 0)

    r = com_home("'" + POOL + "' install nao_esta_no_indice")
    confere("nome fora do índice é erro, não silêncio", r["rc"] != 0)

    # mata pelo PID gravado — `pkill -f <padrao>` casa com qualquer linha de
    # comando que contenha o padrao, inclusive a de quem esta rodando o teste.
    os.cmd("kill $(cat " + PASTA + "/srv.pid) 2>/dev/null; true")
}

# ── erro DENTRO de um módulo importado ──────────────────────────────────────
#
# POR QUE AQUI: precisa de DOIS arquivos, e a suíte em C roda um fonte só.
#
# Uma lib instalada tinha `// nota` (comentário do tempo em que `//` comentava,
# antes do I11). O erro saía assim:
#
#     SyntaxError: random: expressao invalida
#       em d.pr, linha 1
#       | import random
#       | ^^^
#
# Dois defeitos numa linha: a mensagem não dizia o que `//` virou, e o quadro
# apontava a única linha que estava certa — a do `import`. O arquivo e a linha
# do defeito, em outro arquivo, não apareciam em lugar nenhum.
os.writeFile(PASTA + "/lib_torta.pr", "funct f() {\n    // nota velha\n    return 1\n}\n")
os.writeFile(PASTA + "/usa_lib.pr", "import lib_torta\npost(lib_torta.f())\n")

r = roda("'" + POOL + "' usa_lib.pr")
confere("erro dentro do módulo importado aponta o ARQUIVO da lib",
        "lib_torta.pr" in r["saida"])
confere("...e a LINHA de dentro dela, não a do import",
        "linha 2" in r["saida"])
confere("...e o quadro do import continua lá, pra saber quem importou",
        "usa_lib.pr" in r["saida"] and "import lib_torta" in r["saida"])
confere("'//' diz que virou divisão inteira, em vez de 'expressao invalida'",
        "divisao inteira, nao comentario" in r["saida"] and r["rc"] != 0)

os.writeFile(PASTA + "/so_barra.pr", "x = 1\n// nota\npost(x)\n")
r = roda("'" + POOL + "' so_barra.pr")
confere("'//' solto no arquivo principal dá a mesma mensagem",
        "divisao inteira, nao comentario" in r["saida"])

os.writeFile(PASTA + "/divide.pr", "post(7 // 2)\n")
r = roda("'" + POOL + "' divide.pr")
confere("e a divisão inteira de verdade continua funcionando",
        r["rc"] == 0 and r["saida"].strip() == "3")

# ── `-o`: executavel que roda sozinho ───────────────────────────────────────
#
# `pool programa.pr -o nome` gruda o fonte numa copia do proprio binario, com
# um rodape que diz onde ele comeca. O que importa medir: o gerado roda SEM o
# fonte ao lado, recebe argumentos, aceita as tres extensoes, nao gera nada
# quando o fonte esta torto, e recompilar nao empilha payload (senao cada
# geracao carregaria o programa da anterior e o arquivo cresceria sem parar).
os.writeFile(PASTA + "/prog.pr", "import sys\npost(\"compilado\")\npost(\"argv:\", sys.argv)\n")
r = roda("'" + POOL + "' prog.pr -o meuprog")
confere("`-o` gera o executavel", r["rc"] == 0 and "gerado:" in r["saida"])
confere("o gerado existe", os.exists(PASTA + "/meuprog"))

r = roda("./meuprog um dois")
# `sys.argv` segue a convencao de C/Python tambem no executavel gerado: o
# proprio programa em [0] e os argumentos a partir de [1]. O caso conferia
# `['um', 'dois']` e ficou para tras quando a convencao mudou.
confere("o gerado roda e recebe argumentos",
        "compilado" in r["saida"] and "meuprog', 'um', 'dois']" in r["saida"]
        and r["rc"] == 0)

os.cmd("mv " + PASTA + "/prog.pr " + PASTA + "/guardado.pr")
r = roda("./meuprog")
confere("o gerado roda SEM o fonte ao lado", "compilado" in r["saida"] and r["rc"] == 0)
os.cmd("mv " + PASTA + "/guardado.pr " + PASTA + "/prog.pr")

tam1 = os.size(PASTA + "/meuprog")
os.writeFile(PASTA + "/prog2.pr", "post(\"dois\")\n")
roda("'" + POOL + "' prog2.pr -o meuprog2")
tam2 = os.size(PASTA + "/meuprog2")
confere("recompilar nao empilha o payload anterior", tam2 > 0 and tam2 < tam1 + 4096)

os.writeFile(PASTA + "/p3.pr", "post(\"tres\")\n")
roda("'" + POOL + "' p3.pr -o prog3")
r = roda("./prog3")
confere("`-o` gera executavel de qualquer .pr", "tres" in r["saida"] and r["rc"] == 0)

os.writeFile(PASTA + "/ruim.pr", "funct f( {\n")
r = roda("'" + POOL + "' ruim.pr -o naodeve")
confere("fonte com erro nao gera executavel",
        r["rc"] != 0 and not os.exists(PASTA + "/naodeve"))

r = roda("'" + POOL + "' prog.pr -o")
confere("`-o` sem nome de saida diz o uso", r["rc"] == 64 and "uso:" in r["saida"])

# ── `-o` embute os MODULOS que o programa alcanca ───────────────────────────
#
# O executavel grudava so o principal: `import banco` procurava `banco.pr` no
# disco de quem roda e nao achava ("No module named 'banco'"). Agora vai junto
# todo `.pr` alcancado por import — vizinho, subpasta, relativo, `*` e lib
# instalada — resolvido na compilacao como o import resolve rodando. E o
# traceback le a linha do fonte EMBUTIDO e diz o nome do ARQUIVO (`main.pr`,
# `banco.pr`): antes dizia "em psp-pool, linha 6" e mostrava a linha 6 do ELF.
# Medido numa pasta longe, com os fontes RENOMEADOS (nao existem mais no
# caminho de origem) e a pasta de libs apontando pro vazio.
EMB = PASTA + "/emb"
os.mkdir(EMB + "/sub", exist_ok=true)
os.mkdir(HOME + "/libs", exist_ok=true)
os.writeFile(HOME + "/libs/minhalib.pr", "funct de_lib() {\n    return \"lib\"\n}\n")
os.writeFile(EMB + "/banco.pr",
             "funct reais(v) {\n    return \"R$ \" + str(v)\n}\nfunct quebra() {\n    return 1 / 0\n}\n")
os.writeFile(EMB + "/sub/guarda.pr", "TOKEN = \"g\"\n")
os.writeFile(EMB + "/sub/pix.pr", "from .guarda import TOKEN\nfunct pix() {\n    return \"pix-\" + TOKEN\n}\n")
os.writeFile(EMB + "/util.pr", "funct estrela() {\n    return \"*\"\n}\n")
os.writeFile(EMB + "/main.pr",
             "import sys\nfrom banco import reais, quebra\nimport sub.pix\nfrom util import *\nimport minhalib\n"
             + "post(reais(10), pix.pix(), estrela(), minhalib.de_lib())\n"
             + "if \"quebra\" in sys.argv { quebra() }\n"
             + "if \"erro\" in sys.argv { post(int(\"abc\")) }\n")
r = com_home("'" + POOL + "' emb/main.pr -o emb/app")
confere("`-o` embute os modulos alcancados e diz quantos (vizinho, subpasta, relativo, `*`, lib)",
        r["rc"] == 0 and "5 modulos embutidos" in r["saida"])

LONGE = PASTA + "/longe"
os.mkdir(LONGE, exist_ok=true)
os.cmd("cp " + EMB + "/app " + LONGE + "/app && mv " + EMB + " " + PASTA + "/emb_guardado")
r = roda("cd longe && JINGA_HOME=/nao/existe HOME=/nao/existe ./app")
confere("o executavel roda longe, sem nenhum fonte no caminho de origem e sem libs",
        r["rc"] == 0 and r["saida"].strip() == "R$ 10 pix-g * lib")
r = roda("cd longe && JINGA_HOME=/nao/existe HOME=/nao/existe ./app quebra")
confere("erro dentro de modulo embutido: o traceback diz o modulo e mostra a linha do fonte",
        r["rc"] != 0 and "banco.pr, linha 5" in r["saida"] and "return 1 / 0" in r["saida"])
r = roda("cd longe && JINGA_HOME=/nao/existe HOME=/nao/existe ./app erro")
confere("erro no principal: o traceback diz main.pr e mostra a linha dele, nao a do ELF",
        r["rc"] != 0 and "main.pr, linha 8" in r["saida"] and "int(\"abc\")" in r["saida"]
        and not "app, linha" in r["saida"])
os.cmd("mv " + PASTA + "/emb_guardado " + EMB)

# modulo que nao existe: erro na COMPILACAO, nada gerado — um executavel que
# so descobre isso na maquina de quem roda nasce quebrado
os.writeFile(EMB + "/falta.pr", "import naoexiste\npost(1)\n")
r = com_home("'" + POOL + "' emb/falta.pr -o emb/naodeve")
confere("`-o` com modulo que nao se acha recusa e diz qual",
        r["rc"] != 0 and "naoexiste" in r["saida"] and not os.exists(EMB + "/naodeve"))
# e cada modulo passa pela mesma conferencia do --check (tipagem inclusive)
os.writeFile(EMB + "/tipo.pr", "str s = 10\n")
os.writeFile(EMB + "/usa_tipo.pr", "import tipo\npost(1)\n")
r = com_home("'" + POOL + "' emb/usa_tipo.pr -o emb/naodeve2")
confere("`-o` com erro de tipo num modulo recusa, com a mesma frase do --check",
        r["rc"] != 0 and "esperava str" in r["saida"] and not os.exists(EMB + "/naodeve2"))

# ── regra 5 da tipagem estatica: assinatura dos `.pr` importados ───────────
#
# O checador era cego pro que o import traz: `util.soma(1, 2, 3)` passava no
# `--check` e so estourava rodando. Agora o resolvedor entrega a AST do modulo
# importado e a chamada, o construtor, o metodo, o membro e o nome importado
# sao conferidos ANTES de rodar, com as MESMAS frases do runtime — medidas
# aqui nos dois momentos. Fica de fora o que so se sabe rodando: funct
# decorada por decorador geral, variavel do modulo e modulo em ciclo.
IMP = PASTA + "/imp5"
os.mkdir(IMP + "/sub", exist_ok=true)
os.writeFile(IMP + "/util.pr",
             "funct soma(int a, int b=1) {\n    return a + b\n}\n"
             + "class Conta {\n    funct __init__(self, int saldo) {\n        self.saldo = saldo\n    }\n"
             + "    funct extrato(self) {\n        return self.saldo\n    }\n}\n"
             + "X = 10\n"
             + "funct deco(f) {\n    return f\n}\n"
             + "@deco\nfunct trocada(a) {\n    return a\n}\n")
os.writeFile(IMP + "/sub/rel.pr", "from ..util import soma\nfunct usa() {\n    return soma(\"a\")\n}\n")
os.writeFile(IMP + "/ciclo_a.pr", "import ciclo_b\nfunct fa() {\n    return 1\n}\nfunct usa_b() {\n    return ciclo_b.fb()\n}\n")
os.writeFile(IMP + "/ciclo_b.pr", "import ciclo_a\nfunct fb() {\n    return 2\n}\n")

funct caso5(c5_nome, c5_fonte, c5_erro)
{
    os.writeFile(IMP + "/m.pr", c5_fonte)
    c5_check = roda("'" + POOL + "' --check imp5/m.pr")
    c5_roda = roda("'" + POOL + "' imp5/m.pr")
    confere("importado: " + c5_nome + " — acusado ANTES de rodar",
            "\"ok\":false" in c5_check["saida"] and c5_erro in c5_check["saida"])
    confere("importado: " + c5_nome + " — a mesma frase rodando (rc 2)",
            c5_roda["rc"] == 2 and c5_erro in c5_roda["saida"])
}

caso5("aridade de funct do modulo", "import util\npost(util.soma(1, 2, 3))\n",
      "soma() takes from 1 to 2 positional arguments but 3 were given")

# A assinatura de um nome importado é a do MÓDULO, mesmo quando a declaração
# dele está na mesma linha e coluna de uma declaração deste arquivo (a
# compilação por declaração casa os nós pela posição no fonte, e um `funct`
# na linha 1 de cada arquivo é o caso comum). Quebrado, `f(1, 2)` era
# conferido contra `g()` e recusado.
os.writeFile(IMP + "/util_pos.pr", "funct f(a, b) {\n    return a + b\n}\n")
os.writeFile(IMP + "/m.pr", "funct g() {\n    return 1\n}\nfrom util_pos import f\npost(f(1, 2))\n")
r = roda("'" + POOL + "' --check imp5/m.pr")
confere("importado na mesma posicao de uma declaracao local: --check aceita",
        r["saida"].strip() == "{\"ok\":true}")
r = roda("'" + POOL + "' imp5/m.pr")
confere("importado na mesma posicao de uma declaracao local: roda com a assinatura do modulo",
        r["rc"] == 0 and r["saida"].strip() == "3")
caso5("tipo do parametro, via from-import", "from util import soma\npost(soma(\"a\"))\n",
      "parâmetro a de soma() esperava int, recebeu str")
caso5("argumento faltando, por apelido", "import util as u\npost(u.soma())\n",
      "soma() missing 1 required positional argument: 'a'")
caso5("membro que o modulo nao tem", "import util\npost(util.naoexiste)\n",
      "module 'util' has no attribute 'naoexiste'")
caso5("nome que o modulo nao tem", "from util import naoexiste\n",
      "cannot import name 'naoexiste' from 'util'")
caso5("construtor da classe importada", "import util\nc = util.Conta(\"x\")\n",
      "parâmetro saldo de __init__() esperava int, recebeu str")
caso5("metodo da classe importada", "from util import Conta\nConta k = Conta(1)\npost(k.extrato(9))\n",
      "extrato() takes 1 positional argument but 2 were given")
caso5("membro que a classe importada nao tem", "from util import Conta\nk = Conta(1)\npost(k.nada)\n",
      "'Conta' object has no attribute 'nada'")
caso5("modulo importado que nao compila: acusado na linha do import",
      "import sub.rel\npost(rel.usa())\n",
      "sub.rel: parâmetro a de soma() esperava int, recebeu str")

# o que NAO pode virar erro falso
os.writeFile(IMP + "/m.pr", "from util import trocada\npost(trocada(1, 2))\n")
r = roda("'" + POOL + "' --check imp5/m.pr")
confere("importado: funct decorada por decorador geral nao e conferida", "\"ok\":true" in r["saida"])
os.writeFile(IMP + "/m.pr", "from util import X\npost(X + 1)\n")
r = roda("'" + POOL + "' imp5/m.pr")
confere("importado: variavel do modulo passa e roda", r["rc"] == 0 and r["saida"].strip() == "11")
os.writeFile(IMP + "/m.pr", "import ciclo_a\npost(ciclo_a.usa_b(), ciclo_a.fa())\n")
r = roda("'" + POOL + "' imp5/m.pr")
confere("importado: ciclo de import nao da veredito falso e roda", r["rc"] == 0 and r["saida"].strip() == "2 1")
os.writeFile(IMP + "/m.pr", "import util\nc = util.Conta(5)\npost(c.extrato() + util.soma(1))\n")
r = roda("'" + POOL + "' imp5/m.pr")
confere("importado: chamada certa passa e roda", r["rc"] == 0 and r["saida"].strip() == "7")

# ── extensão de antes na linha de comando ───────────────────────────────────
#
# `.ps`, `.psl` e `.p` foram as extensões da linguagem. Hoje o arquivo é `.pr`,
# e o motor NÃO lê os nomes velhos. O que importa aqui é a FRASE: o arquivo
# existe, é Jinga válido, e mesmo assim não roda — sem dizer o conserto,
# isso é um "nao consegui abrir" que não explica nada. A recusa vale nos quatro
# caminhos que leem arquivo (rodar, `--check`, `-o` e `--debug`), e vale só
# para as três de antes: qualquer outro nome continua rodando.
for each velha in [".ps", ".psl", ".p"]
{
    alvo = "velho" + velha
    os.writeFile(PASTA + "/" + alvo, "post(\"nao devia rodar\")\n")
    r = roda("'" + POOL + "' " + alvo)
    confere("rodar " + velha + " e recusado dizendo o conserto",
            r["rc"] != 0 and ".pr" in r["saida"] and "migra_pr" in r["saida"]
            and not "nao devia rodar" in r["saida"])
    r = roda("'" + POOL + "' --check " + alvo)
    confere("--check em " + velha + " tambem recusa", r["rc"] != 0 and ".pr" in r["saida"])
    r = roda("'" + POOL + "' " + alvo + " -o naodeve2")
    confere("`-o` sobre " + velha + " tambem recusa",
            r["rc"] != 0 and not os.exists(PASTA + "/naodeve2"))
}

os.writeFile(PASTA + "/outra.txt", "post(\"extensao estranha roda\")\n")
r = roda("'" + POOL + "' outra.txt")
confere("extensao QUALQUER continua rodando — a recusa e so das tres de antes",
        r["rc"] == 0 and "extensao estranha roda" in r["saida"])

r = roda("'" + POOL + "' nao_existe.pr")
confere("arquivo ausente com a extensao certa diz que nao abriu, sem falar de migracao",
        r["rc"] != 0 and "nao consegui abrir" in r["saida"]
        and not "migra_pr" in r["saida"])

# `import './x.ps'` acha o arquivo velho ao lado e, em vez de "No module
# named", diz que a extensão mudou — o erro tem que falar do ARQUIVO.
os.writeFile(PASTA + "/vizinho.ps", "z = 1\n")
os.writeFile(PASTA + "/importa.pr", "import './vizinho.ps'\n")
r = roda("'" + POOL + "' importa.pr")
confere("import de caminho com extensao velha ensina a nova",
        r["rc"] != 0 and "ImportError" in r["saida"] and "migra_pr" in r["saida"])

# ── o migrador, numa pasta de mentira ───────────────────────────────────────
#
# Sem `--aplica` ele não pode encostar em nada: é essa promessa que faz alguém
# aceitar rodá-lo no projeto inteiro.
MIG = PASTA + "/obra_migra"
os.mkdir(MIG + "/sub", exist_ok=true)
os.writeFile(MIG + "/util.ps", "funct f() {\n    return 7\n}\n")
os.writeFile(MIG + "/sub/usa.psl", "import '../util.ps'\npost(util.f())\n")
os.writeFile(MIG + "/leiame.md", "roda com `pool sub/usa.psl`\n")
MIGRADOR = os.cwd() + "/scripts/migra_pr.pr"

r = roda("'" + POOL + "' '" + MIGRADOR + "' " + MIG)
confere("migrador sem --aplica nao renomeia nada",
        os.exists(MIG + "/util.ps") and not os.exists(MIG + "/util.pr")
        and "nada foi mudado" in r["saida"])

r = roda("'" + POOL + "' '" + MIGRADOR + "' " + MIG + " --aplica")
confere("migrador renomeia as tres extensoes",
        os.exists(MIG + "/util.pr") and os.exists(MIG + "/sub/usa.pr")
        and not os.exists(MIG + "/util.ps"))
confere("migrador arruma a referencia dentro do arquivo",
        "'../util.pr'" in os.readFile(MIG + "/sub/usa.pr"))
confere("migrador arruma a referencia na doc tambem",
        "sub/usa.pr" in os.readFile(MIG + "/leiame.md"))
r = roda("cd " + MIG + " && '" + POOL + "' sub/usa.pr")
confere("o programa migrado roda", r["rc"] == 0 and "7" in r["saida"])

# ── migra_classe.pr: `class X() {` -> `class X {`, `base(x)` -> `base().__init__(x)`
# (2026-09-25). Numa pasta de mentira com .pr, .md e .c (string C com `\n`
# colado na palavra, a armadilha do limite de palavra); mensagens de erro do
# motor com `base()` ficam como estão.
MIGC = PASTA + "/obra_classe"
os.cmd("rm -rf '" + MIGC + "' && mkdir -p '" + MIGC + "'")
MIGRADOR_C = os.cwd() + "/scripts/migra_classe.pr"
os.writeFile(MIGC + "/velho.pr",
    "Entity A() {\n    funct __init__(self, x) { self.x = x }\n}\n"
    + "class B(A) {\n    funct __init__(self, x) {\n        base(x)\n    }\n}\n"
    + "public Class C(){\n    funct v(self) { return 3 }\n}\n"
    + "post(B(1).x, C().v())\n")
os.writeFile(MIGC + "/leiame.md", "Use `Entity Conta() {` e chame `base(args)`.\n")
os.writeFile(MIGC + "/casos.c",
    "{ \"x\", \"Entity A() {\\n}\\nEntity B(A) {\\n    funct __init__(self) { base() }\\n}\\n\",\n"
    + "  \"\", \"TypeError: base(): a Entity pai 'A' nao tem __init__\", 1 },\n")
r = roda("'" + POOL + "' '" + MIGRADOR_C + "' " + MIGC)
confere("migra_classe sem --aplica so relata (3 arquivos, 5 cabecalhos, 3 base)",
        r["rc"] == 0 and "nada mudou" in r["saida"] and "3 arquivo(s)" in r["saida"]
        and os.readFile(MIGC + "/velho.pr").find("Entity A() {") >= 0)
r = roda("'" + POOL + "' '" + MIGRADOR_C + "' " + MIGC + " --aplica --confere")
velho_novo = os.readFile(MIGC + "/velho.pr")
confere("migra_classe tira o () vazio e mantem a heranca",
        velho_novo.find("Entity A {") >= 0 and velho_novo.find("class B(A) {") >= 0
        and velho_novo.find("public Class C {") >= 0)
confere("migra_classe converte base(x) em base().__init__(x)",
        velho_novo.find("base().__init__(x)") >= 0)
confere("migra_classe entende o \\n colado na palavra dentro de string C",
        os.readFile(MIGC + "/casos.c").find("\\nEntity B(A) {") >= 0
        and os.readFile(MIGC + "/casos.c").find("Entity A {\\n}") >= 0)
confere("migra_classe deixa a mensagem de erro `base():` como esta",
        os.readFile(MIGC + "/casos.c").find("TypeError: base(): a Entity pai") >= 0
        and os.readFile(MIGC + "/casos.c").find("{ base().__init__() }") >= 0)
confere("migra_classe mexe na doc tambem",
        os.readFile(MIGC + "/leiame.md").find("`Entity Conta {`") >= 0)
confere("--confere nao reprovou nada", not "REPROVOU" in r["saida"])
r = roda("cd " + MIGC + " && '" + POOL + "' velho.pr")
confere("o programa migrado roda com a sintaxe nova", r["rc"] == 0 and "1 3" in r["saida"])

# ── relatório ───────────────────────────────────────────────────────────────
post("")
post("cli/jpkg:", ok, "checagens passaram")
if falhas.len() > 0
{
    post("FALHARAM:", falhas.len())
    for each f in falhas
    {
        post("  " + f)
    }
    sys.exit(1)
}

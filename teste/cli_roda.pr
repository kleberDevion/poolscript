        and "{\"arquivo\":\"ruim9.pr\",\"ok\":false" in r["saida"])
r = roda([POOL, "--tokens", "bom9.pr", "ruim9.pr"])
confere("--tokens com dois arquivos e uso errado, rc 64", r["rc"] == 64 and "um arquivo por vez" in r["saida"])
# arquivo que não abre: o motivo, no formato de cada comando
r = roda([POOL, "--contexto", "1:1", "naoexiste9.pr"])
confere("--contexto de arquivo que nao existe diz que nao abriu",
        r["rc"] == 1 and "{\"contexto\":\"erro\",\"msg\":\"nao consegui abrir 'naoexiste9.pr'\"}" in r["saida"])
r = roda([POOL, "--tokens", "naoexiste9.pr"])
confere("--tokens de arquivo que nao existe no formato de objeto",
        r["rc"] == 1 and "{\"tokens\":[],\"erros\":[{\"msg\":\"nao consegui abrir 'naoexiste9.pr'\"" in r["saida"])

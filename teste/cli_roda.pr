r = roda([POOL, "prog.pr"], pasta=PASTA + "/cdq")
confere("quadro depois do os.chdir mostra a linha do programa que rodou",
        r["rc"] == 1 and "| post(l[9])" in r["saida"] and not "OUTRO" in r["saida"])
# --check com dois arquivos confere os dois: um JSON por linha, com o arquivo

confere("--check da entrada padrao acha o vizinho na pasta corrente", "{\"ok\":true}" in r["saida"])
# jinga build: o sys.exit de um arquivo não encerra o build, e o rc diz se houve erro
os.mkdir(PASTA + "/build9", exist_ok=True)
os.writeFile(PASTA + "/build9/a.pr", "post(\"a ok\")\n")
os.writeFile(PASTA + "/build9/b.pr", "import sys\npost(\"b\")\nsys.exit(0)\n")

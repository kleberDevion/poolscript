# ── registry DE VERDADE, servido pelo próprio jinker em loopback ────────────
os.writeFile(PASTA + "/estatico/pacote.pr", "")
os.mkdir(PASTA + "/estatico", exist_ok=True)
os.writeFile(PASTA + "/estatico/pacote.pr",
             "#!cmd\nfunct main() {\n    post(\"vim do registry\")\n}\nmain()\n")

import hash
fonte = os.readFile(PASTA + "/estatico/pacote.pr")
sha = hash.sha256(fonte)
raiz_url = "http://127.0.0.1:" + str(PORTA)
indice = "{\"pacote\": {\"url\": \"" + raiz_url + "/pacote.pr\", \"sha256\": \"" + sha + "\"},\n"
indice = indice + " \"torto\": {\"url\": \"" + raiz_url + "/pacote.pr\", \"sha256\": \"" + ("0" * 64) + "\"},\n"
indice = indice + " \"simples\": \"" + raiz_url + "/pacote.pr\"}\n"
os.writeFile(PASTA + "/estatico/index.json", indice)

srv_src = "import jinker\n"
srv_src = srv_src + "app = jinker.Jinker(name=\"registry\", static_folder=\"" + PASTA + "/estatico\", static_url=\"/\")\n"
srv_src = srv_src + "if __name__ == \"main\" {\n"
srv_src = srv_src + "    app(debug=False, host=\"127.0.0.1\", port=" + str(PORTA) + ")\n"
srv_src = srv_src + "}\n"
os.writeFile(PASTA + "/registry_srv.pr", srv_src)

# O servidor é um processo vivo (`capture="live"`), não um `&` do shell. A
# saída dele ia pra srv.log; agora os dois canais são lidos em segundo plano,
# porque cano que ninguém lê enche e para o servidor no meio de uma resposta.
srv = os.run([POOL, PASTA + "/registry_srv.pr"], capture="live")
srv.close()
leitura_srv = [junta_saida(srv), junta_erro(srv)]

# espera a porta ABRIR, em vez de dormir no escuro
import sockets
subiu = False
tentativa = 0
while (tentativa < 50 and subiu == False)
{
    s = sockets.socket()
    s.settimeout(0.2)
    if s.connect_ex(("127.0.0.1", PORTA)) == 0
    {
        subiu = True
    }
    s.close()
    tentativa = tentativa + 1
    sleep(0.1)
}
confere("o registry local subiu", subiu)

if subiu
{
    com_home([POOL, "registry", "set-url", raiz_url + "/index.json"])

    r = com_home([POOL, "install", "pacote"])
    confere("jpkg install <nome> baixa do registry e confere o sha256",
            r["rc"] == 0 and os.isfile(HOME + "/commands/pacote.pr"))

    r = roda_atalho("pacote")
    confere("o pacote baixado executa", "vim do registry" in r["saida"])

    r = com_home([POOL, "install", "torto"])
    confere("sha256 que não confere ABORTA a instalação",
            r["rc"] != 0 and os.exists(HOME + "/commands/torto.pr") == False)

    r = com_home([POOL, "install", "simples"])
    confere("entrada sem sha256 instala (integridade é OPCIONAL — ver auditoria)",
            r["rc"] == 0)

    r = com_home([POOL, "install", "nao_esta_no_indice"])
    confere("nome fora do índice é erro, não silêncio", r["rc"] != 0)
}

# mata pelo próprio processo (no Windows o `kill` é o TerminateProcess) —
# `pkill -f <padrao>` casa com qualquer linha de comando que contenha o
# padrao, inclusive a de quem esta rodando o teste.
srv.kill()
srv.wait()
gather(leitura_srv[0], leitura_srv[1])

# ── erro DENTRO de um módulo importado ──────────────────────────────────────
#
# POR QUE AQUI: precisa de DOIS arquivos, e a suíte em C roda um fonte só.
#
# Uma lib instalada tinha `// nota` (comentário do tempo em que `//` comentava,
# antes do I11). O erro saía assim:
#
#     SyntaxError: random: expressao invalida
#       em d.pr, linha 1
#       | import random
#       | ^^^
#
# Dois defeitos numa linha: a mensagem não dizia o que `//` virou, e o quadro
# apontava a única linha que estava certa — a do `import`. O arquivo e a linha
# do defeito, em outro arquivo, não apareciam em lugar nenhum.
os.writeFile(PASTA + "/lib_torta.pr", "funct f() {\n    // nota velha\n    return 1\n}\n")
os.writeFile(PASTA + "/usa_lib.pr", "import lib_torta\npost(lib_torta.f())\n")

r = roda([POOL, "usa_lib.pr"])
confere("erro dentro do módulo importado aponta o ARQUIVO da lib",
        "lib_torta.pr" in r["saida"])
confere("...e a LINHA de dentro dela, não a do import",
        "linha 2" in r["saida"])
confere("...e o quadro do import continua lá, pra saber quem importou",
        "usa_lib.pr" in r["saida"] and "import lib_torta" in r["saida"])
confere("'//' diz que virou divisão inteira, em vez de 'expressao invalida'",
        "divisao inteira, nao comentario" in r["saida"] and r["rc"] != 0)

os.writeFile(PASTA + "/so_barra.pr", "x = 1\n// nota\npost(x)\n")
r = roda([POOL, "so_barra.pr"])
confere("'//' solto no arquivo principal dá a mesma mensagem",
        "divisao inteira, nao comentario" in r["saida"])

os.writeFile(PASTA + "/divide.pr", "post(7 // 2)\n")
r = roda([POOL, "divide.pr"])
confere("e a divisão inteira de verdade continua funcionando",
        r["rc"] == 0 and r["saida"].strip() == "3")

# ── `-o`: executavel que roda sozinho ───────────────────────────────────────
#
# `pool programa.pr -o nome` gruda o fonte numa copia do proprio binario, com
# um rodape que diz onde ele comeca. O que importa medir: o gerado roda SEM o
# fonte ao lado, recebe argumentos, aceita as tres extensoes, nao gera nada
# quando o fonte esta torto, e recompilar nao empilha payload (senao cada
# geracao carregaria o programa da anterior e o arquivo cresceria sem parar).
# No Windows o gerado se chama `nome.exe` (EXE).
os.writeFile(PASTA + "/prog.pr", "import sys\npost(\"compilado\")\npost(\"argv:\", sys.argv)\n")
r = roda([POOL, "prog.pr", "-o", "meuprog"])
confere("`-o` gera o executavel", r["rc"] == 0 and "gerado:" in r["saida"])
confere("o gerado existe", os.exists(PASTA + "/meuprog" + EXE))

r = roda([gerado("meuprog"), "um", "dois"])
# `sys.argv` segue a convencao de C/Python tambem no executavel gerado: o
# proprio programa em [0] e os argumentos a partir de [1]. O caso conferia
# `['um', 'dois']` e ficou para tras quando a convencao mudou.
confere("o gerado roda e recebe argumentos",
        "compilado" in r["saida"] and "meuprog" + EXE + "', 'um', 'dois']" in r["saida"]
        and r["rc"] == 0)

os.move(PASTA + "/prog.pr", PASTA + "/guardado.pr")
r = roda([gerado("meuprog")])
confere("o gerado roda SEM o fonte ao lado", "compilado" in r["saida"] and r["rc"] == 0)
os.move(PASTA + "/guardado.pr", PASTA + "/prog.pr")

tam1 = os.size(PASTA + "/meuprog" + EXE)
os.writeFile(PASTA + "/prog2.pr", "post(\"dois\")\n")
roda([POOL, "prog2.pr", "-o", "meuprog2"])
tam2 = os.size(PASTA + "/meuprog2" + EXE)
confere("recompilar nao empilha o payload anterior", tam2 > 0 and tam2 < tam1 + 4096)

os.writeFile(PASTA + "/p3.pr", "post(\"tres\")\n")
roda([POOL, "p3.pr", "-o", "prog3"])
r = roda([gerado("prog3")])
confere("`-o` gera executavel de qualquer .pr", "tres" in r["saida"] and r["rc"] == 0)

os.writeFile(PASTA + "/ruim.pr", "funct f( {\n")
r = roda([POOL, "ruim.pr", "-o", "naodeve"])
confere("fonte com erro nao gera executavel",
        r["rc"] != 0 and not os.exists(PASTA + "/naodeve" + EXE))

r = roda([POOL, "prog.pr", "-o"])
confere("`-o` sem nome de saida diz o uso", r["rc"] == 64 and "uso:" in r["saida"])

# ── `-o` embute os MODULOS que o programa alcanca ───────────────────────────
#
# O executavel grudava so o principal: `import banco` procurava `banco.pr` no
# disco de quem roda e nao achava ("No module named 'banco'"). Agora vai junto
# todo `.pr` alcancado por import — vizinho, subpasta, relativo, `*` e lib
# instalada — resolvido na compilacao como o import resolve rodando. E o
# traceback le a linha do fonte EMBUTIDO e diz o nome do ARQUIVO (`main.pr`,
# `banco.pr`): antes dizia "em psp-pool, linha 6" e mostrava a linha 6 do ELF.
# Medido numa pasta longe, com os fontes RENOMEADOS (nao existem mais no
# caminho de origem) e a pasta de libs apontando pro vazio.
EMB = PASTA + "/emb"
os.mkdir(EMB + "/sub", exist_ok=True)
os.mkdir(HOME + "/libs", exist_ok=True)
os.writeFile(HOME + "/libs/minhalib.pr", "funct de_lib() {\n    return \"lib\"\n}\n")
os.writeFile(EMB + "/banco.pr",
             "funct reais(v) {\n    return \"R$ \" + str(v)\n}\nfunct quebra() {\n    return 1 / 0\n}\n")
os.writeFile(EMB + "/sub/guarda.pr", "TOKEN = \"g\"\n")
os.writeFile(EMB + "/sub/pix.pr", "from .guarda import TOKEN\nfunct pix() {\n    return \"pix-\" + TOKEN\n}\n")
os.writeFile(EMB + "/util.pr", "funct estrela() {\n    return \"*\"\n}\n")
os.writeFile(EMB + "/main.pr",
             "import sys\nfrom banco import reais, quebra\nimport sub.pix\nfrom util import *\nimport minhalib\n"
             + "post(reais(10), pix.pix(), estrela(), minhalib.de_lib())\n"
             + "if \"quebra\" in sys.argv { quebra() }\n"
             + "if \"erro\" in sys.argv { post(int(\"abc\")) }\n")
r = com_home([POOL, "emb/main.pr", "-o", "emb/app"])
confere("`-o` embute os modulos alcancados e diz quantos (vizinho, subpasta, relativo, `*`, lib)",
        r["rc"] == 0 and "5 modulos embutidos" in r["saida"])

LONGE = PASTA + "/longe"
os.mkdir(LONGE, exist_ok=True)
# o executável vai MOVIDO pra lá: o `move` leva a permissão de execução junto,
# e o `os.copy` grava o destino como arquivo comum, sem ela
os.move(EMB + "/app" + EXE, LONGE + "/app" + EXE)
os.move(EMB, PASTA + "/emb_guardado")
sem_libs = {"JINGA_HOME": "/nao/existe", VAR_CASA: "/nao/existe"}
r = roda([gerado("app")], pasta=LONGE, amb=sem_libs)
confere("o executavel roda longe, sem nenhum fonte no caminho de origem e sem libs",
        r["rc"] == 0 and r["saida"].strip() == "R$ 10 pix-g * lib")
r = roda([gerado("app"), "quebra"], pasta=LONGE, amb=sem_libs)
confere("erro dentro de modulo embutido: o traceback diz o modulo e mostra a linha do fonte",
        r["rc"] != 0 and "banco.pr, linha 5" in r["saida"] and "return 1 / 0" in r["saida"])
r = roda([gerado("app"), "erro"], pasta=LONGE, amb=sem_libs)
confere("erro no principal: o traceback diz main.pr e mostra a linha dele, nao a do ELF",
        r["rc"] != 0 and "main.pr, linha 8" in r["saida"] and "int(\"abc\")" in r["saida"]
        and not ("app" + EXE + ", linha" in r["saida"]))
os.move(PASTA + "/emb_guardado", EMB)

# modulo que nao existe: erro na COMPILACAO, nada gerado — um executavel que
# so descobre isso na maquina de quem roda nasce quebrado
os.writeFile(EMB + "/falta.pr", "import naoexiste\npost(1)\n")
r = com_home([POOL, "emb/falta.pr", "-o", "emb/naodeve"])
confere("`-o` com modulo que nao se acha recusa e diz qual",
        r["rc"] != 0 and "naoexiste" in r["saida"] and not os.exists(EMB + "/naodeve" + EXE))
# e cada modulo passa pela mesma conferencia do --check (tipagem inclusive)
os.writeFile(EMB + "/tipo.pr", "str s = 10\n")
os.writeFile(EMB + "/usa_tipo.pr", "import tipo\npost(1)\n")
r = com_home([POOL, "emb/usa_tipo.pr", "-o", "emb/naodeve2"])
confere("`-o` com erro de tipo num modulo recusa, com a mesma frase do --check",
        r["rc"] != 0 and "esperava str" in r["saida"] and not os.exists(EMB + "/naodeve2" + EXE))

# ── regra 5 da tipagem estatica: assinatura dos `.pr` importados ───────────
#
# O checador era cego pro que o import traz: `util.soma(1, 2, 3)` passava no
# `--check` e so estourava rodando. Agora o resolvedor entrega a AST do modulo
# importado e a chamada, o construtor, o metodo, o membro e o nome importado
# sao conferidos ANTES de rodar, com as MESMAS frases do runtime — medidas
# aqui nos dois momentos. Fica de fora o que so se sabe rodando: funct
# decorada por decorador geral, variavel do modulo e modulo em ciclo.
IMP = PASTA + "/imp5"
os.mkdir(IMP + "/sub", exist_ok=True)
os.writeFile(IMP + "/util.pr",
             "funct soma(int a, int b=1) {\n    return a + b\n}\n"
             + "class Conta {\n    funct __init__(self, int saldo) {\n        self.saldo = saldo\n    }\n"
             + "    funct extrato(self) {\n        return self.saldo\n    }\n}\n"
             + "X = 10\n"
             + "funct deco(f) {\n    return f\n}\n"
             + "@deco\nfunct trocada(a) {\n    return a\n}\n")
os.writeFile(IMP + "/sub/rel.pr", "from ..util import soma\nfunct usa() {\n    return soma(\"a\")\n}\n")
os.writeFile(IMP + "/ciclo_a.pr", "import ciclo_b\nfunct fa() {\n    return 1\n}\nfunct usa_b() {\n    return ciclo_b.fb()\n}\n")
os.writeFile(IMP + "/ciclo_b.pr", "import ciclo_a\nfunct fb() {\n    return 2\n}\n")

funct caso5(c5_nome, c5_fonte, c5_erro)
{
    os.writeFile(IMP + "/m.pr", c5_fonte)
    c5_check = roda([POOL, "--check", "imp5/m.pr"])
    c5_roda = roda([POOL, "imp5/m.pr"])
    confere("importado: " + c5_nome + " — acusado ANTES de rodar",
            "\"ok\":false" in c5_check["saida"] and c5_erro in c5_check["saida"])
    confere("importado: " + c5_nome + " — a mesma frase rodando (rc 2)",
            c5_roda["rc"] == 2 and c5_erro in c5_roda["saida"])
}

caso5("aridade de funct do modulo", "import util\npost(util.soma(1, 2, 3))\n",
      "soma() takes from 1 to 2 positional arguments but 3 were given")

# A assinatura de um nome importado é a do MÓDULO, mesmo quando a declaração
# dele está na mesma linha e coluna de uma declaração deste arquivo (a
# compilação por declaração casa os nós pela posição no fonte, e um `funct`
# na linha 1 de cada arquivo é o caso comum). Quebrado, `f(1, 2)` era
# conferido contra `g()` e recusado.
os.writeFile(IMP + "/util_pos.pr", "funct f(a, b) {\n    return a + b\n}\n")
os.writeFile(IMP + "/m.pr", "funct g() {\n    return 1\n}\nfrom util_pos import f\npost(f(1, 2))\n")
r = roda([POOL, "--check", "imp5/m.pr"])
confere("importado na mesma posicao de uma declaracao local: --check aceita",
        r["saida"].strip() == "{\"ok\":true}")
r = roda([POOL, "imp5/m.pr"])
confere("importado na mesma posicao de uma declaracao local: roda com a assinatura do modulo",
        r["rc"] == 0 and r["saida"].strip() == "3")
caso5("tipo do parametro, via from-import", "from util import soma\npost(soma(\"a\"))\n",
      "parâmetro a de soma() esperava int, recebeu str")
caso5("argumento faltando, por apelido", "import util as u\npost(u.soma())\n",
      "soma() missing 1 required positional argument: 'a'")
caso5("membro que o modulo nao tem", "import util\npost(util.naoexiste)\n",
      "module 'util' has no attribute 'naoexiste'")
caso5("nome que o modulo nao tem", "from util import naoexiste\n",
      "cannot import name 'naoexiste' from 'util'")
caso5("construtor da classe importada", "import util\nc = util.Conta(\"x\")\n",
      "parâmetro saldo de __init__() esperava int, recebeu str")
caso5("metodo da classe importada", "from util import Conta\nConta k = Conta(1)\npost(k.extrato(9))\n",
      "extrato() takes 1 positional argument but 2 were given")
caso5("membro que a classe importada nao tem", "from util import Conta\nk = Conta(1)\npost(k.nada)\n",
      "'Conta' object has no attribute 'nada'")
caso5("modulo importado que nao compila: acusado na linha do import",
      "import sub.rel\npost(rel.usa())\n",
      "sub.rel: parâmetro a de soma() esperava int, recebeu str")

# o que NAO pode virar erro falso
os.writeFile(IMP + "/m.pr", "from util import trocada\npost(trocada(1, 2))\n")
r = roda([POOL, "--check", "imp5/m.pr"])
confere("importado: funct decorada por decorador geral nao e conferida", "\"ok\":true" in r["saida"])
os.writeFile(IMP + "/m.pr", "from util import X\npost(X + 1)\n")
r = roda([POOL, "imp5/m.pr"])
confere("importado: variavel do modulo passa e roda", r["rc"] == 0 and r["saida"].strip() == "11")
os.writeFile(IMP + "/m.pr", "import ciclo_a\npost(ciclo_a.usa_b(), ciclo_a.fa())\n")
r = roda([POOL, "imp5/m.pr"])
confere("importado: ciclo de import nao da veredito falso e roda", r["rc"] == 0 and r["saida"].strip() == "2 1")
os.writeFile(IMP + "/m.pr", "import util\nc = util.Conta(5)\npost(c.extrato() + util.soma(1))\n")
r = roda([POOL, "imp5/m.pr"])
confere("importado: chamada certa passa e roda", r["rc"] == 0 and r["saida"].strip() == "7")

# ── extensão de antes na linha de comando ───────────────────────────────────
#
# `.ps`, `.psl` e `.p` foram as extensões da linguagem. Hoje o arquivo é `.pr`,
# e o motor NÃO lê os nomes velhos. O que importa aqui é a FRASE: o arquivo
# existe, é Jinga válido, e mesmo assim não roda — sem dizer o conserto,
# isso é um "nao consegui abrir" que não explica nada. A recusa vale nos quatro
# caminhos que leem arquivo (rodar, `--check`, `-o` e `--debug`), e vale só
# para as três de antes: qualquer outro nome continua rodando.
for each velha in [".ps", ".psl", ".p"]
{
    alvo = "velho" + velha
    os.writeFile(PASTA + "/" + alvo, "post(\"nao devia rodar\")\n")
    r = roda([POOL, alvo])
    confere("rodar " + velha + " e recusado dizendo o conserto",
            r["rc"] != 0 and ".pr" in r["saida"] and "migra_pr" in r["saida"]
            and not "nao devia rodar" in r["saida"])
    r = roda([POOL, "--check", alvo])
    confere("--check em " + velha + " tambem recusa", r["rc"] != 0 and ".pr" in r["saida"])
    r = roda([POOL, alvo, "-o", "naodeve2"])
    confere("`-o` sobre " + velha + " tambem recusa",
            r["rc"] != 0 and not os.exists(PASTA + "/naodeve2" + EXE))
}

os.writeFile(PASTA + "/outra.txt", "post(\"extensao estranha roda\")\n")
r = roda([POOL, "outra.txt"])
confere("extensao QUALQUER continua rodando — a recusa e so das tres de antes",
        r["rc"] == 0 and "extensao estranha roda" in r["saida"])

r = roda([POOL, "nao_existe.pr"])
confere("arquivo ausente com a extensao certa diz que nao abriu, sem falar de migracao",
        r["rc"] != 0 and "nao consegui abrir" in r["saida"]
        and not "migra_pr" in r["saida"])

# `import './x.ps'` acha o arquivo velho ao lado e, em vez de "No module
# named", diz que a extensão mudou — o erro tem que falar do ARQUIVO.
os.writeFile(PASTA + "/vizinho.ps", "z = 1\n")
os.writeFile(PASTA + "/importa.pr", "import './vizinho.ps'\n")
r = roda([POOL, "importa.pr"])
confere("import de caminho com extensao velha ensina a nova",
        r["rc"] != 0 and "ImportError" in r["saida"] and "migra_pr" in r["saida"])

# ── o migrador, numa pasta de mentira ───────────────────────────────────────
#
# Sem `--aplica` ele não pode encostar em nada: é essa promessa que faz alguém
# aceitar rodá-lo no projeto inteiro.
MIG = PASTA + "/obra_migra"
os.mkdir(MIG + "/sub", exist_ok=True)
os.writeFile(MIG + "/util.ps", "funct f() {\n    return 7\n}\n")
os.writeFile(MIG + "/sub/usa.psl", "import '../util.ps'\npost(util.f())\n")
os.writeFile(MIG + "/leiame.md", "roda com `pool sub/usa.psl`\n")
MIGRADOR = os.cwd() + "/scripts/migra_pr.pr"

r = roda([POOL, MIGRADOR, MIG])
confere("migrador sem --aplica nao renomeia nada",
        os.exists(MIG + "/util.ps") and not os.exists(MIG + "/util.pr")
        and "nada foi mudado" in r["saida"])

r = roda([POOL, MIGRADOR, MIG, "--aplica"])
confere("migrador renomeia as tres extensoes",
        os.exists(MIG + "/util.pr") and os.exists(MIG + "/sub/usa.pr")
        and not os.exists(MIG + "/util.ps"))
confere("migrador arruma a referencia dentro do arquivo",
        "'../util.pr'" in os.readFile(MIG + "/sub/usa.pr"))
confere("migrador arruma a referencia na doc tambem",
        "sub/usa.pr" in os.readFile(MIG + "/leiame.md"))
r = roda([POOL, "sub/usa.pr"], pasta=MIG)
confere("o programa migrado roda", r["rc"] == 0 and "7" in r["saida"])

# ── migra_classe.pr: `class X() {` -> `class X {`, `base(x)` -> `base().__init__(x)`
# (2026-09-25). Numa pasta de mentira com .pr, .md e .c (string C com `\n`
# colado na palavra, a armadilha do limite de palavra); mensagens de erro do
# motor com `base()` ficam como estão.
MIGC = PASTA + "/obra_classe"
if os.exists(MIGC)
{
    os.rmdir(MIGC, force=True)
}
os.mkdir(MIGC, exist_ok=True)
MIGRADOR_C = os.cwd() + "/scripts/migra_classe.pr"
os.writeFile(MIGC + "/velho.pr",
    "Entity A() {\n    funct __init__(self, x) { self.x = x }\n}\n"
    + "class B(A) {\n    funct __init__(self, x) {\n        base(x)\n    }\n}\n"
    + "public Class C(){\n    funct v(self) { return 3 }\n}\n"
    + "post(B(1).x, C().v())\n")
os.writeFile(MIGC + "/leiame.md", "Use `Entity Conta() {` e chame `base(args)`.\n")
os.writeFile(MIGC + "/casos.c",
    "{ \"x\", \"Entity A() {\\n}\\nEntity B(A) {\\n    funct __init__(self) { base() }\\n}\\n\",\n"
    + "  \"\", \"TypeError: base(): a Entity pai 'A' nao tem __init__\", 1 },\n")
r = roda([POOL, MIGRADOR_C, MIGC])
confere("migra_classe sem --aplica so relata (3 arquivos, 5 cabecalhos, 3 base)",
        r["rc"] == 0 and "nada mudou" in r["saida"] and "3 arquivo(s)" in r["saida"]
        and os.readFile(MIGC + "/velho.pr").find("Entity A() {") >= 0)
r = roda([POOL, MIGRADOR_C, MIGC, "--aplica", "--confere"])
velho_novo = os.readFile(MIGC + "/velho.pr")
confere("migra_classe tira o () vazio e mantem a heranca",
        velho_novo.find("Entity A {") >= 0 and velho_novo.find("class B(A) {") >= 0
        and velho_novo.find("public Class C {") >= 0)
confere("migra_classe converte base(x) em base().__init__(x)",
        velho_novo.find("base().__init__(x)") >= 0)
confere("migra_classe entende o \\n colado na palavra dentro de string C",
        os.readFile(MIGC + "/casos.c").find("\\nEntity B(A) {") >= 0
        and os.readFile(MIGC + "/casos.c").find("Entity A {\\n}") >= 0)
confere("migra_classe deixa a mensagem de erro `base():` como esta",
        os.readFile(MIGC + "/casos.c").find("TypeError: base(): a Entity pai") >= 0
        and os.readFile(MIGC + "/casos.c").find("{ base().__init__() }") >= 0)
confere("migra_classe mexe na doc tambem",
        os.readFile(MIGC + "/leiame.md").find("`Entity Conta {`") >= 0)
confere("--confere nao reprovou nada", not "REPROVOU" in r["saida"])
r = roda([POOL, "velho.pr"], pasta=MIGC)
confere("o programa migrado roda com a sintaxe nova", r["rc"] == 0 and "1 3" in r["saida"])

# ── `private` em qualquer declaração do topo: o que NÃO sai pelo import ──────
#
# Dois arquivos: a lib declara private de cada tipo (funct, variável, tipada,
# desempacotamento, model, enum, class) e uma funct que usa tudo por dentro.
# Quem importa: por dentro funciona; `lib.x`, `from lib import x` e o `*`
# recusam. A recusa sai ANTES de rodar (`--check` e o `jinga` barrado pela
# tipagem, com o quadro da declaração) e RODANDO (o alias `m = lib` o
# checador não segue: aí é a VM, com a nota "'x' e private: declarada em").
PRIV = PASTA + "/priv"
os.mkdir(PRIV, exist_ok=True)
os.writeFile(PRIV + "/lib.pr",
    "private funct f() {\n    return 1\n}\n"
    + "private x = 5\n"
    + "private int n = 7\n"
    + "private a, b = 3, 4\n"
    + "private model M() {\n    x: int\n}\n"
    + "private enum E {\n    A = 1\n}\n"
    + "private class K {\n    funct m(self) {\n        return 2\n    }\n}\n"
    + "pub = 9\n"
    + "funct usa() {\n    return [f(), x, n, a, b, E.A, K().m(), {\"x\": 1} == M]\n}\n")
os.writeFile(PRIV + "/dentro.pr", "import lib\npost(lib.usa())\npost(lib.pub)\n")
r = roda([POOL, "--check", "lib.pr"], pasta=PRIV)
confere("a lib com private em toda declaracao passa no --check", "\"ok\":true" in r["saida"])
r = roda([POOL, "dentro.pr"], pasta=PRIV)
confere("por dentro da lib todo private e alcancado, e o publico sai",
        r["rc"] == 0 and "[1, 5, 7, 3, 4, 1, 2, True]" in r["saida"] and "9" in r["saida"])

# cada nome private, pelos dois caminhos, antes de rodar
for each caso in [["f", 1, "post(lib.f())"], ["x", 4, "post(lib.x)"], ["n", 5, "post(lib.n)"],
                  ["b", 6, "post(lib.b)"], ["M", 7, "post(lib.M)"], ["E", 10, "post(lib.E.A)"],
                  ["K", 13, "post(lib.K())"]]
{
    nome = caso[0]
    linha = caso[1]
    os.writeFile(PRIV + "/usa_" + nome + ".pr", "import lib\n" + caso[2] + "\n")
    r = roda([POOL, "--check", "usa_" + nome + ".pr"], pasta=PRIV)
    confere("--check acusa lib." + nome + " private antes de rodar, com a declaracao",
            "\"ok\":false" in r["saida"]
            and "(existe, mas é private: declarada em lib.pr, linha " + str(linha) + ")" in r["saida"]
            and "\"linha_arquivo\":" + str(linha) in r["saida"] and "/lib.pr\"" in r["saida"])
    r = roda([POOL, "usa_" + nome + ".pr"], pasta=PRIV)
    confere("jinga barra lib." + nome + " pela tipagem e mostra os dois quadros",
            r["rc"] == 2 and "em usa_" + nome + ".pr, linha 2" in r["saida"]
            and "em lib.pr, linha " + str(linha) in r["saida"])
    os.writeFile(PRIV + "/de_" + nome + ".pr", "from lib import " + nome + "\n")
    r = roda([POOL, "--check", "de_" + nome + ".pr"], pasta=PRIV)
    confere("--check acusa `from lib import " + nome + "` private",
            "\"ok\":false" in r["saida"] and "(existe, mas é private: declarada em lib.pr, linha " + str(linha) + ")" in r["saida"])
}
# o cursor do quadro da declaração vai em cima do NOME, não da palavra-chave
r = roda([POOL, "usa_f.pr"], pasta=PRIV)
confere("o quadro da declaracao poe o cursor no nome",
        "| private funct f() {\n  |               ^^^" in r["saida"])

# o `*` deixa os private de fora: `pub` vem, `x` dá NameError
os.writeFile(PRIV + "/estrela.pr", "from lib import *\npost(pub)\npost(x)\n")
r = roda([POOL, "--check", "estrela.pr"], pasta=PRIV)
confere("o `*` nao traz variavel private (NameError antes de rodar)",
        "\"ok\":false" in r["saida"] and "name 'x' is not defined" in r["saida"])

# RODANDO, pelo alias que o checador não segue: traceback com a cadeia de
# chamadores E a nota da declaração, com a linha do fonte e o cursor no nome
os.writeFile(PRIV + "/alias.pr",
    "import lib\nm = lib\nfunct h() {\n    return m.f()\n}\nfunct g() {\n    return h()\n}\npost(g())\n")
r = roda([POOL, "alias.pr"], pasta=PRIV)
confere("rodando: a recusa do private traz o traceback inteiro e a nota da declaracao",
        r["rc"] == 1
        and "AttributeError: module 'lib' has no attribute 'f' (existe, mas é private)" in r["saida"]
        and "em alias.pr, linha 4" in r["saida"] and "em alias.pr, linha 7" in r["saida"]
        and "'f' e private: declarada em lib.pr, linha 1\n  | private funct f() {\n  |               ^^^" in r["saida"])
os.writeFile(PRIV + "/alias_var.pr", "import lib\nm = lib\npost(m.n)\n")
r = roda([POOL, "alias_var.pr"], pasta=PRIV)
confere("rodando: variavel tipada private tambem leva a nota",
        "'n' e private: declarada em lib.pr, linha 5\n  | private int n = 7\n  |             ^^^" in r["saida"])
# erro pego: a nota morre com ele — o erro seguinte, sem relação, não a herda
os.writeFile(PRIV + "/pego.pr",
    "import lib\nm = lib\ntry {\n    post(m.x)\n} catch (e) {\n    post(\"pego:\", e)\n}\npost(m.nao)\n")
r = roda([POOL, "pego.pr"], pasta=PRIV)
confere("a nota da declaracao nao vaza pro erro seguinte depois de um catch",
        "pego: module 'lib' has no attribute 'x' (existe, mas é private)" in r["saida"]
        and "has no attribute 'nao'" in r["saida"] and not "declarada em" in r["saida"])

# ── private e static nas classes (Plano 6, lote 4) ──────────────────────────
# O que pede arquivo de verdade: a posição no JSON do --check, a classe de
# outro módulo e os programas gerados (70 pais, 70 métodos decorados). Os
# outros vetores estão em casos_linguagem.c.
str CLS = PASTA + "/classes"
os.mkdir(CLS, exist_ok=True)

# a escrita aponta o `.` do membro, o mesmo lugar da leitura
os.writeFile(CLS + "/saldo.pr", "class Conta {\n    private int saldo = 0\n}\nConta c = Conta()\nc.saldo = 999\n")
r = roda([POOL, "--check", "saldo.pr"], pasta=CLS)
confere("acesso negado na escrita aponta o membro (linha 5, coluna 2)",
        "\"ok\":false" in r["saida"] and "\"linha\":5,\"coluna\":2" in r["saida"]
        and "acesso negado: 'saldo' e private de Conta" in r["saida"])

# a classe de outro módulo: pelo nome trazido e pelo módulo
os.writeFile(CLS + "/banco.pr",
    "public class Conta {\n    private static int segredo = 99\n    static int total = 0\n}\n")
os.writeFile(CLS + "/usa_from.pr", "from banco import Conta\npost(Conta.segredo)\n")
os.writeFile(CLS + "/usa_mod.pr", "import banco\npost(banco.Conta.segredo)\n")
os.writeFile(CLS + "/grava_mod.pr", "import banco\nbanco.Conta.total = \"texto\"\n")
r = roda([POOL, "--check", "usa_from.pr"], pasta=CLS)
confere("private static de classe importada (from), antes de rodar",
        "\"ok\":false" in r["saida"] and "acesso negado: 'segredo' e private de Conta" in r["saida"])
r = roda([POOL, "--check", "usa_mod.pr"], pasta=CLS)
confere("private static de classe importada (pelo modulo), antes de rodar",
        "\"ok\":false" in r["saida"] and "acesso negado: 'segredo' e private de Conta" in r["saida"])
r = roda([POOL, "--check", "grava_mod.pr"], pasta=CLS)
confere("static tipado de classe importada: a escrita pelo modulo confere o tipo",
        "\"ok\":false" in r["saida"] and "campo total de Conta esperava int, recebeu str" in r["saida"])

# sem teto de pais: o private do 70º pai continua barrado, antes de rodar e
# rodando (pelo `Object`, que o checador não segue: é a regra da VM)
list cls_linhas = []
for each i in range(1, 70)
{
    addEnd(cls_linhas, "class P" + str(i) + " {\n    int funct m" + str(i) + "(self) {\n        return "
                       + str(i) + "\n    }\n}")
}
addEnd(cls_linhas, "class P70 {\n    private int segredo = 7\n}")
list cls_pais = []
for each i in range(1, 71)
{
    addEnd(cls_pais, "P" + str(i))
}
addEnd(cls_linhas, "class F(" + ", ".join(cls_pais) + ") {\n}")
os.writeFile(CLS + "/setenta.pr", "\n".join(cls_linhas) + "\nF f = F()\npost(f.segredo)\n")
os.writeFile(CLS + "/setenta_vm.pr", "\n".join(cls_linhas) + "\nObject o = F()\npost(o.segredo)\n")
r = roda([POOL, "setenta.pr"], pasta=CLS)
confere("70 pais: o private do ultimo e barrado antes de rodar",
        r["rc"] == 2 and "acesso negado: 'segredo' e private de P70" in r["saida"])
r = roda([POOL, "setenta_vm.pr"], pasta=CLS)
confere("70 pais, rodando: a VM barra sem teto de pais",
        r["rc"] == 1 and "acesso negado: 'segredo' e private de P70" in r["saida"])

# decorador em 70 métodos da mesma classe: nenhum par é largado (eram 64 fixos)
list cls_dec = ["class Reg {\n    list v = []\n    Reg funct rota(self) {\n        return self\n    }\n"
                + "    funct register(self, h) {\n        addEnd(self.v, 1)\n        return h\n    }\n}",
                "class App {\n    static Reg r = Reg()"]
for each i in range(70)
{
    addEnd(cls_dec, "    @r.rota()\n    static int funct h" + str(i) + "() {\n        return 1\n    }")
}
addEnd(cls_dec, "}\npost(len(App.r.v))")
os.writeFile(CLS + "/decor70.pr", "\n".join(cls_dec) + "\n")
r = roda([POOL, "decor70.pr"], pasta=CLS)
confere("70 metodos decorados na mesma classe: os 70 registram",
        r["rc"] == 0 and r["saida"] == "70\n")

# ── construtor, campos, enum e redeclaração (Plano 6, lote 5) ───────────────
# A posição no JSON do --check: o erro que é do NOME (redeclarado, repetido,
# sobrescrita) sublinha o nome inteiro, não a declaração; a leitura do campo
# sem valor aponta o membro. Os outros vetores estão em casos_linguagem.c.
# a 2ª classe usa um membro que a 1ª não tem: conferido contra a 1ª, saíam
# dois erros em cascata além da causa
os.writeFile(CLS + "/redecl.pr", "class C {\n    int x = 1\n}\nC a = C()\npost(a.x)\nclass C {\n    str y = \"a\"\n"
    + "    str funct oi(self) {\n        return \"oi \" + self.y\n    }\n}\nC b = C()\npost(b.oi())\n")
r = roda([POOL, "--check", "redecl.pr"], pasta=CLS)
confere("class redeclarada: um erro so, no nome da segunda (linha 6, colunas 7 a 8)",
        "\"linha\":6,\"coluna\":7,\"l2\":6,\"c2\":8" in r["saida"] and r["saida"].count("ja foi declarado") == 2
        and r["saida"].count("\"tipo\":") == 2)
os.writeFile(CLS + "/metodo2.pr",
    "class C {\n    funct oi(self) {\n        post(\"1\")\n    }\n    funct oi(self) {\n        post(\"2\")\n    }\n}\n")
r = roda([POOL, "--check", "metodo2.pr"], pasta=CLS)
confere("metodo repetido: o nome do segundo (linha 5, colunas 11 a 13)",
        "membro 'oi' repetido na classe C" in r["saida"] and "\"linha\":5,\"coluna\":11,\"l2\":5,\"c2\":13" in r["saida"])
os.writeFile(CLS + "/enum2.pr", "enum E {\n    A,\n    B,\n    A\n}\n")
r = roda([POOL, "--check", "enum2.pr"], pasta=CLS)
confere("membro repetido no enum: o nome do segundo (linha 4, colunas 5 a 6)",
        "membro 'A' repetido no enum E" in r["saida"] and "\"linha\":4,\"coluna\":5,\"l2\":4,\"c2\":6" in r["saida"])
os.writeFile(CLS + "/model2.pr", "model M() {\n    nome: str\n    nome: int\n}\n")
r = roda([POOL, "--check", "model2.pr"], pasta=CLS)
confere("campo repetido no model: o nome do segundo (linha 3, colunas 5 a 9)",
        "campo 'nome' repetido no model M" in r["saida"] and "\"linha\":3,\"coluna\":5,\"l2\":3,\"c2\":9" in r["saida"])
os.writeFile(CLS + "/sobre.pr",
    "class Pai {\n    int funct m(self) {\n        return 1\n    }\n}\nclass Filha(Pai) {\n    str funct m(self) {\n"
    + "        return \"t\"\n    }\n}\n")
r = roda([POOL, "--check", "sobre.pr"], pasta=CLS)
confere("sobrescrita que troca o retorno: o nome do metodo da filha (linha 7, colunas 15 a 16)",
        "m() de Filha devolve str e sobrescreve m() de Pai, que devolve int" in r["saida"]
        and "\"linha\":7,\"coluna\":15,\"l2\":7,\"c2\":16" in r["saida"])
str CLS_SEM = "class Pai {\n    int x\n}\nclass Filha(Pai) {\n    str y = \"oi\"\n}\nFilha f = Filha()\npost(f.x)\n"
os.writeFile(CLS + "/semvalor.pr", CLS_SEM)
r = roda([POOL, "--check", "semvalor.pr"], pasta=CLS)
confere("campo do pai sem valor lido: antes de rodar, no membro (linha 8, colunas 7 a 9)",
        "o campo x de Pai foi declarado sem valor e nada o gravou" in r["saida"]
        and "\"linha\":8,\"coluna\":7,\"l2\":8,\"c2\":9" in r["saida"])
# um módulo `.pr` importado pode gravar o campo: o checador não acusa, e a VM
# dá a mesma frase rodando
os.writeFile(CLS + "/nada.pr", "int n = 1\n")
os.writeFile(CLS + "/semvalor_mod.pr", "import nada\n" + CLS_SEM)
r = roda([POOL, "--check", "semvalor_mod.pr"], pasta=CLS)
confere("campo sem valor com modulo .pr importado: o --check nao acusa", "{\"ok\":true}" in r["saida"])
r = roda([POOL, "semvalor_mod.pr"], pasta=CLS)
confere("campo sem valor com modulo .pr importado: rodando, a frase com a causa",
        r["rc"] == 1 and "'Filha' object has no attribute 'x': o campo x de Pai foi declarado sem valor" in r["saida"])

# ── relatório ───────────────────────────────────────────────────────────────
post("")
post("cli/jpkg:", ok, "checagens passaram")
if pulou.len() > 0
{
    post("PULARAM (falta o recurso neste sistema):", pulou.len())
    for each x in pulou
    {
        post("  " + x)
    }
}
os.rmdir(PASTA, force=True)
if falhas.len() > 0
{
    post("FALHARAM:", falhas.len())
    for each f in falhas
    {
        post("  " + f)
    }
    sys.exit(1)
}

confere("build segue depois do sys.exit e sai 1 com erro",
        r["rc"] == 1 and "=== c.pr ===" in r["saida"] and "2 arquivo(s) OK, 1 com erro(s)." in r["saida"])
os.mkdir(PASTA + "/build9ok", exist_ok=True)
os.writeFile(PASTA + "/build9ok/a.pr", "post(\"a ok\")\n")
os.writeFile(PASTA + "/build9ok/b.pr", "import sys\npost(\"b\")\nsys.exit(0)\n")
r = roda([POOL, "build"], pasta=PASTA + "/build9ok")
confere("build sem erro sai 0, com o sys.exit(0) contando como ok",
        r["rc"] == 0 and "2 arquivo(s) OK, 0 com erro(s)." in r["saida"])

# Plano 6, lote 10: linha de comando.

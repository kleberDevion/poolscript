public Class book {
    public static funct isBook(*args){
       for each i in args {
          if (i == 'cu'){
             post(f'De seu {i} pro kid kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk')
             continue
          }
          break
       }
       return;
    }
}
post(book.isBook('cu', 'cu', 'cu'))
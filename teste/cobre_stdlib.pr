# Cobre a STDLIB DA LINGUAGEM que nenhum teste chamava uma vez sequer.
#
# POR QUE ELE EXISTE. O `teste/bench_cobertura.pr` lista as funções em ZERO
# execução, e a lista de `jinga_vm.c` tinha 115 — não ramos de erro
# esquecidos, mas funções inteiras da biblioteca padrão:
#
#     sys.platform  sys.RelativePath  sys.stdin.read/readline
#     sys.stdout.flush  sys.stderr.flush/writeln
#     os.pathFile  os.pathFolder  os.rename  os.cwd  os.environ  os.warn
#     os.ipmach
#     date.time  date.now
#     load()  id()  tup()  dict()      .replace() com lista
#     63 constantes de socket, uma função cada
#
# Nenhuma delas é obscura: `os.cwd()` e `sys.platform()` são das primeiras
# coisas que alguém chama. Elas estavam DOCUMENTADAS e NÃO TESTADAS, que é a
# combinação que faz uma linguagem quebrar na mão de quem confia na doc.
#
# CADA CHECAGEM AFIRMA UM VALOR. Chamar a função e ignorar o retorno cobriria a
# linha e não provaria nada — seria comprar percentual, que é o oposto do que o
# benchmark serve pra decidir.
#
#     ./pool teste/cobre_stdlib.pr
import os
import sys
import date
import sockets

# O sistema decide o shell do `os.cmd`, o valor de algumas constantes de
# socket e quais delas existem.
SO = sys.platform()
WINDOWS = SO == "windows"

# A pasta de trabalho fica DENTRO da pasta corrente, e não em /tmp: no Windows
# o motor é nativo, e "/tmp/x" é "<disco>:\tmp\x", na raiz do disco, não o /tmp
# do MSYS2. O caminho é o INTEIRO, como era o de /tmp: os filhos rodam com
# outra pasta corrente, e o import por caminho absoluto é um dos casos. A `\`
# que o `os.cwd()` do Windows devolve vira `/`: o caminho entra no fonte dos
# programas gerados, e ali `\a`, `\t` e cia. seriam escape.
PASTA = os.cwd().replace("\\", "/") + "/ps_cobre_stdlib"

falhas = []
puladas = []
ok = 0


funct confere(nome, cond)
{
    global ok
    if cond
    {
        ok = ok + 1
    }
    else
    {
        addEnd(falhas, nome)
    }
}

# Checagem que depende do que o sistema NÃO tem não roda, e o relatório diz
# qual ficou de fora e por quê: pular calado contaria como coberto o que não
# foi.
funct nao_rodou(nome, motivo)
{
    addEnd(puladas, nome + " — " + motivo)
}

# O `os.cmd` roda no shell do sistema: /bin/sh no Linux e no macOS, cmd.exe no
# Windows. Os dois entendem aspas DUPLAS, `<`, `>` e `2>&1`, e as linhas daqui
# só usam isso: aspas simples e `VAR=x cmd` o cmd.exe não tem, e o `cd` dele
# não é o do sh.
EXE = "\"" + sys.executable + "\""

# Roda o motor num processo FILHO com a pasta corrente em `pasta`, a saída e o
# erro juntos em `saida` (relativo a `pasta`, ou inteiro). O filho herda a
# pasta corrente de quem o dispara, então ela muda aqui e volta depois: era
# `cd <pasta> && ...` dentro do sh. `home` não vazio é o JINGA_HOME só do
# filho: `VAR="x" cmd` no sh, `set "VAR=x" && cmd` no cmd.exe.
funct roda_em(pasta, args, saida, home) {
    linha = EXE + " " + args + " > \"" + saida + "\" 2>&1"
    if home != "" {
        if WINDOWS {
            linha = "set \"JINGA_HOME=" + home + "\" && " + linha
        }
        else {
            linha = "JINGA_HOME=\"" + home + "\" " + linha
        }
    }
    volta = os.cwd()
    os.chdir(pasta)
    os.cmd(linha)
    os.chdir(volta)
}


# Sobra de uma rodada que caiu no meio sai pelo próprio motor: o `rm -rf` de
# antes não é programa do Windows.
if os.exists(PASTA) {
    os.rmdir(PASTA, force=True)
}
os.mkdir(PASTA, exist_ok=True)

# ── sys ─────────────────────────────────────────────────────────────────────
confere("sys.platform() diz o sistema", SO == "linux" or SO == "darwin" or SO == "windows")

# `sys.RelativePath` BUSCA o arquivo recursivamente a partir do cwd e devolve
# onde achou; sem achar, devolve Null. Então o teste cria o alvo primeiro —
# pedir um nome inexistente testaria só o caminho de falha.
os.mkdir(PASTA + "/fundo", exist_ok=True)
os.writeFile(PASTA + "/fundo/alvo_rp.txt", "achou")
volta = os.cwd()
os.chdir(PASTA)
rp = sys.RelativePath("alvo_rp.txt")
os.chdir(volta)
confere("sys.RelativePath acha o arquivo em subpasta",
        rp != Null and rp.endswith("alvo_rp.txt"))
confere("sys.RelativePath de nome inexistente devolve Null",
        sys.RelativePath("nao_existe_mesmo_987.txt") == Null)

confere("sys.executable aponta um arquivo que existe", os.isfile(sys.executable))
# `sys.argv[0]` é o NOME DO SCRIPT e os argumentos vêm a partir de `[1]` — a
# convenção de C/Python. Rodado sem argumento (é o caso aqui), tem só o [0].
confere("sys.argv sem argumento tem só o nome do script", len(sys.argv) == 1)
confere("sys.argv[0] é o script rodando", sys.argv[0].endswith("cobre_stdlib.pr"))

# stdout/stderr: o `flush` não devolve nada, então o que se afirma é que ele
# ESCOA — escrevendo sem newline e conferindo que o texto saiu antes do fim.
sys.stdout.write("")
sys.stdout.flush()
sys.stderr.write("")
sys.stderr.writeln("")
sys.stderr.flush()
confere("sys.stdout/stderr write+writeln+flush não levantam", True)

# ── sys.stdin ───────────────────────────────────────────────────────────────
#
# Roda um script FILHO com a entrada redirecionada: no processo do teste o
# stdin é o terminal, e ler dele penduraria a suíte pra sempre.
os.writeFile(PASTA + "/le_stdin.pr",
             "import sys\n"
             + "l = sys.stdin.readline()\n"
             + "r = sys.stdin.read(4)\n"
             + "post(l.strip() + \"|\" + r)\n")
os.writeFile(PASTA + "/entrada.txt", "primeira\nabcdefgh")
os.cmd(EXE + " \"" + PASTA + "/le_stdin.pr\" < \"" + PASTA + "/entrada.txt\" > \""
       + PASTA + "/stdin.out\" 2>&1")
confere("sys.stdin.readline() e read(n) leem a entrada",
        os.readFile(PASTA + "/stdin.out").strip() == "primeira|abcd")

# ── import relativo `..` e `__name__` em modulo importado ───────────────────
#
# `pool sub/filho.pr` (caminho RELATIVO, sem `./`) resolvia o `..` a partir do
# cwd, nao da pasta do arquivo — `pool ./sub/filho.pr` funcionava e o outro
# nao. E `__name__` nao existia em modulo importado (`Jinker(__name__)` num
# modulo estourava com NameError). Os dois medidos pela auditoria doc x motor.
os.mkdir(PASTA + "/rel/sub", exist_ok=True)
os.mkdir(PASTA + "/rel/pacote", exist_ok=True)
os.writeFile(PASTA + "/rel/pacote/modulo.pr", "z = 99\n")
os.writeFile(PASTA + "/rel/sub/filho.pr", "from ..pacote.modulo import z\npost(\"z:\", z)\n")
os.writeFile(PASTA + "/rel/nomeado.pr", "post(\"nome:\", __name__)\n")
os.writeFile(PASTA + "/rel/principal.pr", "import nomeado\n")
roda_em(PASTA + "/rel", "sub/filho.pr", "saida_rel.out", "")
confere("import relativo `..` com o script dado como caminho relativo (sub/filho.pr)",
        os.readFile(PASTA + "/rel/saida_rel.out").strip() == "z: 99")
roda_em(PASTA + "/rel", "principal.pr", "saida_nome.out", "")
confere("__name__ num modulo importado e o nome do modulo",
        os.readFile(PASTA + "/rel/saida_nome.out").strip() == "nome: nomeado")

# `import vizinho` (sem ponto) dentro de um modulo de subpasta acha o arquivo
# ao lado dele — so a raiz do projeto era olhada, e `import smtp` dentro de
# `acesso/controller.pr` dava "No module named 'smtp'" (o erro da tela dele).
os.mkdir(PASTA + "/rel/acesso", exist_ok=True)
os.writeFile(PASTA + "/rel/acesso/smtp.pr", "funct manda() {\n    return \"mandou\"\n}\n")
os.writeFile(PASTA + "/rel/acesso/controller.pr", "import smtp\nfunct entra() {\n    return smtp.manda()\n}\n")
os.writeFile(PASTA + "/rel/rotas.pr", "from acesso.controller import entra\npost(entra())\n")
roda_em(PASTA + "/rel", "rotas.pr", "saida_viz.out", "")
confere("`import vizinho` dentro de modulo de subpasta acha o arquivo ao lado",
        os.readFile(PASTA + "/rel/saida_viz.out").strip() == "mandou")

# ── import por caminho entre aspas (`import '../x.pr'`) ──────────────────────
#
# A string e o especificador: com `/` ou extensao e caminho relativo ao
# arquivo que importa; sem isso e nome de modulo do motor ou lib instalada.
# Aqui o que precisa de arquivo de verdade: relativo, pai, sem extensao, `as`,
# PUSH/GET, absoluto, lib (JINGA_HOME), modulo do motor entre aspas e
# `__name__` dentro do modulo importado por caminho.
os.mkdir(PASTA + "/asp/sub", exist_ok=True)
os.mkdir(PASTA + "/asp/pacote", exist_ok=True)
os.mkdir(PASTA + "/asp/home/libs", exist_ok=True)
os.writeFile(PASTA + "/asp/pacote/modulo.pr", "z = 99\nfunct f() {\n    return \"f de \" + __name__\n}\n")
os.writeFile(PASTA + "/asp/sub/irmao.pr", "w = 7\n")
os.writeFile(PASTA + "/asp/home/libs/minhalib.pr", "LIB = \"lib ok\"\n")
os.writeFile(PASTA + "/asp/sub/meu-mod.pr", "q = 1\n")
os.writeFile(PASTA + "/asp/sub/filho.pr",
    "import '../pacote/modulo.pr'\n"
    + "from './irmao.pr' import w\n"
    + "from '../pacote/modulo' import z as zz\n"
    + "import 'json'\n"
    + "from 'json' import stringify as st\n"
    + "import 'minhalib'\n"
    + "PUSH '../pacote/modulo.pr' as pm\n"
    + "PUSH './irmao.pr' GET w as w2\n"
    + "import '" + PASTA + "/asp/pacote/modulo.pr' as abs\n"
    + "import './meu-mod.pr' as mm\n"
    + "post(modulo.z, w, zz, json.stringify([1]), st([2]), minhalib.LIB, pm.z, w2, abs.f(), mm.q)\n")
ESPERADO_ASP = "99 7 99 [1] [2] lib ok 99 7 f de modulo 1"
roda_em(PASTA + "/asp", "sub/filho.pr", "saida_asp.out", PASTA + "/asp/home")
confere("import por caminho: relativo, pai, sem extensao, `as`, PUSH/GET, absoluto, lib e modulo do motor entre aspas",
        os.readFile(PASTA + "/asp/saida_asp.out").strip() == ESPERADO_ASP)
roda_em(PASTA + "/asp/sub", "filho.pr", "../saida_asp2.out", PASTA + "/asp/home")
confere("import por caminho resolve pela pasta do arquivo, nao pelo cwd",
        os.readFile(PASTA + "/asp/saida_asp2.out").strip() == ESPERADO_ASP)

# ── nome qualificado da lib instalada (`import jinga.libs.x`) ────────────────
#
# `jinga.libs.` e o nome logico da pasta de libs: vale onde as libs
# estiverem (aqui, o JINGA_HOME de mentira), liga o ULTIMO nome, e cai no
# mesmo arquivo do `import x` — entao o corpo da lib roda uma vez so, mesmo com
# as duas formas no programa. Uma pasta `jinga/libs/` do projeto continua
# sendo achada quando nao ha lib instalada com aquele nome. `poolscript.libs.`
# e o nome de antes do rename da linguagem e continua valendo.
os.writeFile(PASTA + "/asp/home/libs/contalib.pr", "post(\"corpo\")\nC = 3\n")
os.mkdir(PASTA + "/asp/jinga/libs", exist_ok=True)
os.writeFile(PASTA + "/asp/jinga/libs/doprojeto.pr", "P = 5\n")

funct roda_qual(nome, fonte) {
    os.writeFile(PASTA + "/asp/" + nome, fonte)
    roda_em(PASTA + "/asp", nome, nome + ".out", PASTA + "/asp/home")
    return os.readFile(PASTA + "/asp/" + nome + ".out").strip()
}

confere("import jinga.libs.x liga o ultimo nome",
        roda_qual("q1.pr", "import jinga.libs.minhalib\npost(minhalib.LIB)\n") == "lib ok")
confere("import jinga.libs.x as nome",
        roda_qual("q2.pr", "import jinga.libs.minhalib as m\npost(m.LIB)\n") == "lib ok")
confere("from jinga.libs.x import nome",
        roda_qual("q3.pr", "from jinga.libs.minhalib import LIB\npost(LIB)\n") == "lib ok")
confere("from jinga.libs.x import *",
        roda_qual("q4.pr", "from jinga.libs.minhalib import *\npost(LIB)\n") == "lib ok")
confere("PUSH jinga.libs.x GET nome",
        roda_qual("q5.pr", "PUSH jinga.libs.minhalib GET LIB\npost(LIB)\n") == "lib ok")
confere("forma curta e qualificada no mesmo programa: o corpo da lib roda uma vez",
        roda_qual("q6.pr", "import contalib\nimport jinga.libs.contalib\npost(contalib.C)\n") == "corpo\n3")
confere("import jinga.libs.naoexiste e ImportError",
        roda_qual("q7.pr", "import jinga.libs.naoexiste\n")
            .startswith("ImportError: No module named 'jinga.libs.naoexiste'"))
confere("pasta jinga/libs do PROJETO continua sendo achada",
        roda_qual("q8.pr", "import jinga.libs.doprojeto\npost(doprojeto.P)\n") == "5")
confere("import poolscript.libs.x (o nome de antes do rename) continua importando a mesma lib",
        roda_qual("q9.pr", "import poolscript.libs.minhalib\nimport jinga.libs.minhalib as j\npost(minhalib.LIB, j.LIB)\n")
            == "lib ok lib ok")

# ── import * com arquivo `.pr` de verdade ────────────────────────────────────
#
# `from m import *`, `import m *` e `PUSH m GET *` ligam o que o arquivo
# exporta: o que ele liga no nivel do arquivo (funct, Entity, variavel, os
# imports dele, `global x` gravado de dentro de funct), sem `private`, sem o
# que so existe dentro de bloco e sem o builtin que ele so chamou. A mesma
# regra passou a valer pro `from m import x` e pro `m.x`. O `*` e resolvido na
# compilacao; o que fica pra runtime e o valor (em ciclo, o nome ainda sem
# valor e pulado). Os casos de um arquivo so estao em casos_linguagem.c.
EST = PASTA + "/estrela"
os.mkdir(EST + "/sub", exist_ok=True)
os.writeFile(EST + "/m.pr",
    "import json\n"
    + "funct f() {\n    return \"f\"\n}\n"
    + "Entity E {\n}\n"
    + "x = 1\n"
    + "_u = 2\n"
    + "private funct p() {\n    return 1\n}\n"
    + "private class Pc {\n}\n"
    + "if True {\n    bloco = 3\n}\n"
    + "funct init() {\n    global cfg\n    cfg = 9\n}\n"
    + "init()\n"
    + "n_chamou = len(\"ab\")\n")

# roda `fonte` como EST/<arq> e devolve stdout+stderr sem o fim de linha
funct roda_est(arq, fonte) {
    os.writeFile(EST + "/" + arq, fonte)
    roda_em(EST, arq, arq + ".out", "")
    return os.readFile(EST + "/" + arq + ".out").strip()
}

TUDO = "f E 1 2 [1] 9"
USA = "post(f(), type(E()), x, _u, json.stringify([1]), cfg)\n"
confere("import *: from m import * traz funct, Entity, variavel, _nome, os imports e o global gravado",
        roda_est("e1.pr", "from m import *\n" + USA) == TUDO)
confere("import *: import m * e a mesma regra",
        roda_est("e2.pr", "import m *\n" + USA) == TUDO)
confere("import *: PUSH m GET * e a mesma regra",
        roda_est("e3.pr", "PUSH m GET *\n" + USA) == TUDO)
confere("import *: caminho entre aspas, nas duas grafias",
        roda_est("e4.pr", "from './m.pr' import *\nimport './m' *\n" + USA) == TUDO)
os.writeFile(EST + "/sub/rel.pr", "from ..m import *\n" + USA)
roda_em(EST, "sub/rel.pr", "sub/rel.out", "")
confere("import *: relativo com pontos a partir de subpasta",
        os.readFile(EST + "/sub/rel.out").strip() == TUDO)
confere("import *: nao liga o nome do modulo",
        roda_est("e5.pr", "import m *\npost(m)\n").startswith("NameError: name 'm' is not defined"))
confere("import *: private funct fica de fora",
        roda_est("e6.pr", "from m import *\np()\n").startswith("NameError: name 'p' is not defined"))
confere("import *: private class fica de fora",
        roda_est("e7.pr", "from m import *\nPc()\n").startswith("NameError: name 'Pc' is not defined"))
confere("import *: nome que so existe dentro de bloco fica de fora",
        roda_est("e8.pr", "from m import *\npost(bloco)\n").startswith("NameError: name 'bloco' is not defined"))
confere("import *: o builtin que o modulo so chamou nao sai, e o do importador sobrevive",
        roda_est("e9.pr", "funct len(v) {\n    return 99\n}\nfrom m import *\npost(len(\"a\"))\n") == "99")
os.writeFile(EST + "/m3.pr", "funct len(v) {\n    return 7\n}\n")
confere("import *: builtin REDEFINIDO no modulo sai, como qualquer funct dele",
        roda_est("e10.pr", "from m3 import *\npost(len(\"a\"))\n") == "7")
confere("import explicito: builtin que o modulo so chamou e ImportError",
        roda_est("e11.pr", "from m import len\n").startswith("ImportError: cannot import name 'len' from 'm'"))
confere("import explicito: m.len do builtin que o modulo so chamou e AttributeError",
        roda_est("e12.pr", "import m\npost(m.len)\n").startswith("AttributeError: module 'm' has no attribute 'len'"))
confere("import explicito: private continua dizendo que existe",
        roda_est("e13.pr", "import m\npost(m.p)\n").startswith("AttributeError: module 'm' has no attribute 'p' (existe, mas é private"))
confere("import explicito: private class continua dizendo que existe",
        roda_est("e14.pr", "from m import Pc\n").startswith("AttributeError: module 'm' has no attribute 'Pc' (existe, mas é private"))
confere("import explicito: global gravado de dentro de funct sai",
        roda_est("e15.pr", "from m import cfg\nimport m\npost(cfg, m.cfg)\n") == "9 9")
confere("import *: o que vem depois sobrescreve o que o * trouxe",
        roda_est("e16.pr", "from m import *\nx = 5\npost(x)\n") == "5")
confere("import *: o * sobrescreve o que ja existia",
        roda_est("e17.pr", "x = 5\nfrom m import *\npost(x)\n") == "1")
confere("import *: funct do importador usa o nome que veio do *",
        roda_est("e18.pr", "from m import *\nfunct g() {\n    return f() + str(x)\n}\npost(g())\n") == "f1")
confere("import *: escrita dentro de bloco atravessa ate o nome do *",
        roda_est("e19.pr", "from m import *\nif True {\n    x = 9\n}\npost(x)\n") == "9")
confere("import *: for each sobre o nome do * devolve o valor depois do laco",
        roda_est("e20.pr", "from m import *\nfor each x in [7, 8] {\n}\npost(x)\n") == "1")
confere("import *: nome novo dentro de bloco continua sumindo no fim do bloco",
        roda_est("e21.pr", "from m import *\nif True {\n    novo = 1\n}\npost(novo)\n").startswith("NameError"))
confere("import *: variavel tipada do importador confere o valor que chega, como o import explicito",
        roda_est("e22.pr", "str x = \"a\"\nfrom m import *\n").split("\n")[0]
        == roda_est("e23.pr", "str x = \"a\"\nfrom m import x\n").split("\n")[0])
os.writeFile(EST + "/r.pr", "from json import *\n")
confere("import *: reexportacao — o que r trouxe por * sai de r por * e por r.nome",
        roda_est("e24.pr", "from r import *\npost(parse(\"[1]\"))\nimport r\npost(r.parse(\"[2]\"))\n") == "[1]\n[2]")
os.writeFile(EST + "/r2.pr", "from m import *\n")
confere("import *: reexportacao atravessa arquivo .pr",
        roda_est("e25.pr", "from r2 import *\npost(f())\n") == "f")
os.writeFile(EST + "/mr.pr", "funct range(n) {\n    return [\"r\"]\n}\n")
confere("import *: range que vem do * desliga o atalho do for each",
        roda_est("e26.pr", "from mr import *\nfor each i in range(3) {\n    post(i)\n}\n") == "r")
os.writeFile(EST + "/ca.pr", "from cb import *\npost(fb())\n")
os.writeFile(EST + "/cb.pr", "funct fb() {\n    return \"fb\"\n}\nfrom ca import *\n")
roda_em(EST, "ca.pr", "ca.out", "")
confere("import *: ciclo entre dois arquivos termina e liga o que ja tem valor",
        os.readFile(EST + "/ca.out").strip() == "fb\nfb")
os.writeFile(EST + "/auto.pr", "x = 1\nfrom auto import *\npost(x)\n")
roda_em(EST, "auto.pr", "auto.out", "")
confere("import *: arquivo que importa a si mesmo com * termina",
        os.readFile(EST + "/auto.out").strip() == "1\n1")
confere("import *: modulo que so aparece em runtime diz por que o * nao tem nomes",
        roda_est("e27.pr", "import os\nos.writeFile(\"" + EST + "/gerado.pr\", \"z = 1\\n\")\nfrom gerado import *\n")
            .startswith("ImportError: `*` de 'gerado': os nomes do `*` sao resolvidos antes de o programa rodar"))
# Um `*` que aponta pra modulo ausente deixa a lista do arquivo INCOMPLETA: a
# recusa sobe, em vez de sumir nome em silencio no arquivo de cima.
os.writeFile(EST + "/inc_b.pr", "from naoexiste import *\nW = 1\n")
confere("import *: modulo com * que nao resolve nao entrega lista pela metade",
        roda_est("e28.pr", "from inc_b import *\npost(W)\n").startswith("ImportError: No module named 'naoexiste'"))
os.writeFile(EST + "/chk.pr", "from m import *\npost(f())\n")
roda_em(EST, "--check chk.pr", "chk.out", "")
confere("import *: --check resolve o * do modulo vizinho",
        os.readFile(EST + "/chk.out").strip() == "{\"ok\":true}")
# E quando o modulo NAO existe, o `--check` acusa com a MESMA frase de rodar.
# Antes dizia `{"ok":true}`: um typo no import so aparecia na execucao.
os.writeFile(EST + "/chk2.pr", "from naoexiste_zz import *\npost(f())\n")
roda_em(EST, "--check chk2.pr", "chk2.out", "")
confere("import *: --check acusa o modulo ausente do *",
        "No module named 'naoexiste_zz'" in os.readFile(EST + "/chk2.out")
        and "ImportError" in os.readFile(EST + "/chk2.out"))

# ── os.run: SEGUNDO PLANO ───────────────────────────────────────────────────
#
# O `run` sem `capture` dispara e volta na hora — e o que o separa do `cmd`.
# Enquanto os dois esperavam, ter os dois nao fazia sentido: medido antes,
# `os.run(["sleep", "3"])` segurava o programa por 3 s.
#
# O que se afirma aqui: (1) volta antes do processo terminar, (2) devolve o PID,
# (3) o processo RODA de verdade e sobrevive ao fim de quem disparou,
# (4) programa inexistente continua levantando IOError — sem isso o disparo
# ficaria calado, com o processo morrendo de 127 sem ninguem saber,
# (5) `capture=True` continua ESPERANDO e devolvendo a saida.
#
# O filho é o próprio motor, que existe igual nos três sistemas: dorme 2 s e
# grava a prova. Era `sh -c "sleep 2; echo RODOU > ..."`, e o `sh` não é
# programa do Windows (o que o `run` acha lá é o do MSYS2, e só com ele no
# PATH). A pasta `bg` nasce vazia: a prova NÃO pode existir antes do disparo.
BG = PASTA + "/bg"
if os.exists(BG) {
    os.rmdir(BG, force=True)
}
os.mkdir(BG, exist_ok=True)
PROVA = BG + "/prova.txt"
os.writeFile(BG + "/dorme.pr",
             "import os\nsleep(2)\nos.writeFile(\"" + PROVA + "\", \"RODOU\\n\")\n")

funct tem_prova() {
    return os.exists(PROVA) and os.readFile(PROVA).strip() == "RODOU"
}

t0 = date.timestamp()
pid = os.run([sys.executable, BG + "/dorme.pr"])
gasto = date.timestamp() - t0
confere("os.run sem capture volta antes do processo terminar", gasto < 2)
confere("os.run sem capture devolve o PID", type(pid) == "int" and pid > 0)
# Espera a prova com PRAZO, e não um `sleep 3` fixo: o filho dorme 2 s, e o
# quanto ele leva pra nascer depende da máquina (o runner do CI é mais lento).
while not tem_prova() and date.timestamp() - t0 < 20 {
    sleep(0.1)
}
confere("o processo disparado RODA e sobrevive a quem disparou", tem_prova())

pegou = False
try {
    os.run(["programa_que_nao_existe_zz_987"])
}
catch (IOError e) {
    pegou = True
}
confere("os.run de programa inexistente levanta IOError (nao volta PID calado)", pegou)

# O `capture=True` também com o próprio motor: o `echo` é comando interno do
# cmd.exe, não programa que o `run` ache no PATH do Windows.
os.writeFile(PASTA + "/eco.pr", "post(\"capturado\")\n")
r = os.run([sys.executable, PASTA + "/eco.pr"], True)
confere("os.run com capture=True espera e devolve a saida",
        type(r) == "str" and r.strip() == "capturado")

# ── charset em arquivo: TODO codec que a linguagem conhece ──────────────────
#
# O `encoding` de readFile/writeFile era declarado e IGNORADO — ler latin-1
# pedindo latin-1 saia com acento quebrado e gravar latin-1 gravava utf-8. A
# conversao nao e reimplementada no `os`: ler chama o `.decode()` do bytes e
# gravar chama o `.encode()` do str, entao nao ha lista de convidados nem uma
# segunda copia da logica pra sair de sincronia.
#
# A ida e volta e o que se afirma: gravar num charset e ler de volta nele tem
# que devolver o MESMO texto, e o TAMANHO em bytes prova que a conversao
# aconteceu (latin-1 gasta 4 onde utf-8 gasta 5).
os.mkdir(PASTA + "/cs", exist_ok=True)
TXT = "café"
volta_ok = True
for each cod in ["utf-8", "latin-1", "utf-16", "utf-16be", "utf-32", "utf-32be", "iso-8859-1", "cp819"] {
    arq = PASTA + "/cs/" + cod.replace("-", "") + ".txt"
    os.writeFile(arq, TXT, encoding=cod)
    if os.readFile(arq, encoding=cod) != TXT {
        volta_ok = False
    }
}
confere("arquivo: grava e le de volta em todo codec da linguagem", volta_ok)
confere("arquivo: latin-1 gasta 4 bytes onde utf-8 gasta 5",
        os.size(PASTA + "/cs/latin1.txt") == 4 and os.size(PASTA + "/cs/utf8.txt") == 5)
confere("arquivo: utf-16 gasta 8 bytes e utf-32 gasta 16",
        os.size(PASTA + "/cs/utf16.txt") == 8 and os.size(PASTA + "/cs/utf32.txt") == 16)

pegou = False
try {
    os.writeFile(PASTA + "/cs/x.txt", "ção", encoding="ascii")
}
catch (e) {
    pegou = True
}
confere("arquivo: caractere que nao cabe no charset levanta", pegou)

pegou = False
try {
    os.readFile(PASTA + "/cs/utf8.txt", encoding="klingon")
}
catch (e) {
    pegou = True
}
confere("arquivo: encoding inexistente levanta", pegou)

# `content` em bytes JA e a sequencia final: o encoding nao se aplica
os.writeFile(PASTA + "/cs/b.bin", "ab".encode(), encoding="utf-16")
confere("arquivo: content em bytes ignora o encoding", os.size(PASTA + "/cs/b.bin") == 2)

# o 2o argumento do loadFile e MODO, e charset ali e erro com o caminho certo
os.writeFile(PASTA + "/cs/d.csv", "a,b\n1,2\n")
pegou = False
try {
    os.loadFile(PASTA + "/cs/d.csv", "latin-1")
}
catch (e) {
    pegou = "os.readFile" in str(e)
}
confere("loadFile recusa charset e aponta o os.readFile", pegou)

# ── os: caminho, diretório, ambiente ────────────────────────────────────────
# Caminho ABSOLUTO do sistema: começa com "/" no Linux e no macOS; no Windows,
# com o disco ("D:\" ou "D:/") ou com "\\" (pasta de rede).
funct absoluto(c) {
    if WINDOWS {
        disco = len(c) >= 3 and c[1] == ":" and (c[2] == "\\" or c[2] == "/")
        return disco or c.startswith("\\\\") or c.startswith("//")
    }
    return c.startswith("/")
}

# `pathFile`/`pathFolder` BUSCAM a partir do cwd e levantam se não acharem —
# então o teste cria o alvo e roda de dentro da pasta.
os.mkdir(PASTA + "/uploads", exist_ok=True)
os.writeFile(PASTA + "/dados.json", "{}")
volta2 = os.cwd()
os.chdir(PASTA)
cf = os.pathFile("dados.json")
cp = os.pathFolder("uploads")
os.chdir(volta2)
confere("os.pathFile devolve o caminho absoluto do arquivo",
        absoluto(cf) and cf.endswith("dados.json"))
confere("os.pathFolder devolve o caminho absoluto da pasta",
        absoluto(cp) and cp.endswith("uploads"))

antes = os.cwd()
confere("os.cwd() devolve caminho absoluto", absoluto(antes))
os.chdir(PASTA)
confere("os.chdir muda o cwd de verdade", os.cwd() != antes)
os.chdir(antes)
confere("e volta", os.cwd() == antes)

os.writeFile(PASTA + "/velho.txt", "conteudo")
os.rename(PASTA + "/velho.txt", PASTA + "/novo.txt")
confere("os.rename move o arquivo",
        os.isfile(PASTA + "/novo.txt") and not os.isfile(PASTA + "/velho.txt"))
confere("e o conteúdo atravessa intacto",
        os.readFile(PASTA + "/novo.txt") == "conteudo")

# A variável que o sistema SEMPRE tem: HOME no Linux e no macOS; a do Windows
# é USERPROFILE (lá o HOME só existe se quem disparou o põe, como o MSYS2), e
# sem ela os dois lados seriam null e a igualdade passaria sem ler nada.
VAR_CASA = "HOME"
if WINDOWS {
    VAR_CASA = "USERPROFILE"
}
confere("os.environ lê variável do ambiente", os.environ(VAR_CASA) == os.getenv(VAR_CASA))
confere("os.environ de variável inexistente é Null",
        os.environ("PS_NAO_EXISTE_MESMO_123") == Null)

ip = os.ipmach()
confere("os.ipmach devolve um IP com três pontos", len(ip.split(".")) == 4)

# `os.warn` escreve em stderr colorido — não devolve nada; o que se afirma é
# que ele aceita a cor e não levanta.
os.warn("aviso do teste de cobertura", color="yellow")
confere("os.warn aceita texto e cor", True)

# ── date ────────────────────────────────────────────────────────────────────
t = date.time()
confere("date.time() devolve HH:MM:SS", len(t.split(":")) == 3)
n = date.now()
confere("date.now() traz data e hora juntas", len(str(n)) >= 10)
confere("date.today() traz a data", len(date.today()) >= 8)
confere("date.timestamp() é número positivo", date.timestamp() > 0)

# ── embutidos ───────────────────────────────────────────────────────────────
confere("tup() constrói tupla", type(tup([1, 2])) == "tup" and len(tup([1, 2])) == 2)
confere("dict() constrói dict vazio", type(dict()) == "dict")
confere("id() de dois objetos distintos difere", id([1]) != id([1]))
mesmo = [1]
confere("id() do MESMO objeto é estável", id(mesmo) == id(mesmo))

# `.replace()` com LISTA: troca vários de uma vez
confere("str.replace com lista troca todos",
        "a-b-c".replace(["a", "b"], "x") == "x-x-c")

# `load()` é o `dotenv.load` exposto sem import: lê um `.env` e põe as
# variáveis no ambiente.
#
# A doc (`docs/builtins/load/load.md`) diz "Retorno: bool"; o motor devolve um
# `dict` com o que leu. O teste afirma o que o MOTOR faz — a doc é quem está
# fora de sincronia, e o `audita_doc.pr` não pega isso porque só confere nome e
# ordem de parâmetro, nunca o tipo de retorno.
os.writeFile(PASTA + "/.env", "PS_COB_UM=alfa\nPS_COB_DOIS=beta\n")
m = load(PASTA + "/.env")
confere("load() devolve o que leu do .env",
        type(m) == "dict" and m["PS_COB_UM"] == "alfa")
confere("load() põe a variável no ambiente", os.getenv("PS_COB_DOIS") == "beta")

# ── constantes de socket ────────────────────────────────────────────────────
#
# São 63 funções de uma linha cada, e nenhuma era lida. Conferir o VALOR (e não
# só que existe) é o que separa cobrir de carimbar: `SOCK_STREAM` tem que ser 1
# no Linux, não "algum inteiro".
#
# O valor é o do SISTEMA, e dois mudam de um pro outro: `AF_INET6` (10 no
# Linux, 30 no macOS, 23 no Windows) e `SOL_SOCKET` (1 no Linux, 0xffff no
# macOS e no Windows). Os outros que se conferem pelo número são iguais nos três.
AF_INET6_AQUI = 10
SOL_SOCKET_AQUI = 1
if SO == "darwin" {
    AF_INET6_AQUI = 30
    SOL_SOCKET_AQUI = 65535
}
elif WINDOWS {
    AF_INET6_AQUI = 23
    SOL_SOCKET_AQUI = 65535
}

# E há constante que só alguns sistemas têm (docs/sockets/sockets.md diz
# quais): onde o sistema não tem, ela não existe no módulo, e o nome que falta
# nem compila — o conferidor acusa `sockets.X` inexistente antes de rodar,
# mesmo dentro de um `if`. Então essas são lidas num programa FILHO escrito só
# com as deste sistema, e o dict volta com o valor de cada uma. A que não vier
# (o filho não compilou) fica fora do dict, e a checagem que a usa reprova pela
# contagem.
funct consts_do_sistema(nomes) {
    fonte = "import sockets\n"
    for each nome in nomes {
        fonte = fonte + "post(\"" + nome + "\", sockets." + nome + ")\n"
    }
    os.writeFile(PASTA + "/consts.pr", fonte)
    saida = os.run([sys.executable, PASTA + "/consts.pr"], True)
    lidas = dict()
    for each linha in saida.split("\n") {
        partes = linha.strip().split(" ")
        if len(partes) == 2 and partes[0] in nomes {
            lidas[partes[0]] = int(partes[1])
        }
    }
    if len(lidas) != len(nomes) {
        post("constantes de socket: o filho não leu todas —", saida)
    }
    return lidas
}

# o ocioso do keepalive: TCP_KEEPIDLE no Linux e no Windows, TCP_KEEPALIVE no macOS
OCIOSO = "TCP_KEEPIDLE"
if SO == "darwin" {
    OCIOSO = "TCP_KEEPALIVE"
}
SO_TEM = [OCIOSO, "TCP_KEEPINTVL", "TCP_KEEPCNT"]
if SO == "linux" {
    addEnd(SO_TEM, "AF_PACKET")
}
if not WINDOWS {
    addEnd(SO_TEM, "SO_REUSEPORT")
    addEnd(SO_TEM, "MSG_DONTWAIT")
    addEnd(SO_TEM, "MSG_TRUNC")
}
DO_SISTEMA = consts_do_sistema(SO_TEM)

# os valores de `nomes` que o filho leu, na ordem
funct lidas_de(nomes) {
    vals = []
    for each nm in nomes {
        if nm in DO_SISTEMA {
            addEnd(vals, DO_SISTEMA[nm])
        }
    }
    return vals
}

confere("AF_INET/AF_INET6/AF_UNIX",
        sockets.AF_INET == 2 and sockets.AF_INET6 == AF_INET6_AQUI and sockets.AF_UNIX == 1)
confere("AF_UNSPEC é 0", sockets.AF_UNSPEC == 0)
if SO == "linux" {
    pk = lidas_de(["AF_PACKET"])
    confere("AF_PACKET é 17 no Linux", len(pk) == 1 and pk[0] == 17)
}
else {
    nao_rodou("AF_PACKET é 17 no Linux", "AF_PACKET só existe no Linux")
}
confere("SOCK_STREAM=1 SOCK_DGRAM=2 SOCK_RAW=3",
        sockets.SOCK_STREAM == 1 and sockets.SOCK_DGRAM == 2 and sockets.SOCK_RAW == 3)
confere("SOCK_SEQPACKET é 5", sockets.SOCK_SEQPACKET == 5)
confere("SOL_SOCKET é " + str(SOL_SOCKET_AQUI), sockets.SOL_SOCKET == SOL_SOCKET_AQUI)

opts = [sockets.SO_REUSEADDR, sockets.SO_KEEPALIVE,
        sockets.SO_BROADCAST, sockets.SO_LINGER, sockets.SO_RCVBUF,
        sockets.SO_SNDBUF, sockets.SO_ERROR, sockets.SO_RCVTIMEO,
        sockets.SO_SNDTIMEO, sockets.SO_OOBINLINE, sockets.SO_DONTROUTE,
        sockets.SO_TYPE]
if WINDOWS {
    nao_rodou("SO_REUSEPORT nas opções SO_*", "o Windows não tem SO_REUSEPORT")
    confere("as 12 opções SO_* (sem SO_REUSEPORT) são inteiros distintos e positivos",
            len(opts) == 12 and min(opts) > 0)
}
else {
    opts = opts + lidas_de(["SO_REUSEPORT"])
    confere("as 13 opções SO_* são inteiros distintos e positivos",
            len(opts) == 13 and min(opts) > 0)
}

confere("TCP_NODELAY é 1", sockets.TCP_NODELAY == 1)
kp = lidas_de([OCIOSO, "TCP_KEEPINTVL", "TCP_KEEPCNT"])
confere(OCIOSO + "/INTVL/CNT existem e diferem",
        len(kp) == 3 and kp[0] != kp[1] and kp[1] != kp[2])

confere("IPPROTO_IP=0 TCP=6 UDP=17 ICMP=1 RAW=255",
        sockets.IPPROTO_IP == 0 and sockets.IPPROTO_TCP == 6
        and sockets.IPPROTO_UDP == 17 and sockets.IPPROTO_ICMP == 1
        and sockets.IPPROTO_RAW == 255)

confere("SHUT_RD=0 WR=1 RDWR=2",
        sockets.SHUT_RD == 0 and sockets.SHUT_WR == 1 and sockets.SHUT_RDWR == 2)

msgs = [sockets.MSG_PEEK, sockets.MSG_WAITALL, sockets.MSG_OOB, sockets.MSG_DONTROUTE]
if WINDOWS {
    nao_rodou("MSG_DONTWAIT e MSG_TRUNC nas flags MSG_*", "o Windows não tem essas duas")
    confere("as 4 flags MSG_* (sem MSG_DONTWAIT e MSG_TRUNC) são potências de dois distintas",
            len(msgs) == 4 and min(msgs) > 0)
}
else {
    msgs = msgs + lidas_de(["MSG_DONTWAIT", "MSG_TRUNC"])
    confere("as 6 flags MSG_* são potências de dois distintas",
            len(msgs) == 6 and min(msgs) > 0)
}

ais = [sockets.AI_PASSIVE, sockets.AI_CANONNAME, sockets.AI_NUMERICHOST,
       sockets.AI_NUMERICSERV, sockets.AI_ADDRCONFIG, sockets.AI_V4MAPPED,
       sockets.AI_ALL]
confere("as 7 flags AI_* são positivas", len(ais) == 7 and min(ais) > 0)

nis = [sockets.NI_NUMERICHOST, sockets.NI_NUMERICSERV, sockets.NI_NOFQDN,
       sockets.NI_NAMEREQD, sockets.NI_DGRAM]
confere("as 5 flags NI_* são positivas", len(nis) == 5 and min(nis) > 0)

confere("SOMAXCONN é positivo", sockets.SOMAXCONN > 0)
confere("INADDR_ANY=0 e LOOPBACK=0x7f000001",
        sockets.INADDR_ANY == 0 and sockets.INADDR_LOOPBACK == 2130706433)
confere("INADDR_BROADCAST é 0xffffffff", sockets.INADDR_BROADCAST == 4294967295)

ips = [sockets.IP_TTL, sockets.IP_MULTICAST_TTL, sockets.IP_MULTICAST_LOOP,
       sockets.IP_ADD_MEMBERSHIP, sockets.IP_DROP_MEMBERSHIP, sockets.IPV6_V6ONLY]
confere("as 6 opções de IP são positivas", len(ips) == 6 and min(ips) > 0)

# ── resolução de nome ───────────────────────────────────────────────────────
#
# `localhost` resolve sem rede: está no /etc/hosts (no Windows, o próprio
# resolvedor responde). Nada aqui sai da máquina.
h = sockets.gethostbyname_ex("localhost")
confere("gethostbyname_ex devolve nome, apelidos e endereços",
        len(h) == 3 and "127.0.0.1" in h[2])
confere("gethostbyaddr resolve o loopback de volta",
        len(sockets.gethostbyaddr("127.0.0.1")) == 3)
confere("has_dualstack_ipv6 responde bool",
        sockets.has_dualstack_ipv6() == True or sockets.has_dualstack_ipv6() == False)

# a pasta sai pelo próprio motor, como a sobra lá do começo
os.rmdir(PASTA, force=True)

# ── relatório ───────────────────────────────────────────────────────────────
post("")
post("stdlib:", ok, "checagens passaram")
if puladas.len() > 0
{
    post("NAO RODARAM neste sistema:", puladas.len())
    for each x in puladas
    {
        post("  " + x)
    }
}
if falhas.len() > 0
{
    post("FALHARAM:", falhas.len())
    for each f in falhas
    {
        post("  " + f)
    }
    sys.exit(1)
}

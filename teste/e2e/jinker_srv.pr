# Servidor de teste: sobe o jinker numa porta local. O cliente (jinker_cli.pr)
# bate nele com a lib `request` — a linguagem servindo e consumindo a si
# mesma, sem mock e sem rede externa.
import jinker
import os
from jinker import cors

# Pasta de trabalho do par, RELATIVA ao diretório de onde se roda: o
# `teste/e2e_roda.pr` sobe o servidor e os clientes da raiz do repositório, e
# o jinker_cli.pr abre os arquivos daqui pelo MESMO nome. Era tudo em /tmp, e
# no Windows o motor é nativo: "/tmp/x" é "<disco>:\tmp\x", na raiz do disco
# corrente, fora do checkout — o `os.mkdir` (que cria a cadeia inteira) criava
# essa pasta de carona, e ninguém a apagava.
PASTA = "ps_e2e_jinker"
# static_folder/static_url: pasta de front servida junto com as rotas. É uma
# subpasta, pra servir só o que o teste pôs nela. Relativa, o jinker a procura
# sob a pasta do script (ela e as subpastas) e, não achando lá, sob a corrente
# — que é onde ela está.
ESTATICA = PASTA + "/static"

# A rodada começa do ZERO: o que sobrou da anterior sai antes. É isso que deixa
# o teste RE-EXECUTÁVEL (um `os.mkdir` cru em cima da sobra falhava já na
# primeira linha — a classe do E1, teste não hermético, que a suíte principal
# fechou com mkdtemp+chdir e que não tinha alcançado os e2e) e que impede
# arquivo velho de passar por novo: o cliente lê o que o upload e os handlers
# de WebSocket gravam NESTA rodada, e um da rodada anterior esconderia um
# handler que não rodou. Sobra existe: no Windows o `kill()` do e2e_roda é
# TerminateProcess, e a limpeza do fim (lá embaixo) não chega a rodar.
if os.exists(PASTA) {
    os.rmdir(PASTA, force=True)
}
os.mkdir(ESTATICA)
using open(ESTATICA + "/pagina.txt", "w") as f {
    f.write("sou estatico")
}

app = jinker.Jinker(name="e2e", static_folder=ESTATICA, static_url="/")

# CORS global: só estes métodos, só estas origens
cors(app, options=["GET", "POST", "PUT", "DELETE"], origins=["http://permitido.test"])

# middleware: roda ANTES da rota; `pass` libera, `return` barra
@app.middleware()
funct confere() {
    if jinker.request.header("X-Chave") != "abre" {
        return jinker.jsonify({"msg": "sem permissao"}), 401
    }
    pass
}

@app.route("/protegida", middleware=app.middleware)
funct protegida() {
    return {"entrou": True}
}

@app.route("/cors-info")
funct cors_info() {
    return {"options": cors.options(), "origins": cors.origins(),
            "subset": cors.options(["POST"]), "permiser": cors.permiser()}
}

@app.route("/oi")
funct oi() {
    return "alo"
}

@app.route("/json")
funct js() {
    return {"a": 1, "b": [2, 3]}
}

@app.route("/eco", methods=["POST"])
funct eco() {
    corpo = jinker.request.get_json()
    return {"recebi": corpo["x"]}
}

@app.route("/param/<nome>")
funct param() {
    return jinker.request.path_param("nome")
}

# Profundidade vinda do CLIENTE. Antes: 300 níveis matavam o processo inteiro
# do servidor — `str()` recorria sem teto e a fibra roda numa pilha de C de
# 128 KB, ~64x menor que a do processo. O cliente seguinte tomava "Connection
# refused". Hoje o `str` trunca em 256 e a pilha da fibra tem página de guarda.
@app.route("/fundo/<prof>")
funct fundo() {
    p = int(jinker.request.path_param("prof"))
    x = []
    i = 0
    while (i < p) {
        x = [x]
        i = i + 1
    }
    return {"tam": len(str(x))}
}

@app.route("/hdr")
funct hdr() {
    return {"ua": jinker.request.header("X-Teste")}
}

@app.route("/metodo", methods=["GET", "POST", "PUT", "DELETE"])
funct metodo() {
    return jinker.request.method
}

@app.route("/status")
funct st() {
    # JinkerResponse montado em etapas: status + header + json
    r = jinker.JinkerResponse()
    return r.status(418).header("X-Bule", "sim").json({"cha": True})
}

@app.route("/tupla")
funct tp() {
    # a rota também aceita (corpo, status) como tupla
    return ({"t": 1}, 201)
}

@app.route("/vazio")
funct vz() {
    return Null
}

@app.route("/send")
funct sd() {
    r = jinker.JinkerResponse()
    return r.send("cru")
}

@app.route("/jsonify")
funct jf() {
    return jinker.jsonify({"via": "jsonify"})
}

# ── upload multipart: PoolFileUpload (7 membros) ────────────────────────────
@app.route("/upload", methods=["POST"])
funct up() {
    f = jinker.request.file("arq")
    if f == Null {
        return {"erro": "sem arquivo"}
    }
    f.save(PASTA + "/ps_upload_recebido.txt")
    return {"name": f.name, "ext": f.ext, "size": f.size,
            "content_type": f.content_type, "bytes": len(f.bytes())}
}

@app.route("/uploads", methods=["POST"])
funct ups() {
    # files() é POR CAMPO: vários arquivos mandados no mesmo nome de campo
    fotos = jinker.request.files("fotos")
    nomes = []
    for each f in fotos {
        nomes.append(f.name)
    }
    return {"quantos": len(fotos), "nomes": nomes,
            "vazio": len(jinker.request.files("nao-existe"))}
}

# ── WebSocket: SocketNamespace / SocketEmitter / ChannelManager ─────────────
# socket SEM canal: o `return` do handler volta pro REMETENTE daquela mensagem.
# É o único jeito de responder a quem mandou sem estar num canal (o emit só
# alcança conexão com channel=True).
@app.socket("/ws")
funct ws_handler() {
    using open(PASTA + "/ps_ws_sem_canal.txt", "w") as f {
        f.write(jinker.request.text())
    }
    return "eco: " + jinker.request.text()
}

# canal de verdade: `channel=True` põe a conexão no broadcast. É o caso dos
# "dois terminais" — quem está só ouvindo tem que receber o que o outro manda.
@app.socket("/sala", channel=True)
funct ws_sala() {
    envia = app.socket()
    envia.emit(jinker.request.text(), exclude_self=False)
    using open(PASTA + "/ps_ws_status.txt", "w") as f {
        f.write(str(envia.status_send()) + "|" + str(app.socket.status_send()))
    }
}

# Content-Disposition: é daí que o cliente tira o Response.filename
@app.route("/baixar")
funct baixar() {
    r = jinker.JinkerResponse()
    return r.header("Content-Disposition", "attachment; filename=relatorio.csv").send("a,b\n1,2\n")
}

@app.route("/emitir")
funct emitir() {
    # `st` e a funct da rota /status: gravar nesse nome de dentro daqui
    # escreveria NELA (write-through do global) — o checador pegou isso
    estado = app.channel.emit("aviso", {"n": 1})
    return {"emit": str(estado), "status": str(app.channel.status)}
}

# a app é CHAMÁVEL: `app(...)` sobe o servidor (não existe `.run`)
if __name__ == "main" {
    # A limpeza do fim. O `app(...)` VOLTA quando o servidor para: no Linux e
    # no macOS o `kill()` do e2e_roda é o SIGTERM, o jinker sai do laço e
    # retorna, e a pasta da rodada sai aqui. O `finally` apaga também quando o
    # `app(...)` levanta (porta ocupada) — e o erro segue adiante. No Windows
    # o `kill()` é TerminateProcess: o processo morre sem passar por aqui, e a
    # sobra sai no começo da rodada seguinte (lá em cima).
    try {
        app(debug=False, host="127.0.0.1", port=28840)
    }
    finally {
        os.rmdir(PASTA, force=True)
    }
}

# `jpkg` de ponta a ponta, sem rede e sem tocar no ~/.jinga de verdade.
#
# POR QUE ISTO EXISTE: `vm/ps_pkg.c` estava em **0,0% de cobertura** — 570
# linhas, o gerenciador de pacotes inteiro, sem um único teste. Não por ser
# difícil: `jpkg install arquivo.pr` é 100% local, não precisa de rede nem de
# serviço. Simplesmente ninguém tinha escrito.
#
# O isolamento é `JINGA_HOME`, que o próprio `pkg_home` respeita antes do
# `$HOME`. Sem isso o teste instalaria pacote de mentira na máquina de quem
# roda — que é o tipo de teste que a gente aprende a não rodar.
#
# Cobre os dois modos (comando e lib), o shim gerado, o registro de instalados,
# a desinstalação, o registry, e os caminhos de ERRO — que é onde mora metade
# dos ramos e onde nenhum teste de caminho feliz chega.
import os
import sys

# Tudo mora numa pasta RELATIVA à corrente, criada aqui e apagada no fim pelo
# próprio motor: o `JINGA_HOME` (RAIZ), os pacotes de mentira e os arquivos da
# saída e do código de cada chamada. Era tudo em /tmp, apagado com `rm -rf`
# pelo `os.cmd`, e isso só vale inteiro no Linux e no macOS: no Windows o
# motor é nativo, "/tmp/x" é "<disco>:\tmp\x", na raiz do disco corrente, e o
# cmd.exe não tem `rm`.
#
# Os caminhos vão com "/" nos três sistemas: o `jpkg` tira o nome do pacote do
# que vem depois da última "/" (`derive_name`, em vm/ps_pkg.c).
#
# E o que se lê de volta é pelo `os.readFile`, que fecha o arquivo na hora. O
# `open(...).read()` de antes deixava cada arquivo aberto até o coletor passar,
# e o Windows não apaga arquivo aberto: com um deles aberto, o `os.rmdir` do
# fim não esvazia a pasta e levanta erro.
PASTA = "ps_e2e_pkg"
RAIZ = PASTA + "/home"
SAIDA = PASTA + "/ps_pkg_out.txt"
CODIGO = PASTA + "/ps_pkg_rc.txt"

# O atalho que faz o comando ser chamável pelo nome (`write_shim`, em
# vm/ps_pkg.c): no Linux e no macOS um script sem extensão; no Windows um
# `.cmd`, que é o que o terminal de lá acha pelo nome.
SHIM = RAIZ + "/bin/ps_pkg_cmd"
if sys.platform() == "windows" {
    SHIM = SHIM + ".cmd"
}


# `os.cmd` devolve a SAÍDA (ou Null), nunca o código de saída, então o código
# vem num arquivo, gravado pelo próprio shell. E é o `os.cmd`, não o `os.run`
# com o `wait()` do `Process`, porque o `JINGA_HOME` só chega ao filho pelo
# shell: o `os.run` não recebe ambiente.
#
# A linha vai na sintaxe do shell de cada sistema:
#
#   Linux e macOS  /bin/sh: `VAR='x' prog`, e o código no `echo $?`.
#   Windows        cmd.exe, que não tem `VAR=x prog`, aspas simples nem `$?`:
#                  `set "VAR=x" && prog`, e o código no `%errorlevel%`. O
#                  cmd troca todo `%nome%` quando LÊ a linha, antes de rodar o
#                  primeiro comando, e um `echo %errorlevel%` gravaria o código
#                  de antes do programa. O `^` esconde o nome dessa leitura (e
#                  some nela); o `call` troca de novo na hora de rodar, quando
#                  o programa já saiu.
#
# O arquivo do código é esvaziado antes de cada chamada: se a linha não
# rodasse, o código da chamada ANTERIOR responderia por esta. Vazio, o `int`
# estoura.
#
# Cuidado que custou caro aqui: `Null == 0` é **True** neste motor (é
# deliberado, `val_iguais` documenta o porquê). Então `os.cmd(...) != 0` é
# sempre False e um teste escrito assim aprova qualquer coisa — falso verde
# perfeito, do tipo que passa por revisão.
funct psl(args) {
    os.writeFile(CODIGO, "")
    cmd = ("JINGA_HOME='" + RAIZ + "' '" + sys.executable + "' " + args
           + " > '" + SAIDA + "' 2>&1; echo $? > '" + CODIGO + "'")
    if sys.platform() == "windows" {
        cmd = ("set \"JINGA_HOME=" + RAIZ + "\" && \"" + sys.executable + "\" " + args
               + " > \"" + SAIDA + "\" 2>&1 & call echo %^errorlevel% > \"" + CODIGO + "\"")
    }
    os.cmd(cmd)
    rc = int(os.readFile(CODIGO).strip())
    return [rc, os.readFile(SAIDA)]
}


erros = 0

funct conf(nome, cond, detalhe) {
    if cond {
        post("   ok  " + nome)
        return 0
    }
    post("   ERRO " + nome + " — " + detalhe)
    return 1
}


if __name__ == "main" {
    if os.exists(PASTA) {
        os.rmdir(PASTA, force=true)       # sobra de uma rodada que caiu no meio
    }
    os.mkdir(PASTA)
    os.mkdir(RAIZ)

    # ── um pacote de mentira, mas .pr de verdade ────────────────────────────
    using open(PASTA + "/ps_pkg_ola.pr", "w") as f {
        f.write("funct saudacao(nome) {\n    return \"ola \" + nome\n}\n")
    }
    using open(PASTA + "/ps_pkg_cmd.pr", "w") as f {
        f.write("post(\"rodei como comando\")\n")
    }

    # ── install como LIB ────────────────────────────────────────────────────
    r = psl("install " + PASTA + "/ps_pkg_ola.pr -asLib")
    erros = erros + conf("install -asLib sai 0", r[0] == 0, "rc=" + str(r[0]) + " " + r[1])
    erros = erros + conf("gravou em libs/", os.exists(RAIZ + "/libs/ps_pkg_ola.pr"),
                         "nao achei o .pr em libs/")

    # ── install como COMANDO ────────────────────────────────────────────────
    r = psl("install " + PASTA + "/ps_pkg_cmd.pr")
    erros = erros + conf("install comando sai 0", r[0] == 0, "rc=" + str(r[0]) + " " + r[1])
    erros = erros + conf("gravou em commands/", os.exists(RAIZ + "/commands/ps_pkg_cmd.pr"),
                         "nao achei o .pr em commands/")
    # o shim é o que faz o comando ser chamável pelo nome
    erros = erros + conf("gerou o shim em bin/", os.exists(SHIM),
                         "nao achei o shim")

    # ── list mostra os dois ─────────────────────────────────────────────────
    r = psl("list")
    erros = erros + conf("list sai 0", r[0] == 0, "rc=" + str(r[0]))
    erros = erros + conf("list cita a lib", "ps_pkg_ola" in r[1], r[1])
    erros = erros + conf("list cita o comando", "ps_pkg_cmd" in r[1], r[1])

    # ── o registro de instalados é regravado a cada operação ────────────────
    erros = erros + conf("escreveu installed.json", os.exists(RAIZ + "/installed.json"),
                         "nao achei installed.json")
    if os.exists(RAIZ + "/installed.json") {
        reg = os.readFile(RAIZ + "/installed.json")
        erros = erros + conf("installed.json tem as duas secoes",
                             "commands" in reg and "libs" in reg, reg)
    }

    # ── registry ────────────────────────────────────────────────────────────
    r = psl("registry set-url https://exemplo.invalido/reg.json")
    erros = erros + conf("registry set-url sai 0", r[0] == 0, "rc=" + str(r[0]) + " " + r[1])
    r = psl("registry show")
    erros = erros + conf("registry show devolve a url",
                         "exemplo.invalido" in r[1], r[1])
    # HTTP é GRAVÁVEL mas não é USÁVEL, e isso é de propósito: a checagem mora
    # em `https_ok`, chamada na busca no índice e no download — o ponto de uso,
    # que é onde a garantia importa. Guardar uma string não baixa nada; o que
    # não pode é pacote entrar por canal sem autenticação.
    r = psl("registry set-url http://inseguro.invalido/reg.json")
    erros = erros + conf("registry set-url aceita gravar http", r[0] == 0, r[1])
    r = psl("install um_pacote_qualquer")
    erros = erros + conf("mas INSTALAR por http é recusado",
                         r[0] != 0 and "https" in r[1],
                         "deixou passar: rc=" + str(r[0]) + " " + r[1])
    # e volta pra https, pra o resto do teste não herdar registry quebrado
    psl("registry set-url https://exemplo.invalido/reg.json")

    # ── caminhos de ERRO ────────────────────────────────────────────────────
    r = psl("install " + PASTA + "/nao_existe_mesmo.pr")
    erros = erros + conf("install de arquivo inexistente falha", r[0] != 0, r[1])
    # Um arquivo que EXISTE e não é .pr, criado aqui. Era o /etc/hostname, que
    # só o Linux tem: no macOS e no Windows o caminho não tinha arquivo nenhum.
    using open(PASTA + "/nao_e_fonte.txt", "w") as f {
        f.write("isto nao e fonte da linguagem\n")
    }
    r = psl("install " + PASTA + "/nao_e_fonte.txt")
    erros = erros + conf("install de nao-.pr falha", r[0] != 0, "aceitou: " + r[1])
    r = psl("uninstall nao_instalado_nenhum")
    erros = erros + conf("uninstall do que nao existe falha", r[0] != 0, r[1])
    r = psl("install")
    erros = erros + conf("install sem argumento falha", r[0] != 0, r[1])
    r = psl("uninstall")
    erros = erros + conf("uninstall sem argumento falha", r[0] != 0, r[1])

    # ── uninstall de verdade, nos dois modos ────────────────────────────────
    r = psl("uninstall ps_pkg_ola -asLib")
    erros = erros + conf("uninstall -asLib sai 0", r[0] == 0, "rc=" + str(r[0]) + " " + r[1])
    erros = erros + conf("sumiu de libs/", not os.exists(RAIZ + "/libs/ps_pkg_ola.pr"),
                         "o .pr continua la")
    r = psl("uninstall ps_pkg_cmd")
    erros = erros + conf("uninstall comando sai 0", r[0] == 0, "rc=" + str(r[0]) + " " + r[1])
    erros = erros + conf("sumiu o shim", not os.exists(SHIM),
                         "o shim continua la")

    # ── list vazio depois de tudo ───────────────────────────────────────────
    r = psl("list")
    erros = erros + conf("list depois de limpar sai 0", r[0] == 0, "rc=" + str(r[0]))
    erros = erros + conf("nao cita mais a lib", not "ps_pkg_ola" in r[1], r[1])

    os.rmdir(PASTA, force=true)
    post("")
    if erros > 0 {
        post("psl: FALHOU em", erros, "checagens")
        sys.exit(1)
    }
    post("OK — jpkg instala, lista, desinstala e recusa o que tem que recusar")
    sys.exit(0)
}

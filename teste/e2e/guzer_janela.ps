# guzer com JANELA DE VERDADE — o único jeito de cobrir `vm/ps_guzer.c`.
#
# POR QUE ISTO EXISTE: `teste/e2e/guzer.ps` roda com `GUZER_HEADLESS=1`, e o
# headless retorna de `guz_mostra` na primeira linha. Resultado: 171 membros
# exercitados, o e2e passando, e `ps_guzer.c` em **0,0% de cobertura**. Todo o
# desenho — alocação de cor, texto, PNG, ícone, despacho de clique, o laço de
# eventos e o caminho de fechamento — nunca rodou uma vez sequer.
#
# Aqui a janela abre. O servidor X é o Xvfb (display virtual, sem hardware e
# sem ninguém olhando), e quem age no lugar do usuário é o `xdotool`:
#
#   1. abre a UI e entra no laço de eventos (bloqueante, como em uso real)
#   2. o Expose chega e `desenha()` roda de verdade
#   3. o xdotool CLICA no botão -> ButtonPress -> despacho -> callback do onclick
#   4. o xdotool FECHA a janela -> WM_DELETE_WINDOW -> o laço sai limpo
#
# O passo 4 não é detalhe: saída limpa é o que faz o `.gcda` ser gravado. Morto
# por `timeout`, o processo não grava cobertura nenhuma — foi por isso que a
# primeira tentativa de medir isto deu zero mesmo com a janela abrindo.
#
# Precisa de `xvfb-run` e `xdotool`. Sem eles, PULOU — nunca falso verde.
import os
import sys

MARCA = "/tmp/ps_guzer_clicou.txt"


action conf_gz(nome, cond, detalhe) {
    if cond {
        post("OK — " + nome)
        return 0
    }
    post("ERRO: " + nome + " — " + detalhe)
    return 1
}


action tem(cmd) {
    # `os.cmd` devolve a saída ou Null, NUNCA o rc — e `Null == 0` era True,
    # então esta função dizia "tem" pra qualquer comando, inclusive os que não
    # existem. O PULOU nunca disparava; o teste ia adiante e falhava adiante.
    os.cmd("command -v " + cmd + " > /dev/null 2>&1; echo $? > /tmp/ps_gz_tem")
    return int(open("/tmp/ps_gz_tem").read().strip()) == 0
}


if __name__ == "main" {
    if not tem("xvfb-run") or not tem("xdotool") or not tem("metacity") {
        post("PULOU — falta xvfb-run, xdotool ou metacity")
        post("   (apt install xvfb xdotool metacity wmctrl)")
        sys.exit(0)
    }

    os.cmd("rm -f " + MARCA)

    # O app roda num arquivo à parte porque `show()` BLOQUEIA: quem clica e
    # fecha tem que ser outro processo, agindo de fora, como um usuário.
    # PNG de verdade pra `img` e pro ícone da janela: o próprio `qrcode` da
    # linguagem gera um. Sem imagem, `desenha_png` e `guz_set_icon` (24 + 14
    # ramos) nunca rodam — são a maior região descoberta de `ps_guzer.c`.
    using open("/tmp/ps_guzer_png.ps", "w") as f {
        f.write("import qrcode\n"
                + "q = qrcode.make(\"ps\")\n"
                + "q.save(\"/tmp/ps_guzer_img.png\")\n")
    }
    os.cmd("'" + sys.executable + "' /tmp/ps_guzer_png.ps > /dev/null 2>&1")
    tem_png = os.exists("/tmp/ps_guzer_img.png")

    # Vídeo e áudio minúsculos, feitos com ffmpeg. O guzer abre o vídeo por
    # PIPE DE FRAMES (`guz_video_abre`/`le`/`desenha`, 30 ramos) e o áudio por
    # `ffplay` em outro processo — nada disso tinha rodado nunca.
    tem_ff = tem("ffmpeg") and tem("ffplay")
    if tem_ff {
        os.cmd("ffmpeg -y -f lavfi -i testsrc=size=64x48:rate=10:duration=1"
               + " /tmp/ps_guzer_v.mp4 > /dev/null 2>&1")
        os.cmd("ffmpeg -y -f lavfi -i sine=frequency=440:duration=1"
               + " /tmp/ps_guzer_a.wav > /dev/null 2>&1")
        tem_ff = os.exists("/tmp/ps_guzer_v.mp4") and os.exists("/tmp/ps_guzer_a.wav")
    }

    # A API é dele: `guzer.UI(title, icon)`, geometria por `.stylesheet({...})`,
    # `button(onclick=)`. O botão ganha 400x300 pra o clique do xdotool acertar
    # sem depender de onde o layout o pôs.
    icone = ""
    if tem_png {
        icone = ", \"/tmp/ps_guzer_img.png\""
    }
    midia = ""
    if tem_png {
        midia = (midia
                 + "im = app.img(src=\"/tmp/ps_guzer_img.png\")\n"
                 + "im.stylesheet({ \"width\": \"80\", \"height\": \"80\" })\n")
    }
    if tem_ff {
        midia = (midia
                 + "vd = app.video(src=\"/tmp/ps_guzer_v.mp4\")\n"
                 + "vd.stylesheet({ \"width\": \"64\", \"height\": \"48\" })\n"
                 + "au = app.audio(src=\"/tmp/ps_guzer_a.wav\")\n")
    }
    # `src` que NAO existe: `desenha_png` tem que desistir sem quebrar a janela
    midia = midia + "faltando = app.img(src=\"/tmp/ps_nao_existe_mesmo.png\")\n"

    app = ("import guzer\n"
           + "action clicou() {\n"
           + "    using open(\"" + MARCA + "\", \"w\") as f {\n"
           + "        f.write(\"sim\")\n"
           + "    }\n"
           + "}\n"
           + "app = guzer.UI(\"PS_JANELA_TESTE\"" + icone + ")\n"
           + "w = app.window()\n"
           + "w.stylesheet({ \"width\": \"400\", \"height\": \"300\", \"bg\": \"#204080\" })\n"
           + "p = app.p()\n"
           + "p.text(\"texto desenhado\")\n"
           + "p.stylesheet({ \"color\": \"#ffffff\" })\n"
           # O BOTÃO VEM ANTES DA MÍDIA de propósito: o layout empilha na
           # ordem de criação, e com img/vídeo/áudio na frente ele descia pra
           # longe do ponto fixo onde o xdotool clica. O teste passava a
           # reprovar por causa do layout, não do despacho de clique.
           + "b = app.button(clicou)\n"
           + "b.text(\"clica\")\n"
           + "b.stylesheet({ \"width\": \"400\", \"height\": \"120\", \"bg\": \"#c02020\" })\n"
           + midia
           + "app.show()\n"
           + "post(\"fechou limpo\")\n")
    using open("/tmp/ps_guzer_app.ps", "w") as f {
        f.write(app)
    }

    # O roteiro do "usuário": espera a janela existir, clica no botão, espera,
    # e fecha pelo gerenciador. `--sync` no search evita corrida com o mapeamento.
    # O roteiro do "usuário", de fora do processo:
    #
    # - o `metacity` sobe porque SEM gerenciador de janelas o fechamento não
    #   existe: `wmctrl -c` manda _NET_CLOSE_WINDOW pra raiz e é o WM quem
    #   traduz pra WM_DELETE_WINDOW, que é a única coisa que faz o laço sair.
    #   Matar com `windowkill` derruba a conexão X, o processo morre sujo e o
    #   `.gcda` NÃO é gravado — a medição dava zero mesmo com a janela abrindo.
    # - `windowactivate` antes do clique: o ponteiro tem que estar sobre a
    #   janela certa, e sem WM a pilha de janelas é indefinida.
    roteiro = ("#!/bin/bash\n"
               + "metacity --sm-disable --replace > /dev/null 2>&1 &\n"
               + "sleep 1\n"
               + "'" + sys.executable + "' /tmp/ps_guzer_app.ps > /tmp/ps_guzer_saida.txt 2>&1 &\n"
               + "APP=$!\n"
               + "for i in $(seq 1 100); do\n"
               + "  xdotool search --name PS_JANELA_TESTE > /dev/null 2>&1 && break\n"
               + "  sleep 0.1\n"
               + "done\n"
               + "W=$(xdotool search --name PS_JANELA_TESTE | head -1)\n"
               + "xdotool windowactivate --sync $W 2>/dev/null || true\n"
               + "sleep 1\n"
               + "eval $(xdotool getwindowgeometry --shell $W)\n"
               + "xdotool mousemove $((X+150)) $((Y+30)) click 1\n"
               + "sleep 2\n"
               + "wmctrl -i -c $W\n"
               + "sleep 1\n"
               + "wait $APP 2>/dev/null || true\n")
    using open("/tmp/ps_guzer_roteiro.sh", "w") as f {
        f.write(roteiro)
    }
    os.cmd("chmod +x /tmp/ps_guzer_roteiro.sh")

    os.cmd("timeout 60 xvfb-run -a /tmp/ps_guzer_roteiro.sh > /tmp/ps_guzer_xvfb.txt 2>&1"
           + "; echo $? > /tmp/ps_gz_rc")
    rc = int(open("/tmp/ps_gz_rc").read().strip())

    saida = ""
    if os.exists("/tmp/ps_guzer_saida.txt") {
        saida = open("/tmp/ps_guzer_saida.txt").read()
    }
    erros = 0

    # 1. a janela abriu de fato — sem servidor X o motor diz isso e desiste
    if "sem servidor X" in saida {
        post("ERRO: o Xvfb nao serviu —", saida.strip())
        erros = erros + 1
    }
    # 2. o clique chegou no callback: prova que ButtonPress achou o widget
    if os.exists(MARCA) {
        post("OK — clique despachado pro onclick")
    }
    else {
        post("ERRO: cliquei no botao e o onclick nao rodou")
        post("   saida do app:", saida.strip())
        erros = erros + 1
    }

    # 3. saiu LIMPO pelo WM_DELETE_WINDOW. Não é preciosismo: processo morto
    #    por sinal não grava `.gcda`, e a cobertura de ps_guzer.c volta a zero
    #    sem ninguém entender por quê.
    if "fechou limpo" in saida {
        post("OK — laco de eventos saiu pelo WM_DELETE_WINDOW")
    }
    else {
        post("ERRO: nao saiu limpo — sem isso nao ha cobertura gravada")
        post("   saida:", saida.strip())
        erros = erros + 1
    }

    # ── REGRESSÕES DOS CAMINHOS ESCUROS ─────────────────────────────────────
    #
    # Daqui pra baixo não é teste de feature: é defeito ACHADO rodando o
    # caminho de falha. Nenhum deles aparecia lendo o código, e nenhum deles
    # era pego pelo bloco acima — o teste de cima abre a janela, clica UMA vez
    # num botão e fecha; o estrago mora em trocar o texto no clique, em
    # redesenhar depois, em usar `div` em vez de `button`, e em deixar a
    # janela aberta depois que o vídeo acaba.

    # ── R1. `div(onclick=)`, e o texto trocado DENTRO do handler ────────────
    #
    # Dois defeitos num app só, porque um precisa do outro pra aparecer:
    #
    #  (a) `guz_elem` — o corpo dos 81 elementos — filtrava o onclick com
    #      `args[13].t == V_OBJ`. Action simples é V_FUNC; só a que CAPTURA
    #      variável de fora vira closure (V_OBJ). Então `div(onclick=acao)`
    #      nascia SEM handler e o clique caía no vazio, sem erro nem aviso.
    #      O `button` já tinha sido consertado; o irmão que atende os outros
    #      81 elementos, não.
    #  (b) `guz_mostra` entregava ao laço de desenho o PONTEIRO CRU do texto
    #      de cada elemento. O handler roda DENTRO do laço, e `.text(...)` faz
    #      free() no buffer antigo: dali em diante o laço desenhava memória
    #      liberada, e o próximo Expose (redimensionar, desocultar, mover) lia
    #      o que quer que tivesse caído ali. No binário normal isso é silêncio;
    #      quem acusa é o `make check-asan`, e por isso o roteiro
    #      redimensiona a janela DEPOIS de clicar — sem esse Expose o defeito
    #      não chega nem a ser tocado.
    MARCA_DIV = "/tmp/ps_guzer_div.txt"
    os.cmd("rm -f " + MARCA_DIV)
    using open("/tmp/ps_guzer_div.ps", "w") as f {
        f.write("import guzer\n"
                + "action troca() {\n"
                + "    rot.text(\"TEXTO NOVO, BEM MAIOR QUE O QUE ESTAVA AQUI\")\n"
                + "    using open(\"" + MARCA_DIV + "\", \"w\") as g {\n"
                + "        g.write(\"sim\")\n"
                + "    }\n"
                + "}\n"
                + "app = guzer.UI(\"PS_DIV_TESTE\")\n"
                + "w = app.window()\n"
                + "w.stylesheet({ \"width\": \"400\", \"height\": \"300\" })\n"
                + "rot = app.p()\n"
                + "rot.text(\"velho\")\n"
                + "rot.stylesheet({ \"width\": \"400\", \"height\": \"60\" })\n"
                + "d = app.div(onclick=troca)\n"
                + "d.text(\"clique na div\")\n"
                + "d.stylesheet({ \"width\": \"400\", \"height\": \"200\" })\n"
                + "app.show()\n"
                + "post(\"fechou limpo\")\n")
    }
    using open("/tmp/ps_guzer_div.sh", "w") as f {
        f.write("#!/bin/bash\n"
                + "metacity --sm-disable --replace > /dev/null 2>&1 &\n"
                + "sleep 1\n"
                + "'" + sys.executable + "' /tmp/ps_guzer_div.ps > /tmp/ps_guzer_div_saida.txt 2>&1 &\n"
                + "APP=$!\n"
                + "for i in $(seq 1 100); do\n"
                + "  xdotool search --name PS_DIV_TESTE > /dev/null 2>&1 && break\n"
                + "  sleep 0.1\n"
                + "done\n"
                + "W=$(xdotool search --name PS_DIV_TESTE | head -1)\n"
                + "xdotool windowactivate --sync $W 2>/dev/null || true\n"
                + "sleep 1\n"
                + "eval $(xdotool getwindowgeometry --shell $W)\n"
                # varre a coluna: onde o layout pôs a div não importa
                + "for y in $(seq 10 10 200); do\n"
                + "  xdotool mousemove $((X+40)) $((Y+y)) click 1\n"
                + "  sleep 0.08\n"
                + "done\n"
                # o Expose que fazia o desenho ler o buffer já liberado
                + "sleep 0.5\n"
                + "xdotool windowsize $W 420 320; sleep 0.6\n"
                + "xdotool windowsize $W 400 300; sleep 0.8\n"
                + "wmctrl -i -c $W\n"
                + "sleep 1\n"
                + "wait $APP 2>/dev/null || true\n")
    }
    os.cmd("chmod +x /tmp/ps_guzer_div.sh")
    os.cmd("timeout 60 xvfb-run -a /tmp/ps_guzer_div.sh > /dev/null 2>&1")
    saida_div = ""
    if os.exists("/tmp/ps_guzer_div_saida.txt") {
        saida_div = open("/tmp/ps_guzer_div_saida.txt").read()
    }
    if os.exists(MARCA_DIV) {
        post("OK — div(onclick=action) despachou o clique")
    }
    else {
        post("ERRO: cliquei na div e o onclick nao rodou")
        post("   saida:", saida_div.strip())
        erros = erros + 1
    }
    # sair limpo importa duas vezes: grava o `.gcda` e prova que o redesenho
    # depois da troca de texto não derrubou o laço
    if "fechou limpo" in saida_div {
        post("OK — redesenhou depois da troca de texto e saiu limpo")
    }
    else {
        post("ERRO: nao saiu limpo depois de trocar o texto no handler")
        post("   saida:", saida_div.strip())
        erros = erros + 1
    }

    # ── R2. janela 0x0 ──────────────────────────────────────────────────────
    #
    # O X11 só aceita 1..32767. Com 0 o servidor responde BadValue e o
    # tratador PADRÃO do Xlib despeja o texto em C na stderr e chama exit(1):
    # a VM não vê nada, não levanta exceção, e tudo que vinha depois do show()
    # some. Largura negativa e largura absurda passavam — três jeitos de
    # escrever a mesma bobagem, e só um matava o processo.
    using open("/tmp/ps_guzer_zero.ps", "w") as f {
        f.write("import guzer\n"
                + "app = guzer.UI(\"PS_ZERO_TESTE\")\n"
                + "w = app.window()\n"
                + "w.stylesheet({ \"width\": \"0\", \"height\": \"0\" })\n"
                + "p = app.p()\n"
                + "p.text(\"a janela existe\")\n"
                + "app.show()\n"
                + "post(\"fechou limpo\")\n")
    }
    using open("/tmp/ps_guzer_zero.sh", "w") as f {
        f.write("#!/bin/bash\n"
                + "metacity --sm-disable --replace > /dev/null 2>&1 &\n"
                + "sleep 1\n"
                + "'" + sys.executable + "' /tmp/ps_guzer_zero.ps > /tmp/ps_guzer_zero_saida.txt 2>&1 &\n"
                + "APP=$!\n"
                + "for i in $(seq 1 100); do\n"
                + "  xdotool search --name PS_ZERO_TESTE > /dev/null 2>&1 && break\n"
                + "  sleep 0.1\n"
                + "done\n"
                + "W=$(xdotool search --name PS_ZERO_TESTE | head -1)\n"
                + "eval $(xdotool getwindowgeometry --shell $W)\n"
                + "echo \"TAMANHO $WIDTH x $HEIGHT\" > /tmp/ps_guzer_zero_medida.txt\n"
                + "sleep 0.5\n"
                + "wmctrl -i -c $W\n"
                + "sleep 1\n"
                + "wait $APP 2>/dev/null || true\n")
    }
    os.cmd("chmod +x /tmp/ps_guzer_zero.sh")
    os.cmd("timeout 60 xvfb-run -a /tmp/ps_guzer_zero.sh > /dev/null 2>&1")
    saida_zero = ""
    if os.exists("/tmp/ps_guzer_zero_saida.txt") {
        saida_zero = open("/tmp/ps_guzer_zero_saida.txt").read()
    }
    if "BadValue" in saida_zero or "X Error" in saida_zero {
        post("ERRO: janela 0x0 fez o Xlib matar o processo —", saida_zero.strip())
        erros = erros + 1
    }
    medida_zero = ""
    if os.exists("/tmp/ps_guzer_zero_medida.txt") {
        medida_zero = open("/tmp/ps_guzer_zero_medida.txt").read()
    }
    # 480x320 é o padrão de `ps_guz_run`: pedir 0 tem que cair nele, não matar
    erros = erros + conf_gz("janela 0x0 vira o tamanho padrao 480x320",
                            "TAMANHO 480 x 320" in medida_zero, medida_zero)
    if "fechou limpo" in saida_zero {
        post("OK — janela 0x0 cai no tamanho padrao e o script segue")
    }
    else {
        post("ERRO: janela 0x0 nao abriu nem seguiu —", saida_zero.strip())
        erros = erros + 1
    }

    # ── R3. o vídeo acabou, e a janela continua aberta ──────────────────────
    #
    # `guz_video_le` tratava EOF igual a EAGAIN: só `break`, sem fechar o fd.
    # O fd ficava no `poll` devolvendo POLLHUP na hora, sempre, e o laço virava
    # poll -> read 0 -> poll sem dormir um microssegundo: 100% de um núcleo
    # pelo resto da vida da janela, por um vídeo de UM SEGUNDO que já acabou.
    # Numa máquina de dois núcleos, metade do computador. E o ffmpeg/ffplay
    # ficavam zumbis segurando PID até a janela fechar.
    if tem_ff {
        using open("/tmp/ps_guzer_vid.ps", "w") as f {
            f.write("import guzer\n"
                    + "app = guzer.UI(\"PS_VID_TESTE\")\n"
                    + "w = app.window()\n"
                    + "w.stylesheet({ \"width\": \"200\", \"height\": \"150\" })\n"
                    + "v = app.video(src=\"/tmp/ps_guzer_v.mp4\")\n"
                    + "v.stylesheet({ \"width\": \"64\", \"height\": \"48\" })\n"
                    + "a = app.audio(src=\"/tmp/ps_guzer_a.wav\")\n"
                    + "app.show()\n"
                    + "post(\"fechou limpo\")\n")
        }
        using open("/tmp/ps_guzer_vid.sh", "w") as f {
            f.write("#!/bin/bash\n"
                    + "metacity --sm-disable --replace > /dev/null 2>&1 &\n"
                    + "sleep 1\n"
                    + "'" + sys.executable + "' /tmp/ps_guzer_vid.ps > /tmp/ps_guzer_vid_saida.txt 2>&1 &\n"
                    + "APP=$!\n"
                    + "sleep 6\n"          # o video tem 1s: ja acabou ha 5s
                    + "T1=$(awk '{print $14+$15}' /proc/$APP/stat)\n"
                    + "sleep 4\n"
                    + "T2=$(awk '{print $14+$15}' /proc/$APP/stat)\n"
                    # ARQUIVO SEPARADO, e não o do app: o app escreve com `>`
                    # e sai com stdout em buffer de bloco — a descarga final
                    # dele volta pro offset ZERO e passa POR CIMA da medição.
                    # `TICKS 0` virou `S 0` e o teste leu -1.
                    + "echo \"TICKS $((T2-T1))\" > /tmp/ps_guzer_vid_medida.txt\n"
                    + "echo \"ZUMBIS $(ps -o stat= --ppid $APP | grep -c Z)\""
                    + " >> /tmp/ps_guzer_vid_medida.txt\n"
                    + "W=$(xdotool search --name PS_VID_TESTE | head -1)\n"
                    + "wmctrl -i -c $W\n"
                    + "sleep 1\n"
                    + "wait $APP 2>/dev/null || true\n")
        }
        os.cmd("chmod +x /tmp/ps_guzer_vid.sh")
        os.cmd("timeout 60 xvfb-run -a /tmp/ps_guzer_vid.sh > /dev/null 2>&1")
        saida_vid = ""
        if os.exists("/tmp/ps_guzer_vid_saida.txt") {
            saida_vid = open("/tmp/ps_guzer_vid_saida.txt").read()
        }
        medida = ""
        if os.exists("/tmp/ps_guzer_vid_medida.txt") {
            medida = open("/tmp/ps_guzer_vid_medida.txt").read()
        }
        ticks = -1
        zumbis = -1
        for each lin in medida.split("\n") {
            if lin.startswith("TICKS ") {
                ticks = int(lin.split(" ")[1])
            }
            if lin.startswith("ZUMBIS ") {
                zumbis = int(lin.split(" ")[1])
            }
        }
        # 400 ticks = 100% de um núcleo em 4s. O limite é generoso de
        # propósito: o que se mede aqui é rodar SOLTO, não jitter.
        if ticks >= 0 and ticks < 40 {
            post("OK — video acabado nao queima CPU (" + str(ticks) + " ticks em 4s)")
        }
        else {
            post("ERRO: video acabado gira o laco —", str(ticks), "ticks em 4s (limite 40)")
            post("   saida:", saida_vid.strip())
            erros = erros + 1
        }
        if zumbis == 0 {
            post("OK — ffmpeg e ffplay foram colhidos, sem zumbi")
        }
        else {
            post("ERRO: sobraram", str(zumbis), "filho(s) zumbi depois do video")
            erros = erros + 1
        }
    }
    else {
        post("PULOU R3 — falta ffmpeg/ffplay")
    }

    # ── R4. cor de 3 dígitos, e cor que não é cor ───────────────────────────
    #
    # `guz_cor_val` só exigia `strlen >= 6` e jogava a string inteira no
    # `strtoul(s, NULL, 16)`. Duas consequências, e elas discordavam entre si:
    # texto de 6+ letras que não é hexadecimal ("yellow", "salmon") fazia o
    # strtoul não consumir nada e devolver 0 — o elemento ficava PRETO, cor que
    # ninguém pediu; e o MESMO erro escrito curto ("red", "#fff") caía no `< 6`
    # e mantinha o default. `#fff` é o exemplo da própria doc
    # (docs/guzer/stylesheet/stylesheet.md), e era silenciosamente ignorado.
    #
    # A prova é o PIXEL: abre a janela, tira um xwd e conta. Conferir a cor de
    # outro jeito seria conferir o que o motor guardou, não o que ele pintou.
    action pinta(nome, cor) {
        using open("/tmp/ps_guzer_cor.ps", "w") as f {
            f.write("import guzer\n"
                    + "app = guzer.UI(\"" + nome + "\")\n"
                    + "w = app.window()\n"
                    + "w.stylesheet({ \"width\": \"120\", \"height\": \"90\","
                    + " \"bg\": \"" + cor + "\" })\n"
                    + "app.show()\n")
        }
        using open("/tmp/ps_guzer_cor.sh", "w") as f {
            f.write("#!/bin/bash\n"
                    + "metacity --sm-disable --replace > /dev/null 2>&1 &\n"
                    + "sleep 1\n"
                    + "'" + sys.executable + "' /tmp/ps_guzer_cor.ps > /dev/null 2>&1 &\n"
                    + "APP=$!\n"
                    + "for i in $(seq 1 100); do\n"
                    + "  xdotool search --name " + nome + " > /dev/null 2>&1 && break\n"
                    + "  sleep 0.1\n"
                    + "done\n"
                    + "sleep 1\n"
                    + "W=$(xdotool search --name " + nome + " | head -1)\n"
                    + "xwd -id $W -silent > /tmp/ps_guzer_cor.xwd 2>/dev/null\n"
                    + "wmctrl -i -c $W\n"
                    + "sleep 1\n"
                    + "wait $APP 2>/dev/null || true\n")
        }
        os.cmd("rm -f /tmp/ps_guzer_cor.xwd; chmod +x /tmp/ps_guzer_cor.sh")
        os.cmd("timeout 40 xvfb-run -a /tmp/ps_guzer_cor.sh > /dev/null 2>&1")
        if not os.exists("/tmp/ps_guzer_cor.xwd") {
            return [-1, -1, -1]
        }
        b = open("/tmp/ps_guzer_cor.xwd", "rb").read()
        # varre byte a byte: o cabeçalho do xwd não é múltiplo de 4, então
        # começar em 0 e pular de 4 em 4 pega a fase errada e não acha nada
        verde = 0
        branco = 0
        preto = 0
        i = 0
        n = len(b) - 4
        while i < n {
            if b[i] == 0 and b[i+1] == 255 and b[i+2] == 0 and b[i+3] == 0 {
                verde = verde + 1
            }
            if b[i] == 255 and b[i+1] == 255 and b[i+2] == 255 and b[i+3] == 0 {
                branco = branco + 1
            }
            if b[i] == 0 and b[i+1] == 0 and b[i+2] == 0 and b[i+3] == 0 {
                preto = preto + 1
            }
            i = i + 1
        }
        return [verde, branco, preto]
    }

    if tem("xwd") {
        c = pinta("PS_COR_TESTE", "#0f0")
        # 120x90 = 10800 pixels; a janela inteira é do bg
        erros = erros + conf_gz("cor de 3 digitos (#0f0) pinta VERDE",
                                c[0] > 9000, "verde=" + str(c[0]) + " branco=" + str(c[1])
                                + " preto=" + str(c[2]))
        c = pinta("PS_COR_RUIM", "yellow")
        erros = erros + conf_gz("cor invalida cai no DEFAULT, nao em preto",
                                c[1] > 9000 and c[2] < 1000,
                                "verde=" + str(c[0]) + " branco=" + str(c[1])
                                + " preto=" + str(c[2]))
    }
    else {
        post("PULOU R4 — falta xwd")
    }

    if erros > 0 {
        sys.exit(1)
    }
    post("OK — janela abriu, desenhou, despachou clique e fechou")
    sys.exit(0)
}

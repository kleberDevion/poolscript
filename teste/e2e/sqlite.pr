# sqlite3 / PoolConnection (5) / PoolCursor (8) — banco LOCAL, então dá pra
# exercitar tudo sem servidor. Cada método é chamado de verdade e o efeito é
# conferido lendo de volta.
import sqlite3
import os

# O banco fica numa pasta RELATIVA à corrente, criada aqui e apagada no fim
# pelo próprio motor. Era "/tmp/ps_e2e.db", apagado com `os.run(["rm", "-f",
# ...])`, e isso só vale inteiro no Linux e no macOS. No Windows o motor é
# nativo: "/tmp/ps_e2e.db" é "<disco>:\tmp\ps_e2e.db", na raiz do disco
# corrente, e sem essa pasta o `connect` cai em "unable to open database
# file". E `rm` não é programa do Windows: o que o `os.run` acha no PATH do CI
# é o do MSYS2, que lê "/tmp/..." como o /tmp DELE — o `-f` calava o "não
# existe", o banco da rodada anterior ficava, e o `CREATE TABLE` da seguinte
# caía em "table t already exists".
pasta = "ps_e2e_sqlite"
if os.exists(pasta) {
    os.rmdir(pasta, force=True)       # sobra de uma rodada que caiu no meio
}
os.mkdir(pasta)
arq = pasta + "/ps_e2e.db"

con = sqlite3.connect(arq)
post("connect ->", type(con))

# ── PoolConnection.execute / cursor ─────────────────────────────────────────
con.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, nome TEXT, n INT)")
cur = con.cursor()
post("cursor ->", type(cur))

# ── PoolCursor.execute + lastrowid ──────────────────────────────────────────
cur.execute("INSERT INTO t (nome, n) VALUES (?, ?)", ("ana", 1))
post("lastrowid ->", cur.lastrowid)

# ── executemany + rowcount ──────────────────────────────────────────────────
cur.executemany("INSERT INTO t (nome, n) VALUES (?, ?)",
                [("bia", 2), ("caio", 3), ("dan", 4)])
post("rowcount ->", cur.rowcount)

con.commit()

# ── fetchone / fetchmany / fetchall ─────────────────────────────────────────
cur.execute("SELECT nome, n FROM t ORDER BY id")
post("fetchone ->", cur.fetchone())

cur.execute("SELECT nome FROM t ORDER BY id")
post("fetchmany(2) ->", cur.fetchmany(2))

cur.execute("SELECT nome, n FROM t ORDER BY id")
post("fetchall ->", cur.fetchall())

# ── rollback desfaz o que não foi commitado ─────────────────────────────────
cur.execute("INSERT INTO t (nome, n) VALUES ('temp', 9)")
con.rollback()
cur.execute("SELECT count(*) FROM t")
post("apos rollback ->", cur.fetchone())

# ── close ───────────────────────────────────────────────────────────────────
cur.close()
con.close()
post("fechou ->", "ok")

# A pasta sai com o banco dentro, pelo motor e na hora. O `rm` de antes ia
# sem `capture`, em segundo plano, e ninguém esperava ele terminar. Vem
# DEPOIS dos dois `close()`: no Windows o arquivo que a sqlite mantém aberto
# não se apaga.
os.rmdir(pasta, force=True)
post("fim")

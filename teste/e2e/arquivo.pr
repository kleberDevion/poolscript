# Arquivo (7 metodos) e PoolFile (9) — recurso LOCAL, entao da pra exercitar
# de ponta a ponta sem rede nem banco. Cada metodo e chamado de verdade e o
# efeito e conferido lendo de volta.
import os
import sys
import qrcode

# A pasta de trabalho é /tmp no Linux e no macOS. No Windows o motor é nativo
# e "/tmp/ps_e2e" é "<disco>:\tmp\ps_e2e", na raiz do disco corrente — não o
# /tmp do MSYS2 —, e o `os.mkdir`, que cria a cadeia inteira, deixaria a pasta
# \tmp na raiz do disco depois do teste. Então lá ela é uma subpasta da pasta
# corrente, criada aqui e apagada no fim como a de /tmp. Relativa, e não
# `os.cwd()` + nome: o `os.loadFile` só trata como absoluto o caminho que
# começa com "/", e um "<disco>:\..." cai na busca pelo nome e volta
# FileNotFoundError.
dir = "/tmp/ps_e2e"
if sys.platform() == "windows" {
    dir = "ps_e2e_arquivo"
}
if not os.exists(dir) {
    os.mkdir(dir)
}

# ── Arquivo: write / writelines / read / readline / readlines / close ───────
p = dir + "/a.txt"
f = open(p, "w")
post("write ->", f.write("linha1\n"))
f.writelines(["linha2\n", "linha3\n"])
f.close()

using open(p) as g {
    post("readline ->", g.readline().strip())
    post("readlines ->", g.readlines())
}

using open(p) as g {
    post("read ->", len(g.read()))
}

# read parcial nao consome o resto
using open(p) as g {
    post("read(3) ->", g.read(3))
    post("resto ->", len(g.read()))
}

# ── modo binario ────────────────────────────────────────────────────────────
pb = dir + "/b.bin"
using open(pb, "wb") as f {
    f.write("oi".encode())
    f.writelines(["!".encode()])
}
using open(pb, "rb") as f {
    post("binario ->", f.read())
}

# ── Arquivo.save ────────────────────────────────────────────────────────────
using open(p) as g {
    g.save(dir + "/copia.txt")
}
post("save copiou ->", os.exists(dir + "/copia.txt"))

# ── PoolFile: path/name/ext/size/bytes/save/copy/move/delete ────────────────
# `loadFile` devolve str pra texto e PoolFile pra BINÁRIO — decide pelo
# CONTEÚDO, não pela extensão. O .png é gerado pelo próprio motor (qrcode),
# então é um PNG de verdade: um "oi!" gravado num .png seria texto (vira str)
# e o sistema reclamaria do arquivo.
# `path` é MÉTODO; `name`, `ext` e `size` são CAMPOS (sem parênteses) — é o
# que o `pool --metadata` declara ("kind": "property").
pb = dir + "/b.png"
qrcode.make("oi").save(pb)
pf = os.loadFile(pb)
post("path ->", pf.path().endswith("b.png"))
post("name ->", pf.name)
post("ext ->", pf.ext)
post("size ->", pf.size)
post("bytes ->", len(pf.bytes()))

pf.save(dir + "/salvo.png")
post("PoolFile.save ->", os.exists(dir + "/salvo.png"))

pf.copy(dir + "/copiado.png")
post("copy ->", os.exists(dir + "/copiado.png"))

pf2 = os.loadFile(dir + "/copiado.png")
pf2.move(dir + "/movido.png")
post("move ->", os.exists(dir + "/movido.png"), os.exists(dir + "/copiado.png"))

pf3 = os.loadFile(dir + "/movido.png")
pf3.delete()
post("delete ->", os.exists(dir + "/movido.png"))

# rmdir só remove diretório VAZIO: apaga o conteúdo antes.
# `os.ls` devolve dicts {name, type, size}, não strings.
for each ent in os.ls(dir) {
    # Apaga pelo próprio motor, na hora: o `rmdir` logo abaixo já acha a
    # pasta vazia. Era `os.run(["rm", "-f", ...], true)`, e o `rm` não é do
    # Windows (só o do MSYS2, e só com ele no PATH); o do MSYS2 lê "/tmp/..."
    # como o /tmp DELE, não o do motor — o `-f` calava o "não existe" e o
    # `rmdir` caía em "Directory not empty". `mode="rb"` devolve PoolFile pra
    # QUALQUER arquivo, texto também, e o PoolFile tem `delete()`. O
    # `delete()` não levanta quando o arquivo não sai: quem acusa é o `rmdir`
    # SEM `force`, logo abaixo.
    os.loadFile(dir + "/" + ent["name"], mode="rb").delete()
}
os.rmdir(dir)
post("fim")

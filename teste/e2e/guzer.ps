# API de controle
# `button` e `window` são o mesmo objeto de Elemento, mas o `type()` os
# rotula "Button"/"Window" (documentado em guzer/button e guzer/window).
bt = app.button()
if type(bt) != "Button":
    post("ERRO UI.button ->", type(bt))
    erros = erros + 1
if type(w) != "Window":
    post("ERRO UI.window ->", type(w))
    erros = erros + 1
# e por serem Elemento, respondem aos membros dele
bt.text("clique")
if bt.value != "clique":
    post("ERRO Button.text ->", bt.value)
    erros = erros + 1
if type(bt.div()) != "div":
    post("ERRO Button.div ->", type(bt.div()))
    erros = erros + 1
if type(w.p()) != "p":
    post("ERRO Window.p ->", type(w.p()))
    erros = erros + 1
n = n + 5
nomeado = app.entry(name="campo", value="v")
achado = app.POOLHTMLElements.getitemByIdentify("campo")
if achado.value != "v":
    post("ERRO getitemByIdentify ->", achado.value)
    erros = erros + 1
n = n + 1
raiz.stylesheet("color: red;")
raiz.text("conteudo")
if raiz.value != "conteudo":
    post("ERRO Elemento.text ->", raiz.value)
    erros = erros + 1
n = n + 2
app.show()
n = n + 1

post("membros exercitados:", n)
if erros == 0:
    post("OK — guzer inteiro responde")
else:
    post("FALHA —", erros, "erro(s)")

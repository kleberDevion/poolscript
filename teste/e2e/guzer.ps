# guzer UI (85) e Elemento (84) — GERADO por teste/geradores/guzer.py.
#
# Roda com GUZER_HEADLESS=1: o motor monta a árvore inteira e NÃO abre a
# janela (sem isso o script trava esperando o usuário fechar). Cada
# elemento é criado nos dois lugares — direto na UI e ANINHADO dentro de
# outro elemento — e o `type()` tem que devolver a tag.

import guzer
app = guzer.UI()
w = app.window()
raiz = app.div()
erros = 0
n = 0

# a
a = app.a()
b = raiz.a()
n = n + 2
if type(a) != "a":
    post("ERRO UI.a ->", type(a))
    erros = erros + 1
if type(b) != "a":
    post("ERRO Elemento.a ->", type(b))
    erros = erros + 1

# psodbc: DbConnection (3) e DbCursor (6) contra PostgreSQL e MySQL de VERDADE.
#
# Precisa do usuário/banco de teste (veja teste/e2e/LEIAME.md). SÓ a conexão
# fica dentro de `try`: banco fora do ar é PULOU, com o motivo. Todo o resto
# roda FORA de catch — erro depois de conectar é bug do driver e derruba o
# script com rc != 0. A versão antiga envolvia o exercício inteiro no try, e
# aí bug real e serviço ausente eram o mesmo "PULOU": falso verde.
#
# A porta de cada banco pode vir do ambiente (PS_E2E_PG_PORTA,
# PS_E2E_MY_PORTA, PS_E2E_MS_PORTA; sem ela, a padrão), pra rodar contra um
# banco de teste sem encostar no que já ocupa a porta padrão da máquina. O SQL
# Server (driver `mssql`, o ODBC 18 da Microsoft) entra com o usuário `sa` e a
# senha de PS_E2E_MS_SENHA; sem a senha, PULOU.
import psodbc
import sys
import os

falhas = []
ok = 0

funct confere(nome, cond) {
    global ok
    if cond {
        ok = ok + 1
    }
    else {
        addEnd(falhas, nome)
        post("  FALHOU:", nome)
    }
}

funct conecta(drv, porta) {
    return psodbc.connect(driver=drv, host="127.0.0.1", port=porta,
                          user="ps_teste", password="ps_teste",
                          database="ps_teste")
}

int funct porta_de(str var, int padrao) {
    str v = os.getenv(var, "")
    if v == "" {
        return padrao
    }
    return int(v)
}

funct exercita(nome, drv, porta) {
    post("=====", nome)
    con = conecta(drv, porta)
    cur = con.cursor()

    cur.execute("DROP TABLE IF EXISTS t")
    cur.execute("CREATE TABLE t (id INT, nome VARCHAR(20))")
    cur.execute("INSERT INTO t (id, nome) VALUES (1, 'ana')")
    cur.execute("INSERT INTO t (id, nome) VALUES (2, 'bia')")
    cur.execute("INSERT INTO t (id, nome) VALUES (3, 'caio')")
    con.commit()

    cur.execute("SELECT id, nome FROM t ORDER BY id")
    r = cur.fetchone()
    confere(nome + ": fetchone devolve a primeira linha",
            r != Null and r["id"] == 1 and r["nome"] == "ana")

    cur.execute("SELECT nome FROM t ORDER BY id")
    r = cur.fetchmany(2)
    confere(nome + ": fetchmany(2) devolve as duas primeiras",
            len(r) == 2 and r[0]["nome"] == "ana" and r[1]["nome"] == "bia")

    cur.execute("SELECT id, nome FROM t ORDER BY id")
    r = cur.fetchall()
    confere(nome + ": fetchall devolve as 3 linhas em ordem",
            len(r) == 3 and r[2]["id"] == 3 and r[2]["nome"] == "caio")
    # SQLRowCount pra SELECT é definido pelo driver (pode ser -1); o que não
    # pode é inventar um número errado.
    confere(nome + ": rowcount é 3 ou o -1 que o ODBC permite",
            cur.rowcount == 3 or cur.rowcount == -1)

    # parâmetro ligado (?) — o que protege de injeção
    cur.execute("SELECT nome FROM t WHERE id = ?", (2,))
    r = cur.fetchall()
    confere(nome + ": parâmetro ligado filtra de verdade",
            len(r) == 1 and r[0]["nome"] == "bia")

    # O parâmetro vai com o TIPO do valor. O mysql monta a query com o valor
    # dentro, e mandava tudo entre aspas: `LIMIT '2'` era erro de sintaxe,
    # `True` virava 'True' (= 0, casava com FALSE) e `'41' + 1` virava float.
    cur.execute("SELECT id FROM t ORDER BY id LIMIT ? OFFSET ?", (2, 1))
    r = cur.fetchall()
    confere(nome + ": int em LIMIT/OFFSET", len(r) == 2 and r[0]["id"] == 2 and r[1]["id"] == 3)
    cur.execute("SELECT ? + 1 AS v", (41,))
    r = cur.fetchone()["v"]
    confere(nome + ": int em conta continua int", r == 42 and type(r) == "int")
    cur.execute("DROP TABLE IF EXISTS tb")
    cur.execute("CREATE TABLE tb (id INT, ativo BOOLEAN, preco FLOAT)")
    cur.execute("INSERT INTO tb (id, ativo, preco) VALUES (?, ?, ?)", (1, True, 2.5))
    cur.execute("INSERT INTO tb (id, ativo, preco) VALUES (?, ?, ?)", (2, False, 7.25))
    con.commit()
    cur.execute("SELECT id FROM tb WHERE ativo = ?", (True,))
    r = cur.fetchall()
    confere(nome + ": bool true casa so com a linha true", len(r) == 1 and r[0]["id"] == 1)
    cur.execute("SELECT id FROM tb WHERE ativo = ?", (False,))
    r = cur.fetchall()
    confere(nome + ": bool false casa so com a linha false", len(r) == 1 and r[0]["id"] == 2)
    cur.execute("SELECT id FROM tb WHERE preco = ?", (7.25,))
    r = cur.fetchall()
    confere(nome + ": flo como parametro", len(r) == 1 and r[0]["id"] == 2)
    cur.execute("SELECT id FROM tb WHERE ? = 'a''b'", ("a'b",))
    confere(nome + ": texto com aspa segue escapado", len(cur.fetchall()) == 2)
    cur.execute("DROP TABLE IF EXISTS tb")
    con.commit()

    # ── o SQL que roda é o SQL que foi escrito ──────────────────────────────
    # motor-4: o mysql recusava o SQL acima de 16 KB e o postgres com
    # parâmetro acima de 8 KB ("sql grande demais"). Vai inteiro, e o valor
    # longo volta inteiro.
    cur.execute("SELECT ? + 1 AS v, '" + "x" * 20000 + "' AS longo", (7,))
    r = cur.fetchone()
    confere(nome + ": SQL de mais de 20 KB com parâmetro", r["v"] == 8 and len(r["longo"]) == 20000)
    # motor-29: o SQL com NUL rodava até o NUL
    erro_msg = ""
    try {
        cur.execute("SELECT id FROM t\x00 WHERE id = 1")
        erro_msg = "NAO LEVANTOU"
    } catch (DatabaseError e) {
        erro_msg = str(e)
    }
    confere(nome + ": NUL no SQL recusa", "null character" in erro_msg)
    # motor-30: o parâmetro com NUL ia cortado. O postgres não guarda NUL em
    # texto e recusa (a frase do psycopg2); o mysql grava e devolve igual.
    cur.execute("DROP TABLE IF EXISTS tn")
    cur.execute("CREATE TABLE tn (s VARCHAR(10))")
    con.commit()
    if drv == "postgres" {
        erro_msg = ""
        try {
            cur.execute("INSERT INTO tn (s) VALUES (?)", ("a\x00b",))
            erro_msg = "NAO LEVANTOU"
        } catch (DatabaseError e) {
            erro_msg = str(e)
        }
        confere(nome + ": parâmetro com NUL recusa", "cannot contain NUL" in erro_msg)
    } else {
        cur.execute("INSERT INTO tn (s) VALUES (?)", ("a\x00b",))
        con.commit()
        cur.execute("SELECT s FROM tn")
        r = cur.fetchone()
        confere(nome + ": parâmetro com NUL vai e volta inteiro", r["s"] == "a\x00b")
    }
    cur.execute("DROP TABLE IF EXISTS tn")
    con.commit()

    # ── ERRO: o caminho que decide se o defeito aparece ou some ─────────────
    #
    # Todo o exercício acima é caminho feliz, e por isso `odbc_erro`
    # (`SQLGetDiagRec`, 64 ramos — a maior região descoberta de `ps_db.c`) nunca
    # rodava: ele só executa quando uma chamada FALHA. O que se exige aqui não é
    # "dá erro": é que o erro chegue na linguagem como EXCEÇÃO, com mensagem
    # dizendo o que houve. Erro de banco engolido vira dado errado em silêncio.
    erro_msg = ""
    try {
        cur.execute("SELECT * FROM tabela_que_nao_existe_mesmo")
        erro_msg = "NAO LEVANTOU"
    }
    catch (e) {
        erro_msg = str(e)
    }
    confere(nome + ": tabela inexistente levanta", erro_msg != "NAO LEVANTOU")
    confere(nome + ": e a mensagem diz o nome da tabela",
            "tabela_que_nao_existe_mesmo" in erro_msg)

    erro_msg = ""
    try {
        cur.execute("ISTO NAO E SQL DE JEITO NENHUM")
        erro_msg = "NAO LEVANTOU"
    }
    catch (e) {
        erro_msg = str(e)
    }
    confere(nome + ": sintaxe SQL inválida levanta", erro_msg != "NAO LEVANTOU")

    # coluna que não existe, e tipo errado no parâmetro
    erro_msg = ""
    try {
        cur.execute("SELECT coluna_inexistente FROM t")
        erro_msg = "NAO LEVANTOU"
    }
    catch (e) {
        erro_msg = str(e)
    }
    confere(nome + ": coluna inexistente levanta", erro_msg != "NAO LEVANTOU")

    # a conexão SOBREVIVE ao erro: depois de levantar, ainda dá pra consultar.
    # Driver que fica inutilizável depois de um SQL torto obriga o usuário a
    # reconectar a cada erro — e isso não está em contrato nenhum.
    cur.execute("SELECT id FROM t ORDER BY id")
    confere(nome + ": a conexão continua usável depois do erro",
            len(cur.fetchall()) == 3)

    # fetch ANTES de qualquer execute, e depois de esgotar o resultado
    cur.execute("SELECT id FROM t WHERE id = 999")
    confere(nome + ": fetchone sem linhas devolve Null", cur.fetchone() == Null)
    confere(nome + ": fetchall sem linhas devolve lista vazia", len(cur.fetchall()) == 0)

    # número de parâmetros ligados diferente do número de `?`
    erro_msg = ""
    try {
        cur.execute("SELECT nome FROM t WHERE id = ? AND nome = ?", (2,))
        erro_msg = "NAO LEVANTOU"
    }
    catch (e) {
        erro_msg = str(e)
    }
    confere(nome + ": parâmetros a menos levanta", erro_msg != "NAO LEVANTOU")

    cur.execute("DROP TABLE t")
    con.commit()

    # CURSOR FECHADO — contrato decidido em 28/08: `close()` fecha de verdade.
    #
    # Antes, `close()` só liberava o statement e um `execute()` seguinte
    # preparava outro e funcionava. Este teste travou aquele comportamento como
    # ARMADILHA — não fingia que levantava (nada de falso verde), e reprovaria
    # no dia em que alguém implementasse o erro. Foi o que aconteceu: disparou,
    # e esta é a atualização que ele obrigou.
    #
    # O tipo é `DatabaseError` e não `ProgrammingError`: o PEP 249 pede o
    # segundo, mas ele não existe nesta linguagem, e criar tipo de exceção novo
    # é decisão de API.
    #
    # As QUATRO operações têm que recusar, não só o `execute` — um `fetchall`
    # depois do `close()` lendo o resultado velho é dado obsoleto entregue como
    # atual, que é pior que erro.
    cur.close()
    for each op in ["execute", "fetchall", "fetchone", "fetchmany"] {
        levantou = False
        tipo = ""
        try {
            if op == "execute" {
                cur.execute("SELECT 1")
            }
            elif op == "fetchall" {
                cur.fetchall()
            }
            elif op == "fetchone" {
                cur.fetchone()
            }
            else {
                cur.fetchmany(1)
            }
        }
        catch (e) {
            levantou = True
            tipo = str(e)
        }
        confere(nome + ": " + op + "() depois de close() recusa", levantou)
        confere(nome + ": e o erro cita o cursor fechado", "fechado" in tipo)
    }
    # fechar duas vezes continua válido: nenhum DB-API trata isso como erro
    cur.close()
    confere(nome + ": close() duas vezes é inofensivo", True)

    con.close()
    # e a conexão fechada duas vezes não pode quebrar
    con.close()
    confere(nome + ": fechar a conexão duas vezes é inofensivo", True)
    post(nome, "-> ok")
}

# O SQL Server, pelo ODBC: o que o caminho dele corta ou recusa.
Null funct exercita_mssql(DbConnection con) {
    post("===== mssql")
    DbCursor cur = con.cursor()
    # motor-32: cada valor vinha num buffer de 4 KB, com uma leitura só, e o
    # maior voltava cortado
    cur.execute("SELECT REPLICATE(CAST('x' AS VARCHAR(MAX)), 10000) AS v")
    confere("mssql: valor de 10 KB volta inteiro", len(cur.fetchone()["v"]) == 10000)
    # motor-4: o ODBC recusava o SQL acima de 16 KB
    cur.execute("SELECT ? + 1 AS v, '" + "x" * 20000 + "' AS longo", (7,))
    dict r = cur.fetchone()
    confere("mssql: SQL de mais de 20 KB com parâmetro", r["v"] == 8 and len(r["longo"]) == 20000)
    # motor-30: o parâmetro ia até o NUL
    cur.execute("SELECT ? AS s", ("a\x00b",))
    confere("mssql: parâmetro com NUL vai e volta inteiro", cur.fetchone()["s"] == "a\x00b")
    con.close()
    post("mssql -> ok")
}

for each alvo in [["postgres", "postgres", porta_de("PS_E2E_PG_PORTA", 5432)],
                  ["mysql", "mysql", porta_de("PS_E2E_MY_PORTA", 3306)]] {
    de_pe = False
    try {
        c = conecta(alvo[1], alvo[2])
        c.close()
        de_pe = True
    }
    catch (e) {
        post("PULOU", alvo[0], "->", e)
    }
    if de_pe {
        exercita(alvo[0], alvo[1], alvo[2])
    }
}

DbConnection funct conecta_ms(str senha) {
    return psodbc.connect(driver="mssql", host="127.0.0.1", port=porta_de("PS_E2E_MS_PORTA", 1433),
                          user="sa", password=senha, database="master")
}

str senha_ms = os.getenv("PS_E2E_MS_SENHA", "")
if senha_ms == "" {
    post("PULOU mssql -> sem PS_E2E_MS_SENHA")
} else {
    bool ms_de_pe = False
    try {
        DbConnection teste_ms = conecta_ms(senha_ms)
        teste_ms.close()
        ms_de_pe = True
    } catch (e) {
        post("PULOU mssql ->", e)
    }
    if ms_de_pe {
        exercita_mssql(conecta_ms(senha_ms))
    }
}

post("fim")
if len(falhas) > 0 {
    post("FALHARAM:", len(falhas))
    sys.exit(1)
}

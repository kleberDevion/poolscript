# Cliente: bate no jinker que `jinker_srv.ps` subiu. Exercita a lib `request`,
# o tipo `Response` (12 membros) e, do outro lado, o `RequestProxy` (11).
import request

U = "http://127.0.0.1:28840"

r = request.get(U + "/oi")
post("status_code ->", r.status_code)
post("ok ->", r.ok)
post("text ->", r.text)
post("content ->", r.content)
post("size ->", r.size)
# content_type(esperado) AFIRMA o tipo e devolve a resposta pra encadear
post("content_type ->", type(r.content_type("text/plain")))
post("decode ->", r.decode())

j = request.get(U + "/json")
post("get_json ->", j.get_json())
post("get(chave) ->", j.get("a"))
post("json ->", j.json())

# ── POST com corpo JSON: RequestProxy.get_json do outro lado ────────────────
e = request.post(U + "/eco", body={"x": 42})
post("eco ->", e.get_json())

# ── path_param ──────────────────────────────────────────────────────────────
post("path_param ->", request.get(U + "/param/ana").text)

# ── header ──────────────────────────────────────────────────────────────────
h = request.get(U + "/hdr", headers={"X-Teste": "valor"})
post("header ->", h.get_json())

# ── cada verbo chega como o método certo ────────────────────────────────────
post("GET ->", request.get(U + "/metodo").text)
post("POST ->", request.post(U + "/metodo").text)
post("PUT ->", request.put(U + "/metodo").text)
post("DELETE ->", request.delete(U + "/metodo").text)

# ── HEAD: mesmos headers, sem corpo ─────────────────────────────────────────
hd = request.head(U + "/oi")
post("HEAD status ->", hd.status_code, "corpo vazio ->", len(hd.text) == 0)

# ── JinkerResponse: status + header + json encadeados ───────────────────────
s = request.get(U + "/status")
post("status 418 ->", s.status_code, s.get_json())
post("header da resposta ->", s.headers["X-Bule"])

# ── formas de retorno que a rota converte sozinha ───────────────────────────
t = request.get(U + "/tupla")
post("tupla (corpo, status) ->", t.status_code, t.get_json())
post("Null -> 204 ->", request.get(U + "/vazio").status_code)
post("send ->", request.get(U + "/send").text)
post("jsonify ->", request.get(U + "/jsonify").get_json())

# ── rota inexistente ────────────────────────────────────────────────────────
post("404 ->", request.get(U + "/nao-existe").status_code)

# ── middleware: barra sem a chave, libera com ela ───────────────────────────
post("middleware barra ->", request.get(U + "/protegida").status_code)
ok = request.get(U + "/protegida", headers={"X-Chave": "abre"})
post("middleware libera ->", ok.status_code, ok.get_json())

# ── CorsConfig: options/origins/permiser ────────────────────────────────────
post("cors ->", request.get(U + "/cors-info").get_json())

# ── static_folder: arquivo servido da pasta, sem rota declarada ─────────────
est = request.get(U + "/pagina.txt")
post("static ->", est.status_code, est.text)

# ── Response.filename: vem do Content-Disposition ───────────────────────────
b = request.get(U + "/baixar")
post("filename ->", b.filename, "| corpo ->", b.text.strip())

# ── upload: PoolFileUpload atravessando de verdade ──────────────────────────
alvo = "/tmp/ps_e2e_envio.txt"
using open(alvo, "w") as arq:
    arq.write("conteudo enviado")

u = request.post(U + "/upload", file={"arq": alvo})
post("upload ->", u.get_json())
post("salvou no servidor ->", open("/tmp/ps_upload_recebido.txt").read())

m = request.post(U + "/uploads", file={"fotos": {"name": alvo}})
post("files(campo) ->", m.get_json())

# ── emit sem ninguém no canal: alcança 0, mas não é falha ───────────────────
post("emitir ->", request.get(U + "/emitir").get_json())

# ── WebSocket sem canal: handler roda, mas nada volta pro cliente ───────────
eco = request.ws_connect("ws://127.0.0.1:28841/ws")
vindas = []
eco.on_message(action(m) { vindas.append(m) })
eco.send("pingue")
sleep(1)
post("sem canal, cliente recebe ->", vindas)                       # []
post("mas o handler rodou ->", open("/tmp/ps_ws_sem_canal.txt").read())
eco.close()

# ── WebSocket: dois clientes, um só ouvindo ─────────────────────────────────
# O ouvinte fica parado num `sleep` — é aí que o defeito aparecia: fora de
# fibra o sleep não drenava a conexão e a mensagem só saía no close().
WS = "ws://127.0.0.1:28841/sala"
recebidas = []

ouvinte = request.ws_connect(WS)
ouvinte.on_message(action(m) { recebidas.append(m) })

falante = request.ws_connect(WS)
falante.send("oi da outra ponta")

sleep(2)                      # tem que chegar DURANTE a espera, não no close
post("ouvinte recebeu durante o sleep ->", recebidas)
post("status_send do emissor ->", open("/tmp/ps_ws_status.txt").read())

falante.close()
ouvinte.close()

post("fim")

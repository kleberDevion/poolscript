# MongoConnection (2) e MongoCollection (7) contra um mongod LOCAL.
# Sobe com:  mongod --dbpath /tmp/ps_mongo_db --port 27099 --bind_ip 127.0.0.1
#
# SÓ a conexão fica no `try` (mongod fora do ar = PULOU). O exercício roda
# fora de catch e cada resposta é CONFERIDA — erro ou valor errado derruba o
# script com rc != 0. Antes, o try cobria tudo e qualquer bug virava "PULOU".
import psodbc
import sys

falhas = []

funct confere(nome, cond) {
    if not cond {
        addEnd(falhas, nome)
        post("  FALHOU:", nome)
    }
}

con = Null
try {
    con = psodbc.connect(driver="mongo", host="127.0.0.1", port=27099,
                         database="ps_teste")
    # O `connect` do mongo é PREGUIÇOSO: ele monta o cliente e volta com
    # sucesso mesmo sem mongod nenhum no ar — quem descobre é a primeira
    # operação. Sem esta chamada de sondagem aqui DENTRO do try, o script
    # seguia com `con != Null`, estourava lá embaixo no `col.remove({})` e o
    # e2e inteiro reprovava com "No suitable servers found" — que é máquina
    # sem banco, não defeito da linguagem. Vermelho que não quer dizer nada
    # ensina a ignorar vermelho.
    con.collection("t").count({})
}
catch (e) {
    # PULOU só quando o motivo é NÃO TER SERVIDOR. Qualquer outro erro é
    # defeito e tem que reprovar: um `catch` que engole tudo transforma bug em
    # silêncio, e foi assim que a cobertura de `ps_mongo.c` caiu 2,5 pontos
    # numa medição sem ninguém entender por quê — o teste tinha pulado.
    msg = str(e)
    sem_servidor = ("No suitable servers" in msg or "connection refused" in msg
                    or "Name or service not known" in msg
                    or "server selection timeout" in msg)
    if not sem_servidor {
        post("ERRO na sondagem do mongo (nao e falta de servidor):", msg)
        sys.exit(1)
    }
    con = Null
    post("PULOU mongo ->", e)
}

if con != Null {
    col = con.collection("t")

    # limpa o que sobrou de uma execução anterior
    col.remove({})
    confere("coleção começa vazia", col.count({}) == 0)

    col.insert({"nome": "ana", "n": 1})
    col.insert_many([{"nome": "bia", "n": 2}, {"nome": "caio", "n": 3}])
    confere("insert + insert_many somam 3 documentos", col.count({}) == 3)

    r = col.find_one({"nome": "ana"})
    confere("find_one acha o documento certo", r != Null and r["n"] == 1)

    confere("find sem filtro devolve os 3", len(col.find({})) == 3)

    r = col.find({"n": 2})
    confere("find filtrado devolve só o que casa",
            len(r) == 1 and r[0]["nome"] == "bia")

    col.update({"nome": "ana"}, {"n": 99})
    r = col.find_one({"nome": "ana"})
    confere("update altera o campo", r != Null and r["n"] == 99)

    col.remove({"nome": "caio"})
    confere("remove tira só o que casa", col.count({}) == 2)

    col.remove({})
    con.close()
    post("mongo -> ok")
}

post("fim")
if len(falhas) > 0 {
    post("FALHARAM:", len(falhas))
    sys.exit(1)
}

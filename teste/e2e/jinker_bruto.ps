# Requisições HTTP CRUAS contra o jinker — o que a lib `request` nunca manda.
#
# POR QUE: a auditoria profunda de 2026-08-26 foi para onde a cobertura era
# zero e achou seis defeitos que nenhum cliente educado provoca. Todos da mesma
# família: requisição TORTA aceita com 200 em vez de recusada. Isso é
# *request smuggling* — um intermediário na frente interpreta o que mandaram de
# um jeito, nós de outro, e a diferença vira uma requisição que só um dos dois
# enxerga.
#
# Aqui os bytes são montados na mão e enviados por socket, porque é a única
# forma de escrever `Content-Length : 5` com espaço antes dos dois-pontos.
#
# Sobe com o servidor do par (ver teste/e2e_roda.ps).
import sockets
import sys

HOST = "127.0.0.1"
PORTA = 28840


# Manda os bytes exatos e devolve a primeira linha da resposta ("HTTP/1.1 400
# Bad Request"), ou "" se o servidor fechou sem responder.
action bate(cru) {
    s = sockets.socket()
    s.settimeout(5)
    if s.connect_ex((HOST, PORTA)) != 0 {
        return "SEM-CONEXAO"
    }
    s.send(cru.encode())
    resp = ""
    try {
        resp = s.recv(4096).decode()
    } catch (e) {
        resp = ""
    }
    s.close()
    if resp == "" {
        return "FECHOU-CALADO"
    }
    return resp.split("\r\n")[0]
}


action confere(nome, cru, esperado) {
    obtido = bate(cru)
    if esperado in obtido {
        post("  ok    ", nome, "->", obtido)
        return 0
    }
    post("  FALHOU", nome)
    post("          esperado conter:", esperado)
    post("          obtido         :", obtido)
    return 1
}


if __name__ == "main" {
    if bate("GET /oi HTTP/1.1\r\nHost: x\r\n\r\n") == "SEM-CONEXAO" {
        post("PULOU: nada escutando em", HOST + ":" + str(PORTA))
        sys.exit(0)
    }

    ruins = 0

    # ── requisição sã continua funcionando ──────────────────────────────────
    ruins = ruins + confere("GET normal",
        "GET /oi HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")
    ruins = ruins + confere("POST com Content-Length correto",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: 8\r\n\r\n{\"x\": 1}", "HTTP/1.1 200")

    # ── Transfer-Encoding: não implementamos, então tem que DIZER ───────────
    # Antes: 200 OK com corpo VAZIO. O cliente achava que mandou, o servidor
    # achava que não veio nada. RFC 9112 §6.3/§7.1 manda 501.
    ruins = ruins + confere("chunked -> 501, nao 200 de corpo vazio",
        "POST /eco HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n" +
        "5\r\nOLAAA\r\n0\r\n\r\n", "HTTP/1.1 501")

    # Os dois juntos dizem onde o corpo acaba, e discordar É o ataque.
    ruins = ruins + confere("Transfer-Encoding + Content-Length -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n" +
        "Transfer-Encoding: chunked\r\n\r\nOLAAA", "HTTP/1.1 400")

    # ── Content-Length duplicado ────────────────────────────────────────────
    # Antes: usava o primeiro, calado. O que estivesse na frente podia usar o
    # segundo — e o pedaço entre os dois tamanhos vira requisição fantasma.
    ruins = ruins + confere("Content-Length duplicado e diferente -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: 8\r\n" +
        "Content-Length: 6\r\n\r\n{\"x\": 1}", "HTTP/1.1 400")
    # Repetido com o MESMO valor é legal e colapsa em um.
    ruins = ruins + confere("Content-Length repetido igual -> 200",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: 8\r\n" +
        "Content-Length: 8\r\n\r\n{\"x\": 1}", "HTTP/1.1 200")

    # ── Content-Length que não é número ─────────────────────────────────────
    # Antes: `atol("abc")` = 0, corpo descartado em silêncio.
    ruins = ruins + confere("Content-Length: abc -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\nOLAAA", "HTTP/1.1 400")
    ruins = ruins + confere("Content-Length: 5x -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: 5x\r\n\r\nOLAAA", "HTTP/1.1 400")

    # ── espaço antes dos dois-pontos ────────────────────────────────────────
    # Citado NOMINALMENTE pela RFC 9112 §5.1 como vetor de smuggling. Antes, o
    # header virava um de nome "Content-Length " (com espaço), que nenhuma
    # busca acha: o header sumia e o corpo era descartado.
    ruins = ruins + confere("espaco antes do ':' -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length : 5\r\n\r\nOLAAA", "HTTP/1.1 400")

    # ── linha de header sem ':' ─────────────────────────────────────────────
    ruins = ruins + confere("header sem ':' -> 400",
        "GET /oi HTTP/1.1\r\nHost: x\r\nlixo sem dois pontos\r\n\r\n", "HTTP/1.1 400")

    # ── pipelining: duas requisicoes num UNICO write ────────────────────────
    # Antes: 1 resposta. As mesmas duas em writes separados davam 2 — ou seja,
    # keep-alive funcionava e pipelining nao. O `conn_consome` guardava o resto
    # no buffer, mas o laco so reagia a dado NOVO no socket, e esse ja tinha
    # saido de la.
    # Numa linha só: fora de parênteses, o `+` no fim da linha NÃO continua a
    # expressão — a quebra encerra o statement.
    uma = "GET /oi HTTP/1.1\r\nHost: x\r\n\r\n"
    duas = uma + uma
    s = sockets.socket()
    s.settimeout(5)
    s.connect_ex((HOST, PORTA))
    s.send(duas.encode())
    tudo = ""
    try {
        i = 0
        while i < 4 {
            pedaco = s.recv(4096).decode()
            if pedaco == "" {
                break
            }
            tudo = tudo + pedaco
            if tudo.count("HTTP/1.1") >= 2 {
                break
            }
            i = i + 1
        }
    } catch (e) {
        tudo = tudo
    }
    s.close()
    quantas = tudo.count("HTTP/1.1")
    if quantas >= 2 {
        post("  ok     pipelining: 2 requisicoes num write ->", str(quantas), "respostas")
    }
    else {
        post("  FALHOU pipelining: 2 requisicoes num write ->", str(quantas), "resposta(s)")
        ruins = ruins + 1
    }

    # ── profundidade vinda do cliente NÃO derruba o servidor ────────────────
    # Antes: `/fundo/300` matava o processo (recursão sem teto no `str`, sobre
    # a pilha de 128 KB da fibra), e o pedido seguinte tomava "Connection
    # refused". O que se exige aqui é justamente o PEDIDO SEGUINTE responder.
    ruins = ruins + confere("profundidade 300 do cliente nao mata o servidor",
        "GET /fundo/300 HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")
    ruins = ruins + confere("profundidade 5000 tambem nao",
        "GET /fundo/5000 HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")
    ruins = ruins + confere("e o servidor CONTINUA atendendo depois",
        "GET /oi HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")

    # ── linha de pedido TORTA ───────────────────────────────────────────────
    # O parser de requisição tinha 54 ramos em zero. Nenhum cliente educado
    # manda nada disto; um atacante manda todos.
    ruins = ruins + confere("sem espaco entre metodo e alvo",
        "GET/oi HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 400")
    ruins = ruins + confere("linha de pedido so com o metodo",
        "GET\r\nHost: x\r\n\r\n", "HTTP/1.1 400")
    ruins = ruins + confere("metodo gigante (estoura o campo)",
        ("M" * 300) + " /oi HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 400")
    ruins = ruins + confere("alvo gigante",
        "GET /" + ("a" * 9000) + " HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1")
    ruins = ruins + confere("metodo que nao existe",
        "BREW /oi HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 4")
    ruins = ruins + confere("versao HTTP estranha nao derruba",
        "GET /oi HTTP/9.9\r\nHost: x\r\n\r\n", "HTTP/1.1")
    # LF puro (`\n` sem `\r`) é RECUSADO com 400, não aceito e não esperado até
    # o timeout. Aceitar seria vetor de request smuggling; ficar esperando era
    # conexão presa por lixo. Reconhecer só pra recusar não aceita nada a mais.
    ruins = ruins + confere("LF puro -> 400, sem segurar a conexao",
        "GET /oi HTTP/1.1\nHost: x\n\n", "HTTP/1.1 400")
    # e o corpo legítimo que CONTÉM `\n\n` continua passando: a busca por LF
    # puro só roda quando o `\r\n\r\n` não foi achado
    # o `/eco` espera JSON, e o JSON aqui CONTÉM `\n\n` no valor
    corpo_nn = "{\"x\": \"a\\n\\nb\"}"
    ruins = ruins + confere("corpo com \\n\\n dentro continua valido",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\n"
        + "Content-Length: " + str(len(corpo_nn)) + "\r\n\r\n" + corpo_nn,
        "HTTP/1.1 200")
    ruins = ruins + confere("header sem valor",
        "GET /oi HTTP/1.1\r\nHost: x\r\nX-Vazio:\r\n\r\n", "HTTP/1.1 200")
    ruins = ruins + confere("muitos headers repetidos",
        "GET /hdr HTTP/1.1\r\nHost: x\r\n" + ("X-Rep: 1\r\n" * 60) + "\r\n", "HTTP/1.1")
    ruins = ruins + confere("Content-Length negativo -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: -1\r\n\r\nabc", "HTTP/1.1 400")
    ruins = ruins + confere("Content-Length com sinal de mais -> 400",
        "POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: +5\r\n\r\nabcde", "HTTP/1.1 400")
    ruins = ruins + confere("query string vazia",
        "GET /oi? HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")
    ruins = ruins + confere("query com chave sem valor",
        "GET /oi?a HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")
    ruins = ruins + confere("percent-encoding invalido no alvo",
        "GET /oi?a=%zz HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1")
    ruins = ruins + confere("percent-encoding truncado",
        "GET /oi?a=%4 HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1")

    # ── multipart: 40 ramos em zero no parser de upload ─────────────────────
    # `--` de fecho, parte sem `name`, header com `\n\n` em vez de `\r\n\r\n`,
    # varias partes no mesmo campo (forca o realloc do vetor), e boundary que
    # nao aparece no corpo.
    SEP = "----ps"
    corpo = ("--" + SEP + "\r\n"
             + "Content-Disposition: form-data; name=\"arq\"; filename=\"a.txt\"\r\n"
             + "Content-Type: text/plain\r\n\r\n"
             + "conteudo\r\n"
             + "--" + SEP + "--\r\n")
    ruins = ruins + confere("multipart normal",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=" + SEP + "\r\n"
        + "Content-Length: " + str(len(corpo)) + "\r\n\r\n" + corpo, "HTTP/1.1 200")

    # parte SEM `name`: tem que ser ignorada, nao virar arquivo sem nome
    corpo = ("--" + SEP + "\r\n"
             + "Content-Disposition: form-data; filename=\"x.txt\"\r\n\r\n"
             + "sem nome\r\n"
             + "--" + SEP + "--\r\n")
    ruins = ruins + confere("parte multipart sem name",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=" + SEP + "\r\n"
        + "Content-Length: " + str(len(corpo)) + "\r\n\r\n" + corpo, "HTTP/1.1 200")

    # headers da parte separados por \n\n (cliente relaxado) — o parser tem
    # ramo pros dois separadores
    corpo = ("--" + SEP + "\r\n"
             + "Content-Disposition: form-data; name=\"arq\"; filename=\"b.txt\"\n\n"
             + "corpo relaxado\r\n"
             + "--" + SEP + "--\r\n")
    ruins = ruins + confere("multipart com \\n\\n entre header e corpo",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=" + SEP + "\r\n"
        + "Content-Length: " + str(len(corpo)) + "\r\n\r\n" + corpo, "HTTP/1.1 200")

    # SEIS partes no mesmo campo: o vetor comeca com 4 e tem que crescer
    corpo = ""
    i = 0
    while i < 6 {
        corpo = (corpo + "--" + SEP + "\r\n"
                 + "Content-Disposition: form-data; name=\"fotos\"; filename=\"f"
                 + str(i) + ".png\"\r\n\r\n" + "dados" + str(i) + "\r\n")
        i = i + 1
    }
    corpo = corpo + "--" + SEP + "--\r\n"
    ruins = ruins + confere("seis partes no mesmo campo (cresce o vetor)",
        "POST /uploads HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=" + SEP + "\r\n"
        + "Content-Length: " + str(len(corpo)) + "\r\n\r\n" + corpo, "HTTP/1.1 200")

    # boundary declarado que NAO aparece no corpo
    corpo = "nada de boundary aqui\r\n"
    ruins = ruins + confere("boundary ausente do corpo",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=" + SEP + "\r\n"
        + "Content-Length: " + str(len(corpo)) + "\r\n\r\n" + corpo, "HTTP/1.1 200")

    # multipart SEM boundary no Content-Type
    ruins = ruins + confere("multipart sem boundary declarado",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data\r\n"
        + "Content-Length: 5\r\n\r\nabcde", "HTTP/1.1")

    # boundary vazio, e boundary gigante (estoura o `sep[256]`)
    ruins = ruins + confere("boundary vazio",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=\r\n"
        + "Content-Length: 5\r\n\r\nabcde", "HTTP/1.1")
    ruins = ruins + confere("boundary gigante",
        "POST /upload HTTP/1.1\r\nHost: x\r\n"
        + "Content-Type: multipart/form-data; boundary=" + ("b" * 400) + "\r\n"
        + "Content-Length: 5\r\n\r\nabcde", "HTTP/1.1")

    ruins = ruins + confere("e o servidor continua vivo depois de tudo isso",
        "GET /oi HTTP/1.1\r\nHost: x\r\n\r\n", "HTTP/1.1 200")

    post("")
    if ruins > 0 {
        post("FALHARAM:", ruins)
        sys.exit(1)
    }
    post("bruto: ok")
}

# O SERVIDOR jinker a fundo — loopback, sem serviço externo.
#
# POR QUE ESTE ARQUIVO EXISTE, e por que ele não é "mais um e2e":
#
# 1. `ps_jinker.c` aparecia em 0% de cobertura, e depois de o e2e entrar no
#    portão subiu só pra 15% de ramo. O motivo não era falta de teste: o driver
#    de e2e mata o servidor com sinal, e processo morto por SINAL não grava o
#    `.gcda` do gcov — a metade servidor sumia da medição inteira. Por isso o
#    alvo tem `/__parar`: o servidor sai por `sys.exit(0)` e a cobertura conta.
# 2. A suíte em pytest cobria 74% de linha / 52% de ramo do jinker testando em
#    processo. Este arquivo devolve esse alcance sem voltar pro Python.
#
# Cobre, do lado do cliente e do protocolo cru: métodos, status, cabeçalho,
# query, path param, JSON, multipart, middleware, CORS, estático, canal,
# WebSocket, 404/405 e requisição TORTA (Content-Length inválido, TE+CL,
# chunked, cabeçalho sem ':').
#
#     ./pool teste/jinker_roda.pr
import os
import sys
import date
import sockets
from request import get
from request import post as http_post
from request import put
from request import patch
from request import delete
from request import head
from request import ws_connect

PASTA = "/tmp/ps_jinker_teste"
PORTA = 28952
RAIZ  = "http://127.0.0.1:" + str(PORTA)

falhas = []
ok = 0

funct confere(nome, cond)
{
    global ok
    if cond
    {
        ok = ok + 1
    }
    else
    {
        addEnd(falhas, nome)
    }
}

# Requisição CRUA: abre o socket, escreve os bytes exatos e lê a resposta. É o
# único jeito de testar requisição torta — nenhum cliente HTTP decente deixa
# você mandar `Content-Length: abc`. `cru_em` recebe a porta (a do WebSocket
# é PORTA + 1); `cru` é o atalho pra porta HTTP.
funct cru_em(porta, bytes_pedido)
{
    s = sockets.socket()
    s.settimeout(5.0)
    s.connect(("127.0.0.1", porta))
    s.sendall(bytes_pedido.encode())
    resposta = ""
    erro = ""
    try
    {
        while true
        {
            pedaco = s.recv(4096)
            # `len(x)`, não `x.len()`: `bytes` é o único tipo embutido SEM o
            # método `.len()` (str, list, dict e tup têm). A versão anterior
            # usava `pedaco.len()`, o `catch` engolia o "membro inexistente", e
            # TODA checagem crua voltava string vazia — seis testes reprovando
            # por um erro que ninguém via. Está anotado em notas/TAREFAS.md.
            if len(pedaco) == 0
            {
                break
            }
            resposta = resposta + pedaco.decode()
        }
    }
    catch (e)
    {
        # Timeout de leitura é ESPERADO em conexão keep-alive: o servidor
        # respondeu e não fecha. Qualquer outro erro é defeito do teste e tem
        # que aparecer — engolir calado foi o que escondeu o problema acima.
        # A frase da lib de sockets é "timed out" (não "timeout"): o filtro
        # antigo não a pegava e a suíte inteira imprimia o ruído.
        erro = str(e)
        if not "timed out" in erro and not "timeout" in erro and not "Timeout" in erro
        {
            post("      (cru) erro lendo a resposta:", erro)
        }
    }
    s.close()
    return resposta
}

funct cru(bytes_pedido)
{
    return cru_em(PORTA, bytes_pedido)
}

funct espera_porta(prazo_decimos)
{
    i = 0
    while i < prazo_decimos
    {
        s = sockets.socket()
        s.settimeout(0.2)
        rc_con = s.connect_ex(("127.0.0.1", PORTA))
        s.close()
        if rc_con == 0
        {
            return true
        }
        sleep(0.1)
        i = i + 1
    }
    return false
}

os.mkdir(PASTA, exist_ok=true)
os.cmd("'" + sys.executable + "' teste/jinker_alvo.pr > " + PASTA + "/alvo.log 2>&1 & echo $! > " + PASTA + "/alvo.pid")

if espera_porta(100) == false
{
    post("o servidor-alvo nao abriu a porta " + str(PORTA))
    post(os.readFile(PASTA + "/alvo.log"))
    sys.exit(1)
}

# ── métodos e corpo ─────────────────────────────────────────────────────────
r = get(RAIZ + "/ok")
confere("GET responde 200 com JSON", r.status_code == 200 and r.get_json("ok") == true)
confere("o servidor enxerga o método", r.get_json("metodo") == "GET")

r = http_post(RAIZ + "/eco", body="corpo-do-post")
confere("POST entrega o corpo", r.get_json("corpo") == "corpo-do-post" and r.get_json("metodo") == "POST")

r = put(RAIZ + "/eco", body="p")
confere("PUT chega como PUT", r.get_json("metodo") == "PUT")
r = patch(RAIZ + "/eco", body="p")
confere("PATCH chega como PATCH", r.get_json("metodo") == "PATCH")
r = delete(RAIZ + "/eco")
confere("DELETE chega como DELETE", r.get_json("metodo") == "DELETE")

r = head(RAIZ + "/ok")
confere("HEAD responde sem corpo", r.status_code == 200 and r.text.len() == 0)

# ── status, cabeçalho e texto puro ──────────────────────────────────────────
r = get(RAIZ + "/texto")
confere("resposta de texto puro", r.text == "texto puro")
r = get(RAIZ + "/status")
confere("status customizado chega inteiro", r.status_code == 418)

# ── query, path param e cabeçalho ───────────────────────────────────────────
r = get(RAIZ + "/consulta?q=abc")
confere("query string chega", r.get_json("q") == "abc")
confere("parâmetro ausente vira null", r.get_json("faltando") == null)

r = get(RAIZ + "/consulta?q=a%20b%2Bc")
confere("query percent-encoded é decodificada", r.get_json("q") == "a b+c")

r = get(RAIZ + "/param/42")
confere("path param chega", r.get_json("id") == "42")

# I18: o path param no argumento da funct, sem tocar em request.path_param
# `:id` e um SEGMENTO: `/injeta:id` casa `/injeta/7`, como `/injeta/<id>`.
# Era colado (`/injeta7`) e a suite gravava isso como certo — o front dele
# chamava `/sing-in/abc` e via 404. A forma colada deixa de casar.
r = get(RAIZ + "/injeta/7")
confere("path param injetado no argumento", r.get_json("id") == "7")
r = get(RAIZ + "/injeta7")
confere("URL colada ao nome (`/injeta7`) NAO casa `/injeta:id`", r.status_code == 404)
r = get(RAIZ + "/inverte/X/sub/Y")
confere("injeta por NOME, nao por posicao",
        r.get_json("a") == "X" and r.get_json("b") == "Y")
r = get(RAIZ + "/param/ana")
confere("request.path_param continua valendo", "ana" in r.text)

# `<x>` e UM segmento, como `:x`. Era "o resto, com barras" (o `.+` do
# interpretador de referencia): `/loja/<loja>/item/<item>` — exemplo da
# propria doc — nunca casava, e `/users/<id>` engolia `/users/7/photos`
# inteiro, escondendo a rota POST e devolvendo 405 no lugar dela.
r = get(RAIZ + "/loja/a1/item/b2")
confere("<x> no MEIO do caminho casa (exemplo da doc)",
        r.get_json("loja") == "a1" and r.get_json("item") == "b2")
r = http_post(RAIZ + "/users/7/photos", body={})
confere("<x> no fim nao engole a barra: a rota POST mais longa e alcancada",
        r.get_json("fotos") == "7")
r = get(RAIZ + "/users/7")
confere("...e a rota curta continua casando o segmento", r.get_json("um") == "7")
r = get(RAIZ + "/users/7/photos")
confere("GET num path que so tem POST e 405, nao a rota curta com id '7/photos'",
        r.status_code == 405)
r = get(RAIZ + "/users/7/")
confere("barra extra no fim nao vira parte do valor", r.status_code == 404)

# Rota LONGA declarada antes da curta com o MESMO nome de parametro
# (`/st/<id>/edit` e `/st/<id>`): o reset dos params entre uma tentativa e
# outra so zerava `count` e `usados`, o indice continuava apontando pro slot
# velho, a curta gravava nele sem subir `count`, e o handler recebia ZERO
# argumentos — 500 "missing 1 required positional argument".
r = get(RAIZ + "/st/7")
confere("rota curta depois da longa com o mesmo parametro casa e injeta o valor",
        r.status_code == 200 and r.get_json("id") == "7" and r.get_json("rota") == "um")
r = get(RAIZ + "/st/7/edit")
confere("...e a longa continua casando", r.get_json("rota") == "edit" and r.get_json("id") == "7")

# Literal DEPOIS do parametro no mesmo segmento: `<id>` captura ate o literal.
r = get(RAIZ + "/x/5.json")
confere("`/x/<id>.json` casa `/x/5.json` com id=5", r.status_code == 200 and r.get_json("id") == "5")
r = get(RAIZ + "/x/5")
confere("`/x/<id>.json` NAO casa `/x/5` (falta o literal)", r.status_code == 404)
r = get(RAIZ + "/y/1-2")
confere("`/y/<a>-<b>`: dois parametros no mesmo segmento",
        r.get_json("a") == "1" and r.get_json("b") == "2")

# Sem limite de tamanho no valor: era `char[512]`, e a partir de 512 bytes a
# rota nao casava (404) — um JWT no path passa disso facil.
longo = "a" * 600
r = get(RAIZ + "/param/" + longo)
confere("parametro de 600 caracteres casa e chega inteiro",
        r.status_code == 200 and r.get_json("id") == longo)

# `%00` decodificava pra byte nulo e TRUNCAVA o path: `/users/7%00/photos`
# virava `/users/7` e a rota curta respondia 200. Byte nulo e 400.
bruto = cru("GET /users/7%00/photos HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
confere("`%00` no path e 400, nao outra rota", "HTTP/1.1 400" in bruto)

r = get(RAIZ + "/cabecalho", headers={"X-Chave": "valor"})
confere("cabeçalho do cliente chega", r.get_json("chave") == "valor")
confere("a lista de cabeçalhos não vem vazia", r.get_json("todos") == true)

# ── JSON ────────────────────────────────────────────────────────────────────
r = http_post(RAIZ + "/json", body={"nome": "ana", "n": 2})
confere("JSON do cliente é lido campo a campo", r.get_json("veio") == "ana")

# ── multipart: upload de arquivo ────────────────────────────────────────────
os.writeFile(PASTA + "/enviar.txt", "conteudo enviado")
r = http_post(RAIZ + "/subir", file={"arquivo": {"name": PASTA + "/enviar.txt"}}, fields={"quem": "teste"})
confere("upload chega com nome, tamanho e conteúdo",
        r.get_json("nome") == "enviar.txt" and r.get_json("tamanho") == 16
        and r.get_json("conteudo") == "conteudo enviado")
confere("upload é gravado no disco pelo save()", r.get_json("salvou") == true)
confere("files() enxerga o arquivo", r.get_json("quantos") >= 1)

r = http_post(RAIZ + "/subir", body="sem arquivo nenhum")
confere("POST sem arquivo devolve 400, não 500", r.status_code == 400)

# ── middleware ──────────────────────────────────────────────────────────────
r = get(RAIZ + "/protegida")
confere("middleware barra sem a chave (401)", r.status_code == 401)
r = get(RAIZ + "/protegida", headers={"X-Chave": "abre"})
confere("middleware libera com a chave", r.status_code == 200 and r.get_json("entrou") == true)

# ── handlers em classe com decorador que envolve (uso real) ─────────────────
r = http_post(RAIZ + "/cls/login", body="{}")
confere("classe: middleware=app.middleware barra a rota-metodo sem a chave (401)", r.status_code == 401)
r = http_post(RAIZ + "/cls/login", body="{}", headers={"X-Chave": "abre"})
confere("classe: rota-metodo envolvida por lock responde 200 e roda travada",
        r.status_code == 200 and r.get_json("ok") == true and r.get_json("travado") == true)
r = get(RAIZ + "/cls/item/42")
confere("classe: path param chega no metodo (self, str id)", r.status_code == 200 and r.get_json("id") == "42")
r = get(RAIZ + "/cls/lock/7")
confere("classe: path param atravessa o wrapper (*args, **kwargs) e a rota roda travada",
        r.status_code == 200 and r.get_json("id") == "7" and r.get_json("travado") == true)
r = get(RAIZ + "/cls/lock/8")
confere("classe: o lock foi solto no finally da requisicao anterior",
        r.status_code == 200 and r.get_json("travado") == true)
r = get(RAIZ + "/cls/mw_erra")
confere("classe: middleware que levanta erro responde 500, nao deixa a rota rodar", r.status_code == 500)

# ── handler async: o jinker espera o corpo, e o helper aguardado ve o request ─
r = get(RAIZ + "/async/direto?q=abc")
confere("rota async funct: o jinker espera o corpo e ele ve a requisicao",
        r.status_code == 200 and r.get_json("q") == "abc")
r = get(RAIZ + "/async/helper?q=xyz")
confere("rota async: await de helper async ve o request de quem o criou",
        r.status_code == 200 and r.get_json("q") == "xyz" and r.get_json("depois") == "xyz")

# ── CORS ────────────────────────────────────────────────────────────────────
r = get(RAIZ + "/cors-info")
confere("cors.options() devolve o configurado", "GET" in r.get_json("options"))
confere("cors.origins() devolve o configurado", "http://permitido.test" in r.get_json("origins"))

# `cors(app, options=...)`: o preflight OPTIONS responde com os metodos
# configurados pra ESTE app (a config e por servidor, nao mais global)
pre = cru("OPTIONS /param/1 HTTP/1.1\r\nHost: x\r\nOrigin: http://permitido.test\r\n\r\n")
confere("preflight OPTIONS lista os metodos do cors(app, options=...)",
        "204" in pre and "Access-Control-Allow-Methods: GET, POST, PUT, DELETE, PATCH" in pre)

# ── estático ────────────────────────────────────────────────────────────────
r = get(RAIZ + "/estatico/pagina.txt")
confere("arquivo estático é servido", r.text.strip() == "sou estatico")
r = get(RAIZ + "/estatico/nao_existe.txt")
confere("estático inexistente é 404", r.status_code == 404)

# ── estático: o que NÃO sai ─────────────────────────────────────────────────
# Cada vetor aqui é um jeito conhecido de sair da pasta publicada, e os dois
# primeiros foram MEDIDOS vazando antes do conserto: `GET /static/../x`
# entregava o `.pr` da aplicação e o `/etc/passwd`; `static_folder="."`
# entregava `.git/config` e `.env`. A defesa é o `realpath` do caminho FINAL
# (`jk_sob_a_raiz`), não filtro de string na URL — por isso a lista testa
# codificação, dupla codificação, NUL, UTF-8 overlong, barra invertida e
# symlink: tudo que vira `..` depois de decodificar resolve pra fora e é
# barrado; o que não vira é um nome que não existe. Um vetor novo entra aqui.
#
# O `get()` do request normaliza o `..` no CLIENTE (todo cliente HTTP faz),
# então só a requisição CRUA testa o servidor.
VETORES = [
    # static_folder (montado em /estatico) -> /tmp/ps_jinker_teste/segredo.txt
    "/estatico/../segredo.txt",
    "/estatico/%2e%2e/segredo.txt",
    "/estatico/%2E%2E/segredo.txt",
    "/estatico/..%2fsegredo.txt",
    "/estatico/%2e%2e%2fsegredo.txt",
    "/estatico/%252e%252e/segredo.txt",
    "/estatico/....//segredo.txt",
    "/estatico/..\\segredo.txt",
    "/estatico/./../segredo.txt",
    "/estatico//../segredo.txt",
    "/estatico/pagina.txt%00/../segredo.txt",
    "/estatico/%c0%ae%c0%ae/segredo.txt",
    "/estatico/%e0%80%ae%e0%80%ae/segredo.txt",
    "/estatico/../../../../../../../../etc/passwd",
    "/estatico/link_passwd",
    "/estatico/.env",
    # /static/ fixo (teste/static/) -> teste/jinker_alvo.pr, o proprio servidor
    "/static/../jinker_alvo.pr",
    "/static/%2e%2e/jinker_alvo.pr",
    "/static/..%2fjinker_alvo.pr",
    "/static/%252e%252e/jinker_alvo.pr",
    "/static/solto.txt%00/../jinker_alvo.pr",
    "/static/../../../../../../../../etc/passwd",
    "/static/link_fora"
]
SEGREDOS = ["FORA da pasta", "root:x:", "Jinker(", "SENHA=nao"]
vazou = []
for each caminho in VETORES
{
    bruto = cru("GET " + caminho + " HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    for each s in SEGREDOS
    {
        if s in bruto
        {
            addEnd(vazou, caminho + "  entregou  " + s)
        }
    }
}
confere("nenhum dos " + str(len(VETORES)) + " vetores de travessia entrega segredo", len(vazou) == 0)
for each v in vazou
{
    post("      VAZOU: " + v)
}
r = get(RAIZ + "/estatico/.env")
confere("oculto (.env) DENTRO da pasta publicada e 404", r.status_code == 404)
# `.pr` DENTRO da pasta publicada SAI: e assim que o `psl install` baixa
# pacote de um registry servido pelo jinker (`cli_roda.pr`). Uma versao
# barrava por extensao e quebrou isso. O `.pr` da aplicacao nao sai porque
# nao esta na pasta publicada — e o que os vetores acima garantem.
r = get(RAIZ + "/estatico/fonte.pr")
confere("fonte .pr DENTRO da pasta publicada e servido (registry do psl)", r.status_code == 200 and r.text.strip() == "post(1)")
r = get(RAIZ + "/estatico/.well-known/acme")
confere(".well-known e a excecao e sai (Let's Encrypt)", r.status_code == 200 and r.text.strip() == "token")
r = get(RAIZ + "/static/solto.txt")
confere("/static/ fixo serve da pasta AO LADO do .pr, nao do cwd", r.status_code == 200 and r.text.strip() == "asset solto")

# ── canal ───────────────────────────────────────────────────────────────────
r = get(RAIZ + "/emitir")
confere("canal emite sem cliente e diz o status", r.status_code == 200)

# ── rota e método inexistentes ──────────────────────────────────────────────
r = get(RAIZ + "/rota-que-nao-existe")
confere("rota inexistente é 404", r.status_code == 404)
# Rota SEM `methods=` aceita todos os métodos — é o contrato documentado
# (`methods` vazio = todos os do cors), então POST em `/ok` é 200 mesmo.
r = http_post(RAIZ + "/ok", body="x")
confere("rota sem methods= aceita POST (contrato)", r.status_code == 200)
# Já `/json` declara `methods=["POST"]`: GET nela tem que ser recusado.
r = get(RAIZ + "/json")
confere("método fora do methods= declarado é 405", r.status_code == 405)

# ── atalhos por verbo e o 405 ───────────────────────────────────────────────
r = get(RAIZ + "/verbo")
confere("@app.get registra GET", r.status_code == 200 and r.get_json("verbo") == "GET")
r = http_post(RAIZ + "/verbo", body={"nome": "ana", "idade": 3})
confere("@app.post registra POST e model= valida", r.status_code == 200 and r.get_json("nome") == "ana")
r = http_post(RAIZ + "/verbo", body={"nome": "ana"})
confere("model= no atalho reprova campo faltando com 422", r.status_code == 422)
r = put(RAIZ + "/verbo", body="x")
confere("@app.put registra PUT", r.get_json("verbo") == "PUT")
r = delete(RAIZ + "/verbo")
confere("@app.delete registra DELETE", r.get_json("verbo") == "DELETE")
r = patch(RAIZ + "/verbo/9", body="x")
confere("@app.patch registra PATCH e injeta o path param", r.get_json("id") == "9")
# Método errado num path que EXISTE é 405, não 404: o front que escreveu
# `fetch(url)` (GET) numa rota `post` recebia "URL não existe" — a URL
# existia, o método é que não. O `Allow` diz o que a rota aceita, juntando
# TODAS as rotas do path, na ordem em que foram registradas.
r = http_post(RAIZ + "/verbo/9", body="x")
confere("metodo errado em path existente e 405", r.status_code == 405)
# `r` e a Response das chamadas de cima; a resposta CRUA e texto, e vai em
# outro nome — o tipo de uma variavel e fixado na primeira atribuicao
bruto = cru("POST /verbo/9 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
confere("405 leva Allow: com o metodo da rota", "Allow: PATCH" in bruto)
confere("405 diz o motivo no corpo", "método inválido: POST /verbo/9" in bruto)
bruto = cru("PATCH /verbo HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
confere("Allow junta os verbos de TODAS as rotas do path", "Allow: GET, POST, PUT, DELETE" in bruto)

# ── WebSocket ───────────────────────────────────────────────────────────────
eco = ""
try
{
    # o jinker abre o WebSocket na porta SEGUINTE à do HTTP
    # `on_message` REGISTRA um callback e devolve Null — não é um `recv` que
    # bloqueia. Quem lê a mensagem é o callback, e por isso precisa do `sleep`:
    # a mensagem tem que chegar DURANTE a espera, não no `close`.
    ws = ws_connect("ws://127.0.0.1:" + str(PORTA + 1) + "/ws")
    vindas = []
    ws.on_message(funct(m) { vindas.append(m) })
    ws.send("alo")
    sleep(1)
    eco = str(vindas)
    ws.close()
}
catch (e)
{
    eco = "ERRO: " + str(e)
}
confere("WebSocket faz handshake e ecoa a mensagem", "alo" in eco)

# Upgrade num path que NAO existe: a recusa e uma resposta HTTP 404 (RFC 6455
# §4.2.2). Saia um frame de close WS cru (`88 16 03 f0 …`) numa conexao que
# nunca foi promovida, e o cliente lia lixo sem linha de status.
bruto_ws = cru_em(PORTA + 1, "GET /nope HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n")
confere("WebSocket em path inexistente recebe HTTP 404 com a frase do HTTP",
        bruto_ws.startswith("HTTP/1.1 404") and "rota não encontrada: GET /nope" in bruto_ws)

# Socket LONGO declarado antes do curto com o mesmo parametro (`/chat/<sala>/admin`
# e `/chat/<sala>`): a conexao em `/chat/geral` tem que entrar na sala `geral`
# — o mesmo reset de params das rotas HTTP deixava `count` em 0 e a conexao
# ficava sem sala; o emit pra sala nunca chegava.
sala_msgs = ""
try
{
    ws4 = ws_connect("ws://127.0.0.1:" + str(PORTA + 1) + "/chat/geral")
    sala_vindas = []
    ws4.on_message(funct(m) { sala_vindas.append(str(m)) })
    ws4.send("oi")
    sleep(1)
    sala_msgs = str(sala_vindas)
    ws4.close()
}
catch (e)
{
    sala_msgs = "ERRO: " + str(e)
}
confere("socket curto depois do longo entra na sala automatica: o emit pra sala chega",
        "emit" in sala_msgs and "ret:geral" in sala_msgs)

# `on_message` com `async funct`: a drenagem ESPERA o callback, como o jinker
# espera o handler — o corpo roda, na ordem das mensagens.
vindas_async = []
async funct guarda_async(m)
{
    vindas_async.append(m)
}
eco_async = ""
try
{
    ws3 = ws_connect("ws://127.0.0.1:" + str(PORTA + 1) + "/ws")
    ws3.on_message(guarda_async)
    ws3.send("alo")
    sleep(1)
    eco_async = str(vindas_async)
    ws3.close()
}
catch (e)
{
    eco_async = "ERRO: " + str(e)
}
confere("WebSocket: on_message com async funct roda o corpo do callback", "alo" in eco_async)

# TAMANHO DO FRAME: o WebSocket codifica o comprimento em três formatos, e o
# ramo escolhido depende do tamanho. Só o primeiro era exercitado — "alo" tem 3
# bytes.
#
#   n < 126      1 byte           (o único que o teste acima cobria)
#   n < 65536    126 + 2 bytes
#   n >= 65536   127 + 8 bytes
#
# São dois ramos em `ps_jinker.c` (escrita e leitura de cada formato) que a
# suíte inteira não tocava. Um `if` de tamanho errado corrompe o frame e o
# outro lado desconecta sem dizer por quê — defeito caro de achar em produção
# e barato de cobrir aqui.
medio  = "m" * 300
grande = "g" * 70000
eco_medio = ""
eco_grande = ""
try
{
    ws2 = ws_connect("ws://127.0.0.1:" + str(PORTA + 1) + "/ws")
    recebidas = []
    ws2.on_message(funct(m) { recebidas.append(m) })
    ws2.send(medio)
    sleep(1)
    ws2.send(grande)
    sleep(2)
    ws2.close()
    for each r in recebidas
    {
        if len(r) > 60000
        {
            eco_grande = r
        }
        elif len(r) > 250
        {
            eco_medio = r
        }
    }
}
catch (e)
{
    eco_medio = "ERRO: " + str(e)
}
confere("frame de 300 bytes (comprimento em 2 bytes) atravessa inteiro",
        len(eco_medio) >= 300 and eco_medio.endswith("m"))
confere("frame de 70000 bytes (comprimento em 8 bytes) atravessa inteiro",
        len(eco_grande) >= 70000 and eco_grande.endswith("g"))

# ── validação do corpo com `model` ──────────────────────────────────────────
#
# A linguagem já tinha `model` com validação no `==`; o que faltava era ligar
# isso na porta de entrada da rota. Sem isso toda rota começa com o mesmo bloco
# de `if` conferindo o que já está declarado no model.
#
# O que cada checagem defende:
#   - corpo torto responde 422 dizendo QUAL campo e por quê. "corpo inválido"
#     manda o cliente adivinhar entre os campos.
#   - JSON quebrado é 400, não 422: o defeito é do parser, não do model.
#   - rota SEM model não muda em nada.
r = http_post(RAIZ + "/modelo", body={"nome": "ana", "idade": 30})
confere("corpo que casa o model passa", r.status_code == 200 and r.get_json("criado") == "ana")

r = http_post(RAIZ + "/modelo", body={"nome": "ana"})
confere("campo faltando vira 422", r.status_code == 422)
confere("...dizendo QUAL campo", "idade" in r.text and "faltando" in r.text)

r = http_post(RAIZ + "/modelo", body={"nome": "ana", "idade": "x"})
confere("tipo errado vira 422 dizendo o esperado e o que veio",
        r.status_code == 422 and "esperava int" in r.text and "veio str" in r.text)

r = http_post(RAIZ + "/modelo", body={"nome": "um nome bem maior que o limite", "idade": 1})
confere("length estourado diz os dois numeros",
        r.status_code == 422 and "20" in r.text and "30" in r.text)

r = http_post(RAIZ + "/modelo", body="{isto nao e json")
confere("JSON quebrado e 400, nao 422", r.status_code == 400)

r = http_post(RAIZ + "/eco", body="corpo qualquer")
confere("rota SEM model nao e afetada", r.status_code == 200)

# O model valida o DADO: regex, in/not_in, min/max, optional, aninhado, of.
# Cada frase abaixo e a que o cliente recebe no 422 — com o CAMINHO do campo
# quando e aninhado (`endereco.cep`) ou item de lista (`tags[0]`).
funct cadastro(muda)
{
    corpo = {"nome": "ana", "idade": 30, "papel": "admin", "status": "ativo",
             "endereco": {"rua": "x", "cep": "12345-678"}, "tags": ["a", "b"]}
    for each k in muda.keys()
    {
        corpo[k] = muda[k]
    }
    return http_post(RAIZ + "/modelo2", body=corpo)
}
r = cadastro({})
confere("model com todos os parametros: dado bom passa", r.status_code == 200 and r.get_json("ok") == "ana")
r = cadastro({"apelido": Null})
confere("optional=true aceita null", r.status_code == 200)
r = cadastro({"nome": "ana1"})
confere("regex que nao casa: 422 com o padrao",
        r.status_code == 422 and "campo 'nome': nao casa com o padrao ^[A-Za-z ]+$" in r.text)
r = cadastro({"idade": 12})
confere("min: 422 dizendo o minimo e o que veio",
        r.status_code == 422 and "campo 'idade': no minimo 18, veio 12" in r.text)
r = cadastro({"idade": 130})
confere("max: 422 dizendo o maximo e o que veio",
        r.status_code == 422 and "campo 'idade': no maximo 120, veio 130" in r.text)
r = cadastro({"papel": "x"})
confere("in: 422 listando os valores aceitos",
        r.status_code == 422 and "campo 'papel': esperava um de ['admin', 'user'], veio 'x'" in r.text)
r = cadastro({"status": "banido"})
confere("not_in: 422 dizendo que o valor e proibido",
        r.status_code == 422 and "campo 'status': 'banido' nao e permitido" in r.text)
r = cadastro({"endereco": {"rua": "x", "cep": "1"}})
confere("aninhado: a frase traz o caminho do campo",
        r.status_code == 422 and "campo 'endereco.cep': nao casa com o padrao" in r.text)
r = cadastro({"endereco": {"cep": "12345-678"}})
confere("aninhado: campo faltando dentro do model de dentro",
        r.status_code == 422 and "campo 'endereco.rua': faltando" in r.text)
r = cadastro({"endereco": "x"})
confere("tipo model recebendo o que nao e objeto",
        r.status_code == 422 and "campo 'endereco': esperava objeto, veio str" in r.text)
r = cadastro({"tags": ["a", 1]})
confere("list(of=str): item errado diz a posicao",
        r.status_code == 422 and "campo 'tags[1]': esperava str, veio int" in r.text)
r = cadastro({"tags": ["a", "b", "c", "d"]})
confere("length na list conta itens",
        r.status_code == 422 and "campo 'tags': no maximo 3 itens, veio 4" in r.text)

# ── cliente HTTP: corpo chunked e corpo ate a conexao fechar ───────────────
#
# O jinker sempre responde com Content-Length, entao dois caminhos do cliente
# (`request.get`) nunca rodavam — a cobertura media zero execucoes em
# `le_corpo_chunked` e `le_corpo_ate_fechar`. Um servidor CRU (sockets) numa
# porta propria responde as duas formas, uma conexao cada, e sai. Ele avisa
# que esta ouvindo por ARQUIVO, nao por sonda: uma sonda de porta consumiria
# o `accept` da primeira resposta. `settimeout` no accept: se o teste cair
# antes, o servidor nao fica pendurado.
CRU_PORTA = 28958
os.cmd("rm -f " + PASTA + "/cru_pronto")
os.writeFile(PASTA + "/cru_http.pr",
    "import os\nimport sockets\n"
    + "srv = sockets.create_server((\"127.0.0.1\", " + str(CRU_PORTA) + "))\n"
    + "srv.settimeout(15.0)\n"
    + "os.writeFile(\"" + PASTA + "/cru_pronto\", \"1\")\n"
    + "c = srv.accept()[0]\nc.recv(65536)\n"
    + "c.sendall(\"HTTP/1.1 200 OK\\r\\nTransfer-Encoding: chunked\\r\\nConnection: close\\r\\n\\r\\n"
    + "5\\r\\nola, \\r\\n5\\r\\nmundo\\r\\n0\\r\\n\\r\\n\".encode())\nc.close()\n"
    + "c = srv.accept()[0]\nc.recv(65536)\n"
    + "c.sendall(\"HTTP/1.1 200 OK\\r\\nConnection: close\\r\\n\\r\\ncorpo ate fechar\".encode())\nc.close()\n"
    + "srv.close()\n")
os.cmd("setsid '" + sys.executable + "' " + PASTA + "/cru_http.pr > " + PASTA + "/cru_http.log 2>&1 < /dev/null &")
cru_ouve = false
i = 0
while i < 50
{
    if os.exists(PASTA + "/cru_pronto")
    {
        cru_ouve = true
        break
    }
    sleep(0.1)
    i = i + 1
}
confere("servidor cru de teste subiu", cru_ouve)
corpo_chunked = ""
corpo_fecha = ""
try
{
    corpo_chunked = get("http://127.0.0.1:" + str(CRU_PORTA) + "/chunked", timeout=5).text
    corpo_fecha = get("http://127.0.0.1:" + str(CRU_PORTA) + "/fecha", timeout=5).text
}
catch (e)
{
    post("      (cru http) erro:", str(e))
}
confere("cliente HTTP junta o corpo chunked", corpo_chunked == "ola, mundo")
confere("cliente HTTP le o corpo sem Content-Length ate a conexao fechar", corpo_fecha == "corpo ate fechar")

# ── cookie ──────────────────────────────────────────────────────────────────
#
# Não havia UMA ocorrência de "cookie" no motor. É a feature mais usada depois
# de rota, e sem ela sessão e login se escrevem montando `Set-Cookie` na mão.
#
# O que cada checagem defende:
#   - `Set-Cookie` é o ÚNICO cabeçalho de resposta que se REPETE. Num dict o
#     segundo cookie sobrescreveria o primeiro e sumiria calado.
#   - o padrão é o SEGURO (HttpOnly, SameSite=Lax, Path=/): cookie de sessão
#     legível por JavaScript é XSS virando roubo de sessão.
#   - ler `sid` não pode casar dentro de `notsid` — é o defeito clássico de
#     quem fatia o cabeçalho na mão.
bruto = cru("GET /cookie-poe HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
n_set = 0
for each l in bruto.split("\r\n")
{
    if l.lower().startswith("set-cookie:")
    {
        n_set = n_set + 1
    }
}
confere("os DOIS cookies saem, um Set-Cookie cada", n_set == 2)
confere("o padrao e seguro: HttpOnly e SameSite", "HttpOnly" in bruto and "SameSite=Lax" in bruto)
confere("max_age vira Max-Age", "Max-Age=3600" in bruto)
confere("httponly=false e respeitado",
        "tema=escuro; Path=/x; SameSite=Lax\r\n" in bruto)

# Nomear UM parametro nao pode apagar o default de outro. Era bug: o slot
# pulado chega UNSET e `val_truthy(UNSET)` e falso, entao `secure=true`,
# `samesite=` e `domain=` derrubavam o `httponly=true` do default.
bruto = cru("GET /cookie-defaults HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
confere("secure= nomeado mantem o HttpOnly do default",
        "Set-Cookie: d_secure=1; Path=/; SameSite=Lax; HttpOnly; Secure\r\n" in bruto)
confere("samesite= nomeado mantem o HttpOnly do default",
        "Set-Cookie: d_samesite=1; Path=/; SameSite=Strict; HttpOnly\r\n" in bruto)
confere("domain= nomeado mantem o HttpOnly do default",
        "Set-Cookie: d_domain=1; Path=/; Domain=e.com; SameSite=Lax; HttpOnly\r\n" in bruto)

# O CORPO NUNCA FICA NA MEMORIA DO MOTOR. Ele desce da rede direto pra um
# arquivo — o do `save=` (do usuario) ou um do motor, `.pr_resposta_XXXXXX` na
# pasta corrente, que some com o Response. `.content`/`.text` leem do arquivo
# NA HORA em que o programa pede; `.size` e `.save()` nao tocam na memoria.
# O primeiro conserto tinha SIGSEGV: `ncorpo` guardava o total baixado com
# `corpo` vazio, e o `.content` copiava dai — com corpo pequeno voltava heap do
# proprio processo no lugar dos dados.
funct sobra_temp()
{
    return int(os.cmd("ls -a . | grep -c ps_resposta_", true).strip())
}
alvo_sv = PASTA + "/baixado.bin"
r = get(RAIZ + "/grande", save=alvo_sv)
confere("save= responde 200", r.status_code == 200)
confere("save= grava o corpo INTEIRO no disco", os.size(alvo_sv) == 300000)
confere("save=: .size diz o tamanho sem ler o corpo", r.size == 300000)
confere("save=: .content LE do arquivo salvo quando o programa pede", len(r.content) == 300000)
confere("o que foi pro disco e o corpo de verdade, byte a byte",
        os.readFile(alvo_sv) == "y" * 300000)
confere("save=: o arquivo e do usuario e continua la depois do .content", os.exists(alvo_sv))
confere("save=: nenhum arquivo do motor sobrando", sobra_temp() == 0)

# sem save=: arquivo do motor, e o .save() MOVE em vez de copiar
r = get(RAIZ + "/grande")
confere("sem save=: .size antes de qualquer leitura", r.size == 300000)
f = r.save(PASTA + "/movido.bin")
confere(".save() devolve PoolFile", f is PoolFile)
confere(".save() gravou tudo", os.size(PASTA + "/movido.bin") == 300000)
confere("o PoolFile devolvido sabe o tamanho sem carregar", f.size == 300000)
confere("depois do .save() nao sobra arquivo do motor", sobra_temp() == 0)
confere(".content depois do .save() le do arquivo movido", len(r.content) == 300000)
g = r.save(PASTA + "/copia.bin")
confere("segundo .save() COPIA: o primeiro fica", os.exists(PASTA + "/movido.bin"))
confere("segundo .save() COPIA: o segundo e inteiro", os.size(PASTA + "/copia.bin") == 300000)
tipo_err = ""
try { r.save(7) } catch (TypeError e) { tipo_err = "TypeError" }
confere(".save(7) e TypeError", tipo_err == "TypeError")

# sem corpo: nada e criado, nada sobra
h = head(RAIZ + "/grande")
confere("HEAD: .size 0 e .content vazio", h.size == 0 and len(h.content) == 0)
confere("HEAD: nenhum arquivo do motor", sobra_temp() == 0)
v = get(RAIZ + "/vazio")
confere("204: status certo", v.status_code == 204)
confere("204: .size 0 e nenhum arquivo do motor", v.size == 0 and sobra_temp() == 0)

r = get(RAIZ + "/cookie-le", headers={"Cookie": "sid=abc123; tema=escuro"})
confere("request.cookie le o valor", r.get_json("sid") == "abc123")
confere("...e o segundo par depois do ponto e virgula", r.get_json("tema") == "escuro")
confere("cookie inexistente e null", r.get_json("nao") == null)

# logout = o cookie reescrito com vida zero, mesmo path — a linha exata que
# a doc do cookie promete na tabela de `POST /sair`
bruto = cru("POST /cookie-sai HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
confere("logout: Set-Cookie com valor vazio e Max-Age=0, e os padroes seguros",
        "Set-Cookie: sid=; Path=/; Max-Age=0; SameSite=Lax; HttpOnly\r\n" in bruto)

# ── gather + request.get: pendurava em metade das rodadas ────────────────────
#
# O escalonador de topo criava um epoll por chamada e o fechava quando o SEU
# alvo resolvia; as outras fibras do mesmo gather ficavam com o eventfd num
# epoll morto e o processo esperava pra sempre. Seis rodadas: se uma pendurar,
# o runner mata por tempo — e e o que se quer, nao um verde por sorte.
async funct pega_ok()
{
    return get(RAIZ + "/ok").status_code
}
rodadas_ok = 0
for each rodada in [1, 2, 3, 4, 5, 6]
{
    if gather(pega_ok(), pega_ok(), pega_ok()) == [200, 200, 200]
    {
        rodadas_ok = rodadas_ok + 1
    }
}
confere("gather de tres request.get concorrentes resolve nas seis rodadas", rodadas_ok == 6)

r = get(RAIZ + "/cookie-le", headers={"Cookie": "notsid=x; sid=certo"})
confere("nome parcial NAO casa (`sid` dentro de `notsid`)", r.get_json("sid") == "certo")

# ── protocolo CRU: requisição torta é recusada COM resposta ─────────────────
bruto = cru("GET /ok HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\n")
confere("Content-Length não numérico vira 400", "400" in bruto)

bruto = cru("POST /eco HTTP/1.1\r\nHost: x\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\nx")
confere("Transfer-Encoding junto com Content-Length vira 400", "400" in bruto)

bruto = cru("POST /eco HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")
confere("chunked é recusado com 501, não com 200 e corpo vazio", "501" in bruto)

bruto = cru("GET /ok HTTP/1.1\r\nHost: x\r\nLinhaSemDoisPontos\r\n\r\n")
confere("cabeçalho sem ':' vira 400", "400" in bruto)

bruto = cru("GET /ok HTTP/1.1\r\nHost: x\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx")
confere("Content-Length duplicado e diferente vira 400", "400" in bruto)

bruto = cru("GET /ok HTTP/1.1\r\nHost: x\r\n\r\nGET /texto HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
confere("pipelining responde as DUAS requisições", bruto.count("HTTP/1.1") >= 2)

# ── o handler de socket não pode congelar o servidor ────────────────────────
#
# O handler de `@app.socket` era chamado DIRETO do laço do worker, sem fibra:
# o `sleep(3)` dele caía no caminho cego e parava tudo. Medido antes: `/ok`
# levava 3,4 s e a segunda conexão WebSocket só entrava quando a primeira
# terminava. Em ROTA o mesmo cenário já respondia em 0,7 ms.
travou = ""
try
{
    ws_l = ws_connect("ws://127.0.0.1:" + str(PORTA + 1) + "/lentows")
    lento_vindas = []
    ws_l.on_message(funct(m) { lento_vindas.append(str(m)) })
    ws_l.send("vai")
    sleep(0.5)                      # o handler está dormindo agora

    t0 = date.timestamp()
    r = get(RAIZ + "/ok")
    t1 = date.timestamp()
    confere("rota HTTP responde enquanto o handler de socket dorme",
            r.status == 200 and (t1 - t0) <= 1)

    # e outra conexão WebSocket entra na hora, sem esperar o handler
    t2 = date.timestamp()
    ws_l2 = ws_connect("ws://127.0.0.1:" + str(PORTA + 1) + "/ws")
    segundas = []
    ws_l2.on_message(funct(m) { segundas.append(str(m)) })
    ws_l2.send("oi")
    sleep(0.5)
    t3 = date.timestamp()
    confere("segunda conexão WebSocket entra e é atendida durante o handler lento",
            (t3 - t2) <= 1 and "eco: oi" in str(segundas))

    sleep(3.2)                      # deixa o handler lento terminar
    travou = str(lento_vindas)
    ws_l.close()
    ws_l2.close()
}
catch (e)
{
    travou = "ERRO: " + str(e)
}
confere("o handler lento termina e responde a quem mandou", "lento-fim" in travou)

# ── o comando externo na rota não segura as outras requisições ──────────────
#
# O worker é UM. Com a espera do filho na própria fibra, um `os.run` de 3 s na
# rota `/lento` fazia TODA outra requisição esperar esses 3 s. Aqui a `/lento` é
# disparada de outro processo e, enquanto ela roda, o `/ok` tem que responder na
# hora.
# o `try` é porque o servidor cai antes de a `/lento` responder: sem ele, o
# processo de fundo escreve um NetworkError no meio da saída da suíte
os.run([sys.executable, "-e",
        "import request\ntry { request.get(\"" + RAIZ + "/lento\") } catch (e) { pass }"],
       capture=false)
sleep(0.5)
t0 = date.timestamp()
r = get(RAIZ + "/ok")
t1 = date.timestamp()
confere("os.run dentro da rota nao segura as outras requisicoes",
        r.status == 200 and (t1 - t0) <= 1)

# ── parada limpa (é o que faz o gcov do servidor existir) ───────────────────
# O pedido de parada pode errar (o servidor já estava caindo quando a resposta
# viria) e isso é aceitável — mas NÃO é prova de parada. Quem decide `parou` é
# só o laço abaixo, vendo a porta recusar conexão. A versão antiga marcava
# `parou = true` no catch: qualquer erro (DNS, timeout, bug do cliente HTTP)
# aprovava a checagem sem o servidor ter parado.
parou = false
try
{
    get(RAIZ + "/__parar")
}
catch (e)
{
    pass
}
i = 0
while i < 50
{
    s = sockets.socket()
    s.settimeout(0.2)
    fechou = s.connect_ex(("127.0.0.1", PORTA)) != 0
    s.close()
    if fechou
    {
        parou = true
        break
    }
    sleep(0.1)
    i = i + 1
}
confere("o servidor para limpo quando pedido (sem isso o gcov dele não existe)", parou)
os.cmd("kill $(cat " + PASTA + "/alvo.pid) 2>/dev/null; true")


# ── TLS: o mesmo servidor, agora em HTTPS ───────────────────────────────────
#
# O benchmark de cobertura (`teste/bench_cobertura.pr`) mostrou as três funções
# de TLS de `ps_jinker.c` em ZERO execução: `ps_jk_tls_autogera` (chave RSA,
# X509, subjectAltName, assinatura, PEM no disco), `ps_jk_tls_ctx` e
# `ps_jk_tls_ctx_solta`. Nenhum teste subia o jinker com `tls` — 36 ramos que a
# suíte inteira não tocava.
#
# O cliente da linguagem NÃO serve aqui: ele valida o certificado, e o do teste
# é self-signed, então `request.get` recusa (corretamente). Quem fala é o
# `curl -k`. Sem curl, PULA — e diz que pulou.
# `os.cmd` ECOA a saída e devolve Null — quem quer o resultado grava em
# arquivo e lê. É o mesmo jeito do resto da suíte.
os.cmd("command -v curl > /dev/null 2>&1; echo $? > " + PASTA + "/tem_curl")
if os.readFile(PASTA + "/tem_curl").strip() != "0"
{
    post("  PULOU o TLS — falta o curl (o cliente da linguagem valida o cert,")
    post("  e o do teste é self-signed)")
}
else
{
    PASTA_TLS = "/tmp/ps_jinker_tls"
    os.cmd("rm -rf " + PASTA_TLS)
    os.cmd("setsid '" + sys.executable + "' teste/jinker_alvo_tls.pr > "
           + PASTA + "/tls.log 2>&1 < /dev/null & echo $! > " + PASTA + "/tls.pid")

    subiu = false
    i = 0
    while i < 60
    {
        os.cmd("curl -sk --max-time 2 https://127.0.0.1:28953/ok > " + PASTA + "/tls_ok.txt 2>/dev/null; true")
        txt = os.readFile(PASTA + "/tls_ok.txt")
        if "\"ok\"" in txt
        {
            subiu = true
            break
        }
        sleep(0.25)
        i = i + 1
    }
    confere("o jinker sobe em HTTPS gerando o self-signed sozinho", subiu)
    confere("o certificado autogerado foi pro disco",
            os.isfile(PASTA_TLS + "/.jinkerTls") and os.isfile(PASTA_TLS + "/.jinkerTls.key"))

    if subiu
    {
        os.cmd("curl -sk --max-time 3 https://127.0.0.1:28953/ok > " + PASTA + "/tls_ok.txt 2>/dev/null; true")
        txt = os.readFile(PASTA + "/tls_ok.txt")
        confere("a resposta atravessa o TLS inteira", "\"protocolo\": \"https\"" in txt)

        # O cliente HTTPS DA LINGUAGEM (`request.get("https://...")`) nao tinha
        # teste nenhum — o de cima usa curl. Contra o self-signed daqui ele tem
        # que RECUSAR (valida o certificado com as CAs do sistema) e dizer por
        # que. Cobre o handshake do cliente (`liga_tls`), que a cobertura
        # media com zero execucoes.
        tls_cli = ""
        try
        {
            get("https://127.0.0.1:28953/ok", timeout=3)
            tls_cli = "ACEITOU o self-signed"
        }
        catch (e)
        {
            tls_cli = str(e)
        }
        confere("cliente HTTPS da linguagem recusa o certificado autoassinado e diz o motivo",
                "falha no handshake TLS com 127.0.0.1: certificate verify failed" in tls_cli)

        # parada limpa pelo MESMO motivo do alvo HTTP: morto por sinal, o
        # servidor não grava o `.gcda` e a medição perde o lado TLS.
        os.cmd("curl -sk --max-time 3 https://127.0.0.1:28953/__parar > /dev/null 2>&1; true")
        parou_tls = false
        i = 0
        while i < 50
        {
            s = sockets.socket()
            s.settimeout(0.2)
            fechou = s.connect_ex(("127.0.0.1", 28953)) != 0
            s.close()
            if fechou
            {
                parou_tls = true
                break
            }
            sleep(0.1)
            i = i + 1
        }
        confere("o servidor TLS para limpo quando pedido", parou_tls)
    }
    os.cmd("kill $(cat " + PASTA + "/tls.pid) 2>/dev/null; true")
}

# ── relatório ───────────────────────────────────────────────────────────────
post("")
post("jinker:", ok, "checagens passaram")
if falhas.len() > 0
{
    post("FALHARAM:", falhas.len())
    for each f in falhas
    {
        post("  " + f)
    }
    sys.exit(1)
}

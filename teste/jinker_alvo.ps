# Servidor-alvo do `teste/jinker_roda.ps` — em LOOPBACK, sem serviço externo.
#
# Ele existe pra exercitar o SERVIDOR, que é a metade que a medição de
# cobertura não via: `ps_jinker.c` marcava 24% porque o processo do servidor
# era morto com sinal, e processo morto por sinal NÃO grava o `.gcda` do gcov.
# Por isso a rota `/__parar`: o driver pede a parada, o servidor sai por
# `sys.exit(0)`, e aí a cobertura dele conta.
import jinker
import sys
import os
from jinker import request
from jinker import cors

PASTA = "/tmp/ps_jinker_teste"
os.mkdir(PASTA + "/estatico", exist_ok=true)
os.writeFile(PASTA + "/estatico/pagina.txt", "sou estatico")

# O que NAO pode sair pela rede — cada arquivo abaixo e um jeito que JA VAZOU
# (ver `jk_sob_a_raiz` e `jk_nome_publicavel` na VM):
os.writeFile(PASTA + "/segredo.txt", "FORA da pasta publicada")      # `..` sobe
os.writeFile(PASTA + "/estatico/.env", "SENHA=nao")                 # oculto
os.writeFile(PASTA + "/estatico/fonte.ps", "post(1)")               # fonte da lang
os.mkdir(PASTA + "/estatico/.well-known", exist_ok=true)
os.writeFile(PASTA + "/estatico/.well-known/acme", "token")         # a UNICA excecao
# A pasta fixa `/static/` e a que fica AO LADO do .ps (aqui: teste/static/),
# nao a do diretorio de onde o servidor foi chamado. O driver roda de
# `./pool teste/jinker_alvo.ps` na raiz do repositorio; o `/__parar` apaga.
os.mkdir("teste/static", exist_ok=true)
os.writeFile("teste/static/solto.txt", "asset solto")
# symlink DENTRO da pasta publicada apontando pra FORA: nao tem `..` na URL,
# so o `realpath` pega. O `os` nao cria link; o `ln` do sistema serve.
os.cmd("ln -sf /etc/passwd " + PASTA + "/estatico/link_passwd")
os.cmd("ln -sf " + PASTA + "/segredo.txt teste/static/link_fora")

app = jinker.Jinker(name="alvo", static_folder=PASTA + "/estatico", static_url="/estatico")

cors(options=["GET", "POST", "PUT", "DELETE", "PATCH"], origins=["http://permitido.test"])


# ── básico: método, status, cabeçalho, corpo ────────────────────────────────
@app.route("/ok")
action ok()
{
    return {"ok": true, "metodo": request.method}
}

@app.route("/texto")
action texto()
{
    r = jinker.JinkerResponse()
    return r.header("X-Marca", "poolscript").send("texto puro")
}

@app.route("/status")
action com_status()
{
    r = jinker.JinkerResponse()
    return r.status(418).json({"cha": true})
}

@app.route("/eco", methods=["POST", "PUT", "PATCH", "DELETE"])
action eco()
{
    return {"metodo": request.method, "corpo": request.text(), "caminho": request.path}
}

@app.route("/json", methods=["POST"])
action recebe_json()
{
    # `request.get_json()` NAO recebe campo: devolve o corpo inteiro. Quem
    # recebe nome de campo e o `get_json()` do lado CLIENTE, da lib request —
    # os dois se chamam igual e fazem coisas diferentes.
    corpo = request.get_json()
    return jinker.jsonify({"veio": corpo["nome"], "todo": corpo})
}

@app.route("/consulta")
action consulta()
{
    return {"q": request.get("q"), "faltando": request.get("nao_existe")}
}

@app.route("/cabecalho")
action cabecalho()
{
    return {"chave": request.header("X-Chave"), "todos": request.headers.len() > 0}
}

@app.route("/param/<id>")
action param()
{
    return {"id": request.path_param("id")}
}


# I18 — o path param chega no ARGUMENTO da action, se ela pedir.
#
# A rota `/param/<id>` acima continua usando `request.path_param("id")` e nada
# mudou pra ela: as duas formas convivem, que é o ponto da decisão ("opcional,
# poder injetar o valor no arg da action se o Dev quiser").
@app.route("/injeta:id")
action injeta(id)
{
    return {"id": id}
}

# Casa por NOME, não por posição: aqui os parâmetros estão na ordem INVERSA da
# rota, e cada um recebe o seu.
@app.route("/inverte:a/sub:b")
action inverte(b, a)
{
    return {"a": a, "b": b}
}


# ── upload multipart ────────────────────────────────────────────────────────
@app.route("/subir", methods=["POST"])
action subir()
{
    f = request.file("arquivo")
    if f == null
    {
        r = jinker.JinkerResponse()
        return r.status(400).json({"erro": "sem arquivo"})
    }
    destino = PASTA + "/recebido.txt"
    f.save(destino)
    return {"nome": f.name, "tamanho": f.size, "tipo": f.content_type,
            "ext": f.ext, "salvou": os.exists(destino),
            # `files()` e POR CAMPO — exige o nome; sem ele levanta.
            "conteudo": f.bytes().decode(), "quantos": request.files("arquivo").len()}
}


# ── middleware: barra sem a chave, libera com ela ───────────────────────────
@app.middleware()
action confere_chave()
{
    if request.header("X-Chave") != "abre"
    {
        return jinker.jsonify({"msg": "sem permissao"}), 401
    }
    pass
}

@app.route("/protegida", middleware=app.middleware)
action protegida()
{
    return {"entrou": true}
}


# ── CORS: o que foi configurado aparece ─────────────────────────────────────
@app.route("/cors-info")
action cors_info()
{
    return {"options": cors.options(), "origins": cors.origins(), "permiser": cors.permiser()}
}


# ── canal e websocket ───────────────────────────────────────────────────────
@app.route("/emitir")
action emitir()
{
    st = app.channel.emit("aviso", {"n": 1})
    return {"emit": str(st), "status": str(app.channel.status)}
}

# Socket SEM canal: o `return` do handler volta pro REMETENTE da mensagem.
# `app.socket().emit(...)` é pro caso de CANAL (`channel=true`), onde a mensagem
# vai pra todo mundo inscrito — sem canal não há a quem emitir, e o cliente
# ficava esperando um eco que nunca vinha.
@app.socket("/ws")
action ws_sala()
{
    return "eco: " + request.text()
}


# ── validação do corpo com `model` ──────────────────────────────────────────
model Usuario() {
    nome: str(length=20)
    idade: int
}

@app.route("/modelo", methods=["POST"], model=Usuario)
action modelo()
{
    return {"criado": request.get("nome")}
}


# ── atalhos por verbo: o metodo E o nome do membro ──────────────────────────
# Quatro rotas no MESMO path, uma por verbo — e o 405 tem que listar as
# quatro no `Allow`. A ordem de registro e a ordem do `Allow`.
@app.get("/verbo")
action verbo_get()
{
    return {"verbo": "GET"}
}

@app.post("/verbo", model=Usuario, auth=cors.origins())
action verbo_post()
{
    return {"verbo": "POST", "nome": request.get("nome")}
}

@app.put("/verbo")
action verbo_put()
{
    return {"verbo": "PUT"}
}

@app.delete("/verbo")
action verbo_delete()
{
    return {"verbo": "DELETE"}
}

@app.patch("/verbo/<id>")
action verbo_patch(id)
{
    return {"verbo": "PATCH", "id": id}
}


# ── cookie ──────────────────────────────────────────────────────────────────
# logout: o mesmo cookie com vida zero — e o que a doc do cookie mostra em
# `POST /sair`; o Set-Cookie exato esta na tabela de la
@app.post("/cookie-sai")
action cookie_sai()
{
    return jinker.JinkerResponse().send({"ok": true}).cookie("sid", "", max_age=0)
}

@app.route("/cookie-poe")
action cookie_poe()
{
    return jinker.JinkerResponse()
           .send({"ok": true})
           .cookie("sid", "abc123", max_age=3600)
           .cookie("tema", "escuro", httponly=false, path="/x")
}

@app.route("/cookie-le")
action cookie_le()
{
    return {"sid": request.cookie("sid"),
            "tema": request.cookie("tema"),
            "nao": request.cookie("naoexiste")}
}


# ── parada limpa: sem isso o gcov do servidor não grava nada ────────────────
@app.route("/__parar")
action parar()
{
    post("servidor-alvo: parando a pedido do driver")
    os.rmdir("teste/static", force=true)
    sys.exit(0)
}


# A chave FICA NA MESMA LINHA de propósito: no estilo Allman o motor pula o
# bloco em silêncio (ver `casos_pendentes.c`, "if __name__ no estilo Allman").
if __name__ == "main" {
    app(debug=false, host="127.0.0.1", port=28952)
}

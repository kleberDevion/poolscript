# Teste de CARGA: quanto o servidor jinker aguenta, e onde ele fica frente aos
# servidores HTTP de outras linguagens instaladas na maquina.
#
# O gerador de carga e ESTE programa: K fibras `async` com `request.get` em
# `gather`, cada uma fazendo a sua fatia das R requisicoes. O tempo e de
# parede, medido por fora de cada rodada; o resultado e requisicoes por
# segundo. O mesmo cliente bate em cada servidor, entao a comparacao e do
# SERVIDOR, nao do cliente.
#
# Comparacao de MOTOR (interpretador): tres programas equivalentes — laco
# aritmetico, chamada de funct, dicionario — em PoolScript, Python e Node,
# cronometrados do mesmo jeito (menor de 3 execucoes, custo de partida
# descontado).
#
#     ./pool teste/carga.ps                 # tudo
#     ./pool teste/carga.ps --so-http       # so o servidor
#     ./pool teste/carga.ps --so-motor      # so o interpretador
#
# NAO entra no `make check`: tempo e ruidoso e depende da maquina.
import os
import sys
from request import get

PASTA = "/tmp/ps_carga"
PORTA_PS = 29600
PORTA_PY = 29601
PORTA_NODE = 29602
NIVEIS = [1, 10, 50, 200]     # fibras concorrentes
POR_NIVEL = 3000              # requisicoes por nivel (o cronometro custa um
                              # fork, ~3 ms: a rodada precisa durar bem mais)


funct agora_ns() {
    os.cmd("date +%s%N > " + PASTA + "/t")
    return int(os.readFile(PASTA + "/t").strip())
}


funct tem(cmd) {
    os.cmd("command -v " + cmd + " > " + PASTA + "/tem 2>/dev/null; echo $? >> " + PASTA + "/tem")
    linhas = os.readFile(PASTA + "/tem").strip().split("\n")
    return linhas[len(linhas) - 1] == "0"
}


funct sobe(cmd, porta) {
    os.cmd("cd " + PASTA + " && (" + cmd + " > srv_" + str(porta) + ".log 2>&1 &)")
    i = 0
    while i < 40 {
        try {
            r = get("http://127.0.0.1:" + str(porta) + "/ping", timeout=1)
            if r.status_code == 200 {
                return true
            }
        } catch (e) {
            pass
        }
        sleep(0.1)
        i = i + 1
    }
    return false
}


funct derruba(porta) {
    os.cmd("P=$(ss -lptn 'sport = :" + str(porta) + "' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2); [ -n \"$P\" ] && kill -9 $P; true")
}


# K fibras, cada uma com a sua fatia — devolve [req/s, erros]
async funct bate(porta, quantas) {
    erros = 0
    i = 0
    while i < quantas {
        try {
            r = get("http://127.0.0.1:" + str(porta) + "/ping", timeout=10)
            if r.status_code != 200 {
                erros = erros + 1
            }
        } catch (e) {
            erros = erros + 1
        }
        i = i + 1
    }
    return erros
}


funct rodada(porta, k, total) {
    fibras = []
    i = 0
    while i < k {
        addEnd(fibras, bate(porta, total // k))
        i = i + 1
    }
    t0 = agora_ns()
    erros = gather(fibras)[0]           # lista como argumento: resultados vem em [[...]]
    t1 = agora_ns()
    seg = (t1 - t0) / 1000000000.0
    soma = 0
    for each e in erros {
        soma = soma + e
    }
    return [total / seg, soma, seg]
}


funct carga_http() {
    post("── servidor HTTP: requisicoes por segundo (cliente: PoolScript, " + str(POR_NIVEL) + " req por nivel) ──")
    os.writeFile(PASTA + "/srv_ps.ps",
        "import jinker\nfrom jinker import Jinker\napp = Jinker(__name__)\n"
        + "@app.get(\"/ping\")\nfunct ping() {\n    return {\"ok\": true}\n}\n"
        + "if __name__ == \"main\" {\n    app(debug=false, host=\"127.0.0.1\", port=" + str(PORTA_PS) + ")\n}\n")
    servidores = [["jinker (PoolScript)", "'" + sys.executable + "' srv_ps.ps", PORTA_PS]]
    if tem("python3") {
        os.writeFile(PASTA + "/srv_py.py",
            "from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler\n"
            + "class H(BaseHTTPRequestHandler):\n"
            + "    def do_GET(self):\n"
            + "        b = b'{\"ok\": true}'\n"
            + "        self.send_response(200); self.send_header('Content-Type', 'application/json')\n"
            + "        self.send_header('Content-Length', str(len(b))); self.end_headers(); self.wfile.write(b)\n"
            + "    def log_message(self, *a): pass\n"
            + "ThreadingHTTPServer(('127.0.0.1', " + str(PORTA_PY) + "), H).serve_forever()\n")
        addEnd(servidores, ["http.server (Python 3, threads)", "python3 srv_py.py", PORTA_PY])
    }
    if tem("node") {
        os.writeFile(PASTA + "/srv_node.js",
            "require('http').createServer((q, s) => { s.writeHead(200, {'Content-Type': 'application/json'}); s.end('{\"ok\": true}'); })"
            + ".listen(" + str(PORTA_NODE) + ", '127.0.0.1');\n")
        addEnd(servidores, ["http (Node)", "node srv_node.js", PORTA_NODE])
    }
    post("")
    linha = "  servidor                          "
    for each k in NIVEIS {
        linha = linha + ("K=" + str(k)).rjust(12)
    }
    post(linha + "   erros")
    for each s in servidores {
        derruba(s[2])
        if not sobe(s[1], s[2]) {
            post("  " + s[0].ljust(34) + "nao subiu (ver " + PASTA + "/srv_" + str(s[2]) + ".log)")
            continue
        }
        rodada(s[2], 1, 30)                     # aquece
        linha = "  " + s[0].ljust(34)
        erros = 0
        for each k in NIVEIS {
            r = rodada(s[2], k, POR_NIVEL)
            linha = linha + (str(int(r[0])) + " req/s").rjust(12)
            erros = erros + r[1]
        }
        post(linha + "   " + str(erros))
        derruba(s[2])
    }
}


# ── motor: os mesmos tres programas em tres linguagens ──────────────────────
funct mede_cmd(cmd) {
    melhor = -1.0
    i = 0
    while i < 3 {
        t0 = agora_ns()
        os.cmd("cd " + PASTA + " && " + cmd + " > /dev/null 2>&1")
        t1 = agora_ns()
        t = (t1 - t0) / 1000000.0
        if melhor < 0.0 or t < melhor {
            melhor = t
        }
        i = i + 1
    }
    return melhor
}


funct carga_motor() {
    post("")
    post("── motor: menor de 3 execucoes, em ms, partida descontada ──")
    progs = {
        "aritmetica": {
            "ps": "s = 0\ni = 0\nwhile i < 3000000 {\n    s = s + i * 2 - 1\n    i = i + 1\n}\npost(s)\n",
            "py": "s = 0\ni = 0\nwhile i < 3000000:\n    s = s + i * 2 - 1\n    i = i + 1\nprint(s)\n",
            "js": "let s = 0, i = 0;\nwhile (i < 3000000) { s = s + i * 2 - 1; i = i + 1; }\nconsole.log(s);\n"
        },
        "chamada": {
            "ps": "funct f(a, b) {\n    return a + b\n}\ns = 0\ni = 0\nwhile i < 600000 {\n    s = f(s, i)\n    i = i + 1\n}\npost(s)\n",
            "py": "def f(a, b):\n    return a + b\ns = 0\ni = 0\nwhile i < 600000:\n    s = f(s, i)\n    i = i + 1\nprint(s)\n",
            "js": "function f(a, b) { return a + b; }\nlet s = 0, i = 0;\nwhile (i < 600000) { s = f(s, i); i = i + 1; }\nconsole.log(s);\n"
        },
        "dict": {
            "ps": "d = {}\ni = 0\nwhile i < 100000 {\n    d[str(i)] = i\n    i = i + 1\n}\ns = 0\ni = 0\nwhile i < 300000 {\n    s = s + d[str(i % 100000)]\n    i = i + 1\n}\npost(s)\n",
            "py": "d = {}\ni = 0\nwhile i < 100000:\n    d[str(i)] = i\n    i = i + 1\ns = 0\ni = 0\nwhile i < 300000:\n    s = s + d[str(i % 100000)]\n    i = i + 1\nprint(s)\n",
            "js": "const d = {};\nlet i = 0;\nwhile (i < 100000) { d[String(i)] = i; i = i + 1; }\nlet s = 0; i = 0;\nwhile (i < 300000) { s = s + d[String(i % 100000)]; i = i + 1; }\nconsole.log(s);\n"
        }
    }
    os.writeFile(PASTA + "/vazio.ps", "post(1)\n")
    os.writeFile(PASTA + "/vazio.py", "print(1)\n")
    os.writeFile(PASTA + "/vazio.js", "console.log(1);\n")
    partida = {"ps": mede_cmd("'" + sys.executable + "' vazio.ps")}
    if tem("python3") {
        partida["py"] = mede_cmd("python3 vazio.py")
    }
    if tem("node") {
        partida["js"] = mede_cmd("node vazio.js")
    }
    post("  caso           PoolScript      Python 3        Node")
    for each nome in ["aritmetica", "chamada", "dict"] {
        p = progs[nome]
        os.writeFile(PASTA + "/" + nome + ".ps", p["ps"])
        linha = "  " + nome.ljust(14) + (str(int(mede_cmd("'" + sys.executable + "' " + nome + ".ps") - partida["ps"])) + " ms").rjust(10)
        if "py" in partida {
            os.writeFile(PASTA + "/" + nome + ".py", p["py"])
            linha = linha + (str(int(mede_cmd("python3 " + nome + ".py") - partida["py"])) + " ms").rjust(14)
        } else {
            linha = linha + "-".rjust(14)
        }
        if "js" in partida {
            os.writeFile(PASTA + "/" + nome + ".js", p["js"])
            linha = linha + (str(int(mede_cmd("node " + nome + ".js") - partida["js"])) + " ms").rjust(12)
        } else {
            linha = linha + "-".rjust(12)
        }
        post(linha)
    }
}


if __name__ == "main" {
    os.mkdir(PASTA, exist_ok=true)
    so_http = false
    so_motor = false
    for each a in sys.argv {
        if a == "--so-http" {
            so_http = true
        }
        if a == "--so-motor" {
            so_motor = true
        }
    }
    if not so_motor {
        carga_http()
    }
    if not so_http {
        carga_motor()
    }
}

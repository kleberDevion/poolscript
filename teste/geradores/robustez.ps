# Gera `teste/casos_robustez.c`: cada método do motor chamado com ARIDADE
# errada e TIPO errado em cada posição.
#
# O contrato não precisa de oráculo — "chamada errada tem que reclamar" é
# invariante:
#
#   - erro capturável por try/catch (não crash, não silêncio)
#   - a VM NÃO morre (o runner faz fork/exec, então sinal vira falha)
#   - a VM NÃO trava (o runner tem alarm)
#
# Um caso por TIPO, não por chamada: são ~11 mil chamadas erradas, e uma por
# subprocesso levaria mais de um minuto. Cada programa roda as chamadas do seu
# tipo dentro de try/catch e imprime a lista das que passaram CALADAS. A saída
# esperada é essa lista como ela é hoje — aceitação silenciosa nova, crash ou
# trava mudam o resultado e o caso falha.
#
# Rodar:  ./pool teste/geradores/robustez.ps
import os
import sys
import json

SAIDA = "teste/casos_robustez.c"
TMP = "/tmp/ps_gera_robustez"

# receptores construíveis sem I/O. Lista de pares, não dict: a ORDEM decide a
# ordem dos casos no arquivo gerado, e tem que ser estável entre rodadas.
ALVO = [
    ["str", "\"abc\""], ["list", "[1, 2]"], ["dict", "{\"a\": 1}"], ["tup", "(1, 2)"],
    ["bytes", "\"oi\".encode()"], ["Pattern", "regex.compile(\"a\")"],
    ["MailMessage", "mail.MailMessage()"], ["MailServer", "mail.MailServer()"],
    ["MailReader", "mail.MailReader()"], ["Jinker", "jinker.Jinker(name=\"r\")"],
    ["JinkerResponse", "jinker.JinkerResponse()"], ["QRImage", "qrcode.make(\"x\")"],
    ["UI", "guzer.UI()"], ["socket", "sockets.socket()"]
]

IMPORTS = "import os\nimport regex\nimport mail\nimport jinker\nimport qrcode\nimport guzer\nimport sockets\n"

LIXO = ["Null", "42", "-1", "3.5", "true", "\"texto\"", "[1]", "{\"k\": 1}", "(1,)"]


# Chamada errada com efeito colateral EXISTE: um QRImage que recebeu a string
# "texto" como caminho salvou um PNG na raiz do repo. Cada tipo roda numa pasta
# própria e VAZIA — se sobrar arquivo de uma rodada anterior, um
# `attach("texto")` que antes errava passa a achar o arquivo e o caso vira
# intermitente.
action prologo(tipo):
    d = "/tmp/ps_robustez_" + tipo
    p = "os.cmd(\"rm -rf " + d + "\")\n"
    p = p + "os.mkdir(\"" + d + "\", exist_ok=true)\n"
    p = p + "os.chdir(\"" + d + "\")\n"
    return p


# (rótulo, expressão) de toda chamada ERRADA daquele tipo.
action chamadas(meta, tipo, recv):
    fora = []
    metodos = []
    if tipo in meta["tipos"]:
        metodos = meta["tipos"][tipo]
    for each m in metodos:
        if m.get("kind") == "property":
            continue
        nome = m["nome"]
        ps = m.get("params")
        if ps == Null:
            ps = []
        # falta argumento obrigatório
        tem_obrig = false
        for each p in ps:
            if p.get("default") == Null:
                tem_obrig = true
        if tem_obrig:
            fora.append([nome, recv + "." + nome + "()"])
        # argumentos DEMAIS
        demais = []
        for each i in range(len(ps) + 2):
            demais.append("1")
        fora.append([nome, recv + "." + nome + "(" + ", ".join(demais) + ")"])
        # lixo em CADA posição declarada — opcional inclusive: parâmetro que o
        # motor nem checa aceita qualquer coisa calado, e é isso que se quer ver
        for each i in range(len(ps)):
            for each lixo in LIXO:
                args = []
                for each k in range(len(ps)):
                    if k == i:
                        args.append(lixo)
                    else:
                        args.append("1")
                fora.append([nome, recv + "." + nome + "(" + ", ".join(args) + ")"])
    return fora


# Granularidade de MÉTODO, não de chamada: uma lista com 9 mil combinações de
# argumento não dá sinal nenhum num diff. O que importa é "este método deixou
# de reclamar" — e o total, pra o placar não mudar sem aparecer.
action programa(tipo, fora):
    L = [IMPORTS + prologo(tipo), "CAL = []", "N = []",
         "action calou_(nome):",
         "    if not CAL.contains(nome):",
         "        CAL.append(nome)",
         "    N.append(1)", ""]
    for each par in fora:
        L.append("try:")
        L.append("    _r = " + par[1])
        L.append("    calou_(\"" + par[0] + "\")")
        L.append("catch (e):")
        L.append("    pass")
    L.append("")
    L.append("CAL.sort()")
    L.append("post(len(N), \"caladas em\", len(CAL), \"metodos:\", CAL)")
    return "\n".join(L) + "\n"


action cstr(s):
    e = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t")
    return "\"" + e + "\""


run_selfwith_("main"):
    os.mkdir(TMP, exist_ok=true)
    os.cmd("./pool --metadata > " + TMP + "/meta.json")
    meta = json.parse(open(TMP + "/meta.json").read())

    out = ["/*",
           " * GERADO por teste/geradores/robustez.ps — nao edite na mao.",
           " *",
           " * Chamada errada (aridade e tipo) em cada metodo de cada tipo. O caso",
           " * imprime as chamadas que passaram CALADAS; a saida esperada e a lista",
           " * de hoje. Aceitacao silenciosa nova, crash ou trava fazem o caso falhar.",
           " */",
           "#include \"ps_teste.h\"", "", "const Caso CASOS_ROBUSTEZ[] = {"]

    total = 0
    mudos_total = 0
    for each par in ALVO:
        tipo = par[0]
        recv = par[1]
        fora = chamadas(meta, tipo, recv)
        if len(fora) == 0:
            post("  ", tipo, "sem metodo — pulado")
            continue
        src = programa(tipo, fora)
        fonte = TMP + "/" + tipo + ".ps"
        using open(fonte, "w") as f:
            f.write(src)
        os.cmd("GUZER_HEADLESS=1 ./pool " + fonte + " > " + TMP + "/out 2> " + TMP + "/err; echo $? > " + TMP + "/rc")
        saida = open(TMP + "/out").read().strip()
        rc = int(open(TMP + "/rc").read().strip())
        if rc != 0 or not " caladas em " in saida:
            post("ERRO gerando", tipo, "rc =", rc)
            post(open(TMP + "/err").read()[0:600])
            sys.exit(1)
        mudos = int(saida.split(" ")[0])
        total = total + len(fora)
        mudos_total = mudos_total + mudos
        post("  ", tipo, len(fora), "chamadas erradas,", mudos, "passaram caladas")
        out.append("/* " + tipo + ": " + str(len(fora)) + " chamadas erradas */")
        out.append("{ \"robustez: " + tipo + "\", " + cstr(src) + ", " + cstr(saida) + ", NULL, 0 },")

    out.append("};")
    out.append("const int NC_ROBUSTEZ = N_CASOS(CASOS_ROBUSTEZ);")
    using open(SAIDA, "w") as f:
        f.write("\n".join(out) + "\n")

    post("")
    post(SAIDA + ":", total, "chamadas erradas,", mudos_total, "passam caladas")

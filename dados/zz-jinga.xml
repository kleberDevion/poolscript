<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tipo MIME da Jinga pro freedesktop (GNOME, KDE, XFCE, Cinnamon…).

  A extensão da linguagem é `.pr`, e ninguém mais a reivindica — então aqui
  basta UM glob, com o peso padrão. Era `.ps`, `.psl` e `.p`: o `.ps` é do
  `application/postscript`, e pra ganhar dele este arquivo precisava de peso 80
  no glob, do prefixo `zz-` no nome (o `update-mime-database` processa em
  ordem) e de um `<glob-deleteall/>` que arrancava o `.ps` do PostScript. Nada
  disso existe mais.

  Antes do rename da linguagem o arquivo se chamava `zz-poolscript.xml`, com o
  tipo `text/poolscript`: o `make install-mime` e o instalador APAGAM o antigo
  de `/usr/share/mime/packages/` ao instalar este, senão ficam dois tipos
  registrados pro mesmo `.pr`.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/jinga">
    <comment>Jinga source</comment>
    <comment xml:lang="pt_BR">Código-fonte Jinga</comment>
    <sub-class-of type="text/plain"/>
    <icon name="text-jinga"/>
    <!-- SEM `generic-icon`: o nome genérico (`text-x-script`) existe no tema
         do desktop (Mint-Y, Adwaita…), que vem ANTES do hicolor na herança —
         e o GTK prefere um ícone achado num tema mais próximo a um nome mais
         específico achado num tema mais distante. Com o genérico declarado, a
         logo da linguagem nunca era escolhida. -->

    <glob pattern="*.pr"/>

    <!-- Marcas de pacote da própria linguagem: decidem pelo CONTEÚDO, sem
         depender da extensão. `pool` é o nome antigo do comando. -->
    <magic priority="60">
      <match type="string" value="#!lib" offset="0"/>
      <match type="string" value="#!cmd" offset="0"/>
      <match type="string" value="#!/usr/bin/env jinga" offset="0"/>
      <match type="string" value="#!/usr/local/bin/jinga" offset="0"/>
      <match type="string" value="#!/usr/bin/env pool" offset="0"/>
      <match type="string" value="#!/usr/local/bin/pool" offset="0"/>
    </magic>
  </mime-type>
</mime-info>

# Roda TODO bloco ```ps da documentação pelo `jinga --check`.
#
# POR QUE ESTE ARQUIVO EXISTE: o `audita_doc.pr` confere a ASSINATURA do título
# de cada página contra o `--metadata`. Ninguém conferia o CÓDIGO dentro das
# páginas. O resultado é que `docs/linguagem/06-funcoes.md` ainda apresentava
#
#     int async funct f():   ...
#
# como "válido", e o motor responde "bloco com ':' nao existe mais — use '{ }'".
# Exemplo que não roda é doc errada com cara de doc certa; Python (doctest),
# Rust (`cargo test --doc`) e Go (Example) executam os exemplos por isso.
#
#     ./pool scripts/audita_exemplos_doc.pr          # relata e reprova
#     ./pool scripts/audita_exemplos_doc.pr --lista  # mostra o bloco inteiro
#
# ESCOPO: só as cercas marcadas ```ps / ```jinga. As cercas SEM marcação
# misturam saída de terminal, JSON e shell — incluir tudo daria achado inventado,
# que é pior que achado nenhum.
#
# O `--check` é a tipagem estática inteira: nome que não existe, tipo errado,
# chamada errada, tudo sai antes de rodar. Duas coisas decorrem disso:
#
#   - CONTEXTO. Uma página cujos exemplos pressupõem algo (`app` já criado,
#     `import jinker`) escreve isso num bloco com a cerca ```ps contexto. Ele é
#     conferido como qualquer bloco e vai na frente de todo bloco SEGUINTE da
#     mesma página. É o "os exemplos abaixo pressupõem" escrito em código,
#     visível pra quem lê e usado por quem confere — nada escondido.
#
#   - ERRO MOSTRADO DE PROPÓSITO. Um bloco que existe pra mostrar um erro
#     (`# AttributedValueError: ...`) só passa se o erro que ele ANUNCIA é o
#     que o motor dá. Antes esses blocos eram pulados; agora são conferidos:
#     doc que promete um erro e o motor dá outro é doc errada.
#
# O único bloco que não se confere é o fragmento com `...` — e ele sai
# nomeado, pra revisão humana.
import os
import sys
import json

RAIZ = "docs"
# Pasta de trabalho RELATIVA à corrente, criada antes da conferência e apagada
# no fim dela. Era "/tmp/ps_audita_doc": no Windows o motor é nativo, "/tmp/x"
# vira "<unidade>:\tmp\x" (não é o /tmp do MSYS2), e nada apagava a pasta.
TMP = "ps_audita_exemplos_tmp"


funct lista_md(dir) {
    saida = []
    for each item in os.ls(dir) {
        caminho = dir + "/" + item["name"]
        if item["type"] == "dir" {
            for each f in lista_md(caminho) {
                addEnd(saida, f)
            }
        }
        elif item["name"].endswith(".md") {
            addEnd(saida, caminho)
        }
    }
    return saida
}


# A cerca pode estar INDENTADA (bloco dentro de item de lista do markdown).
# Essa indentação é do markdown, não do código: mantê-la faria o auditor acusar
# "indentacao deve ser multiplo de 4" num exemplo correto — achado inventado.
funct recuo(linha) {
    r_n = 0
    while r_n < linha.len() and linha[r_n] == " " {
        r_n = r_n + 1
    }
    return r_n
}


# Cada bloco: linha da cerca, código e se é o CONTEXTO da página.
funct blocos_ps(txt) {
    b_blocos = []
    b_dentro = false
    b_atual = []
    b_ini = 0
    b_margem = 0
    b_contexto = false
    b_n = 0
    for each linha in txt.splitlines() {
        b_n = b_n + 1
        limpa = linha.strip()
        if b_dentro {
            if limpa == "```" {
                addEnd(b_blocos, {"linha": b_ini, "codigo": "\n".join(b_atual), "contexto": b_contexto})
                b_dentro = false
                b_atual = []
            }
            else {
                if recuo(linha) >= b_margem {
                    addEnd(b_atual, linha[b_margem:linha.len()])
                }
                else {
                    addEnd(b_atual, limpa)
                }
            }
        }
        elif limpa == "```ps" or limpa == "```jinga" or limpa == "```ps contexto" {
            b_dentro = true
            b_ini = b_n
            b_margem = recuo(linha)
            b_atual = []
            b_contexto = (limpa == "```ps contexto")
        }
    }
    return b_blocos
}


# O que o próprio motor escreve rodando com `args`: o stdout e o stderr
# INTEIROS, cada um no seu campo. Com lista e sem shell: era `os.cmd` com o
# caminho entre aspas simples, e no Windows o `os.cmd` é o cmd.exe, onde aspa
# simples não é aspa (o programa procurado virava `'C:\...\pool.exe'`, com as
# aspas no nome).
#
# Os dois canais, e não o `capture=true`: ele devolve o stdout e só cai pro
# stderr quando o stdout vem vazio. O `--check` que não abre o arquivo escreve
# nos DOIS (medido: "jinga: nao consegui abrir '...'" no stderr e o JSON de
# IOError no stdout), e só com o stdout um bloco que cita IOError passaria
# como erro anunciado.
#
# O stdout é lido até o fim antes do stderr. O `--check` só escreve no stderr
# quando não consegue ler o arquivo (uma mensagem de poucas linhas) e o
# `--metadata` não escreve nada lá: o cano do stderr não enche enquanto o
# stdout é lido.
funct roda_motor(args) {
    m_saida = ""
    m_erro = ""
    m_rc = 0
    using os.run([sys.executable] + args, capture="live") as m_proc {
        m_parte = m_proc.read()
        while m_parte != "" {
            m_saida = m_saida + m_parte
            m_parte = m_proc.read()
        }
        m_parte = m_proc.read_err()
        while m_parte != "" {
            m_erro = m_erro + m_parte
            m_parte = m_proc.read_err()
        }
        m_rc = m_proc.wait()
    }
    return {"saida": m_saida, "erro": m_erro, "rc": m_rc}
}


funct confere(codigo) {
    alvo = TMP + "/bloco.pr"
    using open(alvo, "w") as f {
        f.write(codigo + "\n")
    }
    # O stderr NA FRENTE do stdout, como o `2>&1` deixava no arquivo: o stderr
    # sai na hora e o stdout, que não é terminal, só no fim do processo. Com
    # stderr, a resposta não começa por "{" e o `tipo_do_erro` a toma inteira
    # como o erro: não passa calada.
    c_resposta = roda_motor(["--check", alvo])
    c_texto = (c_resposta["erro"] + c_resposta["saida"]).strip()
    # O `--check` sai 0 (passou) ou 1 (acusou), sempre com o JSON. O filho que
    # morre sem responder (sinal no Linux e no macOS, violação de acesso no
    # Windows) deixava a resposta vazia, e o `tipo_do_erro` lia "" como
    # "passou": o bloco que DERRUBA o motor contava como aprovado. Resposta
    # vazia ou código fora de 0 e 1 vira achado, com o código de saída.
    if c_texto == "" or not (c_resposta["rc"] in [0, 1]) {
        return ("o --check nao respondeu direito (saiu com " + str(c_resposta["rc"])
                + ") " + c_texto).strip()
    }
    return c_texto
}


# O bloco só cita MÓDULO DE EXEMPLO?
#
# As páginas de import falam de `import mymod`, `from './irmao.pr' import w`,
# `import '/opt/app/util.pr'` — módulos que não existem nem devem existir no
# repositório. O `--check` passou a acusar módulo ausente (e é o certo: um typo
# no import tem que aparecer no editor), mas o assunto desses blocos é a FORMA
# do import, não a instalação. Então o bloco cujos erros são TODOS "No module
# named" conta como exemplo válido — e vai pra uma lista impressa no fim, pra
# ninguém descobrir isso por acaso.
funct so_modulo_de_exemplo(resposta) {
    if not resposta.startswith("{") { return false }
    r = json.parse(resposta)
    if r["ok"] { return false }
    if r["tipo"] != "ImportError" { return false }
    erros = r.get("erros")
    if erros == Null { return "No module named" in r["msg"] }
    for each e in erros {
        if not "No module named" in e["msg"] { return false }
    }
    return true
}


# O tipo do erro que o `--check` devolveu ("" se passou ou se a saída não é o
# JSON do check — aí a mensagem inteira vale como tipo, pra não passar calado).
funct tipo_do_erro(resposta) {
    if resposta.startswith("{") {
        r = json.parse(resposta)
        if r["ok"] {
            return ""
        }
        return r["tipo"]
    }
    return resposta
}


os.mkdir(TMP, exist_ok=true)
lista = "--lista" in sys.argv

# os nomes de erro da linguagem — do motor, não de lista digitada. O stderr do
# `--metadata` vai pro stderr daqui, como ia quando ele herdava o terminal: se
# o JSON não vier, o motivo aparece antes do erro do `json.parse`.
META = roda_motor(["--metadata"])
sys.stderr.write(META["erro"])
NOMES_DE_ERRO = []
for each e in json.parse(META["saida"])["excecoes"] {
    addEnd(NOMES_DE_ERRO, e["nome"])
}
addEnd(NOMES_DE_ERRO, "SyntaxError")

total = 0
anunciados = 0
pulados = []
achados = []
exemplos_de_modulo = []

for each md in lista_md(RAIZ) {
    contexto = ""
    for each b in blocos_ps(os.readFile(md)) {
        if "..." in b["codigo"] {
            addEnd(pulados, md + ":" + str(b["linha"]))
            continue
        }
        total = total + 1
        codigo = b["codigo"]
        resposta = ""                  # nasce aqui: o que nasce no `if` morre com ele
        if b["contexto"] {
            # o contexto se confere sozinho (com o que veio antes dele) e passa
            # a valer pros blocos seguintes da página
            resposta = confere(contexto + codigo)
            contexto = contexto + codigo + "\n"
        }
        else {
            resposta = confere(contexto + codigo)
        }
        tipo = tipo_do_erro(resposta)
        if tipo == "" {
            continue
        }
        if so_modulo_de_exemplo(resposta) {
            addEnd(exemplos_de_modulo, md + ":" + str(b["linha"]))
            continue
        }
        # erro mostrado de propósito: o bloco anuncia o erro que o motor deu
        if tipo in codigo {
            anunciados = anunciados + 1
            continue
        }
        # o bloco anuncia OUTRO erro: a doc promete um e o motor dá outro
        prometido = ""
        for each nome in NOMES_DE_ERRO {
            if nome in codigo {
                prometido = nome
            }
        }
        msg = resposta
        if prometido != "" {
            msg = "a pagina anuncia " + prometido + ", o motor da " + tipo + ": " + resposta
        }
        addEnd(achados, {"arq": md, "linha": b["linha"], "msg": msg, "codigo": codigo})
    }
}

# A pasta de trabalho sai aqui: nada abaixo a usa, e o `sys.exit` do fim não
# passa por limpeza nenhuma.
os.rmdir(TMP, force=true)

post("blocos ```ps conferidos:", total)
post("  dos quais mostram um erro de proposito, e o motor da ESSE erro:", anunciados)
# Nada de corte silencioso: o que ficou de fora sai NOMEADO, pra revisão humana.
post("blocos pulados (fragmento com '...' — confira à mão):", pulados.len())
for each p in pulados {
    post("  " + p)
}
post("blocos que citam módulo de exemplo (o import não resolve aqui):",
     exemplos_de_modulo.len())
for each e in exemplos_de_modulo {
    post("  " + e)
}

if achados.len() == 0 {
    post("  todos passam no --check (ou anunciam o erro que o motor da)")
    sys.exit(0)
}

post("")
post("BLOCOS QUE O MOTOR RECUSA:", achados.len())
for each a in achados {
    post("  " + a["arq"] + ":" + str(a["linha"]))
    post("    " + a["msg"])
    if lista {
        post("    ----")
        for each l in a["codigo"].splitlines() {
            post("    | " + l)
        }
    }
}
post("")
post("Exemplo que o motor recusa é doc errada. Corrija a página; se o bloco")
post("pressupõe algo (um `app` já criado, um import), escreva isso num bloco")
post("```ps contexto acima dele; se ele mostra um erro de propósito, o nome do")
post("erro tem que estar no bloco, e tem que ser o erro que o motor dá.")
sys.exit(1)

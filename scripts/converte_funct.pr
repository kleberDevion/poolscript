# Troca as grafias antigas `action` e `reaction` pela palavra da linguagem,
# `funct`, num fonte Jinga.
#
#     ./pool scripts/converte_funct.pr arquivo.pr           # mostra o resultado
#     ./pool scripts/converte_funct.pr arquivo.pr --grava   # sobrescreve
#     ./pool scripts/converte_funct.pr --lista a.pr b.pr    # em lote, gravando
#
# Quem decide o que e a PALAVRA e o lexer do motor (`jinga --tokens`), nunca o
# texto: `action` dentro de string, de comentario ou como nome de arquivo
# (`examples/action.pr`) nao e palavra reservada, e so o lexer separa isso sem
# errar. Cada token vem com linha, coluna e tamanho — a troca e cirurgica.
#
# A CONFERENCIA e a parte que importa: o FLUXO DE TOKENS do arquivo convertido
# tem que ser o mesmo do original, token a token, tipo e valor, so trocando a
# palavra. Se um so token a mais, a menos ou diferente aparecer, o arquivo nao
# e gravado — renomear que mexe em outra coisa nao e renomear, e estragar.
#
# Comparar a ARVORE nao serve aqui: `funct` tem 5 letras e `action` tem 6,
# entao toda linha convertida desloca a COLUNA dos nos seguintes e a arvore
# difere por posicao, nao por estrutura. O fluxo de tokens ignora coluna.
import os
import sys
import json

TMP = "/tmp/ps_converte_funct"
ANTIGAS = ["action", "reaction"]


funct roda_motor(bandeira, fonte) {
    os.mkdir(TMP, exist_ok=True)
    str alvo = TMP + "/e.pr"
    os.writeFile(alvo, fonte)
    # Apaga a saida ANTES: um subprocesso que falhe deixaria o resultado da
    # chamada anterior no lugar, e um arquivo seria julgado pela arvore de
    # outro — a mesma armadilha que o para_chaves.pr documenta.
    os.cmd("rm -f " + TMP + "/saida.json")
    os.cmd("'" + sys.executable + "' " + bandeira + " < " + alvo + " > " + TMP + "/saida.json 2>/dev/null")
    str saida = ""
    if os.exists(TMP + "/saida.json") {
        saida = os.readFile(TMP + "/saida.json").strip()
    }
    # a pasta sai a cada chamada: nada fica no /tmp
    os.rmdir(TMP, force=True)
    return saida
}


# Os tokens do fonte, pelo lexer do motor. Desde o 17.0.4 o `--tokens`
# devolve {"tokens": [...], "erros": [...]} (antes, a lista pura): lida como
# lista, a resposta nova virava "sem ocorrencia" calado em todo arquivo.
# Fonte com erro de lexer devolve a lista vazia, e o arquivo fica como esta.
list funct tokens_do(str fonte) {
    str bruto = roda_motor("--tokens", fonte)
    if bruto == "" {
        return []
    }
    dict resp = json.parse(bruto)
    if "erros" in resp {
        return []
    }
    return resp["tokens"]
}


# `action`/`reaction` sairam da linguagem em 2026-09-07 (90561cf), e desde
# entao o lexer as le como nome comum (IDENT), nao como palavra (KW): antes
# daqui o script procurava KW e nao achava nada. O alvo e a palavra na
# posicao da declaracao, `action nome(` ou `action(` (a funct sem nome), e
# nunca depois de `.` (metodo) ou de `funct` (o nome de uma funct). O resto
# do script confere: o fluxo de tokens tem que ser o mesmo, e o convertido
# tem que passar no `--check`.
bool funct eh_alvo(list toks, int i) {
    dict t = toks[i]
    if not (t["v"] in ANTIGAS) or not (t["t"] == "KW" or t["t"] == "IDENT") {
        return False
    }
    if i > 0 and (toks[i - 1]["t"] == "DOT" or toks[i - 1]["v"] == "funct") {
        return False
    }
    if i + 1 < len(toks) and toks[i + 1]["t"] == "LPAREN" {
        # a funct sem nome tem o corpo logo depois do `)`: `action(x) {`;
        # sem o `{` e a chamada de uma funct que se chama `action`
        int prof = 0
        int j = i + 1
        while (j < len(toks)) {
            if toks[j]["t"] == "LPAREN" {
                prof += 1
            }
            elif toks[j]["t"] == "RPAREN" {
                prof -= 1
                if prof == 0 {
                    return j + 1 < len(toks) and toks[j + 1]["t"] == "LBRACE"
                }
            }
            j += 1
        }
        return False
    }
    return i + 2 < len(toks) and toks[i + 1]["t"] == "IDENT" and toks[i + 2]["t"] == "LPAREN"
}


# Os tokens da grafia antiga, agrupados por linha.
funct alvos_por_linha(fonte) {
    list toks = tokens_do(fonte)
    porlinha = {}
    int i = 0
    while (i < len(toks)) {
        if eh_alvo(toks, i) {
            dict t = toks[i]
            str chave = str(t["l"])
            if not (chave in porlinha) {
                porlinha[chave] = []
            }
            addEnd(porlinha[chave], t)
        }
        i += 1
    }
    return porlinha
}


funct converte(fonte) {
    porlinha = alvos_por_linha(fonte)
    if len(porlinha) == 0 {
        return fonte
    }
    linhas = fonte.split("\n")
    saida = []
    i = 0
    while i < len(linhas) {
        L = linhas[i]
        chave = str(i + 1)
        if chave in porlinha {
            # De TRAS PRA FRENTE: trocar da esquerda pra direita desloca as
            # colunas dos tokens seguintes da mesma linha.
            toks = porlinha[chave]
            k = len(toks) - 1
            while k >= 0 {
                t = toks[k]
                ini = t["c"] - 1
                L = L[0:ini] + "funct" + L[ini + t["n"]:len(L)]
                k = k - 1
            }
        }
        addEnd(saida, L)
        i = i + 1
    }
    return "\n".join(saida)
}


# A assinatura do fonte: tipo e valor de cada token, na ordem, com a grafia
# antiga ja normalizada pra `funct`. Sem linha, sem coluna, sem tamanho — o
# que muda de posicao ao encurtar a palavra nao pode contar como diferenca.
funct assinatura(fonte) {
    list toks = tokens_do(fonte)
    if len(toks) == 0 {
        return ""
    }
    list partes = []
    int i = 0
    while (i < len(toks)) {
        dict t = toks[i]
        if eh_alvo(toks, i) {
            partes.append("KW:funct")
        }
        else {
            partes.append(t["t"] + ":" + t["v"])
        }
        i += 1
    }
    return "|".join(partes)
}


# Converte UM arquivo. Devolve o que aconteceu, ou o motivo da recusa.
funct converte_arquivo(caminho, grava) {
    fonte = open(caminho).read()
    novo = converte(fonte)
    if novo == fonte {
        return "sem ocorrencia"
    }
    antes = assinatura(fonte)
    depois = assinatura(novo)
    if antes == "" or depois == "" {
        return "RECUSADO: o lexer nao devolveu tokens"
    }
    if antes != depois {
        return "RECUSADO: o fluxo de tokens mudou"
    }
    if not roda_motor("--check", novo).startswith("{\"ok\":true") {
        return "RECUSADO: o convertido nao passa no --check"
    }
    if grava {
        using open(caminho, "w") as f {
            f.write(novo)
        }
        return "convertido"
    }
    post(novo)
    return "ok (nao gravado)"
}


if __name__ == "main" {
    args = sys.argv[1:]          # sys.argv[0] é o nome do script
    if len(args) < 1 {
        post("uso: jinga scripts/converte_funct.pr <arquivo.pr> [--grava]")
        post("     jinga scripts/converte_funct.pr --lista <a.pr> <b.pr> ...")
        sys.exit(1)
    }
    lote = args[0] == "--lista"
    grava = lote
    for each a in args {
        if a == "--grava" {
            grava = True
        }
    }
    alvos = []
    for each a in args {
        if a == "--lista" or a == "--grava" {
            continue
        }
        addEnd(alvos, a)
    }
    ruins = 0
    for each caminho in alvos {
        r = converte_arquivo(caminho, grava)
        if r.startswith("RECUSADO") {
            ruins = ruins + 1
        }
        if lote or r.startswith("RECUSADO") or r == "sem ocorrencia" {
            post(r.ljust(14), caminho)
        }
    }
    if ruins > 0 {
        post("")
        post(str(ruins) + " arquivo(s) RECUSADO(s) — nada foi gravado neles")
        sys.exit(1)
    }
}

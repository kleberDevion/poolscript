# Gera as listas do realce dos editores a partir do MOTOR.
#
# A gramática TextMate (editor/vscode/syntaxes/poolscript.tmLanguage.json)
# tinha listas digitadas de tipos e builtins — e pintava `Long`, que a
# linguagem não tinha, e não pintava exceção nenhuma. Regra do dono: nenhuma
# lista fixa. As três alternações saem do `pool --metadata`:
#
#   storage.type.poolscript             <- tipos_declaraveis + tipos_apelidos + tipos_nomes
#   support.function.builtin.poolscript <- builtins[].nome
#   support.class.exception.poolscript  <- excecoes[].nome
#
# O syntax do Neovim (editor/nvim/syntax/poolscript.vim) é espelho da
# gramática e tinha as MESMAS listas digitadas — e apodrecia do mesmo jeito
# (sem `long`, sem `PoolFile`, sem exceção nenhuma). As dele saem daqui também:
# cada `syn keyword`/`syn match` gerado vem logo depois de uma linha
# `" GERADO: <lista>`, e é essa instrução (com as continuações `\`) que é
# reescrita. No Vim o apelido de tipo (`string`) pinta por POSIÇÃO (só antes de
# um nome) e o builtin que também é tipo (`str(x)`) fica em psType — por isso
# as listas do Vim são derivadas das três, não iguais.
#
#     ./pool scripts/gera_realce.pr            # reescreve a gramática e o syntax
#     ./pool scripts/gera_realce.pr --portao   # não escreve: reprova se divergir
#
# O resto dos arquivos (comentários, escopos, lookaheads) fica como está.
import os
import sys
import json

GRAMATICA = "editor/vscode/syntaxes/poolscript.tmLanguage.json"
VIM = "editor/nvim/syntax/poolscript.vim"
MARCA = "\" GERADO: "

# `(?!\s*=[^=])`: `int = 1` ou `type=...` como nome de argumento não é tipo.
# `\s*(?=\()`: builtin só pinta quando CHAMADO (`route = 1` fica variável).
REGRAS = [
    ["storage.type.poolscript",             "\\\\b(", ")\\\\b(?!\\\\s*=[^=])"],
    ["support.function.builtin.poolscript", "\\\\b(", ")\\\\s*(?=\\\\()"],
    ["support.class.exception.poolscript",  "\\\\b(", ")\\\\b"],
]


funct nomes_de(meta) {
    tipos = []
    for each t in meta["tipos_declaraveis"] {
        if not tipos.contains(t) { addEnd(tipos, t) }
    }
    for each a in meta["tipos_apelidos"].keys() {
        if not tipos.contains(a) { addEnd(tipos, a) }
    }
    for each t in meta["tipos_nomes"] {
        if not tipos.contains(t) { addEnd(tipos, t) }
    }
    builtins = []
    for each b in meta["builtins"] {
        addEnd(builtins, b["nome"])
    }
    excecoes = []
    for each x in meta["excecoes"] {
        addEnd(excecoes, x["nome"])
    }
    return [tipos, builtins, excecoes]
}


# A linha `"match": "..."` gerada para a regra `i`, com a indentação da linha
# que ela substitui.
funct linha_match(indent, i, nomes) {
    return indent + "\"match\": \"" + REGRAS[i][1] + "|".join(nomes) + REGRAS[i][2] + "\""
}


funct gera(linhas, listas) {
    saida = []
    pendente = -1
    for each l in linhas {
        t = l.strip()
        if pendente >= 0 and t.startswith("\"match\":") {
            indent = l[0:len(l) - len(l.lstrip())]
            addEnd(saida, linha_match(indent, pendente, listas[pendente]))
            pendente = -1
            continue
        }
        i = 0
        for each r in REGRAS {
            if t == "\"name\": \"" + r[0] + "\"," {
                pendente = i
            }
            i = i + 1
        }
        addEnd(saida, l)
    }
    return saida
}


# Uma instrução `syn keyword` do Vim quebrada em linhas de continuação (`\`),
# como o arquivo sempre foi escrito à mão.
funct instrucao_vim(cabeca, nomes) {
    iv_linhas = []
    iv_atual = cabeca
    for each iv_n in nomes {
        if len(iv_atual) + 1 + len(iv_n) > 78 {
            addEnd(iv_linhas, iv_atual)
            iv_atual = "      \\ " + iv_n
        }
        else {
            iv_atual = iv_atual + " " + iv_n
        }
    }
    addEnd(iv_linhas, iv_atual)
    return iv_linhas
}


# O syntax do Vim com as quatro instruções marcadas reescritas. `apelidos` são
# as chaves de `tipos_apelidos` (string, String, …): pintam por posição, num
# `syn match` próprio, e saem da lista de keywords.
funct gera_vim(linhas, listas, apelidos) {
    gv_tipos = []
    for each gv_t in listas[0] {
        if not apelidos.contains(gv_t) { addEnd(gv_tipos, gv_t) }
    }
    gv_builtins = []
    for each gv_b in listas[1] {
        if not gv_tipos.contains(gv_b) { addEnd(gv_builtins, gv_b) }
    }
    gv_saida = []
    gv_i = 0
    while gv_i < len(linhas) {
        gv_l = linhas[gv_i]
        addEnd(gv_saida, gv_l)
        gv_i = gv_i + 1
        if not gv_l.startswith(MARCA) { continue }
        gv_qual = gv_l[len(MARCA):].strip()
        # pula a instrução que estava aí: a cabeça e as continuações `\`
        gv_i = gv_i + 1
        while gv_i < len(linhas) and linhas[gv_i].startswith("      \\") {
            gv_i = gv_i + 1
        }
        gv_geradas = []
        if gv_qual == "tipos" {
            gv_geradas = instrucao_vim("syn keyword psType    ", gv_tipos)
        }
        elif gv_qual == "apelidos" {
            gv_geradas = ["syn match   psType     \"\\<\\%(" + "\\|".join(apelidos)
                          + "\\)\\>\\ze\\s\\+[A-Za-z_]\""]
        }
        elif gv_qual == "builtins" {
            gv_geradas = instrucao_vim("syn keyword psBuiltin ", gv_builtins)
        }
        elif gv_qual == "excecoes" {
            gv_geradas = instrucao_vim("syn keyword psException", listas[2])
        }
        else {
            post("gera_realce: marca desconhecida no syntax do Vim: " + gv_qual)
            sys.exit(1)
        }
        for each gv_g in gv_geradas {
            addEnd(gv_saida, gv_g)
        }
    }
    return gv_saida
}


# Todo token que a gramática emite (`"name": "..."`): uma lista de escopos
# por token — as palavras separadas por espaço são ALTERNATIVAS (a segunda e a
# terceira existem pra tema que não conhece a primeira). Só entram os `.poolscript`.
funct escopos_da_gramatica(linhas) {
    saida = []
    for each l in linhas {
        t = l.strip()
        if not t.startswith("\"name\": \"") {
            continue
        }
        valor = t[len("\"name\": \""):]
        valor = valor[0:valor.find("\"")]
        alternativas = []
        for each esc in valor.split(" ") {
            if esc.endswith(".poolscript") {
                addEnd(alternativas, esc)
            }
        }
        if len(alternativas) > 0 and not saida.contains(alternativas) {
            addEnd(saida, alternativas)
        }
    }
    return saida
}


# Os escopos que um tema cobre: a união de todos os `scope` de `tokenColors`.
# Regra genérica cobre por prefixo (`keyword` cobre `keyword.control.poolscript`).
funct tema_cobre(tema, esc) {
    for each regra in tema["tokenColors"] {
        escopos = regra["scope"]
        if type(escopos) == "str" {
            escopos = [escopos]
        }
        for each s in escopos {
            if s == esc or esc.startswith(s + ".") {
                return true
            }
        }
    }
    return false
}


# As linhas em que `tem` e `gera` diferem, pro portão mostrar o que mudou.
funct mostra_diferencas(tem, gera) {
    md_i = 0
    for each md_l in tem {
        if md_i < len(gera) and gera[md_i] != md_l {
            post("  linha " + str(md_i + 1) + ":")
            post("    tem:  " + md_l.strip()[0:100])
            post("    gera: " + gera[md_i].strip()[0:100])
        }
        md_i = md_i + 1
    }
}


if __name__ == "main" {
    tmp = "/tmp/ps_realce_meta.json"
    os.cmd(sys.executable + " --metadata > " + tmp)
    meta = json.parse(os.readFile(tmp))
    listas = nomes_de(meta)
    apelidos = []
    for each ap in meta["tipos_apelidos"].keys() {
        addEnd(apelidos, ap)
    }

    original = os.readFile(GRAMATICA)
    linhas = original.split("\n")
    novas = gera(linhas, listas)
    gerado = "\n".join(novas)

    vim_original = os.readFile(VIM)
    vim_linhas = vim_original.split("\n")
    vim_novas = gera_vim(vim_linhas, listas, apelidos)
    vim_gerado = "\n".join(vim_novas)

    if "--portao" in sys.argv {
        # 1) escopo da gramática sem cor em algum tema da extensão: foi assim
        #    que `funct`, `Entity`, tipo e builtin saíam todos da mesma cor.
        sem_cor = []
        for each e in os.ls("editor/vscode/themes") {
            if not e["name"].endswith(".json") {
                continue
            }
            tema = json.parse(os.readFile("editor/vscode/themes/" + e["name"]))
            for each alternativas in escopos_da_gramatica(linhas) {
                coberto = false
                for each esc in alternativas {
                    if tema_cobre(tema, esc) {
                        coberto = true
                    }
                }
                if not coberto {
                    addEnd(sem_cor, e["name"] + ": " + " | ".join(alternativas))
                }
            }
        }
        if len(sem_cor) > 0 {
            post("realce: escopo da gramatica SEM cor no tema:")
            for each s in sem_cor {
                post("  " + s)
            }
            sys.exit(1)
        }
        if gerado == original and vim_gerado == vim_original {
            post("realce: gramatica e syntax do Vim batem com o --metadata (" + str(len(listas[0])) + " tipos, "
                 + str(len(listas[1])) + " builtins, " + str(len(listas[2])) + " excecoes); "
                 + str(len(escopos_da_gramatica(linhas))) + " escopos, todos com cor nos temas")
            sys.exit(0)
        }
        if gerado != original {
            post("realce: a gramatica DIVERGE do --metadata — rode ./pool scripts/gera_realce.pr")
            mostra_diferencas(linhas, novas)
        }
        if vim_gerado != vim_original {
            post("realce: o syntax do Vim DIVERGE do --metadata — rode ./pool scripts/gera_realce.pr")
            mostra_diferencas(vim_linhas, vim_novas)
        }
        sys.exit(1)
    }

    os.writeFile(GRAMATICA, gerado)
    os.writeFile(VIM, vim_gerado)
    post("realce gerado: " + str(len(listas[0])) + " tipos, " + str(len(listas[1]))
         + " builtins, " + str(len(listas[2])) + " excecoes (gramatica do VS Code e syntax do Vim)")
}

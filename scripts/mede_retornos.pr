# Descobre o TIPO DE RETORNO de cada nativo, CHAMANDO ele.
#
#     ./pool scripts/mede_retornos.pr             # mede tudo e grava vm/retornos_medidos.inc
#     ./pool scripts/mede_retornos.pr --confere   # mede e compara com o `--metadata` do binario
#
# POR QUE ELE EXISTE. A tipagem estatica confere `str s = os.getenv("X")` antes
# de rodar, e pra isso o compilador precisa saber o que cada nativo devolve de
# VERDADE. Uma tabela escrita a mao ja disse coisa que o motor nao faz, e o
# `--metadata` deixava sem retorno a maior parte dos membros.
#
# O metodo e o do projeto: MEDIR, nao deduzir. Cada membro e chamado num
# programa de verdade e o `type()` do que voltou e anotado. Quem precisa de
# servico mede contra o servico de teste: sqlite, postgres e mariadb locais, o
# mongod de teste (porta 27099), o jinker subido aqui mesmo e os SMTP/IMAP
# falsos de `teste/`.
#
# Tres formas de retorno saem daqui:
#   - um tipo:        `os.cwd` -> "str"
#   - uniao medida:   o tipo muda com o ARGUMENTO ou com o estado, e cada
#                     amostra mostra um lado: `os.getenv` -> "str|Null"
#   - "*":            o tipo e o do CONTEUDO guardado (`d.get`, `json.parse`).
#                     A entrada traz duas amostras que TEM que dar tipos
#                     diferentes: e a prova de que varia, nao uma suposicao.
#
# Membro medido que o `--metadata` nao publica, membro publicado que ninguem
# mediu e chamada que levanta erro: o script para e NAO grava. Lacuna nao vira
# tipo inventado.
import os
import sys
import json
import qrcode

TMP = "/tmp/ps_mede_retorno"
META = TMP + "/meta.json"
SAIDA = "vm/retornos_medidos.inc"
REPO = os.cwd()
PNG = TMP + "/amostra.png"
PORTA_WEB = 28850
# absoluto: os grupos rodam com `cd` na pasta de trabalho
POOL = ""

# Membro que nao devolve: nao ha o que medir, e o motivo fica escrito.
NAO_RETORNA = {}
NAO_RETORNA["sys|exit"] = "encerra o processo"

# ── resultado ───────────────────────────────────────────────────────────────
# RES["dono|membro"] = tipos na ordem em que apareceram
RES = {}
VARIA = {}
ERROS = []


funct anota(chave, tipo) {
    global RES
    if not (chave in RES) {
        RES[chave] = []
    }
    if not (tipo in RES[chave]) {
        addEnd(RES[chave], tipo)
    }
}


# ── programa gerado ─────────────────────────────────────────────────────────
# Cada grupo vira UM programa: o preparo, e cada amostra num `try` que anota
# `R|dono|membro|tipo` (ou `E|...|erro`) num arquivo. Arquivo, e nao a saida
# padrao: membro que imprime por conta propria (`os.warn`, `sys.stdout.write`)
# emendaria o texto dele na linha anotada. E o servidor do jinker, que roda em
# outro processo, anota no mesmo arquivo.
ANOTA = '''funct mr_anota(mr_linha) {
    using open("@TMP@/r.txt", "a") as mr_arq {
        mr_arq.write(mr_linha.replace("\\n", " ") + "\\n")
    }
}
'''


funct troca(txt) {
    return txt.replace("@TMP@", TMP).replace("@PNG@", PNG).replace("@PORTA@", str(PORTA_WEB)).replace("@PORTA_WS@", str(PORTA_WEB + 1))
}


funct amostras_de(ch) {
    if len(ch) > 2 and ch[2] == "*" {
        return ch[3:]
    }
    return ch[2:]
}


funct bloco(chamadas) {
    partes = []
    for each ch in chamadas {
        if ch[0] == "!" {
            addEnd(partes, ch[1])
            continue
        }
        rot = ch[0] + "|" + ch[1] + "|"
        for each e in amostras_de(ch) {
            addEnd(partes, "try {")
            addEnd(partes, "    mr_anota(\"R|" + rot + "\" + type(" + e + "))")
            addEnd(partes, "} catch (mr_e) {")
            addEnd(partes, "    mr_anota(\"E|" + rot + "\" + str(mr_e))")
            addEnd(partes, "}")
        }
    }
    return troca("\n".join(partes))
}


# Quantas amostras cada chave tem que anotar. Programa que morre no meio (um
# `!` que levantou) deixa amostra sem linha — isso tambem e erro.
funct esperadas(chamadas, conta) {
    global VARIA
    for each ch in chamadas {
        if ch[0] == "!" {
            continue
        }
        chave = ch[0] + "|" + ch[1]
        if not (chave in conta) {
            conta[chave] = 0
        }
        conta[chave] = conta[chave] + len(amostras_de(ch))
        if len(ch) > 2 and ch[2] == "*" {
            VARIA[chave] = true
        }
    }
    return conta
}


funct colhe(nome, conta, saida) {
    global ERROS
    arq = TMP + "/r.txt"
    vistas = {}
    if os.exists(arq) {
        for each linha in os.readFile(arq).split("\n") {
            if len(linha) == 0 {
                continue
            }
            partes = linha.split("|")
            chave = partes[1] + "|" + partes[2]
            resto = "|".join(partes[3:])
            if not (chave in vistas) {
                vistas[chave] = 0
            }
            vistas[chave] = vistas[chave] + 1
            if partes[0] == "R" {
                anota(chave, resto)
            }
            else {
                addEnd(ERROS, nome + ": " + chave + " levantou: " + resto)
            }
        }
    }
    faltaram = []
    for each chave in conta.keys() {
        feitas = 0
        if chave in vistas {
            feitas = vistas[chave]
        }
        if feitas < conta[chave] {
            addEnd(faltaram, chave + " (" + str(feitas) + "/" + str(conta[chave]) + ")")
        }
    }
    if len(faltaram) > 0 {
        addEnd(ERROS, nome + ": o programa parou antes de " + ", ".join(faltaram) + ". Saida: " + saida)
    }
}


funct roda_programa(nome, fonte, env, entrada) {
    os.writeFile(TMP + "/" + nome + ".pr", fonte)
    os.cmd("cd '" + TMP + "' && " + env + " timeout 120 '" + POOL + "' '" + TMP + "/" + nome + ".pr' < " + entrada
           + " > '" + TMP + "/" + nome + ".out' 2>&1")
    saida = ""
    if os.exists(TMP + "/" + nome + ".out") {
        saida = os.readFile(TMP + "/" + nome + ".out").strip()
    }
    if len(saida) > 400 {
        saida = saida[len(saida) - 400:]
    }
    return saida
}


funct roda_grupo(g) {
    os.cmd("rm -f '" + TMP + "/r.txt'")
    fonte = troca(ANOTA) + troca(g["prep"]) + "\n" + bloco(g["chamadas"]) + "\n"
    env = ""
    if "env" in g {
        env = troca(g["env"])
    }
    entrada = "/dev/null"
    if "stdin" in g {
        os.writeFile(TMP + "/entrada.txt", g["stdin"])
        entrada = "'" + TMP + "/entrada.txt'"
    }
    saida = roda_programa("g", fonte, env, entrada)
    colhe(g["nome"], esperadas(g["chamadas"], {}), saida)
}


# ── metodos de tipo, medidos por tentativa ─────────────────────────────────
# DUAS amostras por tipo, com CONTEUDO de tipo diferente. Se as duas medicoes
# derem tipos diferentes, o retorno depende do conteudo e a chave vira "*".
AMOSTRAS = {
    "str": {
        "recv": "\"aBc dEf\"",
        "recv2": "\"1 2 3\"",
        "args": ["", "\"b\"", "\"b\", \"x\"", "1", "\"b\", 1", "1, \"x\""]
    },
    "list": {
        "recv": "[3, 1, 2]",
        "recv2": "[\"c\", \"a\", \"b\"]",
        "args": ["", "1", "1, 0", "[9]", "0, 9"]
    },
    "dict": {
        "recv": "{\"a\": 1, \"b\": 2}",
        "recv2": "{\"a\": \"x\", \"b\": \"y\"}",
        "args": ["", "\"a\"", "\"a\", 0", "{\"c\": 3}"]
    },
    "tup": {
        "recv": "(3, 1, 2)",
        "recv2": "(\"c\", \"a\", \"b\")",
        "args": ["", "1", "1, 0"]
    },
    "byte": {
        "recv": "\"aBc\".encode()",
        "recv2": "\"123\".encode()",
        "args": ["", "1", "\"b\".encode()", "5", "5, \"x\".encode()"]
    }
}


# Roda um programa curto e devolve o nome de tipo que ele imprimiu ("" se
# levantou ou se a saida nao parece nome de tipo).
funct roda_curto(fonte) {
    os.writeFile(TMP + "/m.pr", fonte)
    os.cmd("rm -f " + TMP + "/m.out")
    os.cmd("'" + POOL + "' " + TMP + "/m.pr > " + TMP + "/m.out 2>&1")
    if not os.exists(TMP + "/m.out") {
        return ""
    }
    saida = os.readFile(TMP + "/m.out").strip()
    if "Error" in saida or "Traceback" in saida {
        return ""
    }
    if len(saida) == 0 or len(saida) > 20 {
        return ""
    }
    for each c in saida {
        eh_letra = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
        if not eh_letra {
            return ""
        }
    }
    return saida
}


funct mede_tipo(tipo, meta, feitos) {
    global VARIA
    global ERROS
    a = AMOSTRAS[tipo]
    nao = []
    for each membro in meta["tipos"][tipo] {
        nome = membro["nome"]
        chave = tipo + "|" + nome
        if chave in feitos {
            continue
        }
        resultado = ""
        conf = ""
        for each arg in a["args"] {
            resultado = roda_curto("x = " + a["recv"] + "\npost(type(x." + nome + "(" + arg + ")))\n")
            if resultado != "" {
                conf = roda_curto("x = " + a["recv2"] + "\npost(type(x." + nome + "(" + arg + ")))\n")
                break
            }
        }
        if resultado == "" {
            addEnd(nao, nome)
            continue
        }
        if conf != "" and conf != resultado {
            VARIA[chave] = true
            anota(chave, resultado)
            anota(chave, conf)
        }
        else {
            anota(chave, resultado)
        }
    }
    if len(nao) > 0 {
        addEnd(ERROS, tipo + ": nenhuma tentativa chamou " + ", ".join(nao) + " — de a chamada em GRUPOS")
    }
}


# ── os grupos escritos a mao ────────────────────────────────────────────────
# `["dono", "membro", amostra, ...]` mede; `["dono", "membro", "*", a, b]` exige
# que `a` e `b` deem tipos diferentes; `["!", codigo]` so executa, na ordem.
GRUPOS = []


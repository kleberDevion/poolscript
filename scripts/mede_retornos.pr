# ── jinker de pe: request, Response, RequestProxy, upload, canal, websocket ─
SRV_BLOCOS = {
    "@REQ@": [
        ["RequestProxy", "get_json", "*", 'jinker.request.get_json()'],
        ["RequestProxy", "json", "*", 'jinker.request.json()'],
        ["RequestProxy", "get", "*", 'jinker.request.get("q")', 'jinker.request.get("x")'],
        ["RequestProxy", "text", 'jinker.request.text()'],
        ["RequestProxy", "path_param", 'jinker.request.path_param("nome")', 'jinker.request.path_param("mr_nao")'],
        ["RequestProxy", "header", 'jinker.request.header("X-A")', 'jinker.request.header("X-Mr-Nao")'],
        ["RequestProxy", "cookie", 'jinker.request.cookie("c")', 'jinker.request.cookie("mr_nao")'],
        ["RequestProxy", "headers", 'jinker.request.headers'],
        ["RequestProxy", "method", 'jinker.request.method'],
        ["RequestProxy", "path", 'jinker.request.path']
    ],
    "@REQ2@": [
        ["RequestProxy", "get_json", "*", 'jinker.request.get_json()'],
        ["RequestProxy", "json", "*", 'jinker.request.json()']
    ],
    "@UP@": [
        ["RequestProxy", "file", 'jinker.request.file("arq")', 'jinker.request.file("mr_nao")'],
        ["RequestProxy", "files", 'jinker.request.files("arq")', 'jinker.request.files("mr_nao")'],
        ["PoolFileUpload", "bytes", 'mr_f.bytes()'],
        ["PoolFileUpload", "content_type", 'mr_f.content_type'],
        ["PoolFileUpload", "ext", 'mr_f.ext'],
        ["PoolFileUpload", "name", 'mr_f.name'],
        ["PoolFileUpload", "size", 'mr_f.size'],
        ["PoolFileUpload", "save", 'mr_f.save("@TMP@/up1.txt")'],
        ["PoolFileUpload", "move", 'mr_f.move("@TMP@/up2.txt")']
    ],
    "@CANAL@": [
        ["ChannelManager", "emit", 'app.channel.emit("aviso", {"n": 1})'],
        ["ChannelManager", "status", 'app.channel.status']
    ],
    "@SALA@": [
        ["SocketEmitter", "emit", 'mr_envia.emit(jinker.request.text(), exclude_self=false)'],
        ["SocketEmitter", "status_send", 'mr_envia.status_send()'],
        ["SocketNamespace", "emit", 'app.socket.emit("y", exclude_self=false)'],
        ["SocketNamespace", "status_send", 'app.socket.status_send()']
    ]
}

SRV = '''import jinker
import os

app = jinker.Jinker(name="mede")

@app.route("/pronto")
funct mr_pronto() {
    return "ok"
}

@app.route("/txt", methods=["GET", "POST", "PUT", "PATCH", "DELETE"])
funct mr_txt() {
    return "alo"
}

@app.route("/json")
funct mr_json() {
    return {"a": 1, "b": "x"}
}

@app.route("/lista")
funct mr_lista() {
    return [1, 2]
}

@app.route("/baixar")
funct mr_baixar() {
    mr_r = jinker.JinkerResponse()
    return mr_r.header("Content-Disposition", "attachment; filename=r.csv").send("a,b")
}

@app.route("/req/<nome>", methods=["POST"])
funct mr_req() {
@REQ@
    return "ok"
}

@app.route("/req2", methods=["POST"])
funct mr_req2() {
@REQ2@
    return "ok"
}

@app.route("/up", methods=["POST"])
funct mr_up() {
    mr_f = jinker.request.file("arq")
@UP@
    return "ok"
}

@app.route("/canal")
funct mr_canal() {
@CANAL@
    return "ok"
}

@app.socket("/sala", channel=true)
funct mr_sala() {
    mr_envia = app.socket()
@SALA@
}

if __name__ == "main" {
    app(debug=false, host="127.0.0.1", port=@PORTA@)
}
'''

CLIENTE_PREP = '''import request
import os
U = "http://127.0.0.1:@PORTA@"
W = "ws://127.0.0.1:@PORTA_WS@"
mr_pronto = false
mr_i = 0
while mr_i < 100 and not mr_pronto {
    try {
        request.get(U + "/pronto")
        mr_pronto = true
    } catch (mr_e) {
        sleep(0.1)
    }
    mr_i = mr_i + 1
}
os.writeFile("@TMP@/envio.txt", "conteudo")
'''

CLIENTE = [
    ["request", "get", 'request.get(U + "/txt")'],
    ["request", "post", 'request.post(U + "/txt")'],
    ["request", "put", 'request.put(U + "/txt")'],
    ["request", "patch", 'request.patch(U + "/txt")'],
    ["request", "delete", 'request.delete(U + "/txt")'],
    ["request", "head", 'request.head(U + "/txt")'],
    ["request", "post", 'request.post(U + "/req/ana?q=1", body={"x": 1}, headers={"X-A": "v", "Cookie": "c=1"})'],
    ["request", "post", 'request.post(U + "/req2", body=[1, 2])'],
    ["request", "post", 'request.post(U + "/up", file={"arq": "@TMP@/envio.txt"})'],
    ["request", "get", 'request.get(U + "/canal")'],
    ["!", 'mr_r = request.get(U + "/json")'],
    ["Response", "decode", 'mr_r.decode("utf-8")'],
    ["Response", "content_type", 'mr_r.content_type("application/json")'],
    ["Response", "get", "*", 'mr_r.get("a")', 'mr_r.get("b")'],
    ["Response", "get_json", "*", 'mr_r.get_json()', 'request.get(U + "/lista").get_json()'],
    ["Response", "json", "*", 'mr_r.json()', 'request.get(U + "/lista").json()'],
    ["Response", "save", 'mr_r.save("@TMP@/resp.bin")'],
    ["Response", "content", 'mr_r.content'],
    ["Response", "filename", 'mr_r.filename', 'request.get(U + "/baixar").filename'],
    ["Response", "headers", 'mr_r.headers'],
    ["Response", "status", 'mr_r.status'],
    ["Response", "url", 'mr_r.url'],
    ["Response", "ok", 'mr_r.ok'],
    ["Response", "size", 'mr_r.size'],
    ["Response", "status_code", 'mr_r.status_code'],
    ["Response", "text", 'mr_r.text'],
    ["request", "ws_connect", 'request.ws_connect(W + "/sala")'],
    ["!", 'mr_ws = request.ws_connect(W + "/sala")'],
    ["WsConnection", "on_message", 'mr_ws.on_message(funct(m) { pass })'],
    ["WsConnection", "send", 'mr_ws.send("oi")'],
    ["!", 'sleep(1)'],
    ["WsConnection", "close", 'mr_ws.close()']
]


funct mede_jinker() {
    os.cmd("rm -f '" + TMP + "/r.txt'")
    fonte = SRV
    conta = {}
    for each marca in SRV_BLOCOS.keys() {
        fonte = fonte.replace(marca, bloco(SRV_BLOCOS[marca]))
        conta = esperadas(SRV_BLOCOS[marca], conta)
    }
    os.writeFile(TMP + "/srv.pr", troca(ANOTA) + troca(fonte))
    os.cmd("cd '" + TMP + "' && setsid timeout 120 '" + POOL + "' '" + TMP + "/srv.pr' > '" + TMP + "/srv.out' 2>&1 &")
    saida = roda_programa("cliente", troca(ANOTA) + troca(CLIENTE_PREP) + "\n" + bloco(CLIENTE) + "\n", "", "/dev/null")
    os.cmd("pkill -f '" + TMP + "/srv.pr'")
    conta = esperadas(CLIENTE, conta)
    srv_saida = ""
    if os.exists(TMP + "/srv.out") {
        srv_saida = os.readFile(TMP + "/srv.out").strip()
    }
    colhe("jinker", conta, saida + " | servidor: " + srv_saida)
}


# ── SMTP e IMAP falsos (os de teste/e2e/mail_local.pr) ──────────────────────
CERT = TMP + "/cert.pem"
CHAVE = TMP + "/key.pem"
CAIXA = TMP + "/caixa.txt"


funct sobe_mail(script) {
    os.cmd("rm -f '" + CAIXA + "'")
    os.cmd("setsid python3 '" + REPO + "/" + script + "' 0 '" + CERT + "' '" + CHAVE + "' '" + CAIXA
           + "' > '" + TMP + "/mail_srv.log' 2>&1 &")
    i = 0
    while i < 100 {
        if os.exists(CAIXA) {
            prim = os.readFile(CAIXA).split("\n")[0].split()
            if len(prim) > 1 {
                return int(prim[1])
            }
        }
        sleep(0.1)
        i = i + 1
    }
    return 0
}


funct mede_mail() {
    global ERROS
    os.cmd("openssl req -x509 -newkey rsa:2048 -keyout '" + CHAVE + "' -out '" + CERT
           + "' -days 2 -nodes -subj '/CN=localhost' > /dev/null 2>&1")
    porta = sobe_mail("teste/smtp_falso.py")
    if porta == 0 {
        addEnd(ERROS, "mail: o SMTP falso nao subiu")
        return 0
    }
    roda_grupo({
        "nome": "MailServer (SMTP falso)",
        "env": "PS_MAIL_TLS_INSEGURO=1",
        "prep": "import mail\nmr_s = mail.MailServer()\n",
        "chamadas": [
            ["MailServer", "conn", 'mr_s.conn("127.0.0.1", ' + str(porta) + ')'],
            ["MailServer", "login", 'mr_s.login("teste@local", "segredo123")'],
            ["!", 'mr_m = mail.MailMessage()'],
            ["!", 'mr_m.fromAddress("teste@local")'],
            ["!", 'mr_m.toAddress("destino@local")'],
            ["!", 'mr_m.subject("s")'],
            ["!", 'mr_m.body("b")'],
            ["MailServer", "send", 'mr_s.send(mr_m)'],
            ["MailServer", "quit", 'mr_s.quit()']
        ]
    })
    os.cmd("pkill -f '" + CAIXA + "'")
    porta = sobe_mail("teste/imap_falso.py")
    if porta == 0 {
        addEnd(ERROS, "mail: o IMAP falso nao subiu")
        return 0
    }
    roda_grupo({
        "nome": "MailReader (IMAP falso)",
        "env": "PS_MAIL_TLS_INSEGURO=1",
        "prep": "import mail\nmr_r = mail.MailReader()\n",
        "chamadas": [
            ["MailReader", "conn", 'mr_r.conn("127.0.0.1", ' + str(porta) + ')'],
            ["MailReader", "login", 'mr_r.login("teste@local", "segredo123")'],
            ["MailReader", "select", 'mr_r.select("INBOX")'],
            ["MailReader", "search", 'mr_r.search("ALL")'],
            ["MailReader", "body", 'mr_r.body("2")'],
            ["MailReader", "close", 'mr_r.close()']
        ]
    })
    os.cmd("pkill -f '" + CAIXA + "'")
    return 0
}


# ── valores de modulo (`sockets.AF_INET`, `sys.argv`...) ───────────────────
funct mede_valores(meta, feitos) {
    imports = []
    chamadas = []
    for each mod in meta["modulos"].keys() {
        if not ("." in mod) and mod != "Parsing" {
            addEnd(imports, "import " + mod)
        }
        for each mb in meta["modulos"][mod] {
            if mb["kind"] != "value" {
                continue
            }
            if (mod + "|" + mb["nome"]) in feitos {
                continue
            }
            addEnd(chamadas, [mod, mb["nome"], mod + "." + mb["nome"]])
        }
    }
    roda_grupo({"nome": "valores de modulo", "prep": "\n".join(imports) + "\n", "chamadas": chamadas})
}


if __name__ == "main" {
    confere = "--confere" in sys.argv
    os.mkdir(TMP, exist_ok=true)
    os.mkdir(TMP + "/bin", exist_ok=true)
    POOL = os.run(["readlink", "-f", sys.executable], capture=true).strip()
    os.cmd("'" + POOL + "' --metadata > " + META)
    meta = json.parse(os.readFile(META))
    # `os.code` abre o editor do sistema: aqui ele acha um `code` de mentira
    # no PATH do grupo, e a medicao nao abre janela nenhuma.
    os.writeFile(TMP + "/bin/code", "#!/bin/sh\nexit 0\n")
    os.run(["chmod", "+x", TMP + "/bin/code"], capture=true)
    qrcode.make("x").save(PNG)

    feitos = {}
    for each g in GRUPOS {
        esperadas(g["chamadas"], feitos)
    }
    for each marca in SRV_BLOCOS.keys() {
        esperadas(SRV_BLOCOS[marca], feitos)
    }
    esperadas(CLIENTE, feitos)
    # os grupos de mail montam as chamadas na hora (a porta so existe depois)
    for each m in ["conn", "login", "send", "quit"] {
        feitos["MailServer|" + m] = 1
    }
    for each m in ["conn", "login", "select", "search", "body", "close"] {
        feitos["MailReader|" + m] = 1
    }

    for each t in AMOSTRAS.keys() {
        mede_tipo(t, meta, feitos)
    }
    mede_valores(meta, feitos)
    for each g in GRUPOS {
        post("medindo:", g["nome"])
        roda_grupo(g)
    }
    post("medindo: jinker de pe")
    mede_jinker()
    post("medindo: mail")
    mede_mail()

    # ── cobertura: publicado x medido ───────────────────────────────────────
    publicados = {}
    for each mod in meta["modulos"].keys() {
        for each mb in meta["modulos"][mod] {
            publicados[mod + "|" + mb["nome"]] = mb.get("retorna")
        }
    }
    for each t in meta["tipos"].keys() {
        for each mb in meta["tipos"][t] {
            publicados[t + "|" + mb["nome"]] = mb.get("retorna")
        }
    }
    for each b in meta["builtins"] {
        publicados["builtins|" + b["nome"]] = b.get("retorna")
    }
    for each chave in publicados.keys() {
        if not (chave in RES) and not (chave in NAO_RETORNA) {
            addEnd(ERROS, chave + ": publicado no --metadata e nao medido")
        }
    }
    finais = {}
    for each chave in RES.keys() {
        if not (chave in publicados) {
            addEnd(ERROS, chave + ": medido, mas o --metadata nao publica esse membro")
            continue
        }
        if chave in VARIA {
            if len(RES[chave]) < 2 {
                addEnd(ERROS, chave + ": marcado como variavel, mas as amostras deram so " + RES[chave][0])
                continue
            }
            finais[chave] = "*"
        }
        else {
            finais[chave] = "|".join(RES[chave])
        }
    }

    diferentes = []
    for each chave in sorted(finais.keys()) {
        declarado = publicados.get(chave)
        if declarado != finais[chave] {
            addEnd(diferentes, chave.replace("|", ".").ljust(40) + " publicado: " + str(declarado) + "  medido: " + finais[chave])
        }
    }

    if len(ERROS) > 0 {
        post("")
        post("NAO GRAVADO —", len(ERROS), "problema(s):")
        for each e in ERROS {
            post("  ", e)
        }
        sys.exit(1)
    }

    post("")
    post("medidos:", len(finais.keys()), "| publicado diferente do medido:", len(diferentes))
    for each d in diferentes {
        post("  ", d)
    }
    if confere {
        sys.exit(1 if len(diferentes) > 0 else 0)
    }

    # Ordem de bytes de "dono membro": e a do `strcmp` em par (dono, membro),
    # que o `bsearch` de vm/ps_retornos.c usa. O espaco vem antes de qualquer
    # caractere de nome, entao `sys` fica antes de `sys.stdout`.
    ordem = {}
    for each chave in finais.keys() {
        ordem[chave.replace("|", " ")] = chave
    }
    linhas = ["/* GERADO por scripts/mede_retornos.pr — NAO edite a mao.",
              " *",
              " * Tipo de retorno de cada nativo, MEDIDO: o script chama o membro num programa",
              " * de verdade (com os servicos de teste de pe) e anota o `type()` do que voltou.",
              " *   \"a|b\"  o tipo muda com o argumento ou com o estado; cada lado foi medido",
              " *   \"*\"    e o tipo do conteudo guardado; duas amostras provaram que varia",
              " * Ordenado por (dono, membro) em ordem de bytes: vm/ps_retornos.c faz bsearch.",
              " *",
              " *     ./pool scripts/mede_retornos.pr",
              " */"]
    for each k in sorted(ordem.keys()) {
        chave = ordem[k]
        partes = chave.split("|")
        addEnd(linhas, "    { \"" + partes[0] + "\", \"" + partes[1] + "\", \"" + finais[chave] + "\" },")
    }
    os.writeFile(SAIDA, "\n".join(linhas) + "\n")
    post("gravado em", SAIDA)
}

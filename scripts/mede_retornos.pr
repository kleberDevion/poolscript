# Banco relacional: as MESMAS chamadas em cada driver, e o resultado de cada
# chave e a uniao do que os tres devolveram.
funct chamadas_db(url) {
    return [
        ["psodbc", "connect", 'psodbc.connect(url="' + url + '")'],
        ["!", 'mr_c = psodbc.connect(url="' + url + '")'],
        ["DbConnection", "cursor", 'mr_c.cursor()'],
        ["!", 'mr_cur = mr_c.cursor()'],
        ["DbCursor", "execute", 'mr_cur.execute("DROP TABLE IF EXISTS mr_t")'],
        ["!", 'mr_cur.execute("CREATE TABLE mr_t (i INTEGER)")'],
        ["!", 'mr_cur.execute("INSERT INTO mr_t VALUES (1)")'],
        ["DbConnection", "commit", 'mr_c.commit()'],
        ["DbCursor", "rowcount", 'mr_cur.rowcount'],
        ["!", 'mr_cur.execute("SELECT i FROM mr_t")'],
        ["DbCursor", "fetchall", 'mr_cur.fetchall()'],
        ["!", 'mr_cur.execute("SELECT i FROM mr_t")'],
        ["DbCursor", "fetchone", 'mr_cur.fetchone()'],
        ["!", 'mr_cur.execute("SELECT i FROM mr_t WHERE i = 99")'],
        ["DbCursor", "fetchone", 'mr_cur.fetchone()'],
        ["!", 'mr_cur.execute("SELECT i FROM mr_t")'],
        ["DbCursor", "fetchmany", 'mr_cur.fetchmany(1)'],
        ["!", 'mr_cur.execute("DROP TABLE mr_t")'],
        ["!", 'mr_c.commit()'],
        ["DbCursor", "close", 'mr_cur.close()'],
        ["DbConnection", "close", 'mr_c.close()']
    ]
}


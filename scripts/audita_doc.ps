# Auditoria doc ↔ motor: o título de cada página tem que bater com a
# assinatura REAL que o motor expõe.
#
# A regra do projeto (notas/CLAUDE.md) é que assinatura de doc nunca é digitada
# de memória. Este script existia, dependia de um `audita_doc_sigs.py` e de um
# `.audita_sigs.json` que não existem mais desde o porte pra C, e sumiu do
# repositório junto — a auditoria deixou de existir sem ninguém notar. Agora a
# fonte é `pool --metadata`, lida das tabelas do próprio VM.
#
#     ./pool scripts/audita_doc.ps           # relata
#     ./pool scripts/audita_doc.ps --tudo    # lista também as páginas OK
#
# O QUE ELE NÃO CONFERE, e isso é dito de propósito: `--metadata` devolve os
# NOMES dos parâmetros, mas nenhum default — 309 parâmetros, zero defaults. O
# motor não sabe os defaults das nativas, que estão escritos no corpo em C de
# cada uma. Então `flags=0` na doc não é verificável hoje; só a existência e a
# ordem de `flags`. Limitação declarada em vez de disfarçada — dizer "263/263
# OK" conferindo metade seria pior que não conferir.
import os
import sys
import json
import regex

DOCS = "docs"


# Todas as páginas .md, recursivamente.
action junta_md(alvo, acc) {
    if os.isdir(alvo) {
        for each e in os.ls(alvo) {
            junta_md(alvo + "/" + e["name"], acc)
        }
    }
    elif alvo.endswith(".md") {
        acc.append(alvo)
    }
    return acc
}


# "# `regex.sub(pattern, repl, string, count=0)`" -> ["regex.sub", [nomes...]]
# Devolve [] quando a primeira linha não é um título de assinatura.
action le_titulo(caminho) {
    linha = ""
    for each l in open(caminho).read().split("\n") {
        if l.strip() != "" {
            linha = l.strip()
            break
        }
    }
    m = regex.findall("^# `([A-Za-z_][A-Za-z0-9_.]*)\\(([^`]*)\\)`$", linha)
    if len(m) == 0 {
        return []
    }
    nome = m[0][0]
    dentro = m[0][1].strip()
    params = []
    if dentro != "" {
        for each p in dentro.split(",") {
            p = p.strip()
            if p == "" {
                continue
            }
            # o default fica de fora: o motor não sabe qual é (ver cabeçalho)
            params.append(p.split("=")[0].strip())
        }
    }
    return [nome, params]
}


# ── tipo de erro citado na doc TEM que existir no motor ─────────────────────
#
# POR QUE: `docs/PoolScript.md` listava `PermissionError` e `ConnectionError`
# numa tabela de "tipos disponiveis". O motor NUNCA levanta nenhum dos dois —
# zero ponto no `vm/`. Quem seguisse a doc escrevia `catch (PermissionError e)`,
# o handler jamais disparava, o erro escapava e o programa morria com rc=1.
#
# A tabela derivou porque `PoolScript.md` e `LANGUAGE.md` nao estavam no escopo
# de nenhum auditor: o `audita_doc` conferia assinatura de metodo, nao taxonomia
# de erro. Deriva sem detector e so questao de tempo.
#
# A regra e simples: todo `NomeError` citado em qualquer .md precisa aparecer
# como string no motor. Nome levantado pelo USUARIO (`raise MinhaCoisa("x")`) e
# exceção legitima e sai da conta — por isso o filtro pega so o que o motor
# poderia emitir.
action tipos_do_motor() {
    vistos = {}
    for each nome in os.ls("vm") {
        n = nome["name"]
        if not n.endswith(".c") {
            continue
        }
        fonte = open("vm/" + n).read()
        # SO onde a string de fato vira TIPO DE ERRO.
        #
        # O padrao antigo era a string entre aspas em QUALQUER lugar do .c, e
        # isso deixava passar fantasma. Foi assim que `NotImplementedError`
        # passou a "existir": ele aparece tambem no JSON do `pool --check` e num
        # PyErr_Format do embed Python — nenhum dos dois e excecao de runtime.
        #
        # Enumerar os macros nao serve (sao muitos: ERRO_T, ERRO_TF, BERRO,
        # MERRO, REDE, BY_ERRO_TIPO, CMP_RECUSA...). O que todos tem em comum e
        # a LINHA: ela cita `ERRO`, `REDE` ou `erro_tipo`. Duas linhas de
        # tolerancia porque a chamada as vezes quebra.
        linhas = fonte.split("\n")
        i = 0
        while i < len(linhas) {
            achou = regex.findall("\"([A-Z][A-Za-z]*(?:Error|Exception|Warning|Unexpected|UnexpectedValues|Implemented))\"", linhas[i])
            if len(achou) > 0 {
                janela = linhas[i]
                if i > 0 { janela = linhas[i - 1] + "\n" + janela }
                if i > 1 { janela = linhas[i - 2] + "\n" + janela }
                if "ERRO" in janela or "REDE" in janela or "erro_tipo" in janela {
                    for each m in achou {
                        vistos[m] = 1
                    }
                }
            }
            i = i + 1
        }
        # E os que o motor escreve DIRETO no stderr, sem passar pelo campo de
        # tipo — o `IndexOutOfBoundsWarning` e o caso, e e justamente o que a
        # doc precisa citar pra avisar que ele NAO e capturavel.
        for each m in regex.findall("\"([A-Z][A-Za-z]*(?:Error|Warning)): ", fonte) {
            vistos[m] = 1
        }
    }
    return vistos
}


action confere_tipos_de_erro(paginas) {
    motor = tipos_do_motor()
    # Levantados pelo usuario nos exemplos da doc: sao ilustracao de `raise`,
    # nao promessa de que o motor emite.
    do_usuario = ["MeuErro", "MinhaExcecao", "ErroDeNegocio", "SaldoInsuficiente",
                  "MetadataIlegivel", "ValidationError", "AppError"]
    fantasmas = []
    for each pag in paginas {
        texto = open(pag).read()
        # Linha de CITACAO (`> ` do markdown) fala SOBRE o tipo, nao promete
        # que ele existe — e onde se registra "esta tabela ja teve X, que o
        # motor nunca levanta". Sem esta exclusao, documentar o defeito vira o
        # defeito.
        limpo = []
        for each l in texto.split("\n") {
            if not l.strip().startswith(">") {
                addEnd(limpo, l)
            }
        }
        texto = ("\n").join(limpo)
        # `Error` nao basta: `OutputUnexpectedValues` e um tipo real e nao
        # termina assim. O padrao pega o formato de nome de tipo de erro.
        for each m in regex.findall("`([A-Z][A-Za-z]*(?:Error|Exception|Warning|Unexpected|UnexpectedValues))`", texto) {
            if m in motor or do_usuario.contains(m) {
                continue
            }
            achou = false
            for each f in fantasmas {
                if f[0] == m and f[1] == pag {
                    achou = true
                }
            }
            if not achou {
                addEnd(fantasmas, [m, pag])
            }
        }
    }
    return fantasmas
}


# O SENTIDO CONTRARIO, que faltava.
#
# A checagem de cima pergunta "todo tipo citado na doc existe no motor?". Ela
# nunca perguntou o inverso — e por isso `NameError`, `AttributeError` e
# `OverflowError` nasceram capturaveis, publicos, e sem aparecer em UM .md
# sequer. O usuario nao tinha como descobrir que existiam.
#
# A pagina de referencia e `docs/exceptions/exceptions.md`: e a tabela que a
# doc inteira aponta. Tipo que o motor levanta e nao esta la, reprova.
CATALOGO = "docs/exceptions/exceptions.md"

action confere_motor_na_doc() {
    motor = tipos_do_motor()
    texto = open(CATALOGO).read()
    faltando = []
    for each t in sorted(motor.keys()) {
        if not ("`" + t + "`") in texto {
            addEnd(faltando, t)
        }
    }
    return faltando
}


if __name__ == "main" {
    tudo = false
    for each a in sys.argv {
        if a == "--tudo" {
            tudo = true
        }
    }

    # `os.cmd` devolve o código de saída, não a saída — daí o arquivo no meio.
    tmp = "/tmp/ps_meta.json"
    os.cmd("'" + sys.executable + "' --metadata > " + tmp)
    meta = json.parse(open(tmp).read())

    # índice: "modulo.funcao" -> lista de nomes de parâmetro
    real = {}
    for each mod in meta["modulos"].keys() {
        for each f in meta["modulos"][mod] {
            nomes = []
            for each p in f["params"] {
                nomes.append(p["nome"])
            }
            real[mod + "." + f["nome"]] = nomes
        }
    }

    # ── taxonomia de erro: antes de qualquer coisa, porque um `catch` que nao
    # dispara e pior que doc faltando — ele MATA o programa de quem seguiu.
    fantasmas = confere_tipos_de_erro(junta_md(DOCS, []))
    if len(fantasmas) > 0 {
        post("")
        post("TIPO DE ERRO citado na doc que o motor NUNCA levanta:", str(len(fantasmas)))
        for each f in fantasmas {
            post("   " + f[0].ljust(24) + f[1])
        }
        post("")
        post("Quem escrever `catch (" + fantasmas[0][0] + " e)` seguindo a doc tem um")
        post("handler que jamais dispara: o erro escapa e o programa morre com rc=1.")
        sys.exit(1)
    }
    post("tipos de erro citados na doc: todos existem no motor")

    faltando = confere_motor_na_doc()
    if len(faltando) > 0 {
        post("")
        post("TIPO DE ERRO que o motor levanta e a doc NAO lista:", str(len(faltando)))
        for each t in faltando {
            post("   " + t)
        }
        post("")
        post("Estao em " + CATALOGO + " — sao capturaveis, o usuario precisa saber")
        post("que existem. Tipo publico fora do catalogo e feature invisivel.")
        sys.exit(1)
    }
    post("tipos de erro do motor: todos aparecem em " + CATALOGO)

    paginas = 0
    sem_titulo = []
    fora_do_motor = []
    divergentes = []
    motor_mudo = []
    okey = 0

    for each caminho in junta_md(DOCS, []) {
        t = le_titulo(caminho)
        if len(t) == 0 {
            sem_titulo.append(caminho)
            continue
        }
        paginas = paginas + 1
        nome = t[0]
        docp = t[1]

        # O CAMINHO diz o namespace. `docs/jinker/request/get/get.md` documenta
        # `jinker.request.get`, não o módulo `request` de HTTP — sem esta
        # checagem os dois colidem no índice e a página aparece como
        # divergente sem ser. Só compara quando a primeira pasta sob `docs/`
        # é o próprio módulo do título.
        raiz_doc = caminho.split("/")[1]
        if nome.split(".")[0] != raiz_doc {
            fora_do_motor.append(caminho + "  (" + nome + ", sob docs/" + raiz_doc + ")")
            continue
        }
        if not nome in real {
            # Método de objeto e página de conceito não estão em `modulos`;
            # não é divergência, é fora do alcance desta conferência.
            fora_do_motor.append(caminho + "  (" + nome + ")")
            continue
        }
        motorp = real[nome]
        # O motor declarar ZERO parâmetro pra uma função que evidentemente
        # recebe algum não é erro da doc — é lacuna do `--metadata`, que lê
        # essas listas de tabelas escritas à mão ao lado de cada nativa. Culpar
        # a doc aqui faria "corrigir" páginas certas pra bater com uma fonte
        # incompleta. Vai pra uma pilha separada, e o LSP sofre do mesmo mal:
        # ele oferece completion a partir desta mesma tabela.
        if len(motorp) == 0 and len(docp) > 0 {
            motor_mudo.append([caminho, nome, docp])
            continue
        }
        if docp == motorp {
            okey = okey + 1
            if tudo {
                post("  ok    ", nome)
            }
        }
        else {
            divergentes.append([caminho, nome, docp, motorp])
        }
    }

    post("")
    post("páginas com título de assinatura:", paginas)
    post("  conferidas contra o motor:", okey + len(divergentes))
    post("  batem:", okey)
    post("  fora do alcance (método de objeto / conceito):", len(fora_do_motor))
    post("arquivos .md sem título de assinatura:", len(sem_titulo))
    post("  motor nao declara os parametros (lacuna do --metadata):", len(motor_mudo))
    post("")
    post("NAO CONFERIDO: valores default. `pool --metadata` nao os expoe (309")
    post("parametros, zero defaults) porque cada nativa resolve o dela no corpo")
    post("em C. `flags=0` na doc continua sem verificacao — so a existencia e a")
    post("ordem de `flags`.")

    if len(motor_mudo) > 0 {
        post("")
        post("MOTOR SEM PARAMETROS DECLARADOS (a doc esta certa; o --metadata e")
        post("que nao sabe, e o LSP tambem nao):")
        for each d in motor_mudo {
            post("   ", d[1] + "(" + (", ").join(d[2]) + ")", " ->  motor diz", d[1] + "()")
        }
    }
    if len(divergentes) == 0 {
        post("")
        post("nenhuma divergencia de nome/ordem entre doc e motor.")
        # `exit` exige int: bool não converte sozinho (e o motor está certo em
        # não adivinhar). Lacuna do motor também reprova — é achado, não aviso.
        if len(motor_mudo) > 0 {
            sys.exit(1)
        }
        sys.exit(0)
    }
    post("")
    post("DIVERGENTES:", len(divergentes))
    for each d in divergentes {
        post("  ", d[0])
        post("      doc  :", d[1] + "(" + (", ").join(d[2]) + ")")
        post("      motor:", d[1] + "(" + (", ").join(d[3]) + ")")
    }
    sys.exit(1)
}

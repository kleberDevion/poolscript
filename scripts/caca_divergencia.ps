// Caçador de DIVERGÊNCIA entre os dois motores — escrito em PoolScript.
//
// Roda cada .ps de uma pasta no interpretador E no binário `pool`, compara
// saída + código de saída + mensagem de erro, e CLASSIFICA a diferença. O
// interpretador é a autoridade.
//
//   ./pool scripts/caca_divergencia.ps <pasta_com_casos> [relatorio.txt]
//
// Classes relatadas:
//   ACEITA   um motor roda, o outro erra
//   SAIDA    os dois rodam, saída diferente
//   TIPO     os dois erram, TIPO de erro diferente
//   MSG      mesmo tipo, mensagem diferente
//   PYTHON   mensagem vazando do Python (inglês/traceback) em algum motor
import os
import sys

// sys.argv NÃO inclui o nome do script (igual nos 2 motores): [0] é o 1º arg
RAIZ = os.cwd()
PASTA = sys.argv[0] if len(sys.argv) > 0 else RAIZ + "/casos"
SAIDA = sys.argv[1] if len(sys.argv) > 1 else RAIZ + "/divergencias.txt"
INTERP = "PYTHONPATH=" + RAIZ + "/src NO_COLOR=1 python3 -m poolscript"
VM = RAIZ + "/pool"

// marcas de mensagem que vazou do Python (não é texto da linguagem)
VAZA = ["unsupported operand", "Traceback (most recent", "object has no attribute",
        "not subscriptable", "takes no arguments", "argument of type",
        "can only concatenate", "unhashable type", "NoneType", "positional argument"]

CLASSES = { "ACEITA": [], "SAIDA": [], "TIPO": [], "MSG": [], "PYTHON": [] }
EST = { "casos": 0, "iguais": 0 }

// roda: devolve [rc, stdout, stderr] — os fluxos ficam SEPARADOS de propósito.
// Juntar com 2>&1 parecia mais simples e mentia: stdout é bufferizado e stderr
// não, então um caso que imprime E DEPOIS erra saía em ordem diferente em cada
// motor e virava "divergência" que não existia.
// O caminho vai ENTRE ASPAS: nome de caso com `<`, `>` ou `&` (os operadores
// da linguagem estão no nome do arquivo) virava redirecionamento do shell e o
// caso nem rodava — aparecia como "divergência" que era só o medidor quebrado.
action roda(cmd, arquivo, tmp_err):
    saida = os.cmd(cmd + " \"" + arquivo + "\" 2>\"" + tmp_err + "\"; echo \"__RC=$?\"", capture=true)
    marca = saida.rfind("__RC=")
    rc = "?"
    texto = saida
    if marca >= 0:
        rc = saida[marca + 5:len(saida)].strip()
        texto = saida[0:marca].strip()
    erro = ""
    if os.isfile(tmp_err):
        erro = os.readFile(tmp_err).strip()
    return [rc, texto, erro]

// primeira_linha: o "Tipo: mensagem" (o resto é traceback/cursor)
action primeira_linha(txt):
    if txt == "":
        return ""
    return txt.split("\n")[0].strip()

// tipo_do_erro: "RuntimeError: x" -> "RuntimeError"
action tipo_do_erro(linha):
    i = linha.find(":")
    if i < 0:
        return linha
    return linha[0:i].strip()

action vaza_python(linha):
    for each marca in VAZA:
        if linha.contains(marca):
            return true
    return false

action registra(classe, caso, a, b):
    CLASSES[classe].append(caso + "\n    interp: " + a + "\n    VM    : " + b)

arquivos = []
for each item in os.ls(PASTA):
    if item["type"] == "file" and item["name"].endswith(".ps"):
        arquivos.append(item["name"])
arquivos.sort()

post("casos:", len(arquivos))

ERR_I = PASTA + "/.err_interp"
ERR_V = PASTA + "/.err_vm"

for each nome in arquivos:
    caminho = PASTA + "/" + nome
    EST["casos"] = EST["casos"] + 1
    ri = roda(INTERP, caminho, ERR_I)
    rv = roda(VM, caminho, ERR_V)
    oki = ri[0] == "0"
    okv = rv[0] == "0"
    li = primeira_linha(ri[2])
    lv = primeira_linha(rv[2])
    caso = nome.replace(".ps", "")

    if vaza_python(li) or vaza_python(lv):
        registra("PYTHON", caso, li, lv)
        continue
    if oki != okv:
        registra("ACEITA", caso, "rc=" + ri[0] + " " + li, "rc=" + rv[0] + " " + lv)
        continue
    if oki:
        if ri[1] == rv[1]:
            EST["iguais"] = EST["iguais"] + 1
        else:
            registra("SAIDA", caso, ri[1].replace("\n", " | "), rv[1].replace("\n", " | "))
        continue
    ti = tipo_do_erro(li)
    tv = tipo_do_erro(lv)
    if ti != tv:
        registra("TIPO", caso, li, lv)
    elif li != lv:
        registra("MSG", caso, li, lv)
    else:
        EST["iguais"] = EST["iguais"] + 1

// ── relatório ───────────────────────────────────────────────────────────────
linhas = []
linhas.append("MATRIZ DIFERENCIAL — " + str(EST["casos"]) + " casos")
linhas.append("iguais nos 2 motores: " + str(EST["iguais"]))
linhas.append("")
total_div = 0
for each classe in ["PYTHON", "ACEITA", "TIPO", "MSG", "SAIDA"]:
    total_div = total_div + len(CLASSES[classe])
linhas.append("DIVERGENTES: " + str(total_div))
for each classe in ["PYTHON", "ACEITA", "TIPO", "MSG", "SAIDA"]:
    linhas.append("  " + classe + ": " + str(len(CLASSES[classe])))
linhas.append("")

for each classe in ["PYTHON", "ACEITA", "TIPO", "MSG", "SAIDA"]:
    if len(CLASSES[classe]) == 0:
        continue
    linhas.append("=== " + classe + " (" + str(len(CLASSES[classe])) + ") ===")
    for each item in CLASSES[classe]:
        linhas.append(item)
    linhas.append("")

os.writeFile(SAIDA, "\n".join(linhas))
post("iguais:", EST["iguais"], " divergentes:", total_div)
for each classe in ["PYTHON", "ACEITA", "TIPO", "MSG", "SAIDA"]:
    post(" ", classe, len(CLASSES[classe]))
post("relatorio:", SAIDA)

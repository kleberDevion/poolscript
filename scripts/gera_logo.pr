# Gera a logo da Jinga — o "J" roxo com a sombra coral — a partir de UM
# contorno, em vetor (SVG) e em pixel (PNG), sem biblioteca de fora: o
# rasterizador e o escritor de PNG estão aqui, em Jinga.
#
#   jinga scripts/gera_logo.pr            # grava todos os arquivos
#   jinga scripts/gera_logo.pr <pasta>    # grava uma prévia (previa.png, 512px, e previa.svg) na pasta
#
# Saídas:
#   dados/icones/text-jinga.svg                          o ícone do .pr no desktop (vetor)
#   editor/vscode/images/icon.png                        256 px, fundo branco de cantos redondos (a vitrine da extensão)
#   editor/vscode/images/arquivo.png                     128 px, fundo transparente (ícone do arquivo)
#   editor/intellij/plugin/resources/icons/jinga_pr.png  16 px  (e @2x, 32 px)
#
# O DESENHO é o da imagem que o dono mandou em 2026-10-14 ("logo da jinga"):
# um J de letra sem serifa, roxo chapado, com o mesmo J em coral atrás,
# deslocado pra direita e pra baixo. As cores e a forma foram copiadas dela
# (decisão dele: não há o arquivo original). O contorno está nas coordenadas
# daquela imagem (1920 x 1080, y pra baixo): é só medir de novo se ela mudar.
import bytes
import os
import sys

# ── o contorno do J ──────────────────────────────────────────────────────────
# Fechado, no sentido horário. Cada peça é [tipo, pontos...]: "M" começa, "L"
# é reta até o ponto, "C" é a cúbica de Bézier (dois pontos de controle e o
# fim). Haste reta à direita, gancho embaixo, ponta cortada na vertical.
list CONTORNO = [
    ["M", [808.0, 328.0]],
    ["L", [858.0, 328.0]],
    ["L", [858.0, 545.0]],
    ["C", [858.0, 600.0], [835.0, 633.0], [793.0, 633.0]],
    ["C", [775.0, 633.0], [762.0, 631.0], [754.0, 629.0]],
    ["L", [754.0, 589.0]],
    ["C", [762.0, 591.0], [770.0, 592.0], [777.0, 592.0]],
    ["C", [798.0, 592.0], [808.0, 580.0], [808.0, 552.0]],
    ["L", [808.0, 328.0]]
]
# a sombra é o mesmo J, deslocado
list DESLOCA_SOMBRA = [20.0, 10.0]
list COR_J = [91, 23, 230]          # roxo
list COR_SOMBRA = [255, 90, 90]     # coral
list COR_FUNDO = [255, 255, 255]    # o branco da imagem, só na vitrine da extensão
int PASSOS_CURVA = 32               # retas por curva no rasterizador

# O contorno vira polígono: cada cúbica em PASSOS_CURVA retas.
list funct achata(list contorno, list desloca) {
    list pts = []
    list atual = [0.0, 0.0]
    for each peca in contorno {
        str tipo = peca[0]
        if tipo == "C" {
            list p1 = peca[1]
            list p2 = peca[2]
            list p3 = peca[3]
            int k = 1
            while (k <= PASSOS_CURVA) {
                flo t = k / PASSOS_CURVA
                flo u = 1.0 - t
                flo x = u * u * u * atual[0] + 3 * u * u * t * p1[0] + 3 * u * t * t * p2[0] + t * t * t * p3[0]
                flo y = u * u * u * atual[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1]
                pts.append([x + desloca[0], y + desloca[1]])
                k++
            }
            atual = p3
        }
        else {
            list p = peca[1]
            pts.append([p[0] + desloca[0], p[1] + desloca[1]])
            atual = p
        }
    }
    return pts
}

list J = achata(CONTORNO, [0.0, 0.0])
list SOMBRA = achata(CONTORNO, DESLOCA_SOMBRA)

# A caixa que o desenho ocupa, com a sombra (pra centralizar e escalar).
list funct caixa(list a, list b) {
    flo xmin = a[0][0]
    flo xmax = a[0][0]
    flo ymin = a[0][1]
    flo ymax = a[0][1]
    for each p in a + b {
        xmin = min(xmin, p[0])
        xmax = max(xmax, p[0])
        ymin = min(ymin, p[1])
        ymax = max(ymax, p[1])
    }
    return [xmin, ymin, xmax, ymax]
}
list CAIXA = caixa(J, SOMBRA)

# ── SVG ──────────────────────────────────────────────────────────────────────
str funct num(flo v) {
    return str(round(v * 10) / 10)
}
str funct par(list p) {
    return num(p[0]) + "," + num(p[1])
}
str funct hexcor(list c) {
    return "#" + hex(c[0])[2:].rjust(2, "0") + hex(c[1])[2:].rjust(2, "0") + hex(c[2])[2:].rjust(2, "0")
}
str funct caminho_svg() {
    list partes = []
    for each peca in CONTORNO {
        str tipo = peca[0]
        if tipo == "C" {
            partes.append("C" + par(peca[1]) + " " + par(peca[2]) + " " + par(peca[3]))
        }
        else {
            partes.append(tipo + par(peca[1]))
        }
    }
    return " ".join(partes) + " Z"
}
str funct svg() {
    # um quadrado em volta do desenho, com folga de 5% de cada lado
    flo lw = CAIXA[2] - CAIXA[0]
    flo lh = CAIXA[3] - CAIXA[1]
    flo lado = max(lw, lh) / 0.9
    flo x0 = CAIXA[0] + lw / 2 - lado / 2
    flo y0 = CAIXA[1] + lh / 2 - lado / 2
    str d = caminho_svg()
    return ("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"512\" height=\"512\" viewBox=\""
        + num(x0) + " " + num(y0) + " " + num(lado) + " " + num(lado) + "\">\n"
        + "  <!--\n"
        + "    A logo da Jinga: o J roxo com a sombra coral. GERADO por\n"
        + "    scripts/gera_logo.pr, do mesmo contorno que faz os PNG dos\n"
        + "    editores; não edite à mão, mude o script.\n"
        + "  -->\n"
        + "  <path d=\"" + d + "\" fill=\"" + hexcor(COR_SOMBRA) + "\" transform=\"translate("
        + num(DESLOCA_SOMBRA[0]) + " " + num(DESLOCA_SOMBRA[1]) + ")\"/>\n"
        + "  <path d=\"" + d + "\" fill=\"" + hexcor(COR_J) + "\"/>\n"
        + "</svg>\n")
}

# ── PNG (RGBA, deflate sem compressão) ───────────────────────────────────────
TABELA_CRC = []
funct monta_crc() {
    global TABELA_CRC
    i = 0
    while i < 256 {
        c = i
        k = 0
        while k < 8 {
            if c & 1 {
                c = 3988292384 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        addEnd(TABELA_CRC, c)
        i = i + 1
    }
}
funct crc32(dados) {
    c = 4294967295
    for each x in dados {
        c = TABELA_CRC[(c ^ x) & 255] ^ (c >> 8)
    }
    return c ^ 4294967295
}
funct adler32(dados) {
    a = 1
    b = 0
    for each x in dados {
        a = (a + x) % 65521
        b = (b + a) % 65521
    }
    return (b << 16) | a
}
funct be32(v) { return [(v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255] }
funct chunk(tipo, dados) {
    corpo = []
    for each ch in tipo { addEnd(corpo, ord(ch)) }
    for each x in dados { addEnd(corpo, x) }
    saida = be32(len(dados))
    for each x in corpo { addEnd(saida, x) }
    for each x in be32(crc32(corpo)) { addEnd(saida, x) }
    return saida
}
funct zlib_cru(dados) {
    saida = [120, 1]
    i = 0
    total = len(dados)
    while i < total or total == 0 {
        qtd = min(65535, total - i)
        final = 1 if i + qtd >= total else 0
        addEnd(saida, final)
        addEnd(saida, qtd & 255)
        addEnd(saida, (qtd >> 8) & 255)
        addEnd(saida, (qtd ^ 65535) & 255)
        addEnd(saida, ((qtd ^ 65535) >> 8) & 255)
        j = 0
        while j < qtd {
            addEnd(saida, dados[i + j])
            j = j + 1
        }
        i = i + qtd
        if total == 0 { break }
    }
    for each x in be32(adler32(dados)) { addEnd(saida, x) }
    return saida
}
funct png(largura, altura, pixels) {
    # pixels: lista plana RGBA, linha a linha
    cru = []
    y = 0
    while y < altura {
        addEnd(cru, 0)
        inicio = y * largura * 4
        i = 0
        while i < largura * 4 {
            addEnd(cru, pixels[inicio + i])
            i = i + 1
        }
        y = y + 1
    }
    saida = [137, 80, 78, 71, 13, 10, 26, 10]
    ihdr = be32(largura) + be32(altura) + [8, 6, 0, 0, 0]
    for each x in chunk("IHDR", ihdr) { addEnd(saida, x) }
    for each x in chunk("IDAT", zlib_cru(cru)) { addEnd(saida, x) }
    for each x in chunk("IEND", []) { addEnd(saida, x) }
    return bytes.new(saida)
}

# ── rasterizador: linhas de varredura, 4x4 amostras por pixel ────────────────
# Para cada uma das 4 linhas de amostra de um pixel, as bordas do polígono
# cortam a linha em pontos; entre o 1º e o 2º, o 3º e o 4º... é dentro (regra
# par-ímpar). Cada amostra dentro soma 1 no pixel dela; 16 amostras = cheio.
list funct coberturas(list poli, int tam, flo ox, flo oy, flo escala) {
    list cont = [0] * (tam * tam)
    int n = len(poli)
    int py = 0
    while (py < tam) {
        int sy = 0
        while (sy < 4) {
            flo y = oy + (py + (sy + 0.5) / 4) * escala
            list xs = []
            int i = 0
            while (i < n) {
                list a = poli[i]
                list b = poli[(i + 1) % n]
                if (a[1] <= y and b[1] > y) or (b[1] <= y and a[1] > y) {
                    xs.append(a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]))
                }
                i++
            }
            xs.sort()
            int k = 0
            while (k + 1 < len(xs)) {
                # amostras com ox + (j + 0.5) / 4 * escala dentro de [xa, xb)
                int j0 = max(0, int((xs[k] - ox) * 4 / escala - 0.5) + 1)
                int j1 = min(tam * 4 - 1, int((xs[k + 1] - ox) * 4 / escala - 0.5))
                int j = j0
                while (j <= j1) {
                    cont[py * tam + j // 4] += 1
                    j++
                }
                k += 2
            }
            sy++
        }
        py++
    }
    return cont
}

# Põe uma camada (cor e cobertura de 0 a 1) por cima, em alfa direto.
list funct por_cima(list baixo, list cor, flo a) {
    flo fa = baixo[3]
    flo sai = a + fa * (1.0 - a)
    if sai <= 0.0 {
        return [0.0, 0.0, 0.0, 0.0]
    }
    list r = []
    int c = 0
    while (c < 3) {
        r.append((cor[c] * a + baixo[c] * fa * (1.0 - a)) / sai)
        c++
    }
    r.append(sai)
    return r
}

byte funct rasteriza(int tam, flo fracao, bool com_fundo, int raio_canto) {
    # o desenho ocupa `fracao` do lado, centralizado
    flo lw = CAIXA[2] - CAIXA[0]
    flo lh = CAIXA[3] - CAIXA[1]
    flo escala = max(lw, lh) / (tam * fracao)     # unidades da imagem por pixel
    flo ox = CAIXA[0] + lw / 2 - (tam / 2) * escala
    flo oy = CAIXA[1] + lh / 2 - (tam / 2) * escala
    list cj = coberturas(J, tam, ox, oy, escala)
    list cs = coberturas(SOMBRA, tam, ox, oy, escala)
    list pixels = []
    int py = 0
    while (py < tam) {
        int px = 0
        while (px < tam) {
            list cor = [0.0, 0.0, 0.0, 0.0]
            if com_fundo {
                # fundo branco de cantos redondos; o J vai por cima
                flo fx = min(px + 0.5, tam - px - 0.5)
                flo fy = min(py + 0.5, tam - py - 0.5)
                flo fa = 1.0
                if fx < raio_canto and fy < raio_canto {
                    flo dx = raio_canto - fx
                    flo dy = raio_canto - fy
                    flo dist = (dx * dx + dy * dy) ** 0.5
                    fa = min(1.0, max(0.0, raio_canto - dist + 0.5))
                }
                cor = [COR_FUNDO[0] * 1.0, COR_FUNDO[1] * 1.0, COR_FUNDO[2] * 1.0, fa]
            }
            cor = por_cima(cor, COR_SOMBRA, cs[py * tam + px] / 16.0)
            cor = por_cima(cor, COR_J, cj[py * tam + px] / 16.0)
            pixels.append(int(round(cor[0])))
            pixels.append(int(round(cor[1])))
            pixels.append(int(round(cor[2])))
            pixels.append(int(round(255 * cor[3])))
            px++
        }
        py++
    }
    return png(tam, tam, pixels)
}

monta_crc()
if __name__ == "main" {
    if len(sys.argv) > 1 {
        str pasta = sys.argv[1]
        os.writeFile(pasta + "/previa.png", rasteriza(512, 0.8, True, 96))
        os.writeFile(pasta + "/previa.svg", svg())
        post("prévia em " + pasta)
    }
    else {
        os.writeFile("dados/icones/text-jinga.svg", svg())
        os.writeFile("editor/vscode/images/icon.png", rasteriza(256, 0.8, True, 48))
        os.writeFile("editor/vscode/images/arquivo.png", rasteriza(128, 0.92, False, 0))
        os.writeFile("editor/intellij/plugin/resources/icons/jinga_pr.png", rasteriza(16, 0.96, False, 0))
        os.writeFile("editor/intellij/plugin/resources/icons/jinga_pr@2x.png", rasteriza(32, 0.96, False, 0))
        post("logo gerada: svg + 4 png")
    }
}


# O deftype, permite esse tipo de expressão - int16 nome = 100; - sem ele - in16 nome = int16(100);
deftype class int16
{
    # O codenome Literals, e uma Hiper classe, mae de todas, que nela pode se atribuir a uma classe
    # qualquer o literal que pertence a outro tipo primitivo da linaguagem, ja callme
    # Se refere a classe chamar a se mesma dentro de seu escopo, o sinal -> e so de atribuição.
    callme int16(int value) -> Literals.int
    {
        if (value < 0xFFFF || value > 0)
        {
            return value
        }
        return  f'Valor atribuido a {int16} fora de 16bits.'
    }
}

int16 idade = 17;

# ---------------------------------------------------------------------------
# Proposta do assistente (2026-10-23), escrita abaixo da sua pra você comparar.
# Nada disso existe ainda: é desenho pra trilha de dev (item 16 do
# JINGA-TUDO 6.4), que entra depois da correção da base. A decisão é sua.
#
# O seu deftype junta duas coisas que as linguagens consolidadas separam.
#
# 1) TIPO LIMITADO (o int16): um primitivo com faixa, como o Ada faz desde 1983
#    (`type Int16 is range -2**15 .. 2**15 - 1;`) e o Pascal (`type Idade =
#    0..150;`). A forma `type Nome = ...` é a do Python 3.12 (PEP 695) e do
#    TypeScript. As restrições são as palavras que o `model` da Jinga já usa
#    pra validar campo (min, max, length, regex, in), sem palavra nova:

type int16 = int(min=-32768, max=32767)
type Idade = int(min=0, max=150)
type Cpf = str(length=11, regex=r"\d{11}")

int16 x = 100            # vale: o literal cabe, conferido ANTES de rodar
int16 y = 40000          # erro antes de rodar:
                         #   ValueError: 40000 fora de int16 (-32768 a 32767)
Idade i = int(input())   # valor que só se sabe rodando: conferido rodando,
                         #   com o mesmo ValueError, na linha da atribuição
int z = x + 1            # int16 é int: entra em toda conta de int
int16 w = x + 1          # o resultado volta a ser conferido na atribuição

#    Fora da faixa é ERRO, como o Constraint_Error do Ada. Nunca dá a volta
#    calado (como o int16_t do C, que o Plano 1 traz pra memória do C) nem
#    vira texto no lugar do número.
#
# 2) CLASSE QUE RECEBE LITERAL (o `int16 idade = 17` sem `int16(17)`): é o
#    construtor de conversão do C++ (`Dinheiro d = 10;` chama `Dinheiro(int)`,
#    e o `explicit` desliga) e o `implicit operator` do C#. Aqui, o construtor
#    marcado diz de que literal a classe nasce:

class Dinheiro {
    int centavos = 0

    @literal                         # aceita `Dinheiro d = 10.50`
    funct __init__(self, flo reais) {
        if (reais < 0) {
            raise ValueError(f"valor negativo: {reais}")
        }
        self.centavos = round(reais * 100)
    }
}

Dinheiro preco = 10.50     # chama o __init__ marcado: o mesmo que Dinheiro(10.50)
Dinheiro outro = "dez"     # erro antes de rodar: o construtor pede flo

#    Sem o @literal, `Dinheiro d = 10.50` continua erro, que é a regra de hoje
#    (sem conversão implícita). Só a classe que pede recebe literal, e o tipo
#    do literal é o do parâmetro do construtor, conferido antes de rodar.
#
# Três pontos do esboço de cima que este desenho resolve:
# - `value < 0xFFFF || value > 0` aceita qualquer número: o -5 passa pela
#   primeira condição e o 100000 pela segunda. A faixa do int16 com sinal é
#   -32768 a 32767 (sem sinal, 0 a 65535);
# - devolver o texto do erro faz a variável receber o texto: `idade` viraria
#   a frase. O erro tem que ser levantado (raise);
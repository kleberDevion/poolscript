#!cmd
import sys
import os

# Ler `sys.argv` sem conferir o tamanho quebra quando o script roda sem
# argumento. Antes isso passava calado — indice fora da faixa devolvia Null, e
# os `if (target and ...)` abaixo simplesmente nao entravam. Hoje levanta
# IndexError, e a leitura precisa ser guardada. O valor vazio preserva o
# mesmo comportamento falsy que esses `if` ja esperavam.
target = ""
target_2 = ""
if len(sys.argv) > 0 {
    target = sys.argv[0]
}
if len(sys.argv) > 1 {
    target_2 = sys.argv[1]
}




bool reaction mainter()
{
    try {
        if (target and sys.platform() == 'windows' and target.contains('.')) {
            os.chdir('/mnt/c/Users/klebe/')
            post(os.pathFile(target))
        } elif (target and sys.platform() == 'linux' and target.contains('.')) {
            os.chdir('/home/kleberDevion')
            post(os.pathFile(target))
        } elif (target and sys.platform() == 'linux' and target.contains('.') and target_2 == "--ct") {
            os.chdir('/home/kleberDevion')
            file = os.pathFile(target)
        }
    } catch (e) {
        post(<red>f"WhereCommandError: {e}")
    }
    return false
}

mainter()
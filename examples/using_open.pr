# Built-ins novos da v0.3.0: open + using
# Cria um arquivo na pasta de onde roda, lê de volta, mostra e apaga.

using open("jinga_demo.txt", "w") as f {
    f.write("primeira linha\n")
    f.write("segunda linha\n")
}

using open("jinga_demo.txt", "r") as f {
    str conteudo = f.read()
    post("conteudo:" conteudo)
}

# o arquivo do exemplo sai junto: o handle fechado apaga o próprio caminho
demo = open("jinga_demo.txt")
demo.close()
demo.delete()

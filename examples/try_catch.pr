# try_catch.pr — captura de erros
try {
    x = 10 / 0
} catch (e) {
    post("capturou: " {e})
}

# (nome que nao existe e erro ANTES de rodar, nao ha catch que pegue; o que
# o catch pega e o erro que so acontece rodando, como um indice fora da lista)
try {
    y = [1, 2][5]
} catch (e) {
    post("tambem capturou: " {e})
}

post("depois dos try/catch")

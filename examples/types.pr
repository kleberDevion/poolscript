# ESBOÇO — item 16 (tipos), decisão do dono em 2026-11-17.
#
# Nada aqui roda ainda: o item 16 entra depois da linkagem com o C e do
# `T[]` (item 13). Este arquivo é a proposta escrita, não um exemplo.
# O `teste/exemplos_roda.pr` o pula de propósito (lista PROPOSTA).
#
# Só existem estas formas:
#
#   1. `type Nome = tipo`                    — outro nome para um tipo
#   2. `type Nome = tipo(min=..., max=...)`  — tipo limitado
#   3. `type enum Nome { membro = tipo; }`   — enum de tipos
#   4. `type class Nome { @literal ... }`    — classe que recebe literal
#
# Nada de `deftype class`, `callme` ou `Literals`.

# ---------------------------------------------------------------------------
# 1) Tipo com outro nome. `int16` é o `int`; não há tipo novo por baixo.

type int16 = int
type Texto = str

int16 x = 100            # vale
Texto t = "ok"           # vale

# ---------------------------------------------------------------------------
# 2) Tipo limitado: as palavras que o `model` já usa (min, max, length,
#    regex, in), sem palavra nova.

type Int16 = int(min=-32768, max=32767)
type Idade = int(min=0, max=150)
type Cpf = str(length=11, regex=r"\d{11}")

Int16 y = 40000          # erro antes de rodar:
                         #   ValueError: 40000 fora de Int16 (-32768 a 32767)
Idade i = int(input())   # valor que só se sabe rodando: conferido rodando,
                         #   com o mesmo ValueError, na linha da atribuição
int z = x + 1            # Int16 é int: entra em toda conta de int
Int16 w = x + 1          # o resultado volta a ser conferido na atribuição

Cpf cpf = "12345678901"  # vale
Cpf errado = "123"       # erro antes de rodar: length=11

# Fora da faixa é ERRO, como o Constraint_Error do Ada. Nunca dá a volta
# calado (como o int16_t do C) nem vira texto no lugar do número.

# ---------------------------------------------------------------------------
# 3) Enum de tipos: cada membro é um tipo limitado e se usa como tipo.

type enum Faixa {
    idade = int(min=18, max=120);
}

Faixa.idade user_age = 23    # vale
Faixa.idade outra = 200      # erro antes de rodar:
                             #   ValueError: 200 fora de Faixa.idade (18 a 120)

# ---------------------------------------------------------------------------
# 4) Classe que recebe literal: o decorador `@literal` pega o tipo do
#    parâmetro do construtor e o passa pra classe.

type class Dinheiro {
    int centavos = 0

    @literal                         # aceita `Dinheiro d = 10.50`
    funct __init__(self, flo reais) {
        if (reais < 0) {
            raise ValueError(f"valor negativo: {reais}")
        }
        self.centavos = round(reais * 100)
    }
}

Dinheiro preco = 10.50     # chama o __init__ marcado: o mesmo que Dinheiro(10.50)
Dinheiro outro = "dez"     # erro antes de rodar: o construtor pede flo

# Sem o @literal, `Dinheiro d = 10.50` continua erro, que é a regra de hoje
# (sem conversão implícita). Só a classe que pede recebe literal, e o tipo
# do literal é o do parâmetro do construtor, conferido antes de rodar.

# per_page_mock.pr — paginação de uma consulta, na forma de um handler do
# jinker (o `self` e o `data` são os do handler baseado em classe). Roda
# sozinho: o banco é um sqlite temporário que ele mesmo cria e povoa.
import jinker
import psodbc

conn = Null

funct connDatabase() {
    global conn
    if conn == Null {
        conn = psodbc.connect(url="sqlite:////tmp/per_page_mock.db")
        cur = conn.cursor()
        cur.execute("CREATE TABLE IF NOT EXISTS emails (id INTEGER PRIMARY KEY, id_user INTEGER, assunto TEXT)")
        cur.execute("DELETE FROM emails")
        i = 1
        while i <= 45 {
            cur.execute("INSERT INTO emails (id_user, assunto) VALUES (?, ?)", (i % 3, "assunto " + str(i)))
            i = i + 1
        }
        conn.commit()
    }
}

funct SearchInbox(self, data) {
    try {
        connDatabase()
        mouse = conn.cursor()

        if data and data.get("id") {
            mouse.execute("SELECT * FROM emails WHERE id_user = ?", (data["id"],))
            resultado = mouse.fetchone()
            return jinker.jsonify({
                "status_code": 209,
                "infos": resultado
            }), 209
        }

        # nascem AQUI, fora dos `if`: o que nasce dentro de um bloco morre com ele
        page = 1
        per_page = 20
        if data {
            p = data.get("page")
            if p {
                page = int(p)
            }
            pp = data.get("per_page")
            if pp {
                per_page = int(pp)
            }
        }
        if page < 1 {
            page = 1
        }
        if per_page < 1 {
            per_page = 20
        }
        if per_page > 100 {
            per_page = 100
        }
        offset = (page - 1) * per_page

        mouse.execute("SELECT * FROM emails LIMIT ? OFFSET ?", (per_page, offset))
        resultado_2 = mouse.fetchall()

        mouse.execute("SELECT COUNT(*) as total FROM emails")
        total = mouse.fetchone()["total"]
        total_pages = int((total + per_page - 1) / per_page)   # arredonda pra cima

        return jinker.jsonify({
            "status_code": 200,
            "page": page,
            "per_page": per_page,
            "total": total,
            "total_pages": total_pages,
            "has_next": page < total_pages,
            "has_prev": page > 1,
            "infos": resultado_2
        }), 200
    }
    catch (e) {
        post(<red>f"Erro interno em SmtpControl.SearchInbox(): {e}")
        return jinker.jsonify({
            "status_code": 500,
            "message": "Server Internal Error!"
        }), 500
    }
}

if __name__ == "main" {
    resposta, codigo = SearchInbox(Null, {"page": 2, "per_page": 10})
    post(codigo)
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PoolScript",
  "scopeName": "source.poolscript",
  "fileTypes": [
    "ps",
    "psl",
    "p"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.poolscript",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "comment.line.number-sign.poolscript",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.poolscript",
          "begin": "[frbFRB]*'''",
          "end": "'''",
          "patterns": [
            {
              "include": "#interp"
            },
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.poolscript",
          "begin": "[frbFRB]*\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interp"
            },
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.poolscript",
          "begin": "[frbFRB]*'",
          "end": "'",
          "patterns": [
            {
              "include": "#interp"
            },
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interp": {
      "name": "meta.embedded.poolscript",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.poolscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.poolscript"
        }
      },
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#calls"
        }
      ]
    },
    "decorators": {
      "name": "meta.decorator.poolscript",
      "match": "(@)([A-Za-z_][\\w]*(?:\\.[A-Za-z_]\\w*)*)",
      "captures": {
        "1": {
          "name": "punctuation.decorator.poolscript"
        },
        "2": {
          "name": "entity.name.function.decorator.poolscript"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(action|reaction)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.function.poolscript"
            },
            "2": {
              "name": "entity.name.function.poolscript"
            }
          }
        },
        {
          "match": "\\b(Entity|class|Class|model|enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.class.poolscript"
            },
            "2": {
              "name": "entity.name.type.class.poolscript"
            }
          }
        },
        {
          "comment": "heranca: o nome do pai tambem e um tipo",
          "match": "(?<=\\b(?:Entity|class|Class)\\s{1,20})[A-Za-z_]\\w*\\s*\\(\\s*([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "entity.other.inherited-class.poolscript"
            }
          }
        },
        {
          "comment": "parametros da declaracao — o C# pinta parametro de azul claro",
          "begin": "(?<=\\b(?:action|reaction)\\s{1,4}[A-Za-z_]\\w{0,64})\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "match": "\\b(str|int|flo|bool|list|dict|json|tup|bytes|char|Object|object)\\b",
              "name": "storage.type.poolscript"
            },
            {
              "match": "\\b[A-Za-z_]\\w*\\b",
              "name": "variable.parameter.poolscript"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "`self` e o `this` do C#",
          "match": "\\bself\\b",
          "name": "variable.language.self.poolscript"
        },
        {
          "name": "keyword.control.poolscript",
          "match": "\\b(if|elif|else|while|for|each|in|is|match|case|try|catch|finally|raise|return|yield|break|continue|with|using|await|async|import|from|as|global|count|to|of)\\b"
        },
        {
          "name": "keyword.operator.logical.poolscript",
          "match": "\\b(and|or|not|Not)\\b"
        },
        {
          "name": "storage.type.poolscript",
          "match": "\\b(str|int|flo|bool|list|dict|json|tup|bytes|action|reaction|Entity|class|Class|model|enum|type|char|Object|object)\\b"
        },
        {
          "name": "storage.modifier.poolscript",
          "match": "\\b(private|public)\\b"
        },
        {
          "name": "keyword.control.verb.poolscript",
          "match": "\\b(PUSH|GET|POST|PUT|DELETE|JSON)\\b"
        },
        {
          "name": "support.function.builtin.poolscript",
          "match": "\\b(post|input|listen|route|create|clear|space|addEnd|full|mei)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.poolscript",
          "match": "\\b(true|True|false|False)\\b"
        },
        {
          "name": "constant.language.null.poolscript",
          "match": "\\b(Null|null|None|none)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.poolscript",
      "match": "\\b(0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|\\d+\\.?\\d*([eE][+-]?\\d+)?)\\b"
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.poolscript"
            }
          }
        },
        {
          "comment": "acesso a membro sem chamada e propriedade",
          "match": "(?<=\\.)([A-Za-z_]\\w*)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.property.poolscript"
            }
          }
        }
      ]
    }
  }
}

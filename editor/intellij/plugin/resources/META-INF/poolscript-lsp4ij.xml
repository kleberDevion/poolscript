<idea-plugin>
  <!-- Carregado só com o plugin LSP4IJ (marketplace) ligado. O servidor LSP da
       PoolScript passa a ser declarado AQUI, com o mapeamento `*.pr`: nada a
       cadastrar em Settings > Languages & Frameworks > Language Servers — era
       esse cadastro manual, ainda em `*.ps`, que deixava o `.pr` sem
       completion. O languageId "poolscript" é o que vai no didOpen. -->
  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="poolscript" name="PoolScript" factoryClass="poolscript.lsp.PoolLspFactory"
            supportsLightEdit="true" icon="/icons/poolscript_pr.png"
            description="poolscript-lsp: completion, hover, definição, outline e diagnóstico do motor"/>
    <fileNamePatternMapping serverId="poolscript" patterns="*.pr" languageId="poolscript"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <!-- o balão de "há um servidor cadastrado à mão" -->
    <notificationGroup id="PoolScript" displayType="BALLOON"/>
  </extensions>
</idea-plugin>

{
  "name": "Jinga One Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#282C34",
    "editor.foreground": "#ABB2BF",
    "editorLineNumber.foreground": "#4B5263",
    "editorLineNumber.activeForeground": "#ABB2BF",
    "editor.selectionBackground": "#3E4451",
    "editor.lineHighlightBackground": "#2C313A",
    "editorCursor.foreground": "#528BFF",
    "editorIndentGuide.background1": "#3B4048",
    "sideBar.background": "#21252B",
    "activityBar.background": "#282C34",
    "statusBar.background": "#21252B",
    "titleBar.activeBackground": "#282C34",
    "tab.activeBackground": "#282C34",
    "tab.inactiveBackground": "#21252B"
  },
  "tokenColors": [
    {
      "name": "Jinga: comentário",
      "scope": ["comment.line.number-sign.jinga", "comment.block.jinga"],
      "settings": { "foreground": "#5C6370", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: controle de fluxo (if for while return try match import …)",
      "scope": ["keyword.control.jinga"],
      "settings": { "foreground": "#C678DD", "fontStyle": "" }
    },
    {
      "name": "Jinga: operador-palavra (and or not is in)",
      "scope": ["keyword.operator.logical.jinga"],
      "settings": { "foreground": "#C678DD", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: verbos (PUSH GET POST PUT DELETE JSON)",
      "scope": ["keyword.control.verb.jinga"],
      "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
    },
    {
      "name": "Jinga: a palavra funct",
      "scope": ["storage.type.function.jinga"],
      "settings": { "foreground": "#E06C75", "fontStyle": "" }
    },
    {
      "name": "Jinga: nome da funct (declaração e chamada)",
      "scope": ["entity.name.function.jinga", "entity.name.function.call.jinga"],
      "settings": { "foreground": "#61AFEF", "fontStyle": "" }
    },
    {
      "name": "Jinga: Entity class model enum",
      "scope": ["storage.type.class.jinga"],
      "settings": { "foreground": "#D19A66", "fontStyle": "" }
    },
    {
      "name": "Jinga: nome da Entity/model",
      "scope": ["entity.name.type.class.jinga"],
      "settings": { "foreground": "#E5C07B", "fontStyle": "" }
    },
    {
      "name": "Jinga: pai herdado",
      "scope": ["entity.other.inherited-class.jinga"],
      "settings": { "foreground": "#E5C07B", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: tipos (str int byte list dict …) e prefixo de string (f r b)",
      "scope": ["storage.type.jinga", "storage.type.string.prefix.jinga"],
      "settings": { "foreground": "#4EC9B0", "fontStyle": "" }
    },
    {
      "name": "Jinga: modificadores (static nonnull private public)",
      "scope": ["storage.modifier.jinga"],
      "settings": { "foreground": "#ABB2BF", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: builtins (post len range …)",
      "scope": ["support.function.builtin.jinga"],
      "settings": { "foreground": "#DCDCAA", "fontStyle": "" }
    },
    {
      "name": "Jinga: exceções (Exception ValueError …)",
      "scope": ["support.class.exception.jinga"],
      "settings": { "foreground": "#F78C6C", "fontStyle": "" }
    },
    {
      "name": "Jinga: decorador (@ e o nome)",
      "scope": ["meta.decorator.jinga", "punctuation.decorator.jinga", "entity.name.function.decorator.jinga"],
      "settings": { "foreground": "#FF79C6", "fontStyle": "" }
    },
    {
      "name": "Jinga: self",
      "scope": ["variable.language.self.jinga"],
      "settings": { "foreground": "#56B6C2", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: parâmetro",
      "scope": ["variable.parameter.jinga"],
      "settings": { "foreground": "#9CDCFE", "fontStyle": "" }
    },
    {
      "name": "Jinga: propriedade (.x sem chamada)",
      "scope": ["variable.other.property.jinga"],
      "settings": { "foreground": "#ABB2BF", "fontStyle": "" }
    },
    {
      "name": "Jinga: string",
      "scope": ["string.quoted.double.jinga", "string.quoted.single.jinga", "string.quoted.triple.jinga"],
      "settings": { "foreground": "#98C379", "fontStyle": "" }
    },
    {
      "name": "Jinga: literal de bytes b\"...\"",
      "scope": ["string.quoted.bytes.jinga"],
      "settings": { "foreground": "#B5CEA8", "fontStyle": "" }
    },
    {
      "name": "Jinga: escape na string",
      "scope": ["constant.character.escape.jinga"],
      "settings": { "foreground": "#56B6C2", "fontStyle": "" }
    },
    {
      "name": "Jinga: chaves da interpolação",
      "scope": ["punctuation.definition.template-expression.begin.jinga", "punctuation.definition.template-expression.end.jinga"],
      "settings": { "foreground": "#C678DD", "fontStyle": "" }
    },
    {
      "name": "Jinga: número",
      "scope": ["constant.numeric.jinga"],
      "settings": { "foreground": "#D19A66", "fontStyle": "" }
    },
    {
      "name": "Jinga: true false Null",
      "scope": ["constant.language.boolean.jinga", "constant.language.null.jinga"],
      "settings": { "foreground": "#D19A66", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: operador de símbolo e pontuação",
      "scope": ["keyword.operator.jinga", "punctuation.jinga"],
      "settings": { "foreground": "#ABB2BF", "fontStyle": "" }
    },
    {
      "name": "Jinga: dunder (__name__ __init__)",
      "scope": ["support.variable.dunder.jinga"],
      "settings": { "foreground": "#E5C07B", "fontStyle": "italic" }
    },
    {
      "name": "Jinga: trecho interpolado volta à cor do texto",
      "scope": ["meta.embedded.jinga"],
      "settings": { "foreground": "#ABB2BF", "fontStyle": "" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#ABB2BF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ABB2BF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "comment",
        "comment.line.double-slash.jinga",
        "comment.line.number-sign.jinga",
        "comment.block.jinga"
      ],
      "settings": {
        "foreground": "#5C6370",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.double.jinga",
        "string.quoted.single.jinga",
        "string.quoted.triple.jinga"
      ],
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "scope": [
        "constant.character.escape.jinga"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "scope": [
        "constant.numeric.jinga"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "scope": [
        "constant.language.boolean.jinga",
        "constant.language.null.jinga"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "scope": [
        "keyword.control.jinga"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "scope": [
        "keyword.operator.logical.jinga"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "scope": [
        "storage.type.jinga",
        "storage.type.function.jinga",
        "storage.type.class.jinga"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "scope": [
        "storage.modifier.jinga"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function.jinga",
        "entity.name.function.call.jinga"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "scope": [
        "entity.name.type.jinga"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator.jinga",
        "punctuation.decorator.jinga",
        "meta.decorator.jinga"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "scope": [
        "meta.embedded.jinga"
      ],
      "settings": {
        "foreground": "#ABB2BF"
      }
    }
  ]
}
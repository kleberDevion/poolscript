{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PoolScript",
  "scopeName": "source.poolscript",
  "fileTypes": [
    "ps",
    "psl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#keywords_control"
    },
    {
      "include": "#return_type_decl"
    },
    {
      "include": "#keywords_declaration"
    },
    {
      "include": "#keywords_import"
    },
    {
      "include": "#keywords_logical"
    },
    {
      "include": "#self"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#stdlib_modules"
    },
    {
      "include": "#stdlib_methods"
    },
    {
      "include": "#string_methods"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#named_args"
    },
    {
      "include": "#function_def"
    },
    {
      "include": "#function_call"
    },
    {
      "include": "#class_name"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.poolscript",
          "match": "//.*$"
        },
        {
          "name": "comment.line.hash.poolscript",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.poolscript",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fstring.poolscript",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            },
            {
              "name": "variable.other.readwrite.poolscript",
              "begin": "\\{",
              "end": "\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.fstring.poolscript",
          "begin": "f'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.poolscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.poolscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.poolscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.decorator.poolscript"
            },
            "2": {
              "name": "entity.name.function.decorator.poolscript"
            }
          }
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.poolscript",
          "match": "\\b(if|elif|else|while|for|each|in|is|return|try|catch|finally|raise|as|with|of|using|async|await|count|continue|break|match|case|yield|to|run_selfwith_|NonNull|base|static|global)\\b"
        }
      ]
    },
    "keywords_declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.poolscript",
          "match": "\\b(action|reaction|Entity|Class|class|model|type)\\b"
        }
      ]
    },
    "keywords_import": {
      "patterns": [
        {
          "name": "keyword.control.import.poolscript",
          "match": "\\b(import|from|PUSH|GET)\\b"
        }
      ]
    },
    "keywords_logical": {
      "patterns": [
        {
          "name": "keyword.operator.logical.poolscript",
          "match": "\\b(and|or|not|Not|is not|not is)\\b"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.self.poolscript",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.poolscript",
          "match": "\\b(str|int|flo|bool|list|dict|tup)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.poolscript",
          "match": "\\b(post|input|len|range|open|map|filter|getAll|load|create|clear|space|addEnd|char|type|render)\\b(?=\\s*(\\(|$))"
        }
      ]
    },
    "stdlib_modules": {
      "patterns": [
        {
          "name": "support.class.stdlib.module.poolscript",
          "match": "\\b(request|date|json|os|hash|jwt|mail|db|sqlite3|manpu|mp|regex|sys|dotenv|qrcode|Jinker|cors|jinker|parsing)\\b"
        }
      ]
    },
    "stdlib_methods": {
      "patterns": [
        {
          "comment": "request lib",
          "match": "\\.(get|post|put|patch|delete|ws_connect|get_json|ok|status|text|json)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.request.poolscript"
            }
          }
        },
        {
          "comment": "date lib",
          "match": "\\.(time|today|datahora|now|timestamp|hora)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.date.poolscript"
            }
          }
        },
        {
          "comment": "json lib",
          "match": "\\.(parse|stringify)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.json.poolscript"
            }
          }
        },
        {
          "comment": "os lib",
          "match": "\\.(pathFile|pathFolder|loadFile|getenv|warn|ipmach|mkdir|rmdir|ls|cmd|code|exists|isfile|isdir|rename|copy|move|size|cwd|chdir|environ|bytes|path)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.os.poolscript"
            }
          }
        },
        {
          "comment": "hash lib",
          "match": "\\.(crypt|check)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.hash.poolscript"
            }
          }
        },
        {
          "comment": "jwt lib",
          "match": "\\.(gen|check)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.jwt.poolscript"
            }
          }
        },
        {
          "comment": "mail lib — MailServer, MailMessage e MailReader",
          "match": "\\.(conn|login|send|quit|from_address|to|subject|body|attach|get_as_string|select|search|close)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.mail.poolscript"
            }
          }
        },
        {
          "comment": "db lib",
          "match": "\\.(connect|query|cursor|execute|commit|close|find|find_one|insert|insert_many|update|remove|count|collection)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.db.poolscript"
            }
          }
        },
        {
          "comment": "manpu lib",
          "match": "\\.(read|write|remove|src|full|mei)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.manpu.poolscript"
            }
          }
        },
        {
          "comment": "regex lib",
          "match": "\\.(match|search|findall|sub|split|escape)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.regex.poolscript"
            }
          }
        },
        {
          "comment": "sys lib",
          "match": "\\.(stdout|stderr|argv|exit|platform)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.sys.poolscript"
            }
          }
        },
        {
          "comment": "jinker lib",
          "match": "\\.(route|options|origins|run|debug|host|port|channel|jsonify|render)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.jinker.poolscript"
            }
          }
        },
        {
          "comment": "dotenv / qrcode",
          "match": "\\.(load|gen)\\b",
          "captures": {
            "0": {
              "name": "support.function.stdlib.poolscript"
            }
          }
        }
      ]
    },
    "string_methods": {
      "patterns": [
        {
          "comment": "Métodos de string PoolStr",
          "match": "\\.(upper|lower|title|capitalize|strip|lstrip|rstrip|split|join|replace|isalpha|isdigit|isnumeric|isalnum|isspace|isupper|islower|startswith|endswith|contains|len|findall)\\b",
          "captures": {
            "0": {
              "name": "support.function.string.poolscript"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.poolscript",
          "match": "\\b(True|true|False|false)\\b"
        },
        {
          "name": "constant.language.null.poolscript",
          "match": "\\b(Null|null|None|none)\\b"
        },
        {
          "name": "constant.language.http.poolscript",
          "match": "\\b(POST|PUT|DELETE|JSON)\\b"
        },
        {
          "name": "constant.language.special.poolscript",
          "match": "\\b(__name__|__init__|__owner_entity__)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.poolscript",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.poolscript",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "named_args": {
      "comment": "Parâmetros nomeados em chamadas: func(nome=valor)",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)(?=[^=])",
          "captures": {
            "1": {
              "name": "variable.parameter.poolscript"
            },
            "2": {
              "name": "keyword.operator.assignment.named.poolscript"
            }
          }
        }
      ]
    },
    "function_def": {
      "comment": "Definição de action: action nomeFuncao(",
      "patterns": [
        {
          "match": "\\b(action|reaction)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.poolscript"
            },
            "2": {
              "name": "entity.name.function.definition.poolscript"
            }
          }
        }
      ]
    },
    "function_call": {
      "comment": "Chamada de função: nome(",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.poolscript"
            }
          }
        }
      ]
    },
    "class_name": {
      "comment": "Nomes que começam com maiúscula = classe/Entity",
      "patterns": [
        {
          "name": "support.class.poolscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.poolscript",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.comparison.poolscript",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.increment.poolscript",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.arithmetic.poolscript",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.symbol.poolscript",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.poolscript",
          "match": "(?<![=!<>])=(?!=)"
        }
      ]
    },
    "return_type_decl": {
      "name": "meta.return-type.poolscript",
      "match": "\\b(int|bool|flo|str)\\b(?=\\s+(?:action|reaction)\\b)",
      "captures": {
        "1": {
          "name": "storage.type.return.poolscript"
        }
      }
    }
  }
}
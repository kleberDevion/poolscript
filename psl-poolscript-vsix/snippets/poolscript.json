{
  "if (brace)": {
    "prefix": "if{",
    "body": ["if (${1:cond}) {", "    ${0:post(\"ok\")}", "}"],
    "description": "if com chaves"
  },
  "if/else": {
    "prefix": "ife",
    "body": ["if (${1:cond}) {", "    ${2:continue}", "} else {", "    ${0:post(\"erro\")}", "}"],
    "description": "if/else"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:cond}) {", "    ${0:body}", "}"]
  },
  "for each": {
    "prefix": "fore",
    "body": ["for each ${1:item} in ${2:lista} {", "    ${0:post(${1:item})}", "}"]
  },
  "action": {
    "prefix": "action",
    "body": ["action ${1:nome}(${2:args}) {", "    ${0:return Null}", "}"]
  },
  "action lambda": {
    "prefix": "actionl",
    "body": ["action(${1:args}) { return ${0:expr} }"]
  },
  "global": {
    "prefix": "global",
    "body": ["global ${0:nome}"]
  },
  "try/catch": {
    "prefix": "try",
    "body": ["try {", "    ${1:codigo()}", "} catch (${2:e}) {", "    ${0:return e}", "}"]
  },
  "model": {
    "prefix": "model",
    "body": ["model ${1:Nome}() {", "    ${2:campo}: ${3:str}(length=${4:60})", "}"]
  },
  "run_selfwith_": {
    "prefix": "run",
    "body": ["run_selfwith_(\"main\") {", "    ${0:minhaAction()}", "}"]
  },
  "jinker server": {
    "prefix": "jinker",
    "body": [
      "from jinker import Jinker, cors, jsonify",
      "",
      "app = Jinker(__name__)",
      "cors(options=[\"GET\", \"POST\"], permiser=[\"*/${1:api}\", \"allowed.all/Users-Agent\"])",
      ""
    ]
  },
  "db query curto": {
    "prefix": "dbq",
    "body": [
      "${1:result} = db.query(",
      "    base=${2:banco},",
      "    cmd=${3:cmd},",
      "    table=\"${4:tabela}\"",
      ")"
    ]
  },
  "db convencional": {
    "prefix": "dbc",
    "body": [
      "conn = db.query(\"${1:banco.db}\")",
      "cursor = conn.cursor()",
      "cursor.execute(\"${2:SELECT * FROM users}\")",
      "result = getAll()",
      "conn.close()"
    ]
  },
  "hash crypt": {
    "prefix": "hcrypt",
    "body": ["${1:senha_hash} = hash.crypt(${2:senha})"]
  },
  "hash check": {
    "prefix": "hcheck",
    "body": ["${1:ok} = hash.check(${2:hash_banco}, ${3:senha_digitada})"]
  },
  "jwt gen": {
    "prefix": "jwtgen",
    "body": [
      "payload = {",
      "    \"user_id\": ${1:user_id},",
      "    \"exp\": date.timestamp() + date.hora(hours=${2:24})",
      "}",
      "token = jwt.gen(payload, ${3:my_key}, algorithm=\"HS256\")"
    ]
  },
  "jwt check": {
    "prefix": "jwtcheck",
    "body": ["${1:payload} = jwt.check(${2:token}, ${3:my_key})"]
  },
  "import db": {
    "prefix": "impdb",
    "body": ["import db"]
  },
  "import hash jwt": {
    "prefix": "impauth",
    "body": ["import hash", "import jwt", "import date"]
  },
  "post": {
    "prefix": "post",
    "body": ["post(${1:\"\"})"]
  },
  "return jsonify": {
    "prefix": "rjson",
    "body": ["return jsonify({", "    \"${1:msg}\": \"${2:valor}\"", "}), ${3:200}"]
  }
}

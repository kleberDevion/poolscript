{
  "comments": {
    "lineComment": "//",
    "blockComment": ["\"\"\"", "\"\"\""]
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|elif|else|while|for|action|try|catch|using|@[A-Za-z_].*)\\b.*:\\s*$|.*\\{\\s*$",
    "decreaseIndentPattern": "^\\s*(\\}|else\\b|elif\\b|catch\\b|finally\\b).*$"
  },
  "onEnterRules": [
    {
      "beforeText": ":\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}

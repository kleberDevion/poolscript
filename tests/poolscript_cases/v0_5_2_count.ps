// Suite oficial do operador `count` (v0.5.2)
// Cada bloco emite uma string-marcador. Os asserts batem essa lista.

list nums = [1, 2, 3, 7, 7, 17, 7]

if (count int(7) in nums == 3) { post("prefix-value-ok") }
if (int(7) count in nums == 3) { post("infix-ok") }
if (count int(7) in nums) { post("truthy-ok") }
if (count int in nums == 7) { post("prefix-type-ok") }

str frase = "oi mundo oi pessoal oi"
if (count str("oi") in frase == 3) { post("substring-ok") }

int n = 17717
if (count int(7) in n == 3) { post("digits-in-int-ok") }

int doisDigitos = 67
if (count int(7) in doisDigitos == 1) { post("digit-of-pair-ok") }

json scores = { "joao": 7, "ana": 8, "leo": 7 }
if (count int(7) in scores == 2) { post("dict-value-ok") }

action contarSetes() {
    count each int(7) in nums {
        return;
    }
}
if (contarSetes() == 3) { post("count-each-return-total-ok") }

list bs = [True, False, True, True, 1, 0]
if (count bool(True) in bs == 3) { post("bool-strict-ok") }

list mistura = [1, 1.0, 2.5, 2.5, 3]
if (count flo in mistura == 3) { post("flo-type-ok") }

if (not count str("zzz") in frase) { post("not-count-ok") }

list a = [1,1,2]
list b = [3,4,5]
if (count int(1) in a and count int(3) in b) { post("count-and-count-ok") }

if (count str("xx") in frase == 0) { post("zero-count-ok") }

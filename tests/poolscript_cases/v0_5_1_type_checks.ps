// Testes reais em PoolScript: tipos, comparações e validações múltiplas
enter1 = 123
if (enter1 is int) { post("dyn-int-ok") } else { post("dyn-int-fail") }

int enter2 = 456
if (enter2 is int) { post("typed-int-ok") }

flo valor_flo = 1
if (valor_flo is flo) { post("typed-flo-ok") }

texto = "Pool"
if (texto is str and texto not is None) { post("str-not-none-ok") }
if (texto is not None) { post("is-not-none-ok") }

lista = ["a", "b", "c"]
objeto = {nome: "Pool", versao: 5}
if (lista is list and objeto is json) { post("collections-ok") }

nome1 = "A"
nome2 = "B"
nome3 = "C"
if (nome1 and nome2 and nome3 not is None) { post("multi-and-ok") }
if (nome1) { post("truthy-name-ok") }

if (123 == 123 and 123 != 456 and 123 === 123 and 123 !== 456) { post("equality-ok") }
if (1 < 2 and 2 <= 2 and 3 > 2 and 3 >= 3) { post("magnitude-ok") }
if ("b" in lista and "z" not in lista) { post("membership-ok") }

convertido = int("17")
real = flo("1.5")
como_texto = str(99)
if (convertido is int and real is flo and como_texto is str) { post("casts-ok") }
